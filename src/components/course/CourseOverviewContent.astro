---
import type { CollectionEntry } from 'astro:content';
import {
  courseOverviewData,
  courseOverviewSections,
} from '../../lib/course-overview';
import { getLessonRoadmap, getLessonTopics } from '../../lib/lesson-topics';
import { isReleasedStudentLesson } from '../../lib/student-release';
import { withBase } from '../../lib/site';
import '../../styles/course-overview.css';

interface Props {
  lessons: CollectionEntry<'lessons'>[];
  roadmapScope?: 'full' | 'released';
  linkReleasedLessons?: boolean;
}

const {
  lessons,
  roadmapScope = 'full',
  linkReleasedLessons = false,
} = Astro.props;
const lessonsById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
const roadmap = getLessonRoadmap().filter(
  (lesson) => roadmapScope === 'full' || isReleasedStudentLesson(lesson.id),
);
const roadmapById = new Map(roadmap.map((lesson) => [lesson.id, lesson]));
const topicGroups = getLessonTopics().map((topic) => ({
  topic,
  lessons: topic.lessonIds.flatMap((lessonId) => {
    const lesson = roadmapById.get(lessonId);
    return lesson ? [lesson] : [];
  }),
})).filter(({ lessons: topicLessons }) => topicLessons.length > 0);
---

<div class="course-overview-content lesson-content" data-course-overview-content>
  <section class="lesson-section course-overview-section" id={courseOverviewSections[0].id}>
    <div class="section-heading"><span>01</span><h2>{courseOverviewSections[0].label}</h2></div>
    <ul class="course-overview-list">
      {courseOverviewData.learning.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[1].id}>
    <div class="section-heading"><span>02</span><h2>{courseOverviewSections[1].label}</h2></div>
    <ul class="course-overview-list course-overview-list--cards">
      {courseOverviewData.relationship.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[2].id}>
    <div class="section-heading"><span>03</span><h2>{courseOverviewSections[2].label}</h2></div>
    <ul class="course-overview-list">
      {courseOverviewData.aiStrengths.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[3].id}>
    <div class="section-heading"><span>04</span><h2>{courseOverviewSections[3].label}</h2></div>
    <ul class="course-overview-list">
      {courseOverviewData.humanJudgment.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[4].id}>
    <div class="section-heading"><span>05</span><h2>{courseOverviewSections[4].label}</h2></div>
    <div class="course-overview-types">
      {courseOverviewData.informationTypes.map((item) => (
        <article><h3>{item.title}</h3><p>{item.description}</p></article>
      ))}
    </div>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[5].id}>
    <div class="section-heading"><span>06</span><h2>{courseOverviewSections[5].label}</h2></div>
    <ol class="course-overview-cycle">
      {courseOverviewData.cycle.map((item, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>
      ))}
    </ol>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[6].id}>
    <div class="section-heading"><span>07</span><h2>{courseOverviewSections[6].label}</h2></div>
    <div class="course-overview-topics">
      {topicGroups.map(({ topic, lessons: topicLessons }) => (
        <article>
          <header>
            <span>주제 {topic.number}</span>
            <div>
              <h3>{topic.title}</h3>
              {topic.subtitle && <p class="course-overview-topic__subtitle">{topic.subtitle}</p>}
            </div>
          </header>
          <ol>
            {topicLessons.map((lesson) => (
              <li>
                <span>제{lesson.day}차시</span>
                {linkReleasedLessons && isReleasedStudentLesson(lesson.id) && lessonsById.has(lesson.id) ? (
                  <a href={withBase(`/lessons/${lesson.id}/`)}>
                    {lesson.title.replace(/^제\d+차시\s*·?\s*/, '')}
                  </a>
                ) : (
                  <strong>{lesson.title.replace(/^제\d+차시\s*·?\s*/, '')}</strong>
                )}
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[7].id}>
    <div class="section-heading"><span>08</span><h2>{courseOverviewSections[7].label}</h2></div>
    <div class="course-overview-usage">
      {courseOverviewData.usage.map((item) => (
        <article><h3>{item.title}</h3><p>{item.description}</p></article>
      ))}
    </div>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[8].id}>
    <div class="section-heading"><span>09</span><h2>{courseOverviewSections[8].label}</h2></div>
    <ul class="course-overview-list">
      {courseOverviewData.outcomes.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="lesson-section course-overview-section" id={courseOverviewSections[9].id}>
    <div class="section-heading"><span>10</span><h2>{courseOverviewSections[9].label}</h2></div>
    <div class="course-overview-principles">
      {courseOverviewData.principles.map((item, index) => (
        <blockquote><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></blockquote>
      ))}
    </div>
  </section>
  {roadmapScope === 'full' && (
    <p class="course-overview-release-note">
      차시별 학습자료는 강의 진행에 맞춰 e-book에서 제공된다.
    </p>
  )}
</div>
