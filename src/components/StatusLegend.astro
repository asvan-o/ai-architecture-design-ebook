---
import StatusBadge from './StatusBadge.astro';

const statuses = [
  '공식 자료 확인',
  '출처 확인',
  '해석',
  '디자인 제안',
  'AI 생성',
  '검증 필요',
  '전문가 검토 필요',
  '업데이트 가능성 높음',
] as const;
---

<div class="status-legend" aria-label="사실성 상태 배지">
  {statuses.map((status) => <StatusBadge status={status} />)}
</div>
