---
import StatusBadge from './StatusBadge.astro';

const statuses = [
  { kind: 'verificationStatus', value: 'official-source-checked' },
  { kind: 'verificationStatus', value: 'source-checked' },
  { kind: 'contentType', value: 'interpretation' },
  { kind: 'contentType', value: 'design-proposal' },
  { kind: 'authorship', value: 'ai-generated' },
  { kind: 'verificationStatus', value: 'pending' },
  { kind: 'professionalReviewStatus', value: 'required' },
  { kind: 'freshness', value: 'update-sensitive' },
] as const;
---

<div class="status-legend" aria-label="사실성 상태 배지">
  {statuses.map((status) => <StatusBadge kind={status.kind} value={status.value} />)}
</div>
