---
import Lesson04RfpReviewPractice from './Lesson04RfpReviewPractice.astro';
import LessonSection from './LessonSection.astro';
import PromptCopyBlock from './PromptCopyBlock.astro';
import type { Lesson04WorkflowData } from '../../lib/lesson04-workflow';
import { lesson04ProgramIdeas } from '../../lib/lesson04-final-content';

interface Props {
  lessonId: string;
  workflow: Lesson04WorkflowData;
  [key: string]: unknown;
}

const { lessonId, workflow } = Astro.props;
const { finalContent } = workflow;
const { antigravity, organizer } = finalContent;
---

<Lesson04RfpReviewPractice lessonId={lessonId} review={workflow.reviewPractice} />

<LessonSection id="section-06" number="06" title="Antigravity 2.0 이해와 실습 준비" class="outline-section lesson04-final-section" {lessonId}>
  <div class="lead-block">
    <span>PART B · DESIGN AUTOMATION</span>
    <h3>설계 업무를 정리하는 로컬 프로그램을 직접 기획한다.</h3>
    <p>{antigravity.overview}</p>
  </div>
  <div class="role-flow" aria-label="Antigravity 2.0 실습의 역할">
    <article><strong>Antigravity 2.0</strong><span>프로그램 제작</span></article>
    <b aria-hidden="true">→</b>
    <article><strong>로컬 프로젝트 폴더</strong><span>파일과 코드의 작업 범위</span></article>
    <b aria-hidden="true">→</b>
    <article><strong>사람의 검토</strong><span>권한·분류·결과 확인</span></article>
  </div>
  <aside class="boundary-note">
    Antigravity는 코드를 만들고 실행할 수 있지만, 설계 판단·법규 적합성·구조 안전·재료 성능·시공 가능성을 대신 확정하지 않는다.
  </aside>
</LessonSection>

<LessonSection id="section-07" number="07" title="Antigravity 2.0 사용법 · Project, Local Mode, 설정, 단축키, slash command" class="outline-section lesson04-final-section" {lessonId}>
  <div class="two-column">
    <section>
      <h3>바탕화면에서 Project 시작</h3>
      <ol>{antigravity.projectSteps.map((step) => <li>{step}</li>)}</ol>
    </section>
    <section>
      <h3>권장 설정</h3>
      <div class="setting-list">
        {antigravity.settings.map((setting) => (
          <article><strong>{setting.name}</strong><b>{setting.value}</b><p>{setting.note}</p></article>
        ))}
      </div>
    </section>
  </div>
  <p class="key-message">{antigravity.safetyMessage}</p>
  <div class="two-column">
    <section>
      <h3>slash command</h3>
      {antigravity.slashCommands.map((item) => (
        <div class="command-card">
          <code>{item.command}</code><p>{item.description}</p>
          <PromptCopyBlock id={`lesson04-${item.command.slice(1)}`} title={`${item.command} 예제`} prompt={item.example} />
        </div>
      ))}
    </section>
    <section>
      <h3>Windows 단축키</h3>
      <dl class="shortcut-list">
        {antigravity.shortcuts.map(([key, action]) => <div><dt>{key}</dt><dd>{action}</dd></div>)}
      </dl>
    </section>
  </div>
  <div class="source-list">
    <strong>공식 자료 확인 · {antigravity.checkedAt}</strong>
    <ul>{antigravity.sources.map(([title, url]) => <li><a href={url} target="_blank" rel="noreferrer">{title}</a></li>)}</ul>
  </div>
</LessonSection>

<LessonSection id="section-08" number="08" title="무엇을 자동화할 것인가 · 설계 프로젝트 자동 정리 프로그램" class="outline-section lesson04-final-section" {lessonId}>
  <div class="lead-block lead-block--dark">
    <span>MAIN PROGRAM</span>
    <h3>{organizer.name}</h3>
    <p>한 프로젝트 전용 프로그램이 아니라, 하나의 ROOT 아래에서 여러 설계 프로젝트를 만들고 전환하는 로컬 도구를 기획한다.</p>
  </div>
  <div class="program-principles">
    <article><strong>기준</strong><p>실제 Windows 프로젝트 폴더가 항상 원본이다.</p></article>
    <article><strong>자동화</strong><p>확실한 확장자는 규칙으로, 이미지는 용도 중심으로 분류한다.</p></article>
    <article><strong>검토</strong><p>애매한 항목과 전문 판단은 사람이 확인한다.</p></article>
  </div>
</LessonSection>

<LessonSection id="section-09" number="09" title="개발 실습 · ROOT와 다중 프로젝트 구조 만들기" class="outline-section lesson04-final-section" {lessonId}>
  <p>사용자가 ROOT의 위치와 이름을 정한다. 아래 이름은 수업 예시이며 Windows 사용자명이나 절대경로를 직접 입력하지 않는다.</p>
  <div class="tree-grid">
    <article><h3>ROOT와 여러 프로젝트</h3><pre><code>{organizer.rootExample}</code></pre></article>
    <article><h3>프로젝트 생성 시 하위 구조</h3><pre><code>{organizer.projectTree}</code></pre></article>
  </div>
  <aside class="boundary-note"><code>_INBOX</code>는 만들지 않는다. 프로젝트 폴더 최상위가 미분류 파일을 감지하는 작업 위치다.</aside>
</LessonSection>

<LessonSection id="section-10" number="10" title="개발 실습 · 파일 감지와 자동 분류" class="outline-section lesson04-final-section" {lessonId}>
  <div class="two-column">
    <section><h3>파일 투입과 감지</h3><ol>{organizer.intake.map((item) => <li>{item}</li>)}</ol></section>
    <section>
      <h3>확장자 규칙</h3>
      <div class="table-scroll" tabindex="0" role="region" aria-label="확장자별 자동 분류 규칙">
        <table><thead><tr><th>파일 형식</th><th>이동 폴더</th></tr></thead><tbody>{organizer.extensionRules.map(([ext, folder]) => <tr><th scope="row">{ext}</th><td>{folder}</td></tr>)}</tbody></table>
      </div>
    </section>
  </div>
  <p class="key-message">확장자로 확실한 파일은 Gemini API를 호출하지 않는다.</p>
</LessonSection>

<LessonSection id="section-11" number="11" title="개발 실습 · Gemini API 이미지 자동 분류" class="outline-section lesson04-final-section" {lessonId}>
  <p>{organizer.geminiModel}</p>
  <p>현재 공식 문서는 이미지 분류를 포함한 이미지 이해 작업에 Gemini API를 사용할 수 있다고 안내한다. 결과는 자동 확정이 아니라 프로젝트 용도 분류의 보조 신호로 사용한다.</p>
  <div class="category-grid" aria-label="이미지 자동 분류 범주">{organizer.imageCategories.map((item) => <span>{item}</span>)}</div>
  <div class="two-column">
    <section><h3>분류 원칙</h3><ul>{organizer.imagePolicy.map((item) => <li>{item}</li>)}</ul></section>
    <section><h3>API Key 안전</h3><ul>{organizer.apiSafety.map((item) => <li>{item}</li>)}</ul></section>
  </div>
  <aside class="boundary-note"><strong>핵심 질문</strong> “이 이미지가 프로젝트에서 어떤 용도로 사용되는가?”</aside>
  <p class="source-list"><a href={organizer.geminiSource} target="_blank" rel="noreferrer">Gemini API 이미지 이해 공식 문서</a> · 확인일 {antigravity.checkedAt}</p>
</LessonSection>

<LessonSection id="section-12" number="12" title="개발 실습 · 작업파일 Revision 라벨링" class="outline-section lesson04-final-section" {lessonId}>
  <div class="revision-example">
    <article><strong>Lobby.skp</strong><span>R01 → R02 → R03</span></article>
    <article><strong>Restaurant.skp</strong><span>R01 → R02</span></article>
    <article><strong>Exterior.skp</strong><span>독립 작업파일</span></article>
  </div>
  <ul>{organizer.revision.map((item) => <li>{item}</li>)}</ul>
  <aside class="boundary-note">파일명 변경 없음 · 파일 복제 없음 · Revision은 백업 기능이 아님</aside>
</LessonSection>

<LessonSection id="section-13" number="13" title="전체 자동화 검증" class="outline-section lesson04-final-section" {lessonId}>
  <fieldset class="verification-list">
    <legend>사람이 마지막으로 확인할 항목</legend>
    {organizer.checks.map((item) => <label><input type="checkbox" /> <span>{item}</span></label>)}
  </fieldset>
  <p class="key-message">자동 분류가 끝나도 원본 폴더와 98_REVIEW를 확인한 뒤 다음 작업으로 넘어간다.</p>
</LessonSection>

<LessonSection id="section-14" number="14" title="Antigravity 2.0으로 더 만들어볼 수 있는 건축·디자인 업무 도구" class="outline-section lesson04-final-section" {lessonId}>
  <div class="lead-block">
    <span>PART C · 10 STARTER IDEAS</span>
    <h3>아이디어를 고르고, 시작 프롬프트로 구조부터 설계한다.</h3>
    <p>각 프롬프트는 즉시 완성품을 요구하지 않고 화면·데이터·자동화 흐름과 최소 기능부터 검토하도록 구성했다.</p>
  </div>
  <div class="idea-grid">
    {lesson04ProgramIdeas.map((idea) => (
      <article class="idea-card">
        <span>{String(idea.number).padStart(2, '0')}</span>
        <h3>{idea.title}</h3>
        <p>{idea.description}</p>
        <ul>{idea.features.map((feature) => <li>{feature}</li>)}</ul>
        <PromptCopyBlock id={`lesson04-program-${idea.number}`} title="시작 프롬프트 복사" prompt={idea.prompt} />
      </article>
    ))}
  </div>
</LessonSection>

<style>
  :global(.lesson04-final-section) { --l04-ink: #17211d; --l04-paper: #f4f0e7; --l04-accent: #a33c25; }
  .lead-block { display:grid; gap:.65rem; padding:clamp(1.25rem,3vw,2rem); border-left:5px solid var(--l04-accent); background:var(--l04-paper); }
  .lead-block > span { color:var(--l04-accent); font-size:.75rem; font-weight:800; letter-spacing:.12em; }
  .lead-block h3,.lead-block p { margin:0; }
  .lead-block h3 { font-family:var(--serif); font-size:clamp(1.5rem,3vw,2.2rem); text-wrap:balance; }
  .lead-block p { max-width:54rem; line-height:1.75; }
  .lead-block--dark { color:#fff; background:var(--l04-ink); border-left-color:#d88363; }
  .role-flow,.program-principles,.revision-example { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.8rem; align-items:center; margin-top:1.25rem; }
  .role-flow article,.program-principles article,.revision-example article { display:grid; gap:.35rem; min-width:0; padding:1rem; border:1px solid var(--line-dark); background:#fff; }
  .role-flow b { text-align:center; color:var(--l04-accent); }
  .program-principles { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .program-principles p { margin:.3rem 0 0; line-height:1.6; }
  .boundary-note,.key-message { margin-top:1.2rem; padding:1rem 1.2rem; border-left:4px solid var(--l04-accent); background:#f8eee8; line-height:1.7; }
  .two-column,.tree-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:1.25rem; }
  .two-column > section,.tree-grid > article { min-width:0; padding:1.2rem; border:1px solid var(--line-dark); background:#fff; }
  .two-column h3,.tree-grid h3 { margin-top:0; }
  .two-column li { margin:.55rem 0; line-height:1.6; }
  .setting-list { display:grid; gap:.75rem; }
  .setting-list article { display:grid; gap:.3rem; padding:.8rem; background:var(--l04-paper); }
  .setting-list b { color:var(--l04-accent); }
  .setting-list p { margin:0; line-height:1.55; }
  .command-card { margin-top:1rem; padding-top:1rem; border-top:1px solid var(--line); }
  .command-card > code { color:var(--l04-accent); font-weight:800; }
  .shortcut-list { display:grid; margin:0; border:1px solid var(--line); }
  .shortcut-list > div { display:grid; grid-template-columns:minmax(8rem,.4fr) minmax(0,1fr); border-bottom:1px solid var(--line); }
  .shortcut-list > div:last-child { border-bottom:0; }
  .shortcut-list dt,.shortcut-list dd { margin:0; padding:.75rem; }
  .shortcut-list dt { font-weight:800; background:var(--l04-paper); }
  .source-list { margin-top:1.2rem; font-size:.92rem; line-height:1.7; }
  .source-list ul { display:flex; flex-wrap:wrap; gap:.6rem 1.2rem; padding-left:1.2rem; }
  .tree-grid pre { max-width:100%; margin:0; padding:1rem; overflow:auto; color:#f8f5ed; background:var(--l04-ink); font-size:.9rem; line-height:1.6; }
  .table-scroll { max-width:100%; overflow-x:auto; }
  table { width:100%; min-width:32rem; border-collapse:collapse; }
  th,td { padding:.75rem; border:1px solid var(--line); text-align:left; }
  thead th { color:#fff; background:var(--l04-ink); }
  .category-grid { display:flex; flex-wrap:wrap; gap:.55rem; margin:1rem 0; }
  .category-grid span { padding:.55rem .7rem; border:1px solid var(--line-dark); background:#fff; font-size:.85rem; font-weight:800; }
  .revision-example { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .revision-example span { color:var(--l04-accent); font-weight:800; }
  .verification-list { display:grid; gap:.65rem; margin:0; padding:1.2rem; border:1px solid var(--line-dark); }
  .verification-list legend { padding:0 .5rem; font-family:var(--serif); font-size:1.3rem; font-weight:800; }
  .verification-list label { display:flex; gap:.7rem; align-items:flex-start; line-height:1.6; }
  .verification-list input { width:1.15rem; height:1.15rem; margin-top:.25rem; accent-color:var(--l04-accent); }
  .idea-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:1.25rem; }
  .idea-card { min-width:0; padding:1.2rem; border:1px solid var(--line-dark); background:#fff; }
  .idea-card > span { color:var(--l04-accent); font-weight:800; letter-spacing:.1em; }
  .idea-card h3 { margin:.35rem 0; font-family:var(--serif); font-size:1.35rem; text-wrap:balance; }
  .idea-card p,.idea-card li { line-height:1.6; }
  @media (max-width:760px) {
    .role-flow,.program-principles,.revision-example,.two-column,.tree-grid,.idea-grid { grid-template-columns:minmax(0,1fr); }
    .role-flow b { transform:rotate(90deg); }
    .shortcut-list > div { grid-template-columns:minmax(0,1fr); }
    .tree-grid pre { font-size:.78rem; }
  }
  @media print {
    .lead-block,.role-flow article,.program-principles article,.two-column > section,.tree-grid > article,.revision-example article,.idea-card,.verification-list { break-inside:avoid; page-break-inside:avoid; }
    .two-column,.tree-grid,.idea-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .tree-grid pre { white-space:pre-wrap; overflow:visible; }
    .idea-card :global(button),.idea-card :global(.copy-button) { display:none!important; }
  }
</style>
