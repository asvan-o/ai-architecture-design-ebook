---
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<aside class="lesson-topic" aria-label={`주제 ${number}`}>
  <span>주제 {number}</span>
  <strong>{title}</strong>
</aside>

<style>
  .lesson-topic {
    display: grid;
    gap: 0.4rem;
    margin: 0 0 1.5rem;
    padding: 1rem 0;
    border-top: 2px solid var(--color-text, #292a25);
    border-bottom: 1px solid var(--color-border, #d9d7cf);
  }

  .lesson-topic span {
    color: var(--color-accent, #5f6548);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .lesson-topic strong {
    max-width: 34ch;
    font-size: clamp(1.2rem, 2.6vw, 1.75rem);
    line-height: 1.35;
    text-wrap: balance;
  }

  @media print {
    .lesson-topic {
      break-inside: avoid-page;
      page-break-inside: avoid;
    }
  }
</style>
