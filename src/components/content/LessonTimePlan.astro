---
interface TimePlanItem {
  label: string;
  detail: string;
  minutes: number;
  practiceRelated?: boolean;
}

interface Props {
  totalMinutes: number;
  timePlan: TimePlanItem[];
}

const { totalMinutes, timePlan } = Astro.props;
const isInstructorConsole = Astro.url.pathname.includes('/instructor-console/');
const instructorTimelineJson = JSON.stringify({ totalMinutes, items: timePlan })
  .replaceAll('<', '\\u003c')
  .replaceAll('\u2028', '\\u2028')
  .replaceAll('\u2029', '\\u2029');
const displayedTimePlan = timePlan.map((item) => {
  const labelIsTimeRange = /^\s*\d/.test(item.label) && item.label.includes('분');
  return {
    title: labelIsTimeRange ? item.detail : item.label,
    detail: labelIsTimeRange ? '' : item.detail,
  };
});
---

{isInstructorConsole && (
  <script is:inline type="application/json" data-instructor-timeline set:html={instructorTimelineJson} />
)}

<div class="time-plan time-plan--detailed">
  <header><span>TODAY'S FLOW</span><strong>오늘의 수업 흐름</strong></header>
  <ol class="time-plan__detailed-list">
    {displayedTimePlan.map((item, index) => (
      <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item.title}</strong>{item.detail && <p>{item.detail}</p>}</div></li>
    ))}
  </ol>
</div>
