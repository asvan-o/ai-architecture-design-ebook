---
interface TimePlanItem {
  label: string;
  detail: string;
  minutes: number;
  practiceRelated?: boolean;
}

interface Props {
  totalMinutes: number;
  timePlan: TimePlanItem[];
}

const { totalMinutes, timePlan } = Astro.props;
const allocatedMinutes = timePlan.reduce((sum, item) => sum + item.minutes, 0);
---

<div class="time-plan time-plan--detailed">
  <div class="table-scroll" tabindex="0" role="region" aria-label="제1차시 시간표">
    <table class="lesson-table">
      <caption class="sr-only">제1차시 수업 구성</caption>
      <thead>
        <tr><th>구간</th><th>내용</th><th>시간</th></tr>
      </thead>
      <tbody>
        {timePlan.map((item) => (
          <tr>
            <th scope="row">{item.label}</th>
            <td>{item.detail}</td>
            <td>{item.minutes}분</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {allocatedMinutes !== totalMinutes && (
    <p class="time-plan__warning">시간 배분 합계 검토 필요: {allocatedMinutes}분</p>
  )}
</div>
