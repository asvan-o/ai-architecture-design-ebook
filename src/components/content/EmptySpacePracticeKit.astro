---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PromptCopyBlock from './PromptCopyBlock.astro';

type PromptExample = {
  id: string;
  title: string;
  content: string;
};

type BaseImage = {
  src: ImageMetadata;
  alt: string;
  caption: string;
};

interface Props {
  prompts: PromptExample[];
  images: BaseImage[];
}

const { prompts, images } = Astro.props;
---

<div class="empty-space-kit">
  <section aria-labelledby="empty-space-prompts-title">
    <header class="empty-space-kit__header">
      <span>교육용 제작 예시</span>
      <h3 id="empty-space-prompts-title">빈 공간 이미지 제작 프롬프트</h3>
      <p>
        아래 세 문장은 수업용 빈 공간 이미지를 준비할 때 사용한 제작 예시입니다. 이미지 생성·수정
        실습에서 작성할 인테리어 요청문의 정답이 아니며, 공간 용도와 사용자에 맞게 새 요청문을
        작성해야 합니다.
      </p>
    </header>

    <div class="prompt-examples">
      {prompts.map((prompt, index) => (
        <details>
          <summary>
            <span>제작 예시 {String(index + 1).padStart(2, '0')}</span>
            <strong>{prompt.title}</strong>
          </summary>
          <div class="prompt-example" id={prompt.id}>
            <PromptCopyBlock
              id={`${prompt.id}-copy`}
              title={prompt.title}
              prompt={prompt.content}
              label="생성 프롬프트 복사"
            />
          </div>
        </details>
      ))}
    </div>
  </section>

  <section aria-labelledby="empty-space-gallery-title">
    <header class="empty-space-kit__header">
      <span>PRACTICE INPUT</span>
      <h3 id="empty-space-gallery-title">실습 선택용 빈 공간 이미지</h3>
      <p>
        다섯 장 중 하나를 선택합니다. 특정 이미지가 정답은 아니며, 보이는 장면만으로 정확한 구조·면적이나
        도면 정보를 단정하지 않습니다.
      </p>
    </header>

    <div class="base-image-gallery">
      {images.map((image, index) => (
        <figure>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 720px) 100vw, 50vw"
            loading="eager"
          />
          <figcaption>
            <span>BASE {String(index + 1).padStart(2, '0')}</span>
            {image.caption}
          </figcaption>
          <a
            class="base-image-download"
            href={image.src.src}
            download={`lesson-02-empty-space-base-${String(index + 1).padStart(2, '0')}.jpeg`}
            aria-label={`빈 공간 이미지 BASE ${String(index + 1).padStart(2, '0')} 다운로드`}
          >
            이미지 다운로드
            <span aria-hidden="true">↓</span>
          </a>
        </figure>
      ))}
    </div>
  </section>
</div>

<style>
  .empty-space-kit {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
    margin-top: 2rem;
    min-width: 0;
  }

  .empty-space-kit section,
  .empty-space-kit__header,
  .prompt-examples,
  .base-image-gallery {
    min-width: 0;
  }

  .empty-space-kit__header {
    max-width: 72ch;
    margin-bottom: 1.25rem;
  }

  .empty-space-kit__header > span {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-accent, #5f6548);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .empty-space-kit__header h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    text-wrap: balance;
  }

  .empty-space-kit__header p {
    margin: 0.75rem 0 0;
  }

  .prompt-examples {
    display: grid;
    gap: 0.75rem;
  }

  details {
    border-top: 1px solid var(--color-border, #d9d7cf);
    border-bottom: 1px solid var(--color-border, #d9d7cf);
    background: var(--color-surface, #f8f7f2);
  }

  details + details {
    margin-top: -1px;
  }

  summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    align-items: baseline;
    padding: 1rem;
    cursor: pointer;
  }

  summary:focus-visible {
    outline: 3px solid var(--color-focus, #1d4ed8);
    outline-offset: 3px;
  }

  summary span {
    color: var(--color-muted, #66655f);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  summary strong {
    overflow-wrap: anywhere;
  }

  .prompt-example {
    padding: 0 1rem 1.25rem;
  }

  .prompt-example p {
    margin: 0;
    padding: 1rem;
    border-left: 3px solid var(--color-accent, #5f6548);
    background: var(--color-background, #fff);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .base-image-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  figure {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    margin: 0;
    min-width: 0;
    break-inside: avoid-page;
    page-break-inside: avoid;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border, #d9d7cf);
    object-fit: contain;
  }

  figcaption {
    color: var(--color-text, #292a25);
    line-height: 1.55;
  }

  figcaption span {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-muted, #66655f);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .base-image-download {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-text, #292a25);
    color: var(--color-text, #292a25);
    background: var(--color-background, #fff);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .base-image-download:hover {
    color: var(--color-background, #fff);
    background: var(--color-text, #292a25);
  }

  .base-image-download:focus-visible {
    outline: 3px solid var(--color-focus, #1d4ed8);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .base-image-gallery {
      grid-template-columns: minmax(0, 1fr);
    }

    summary {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }

  @media print {
    .empty-space-kit {
      display: block;
    }

    .empty-space-kit > section + section {
      margin-top: 8mm;
    }

    .empty-space-kit__header {
      break-inside: avoid-page;
      page-break-inside: avoid;
    }

    details {
      break-inside: avoid-page;
      page-break-inside: avoid;
    }

    details > summary {
      cursor: default;
      padding: 3mm;
    }

    details > .prompt-example {
      display: block !important;
      padding: 0 0 4mm;
    }

    .prompt-example p {
      padding: 3mm;
    }

    .base-image-gallery {
      grid-template-columns: minmax(0, 1fr);
      gap: 7mm;
    }

    figure :global(img) {
      max-height: 105mm;
      object-fit: contain;
    }

    .base-image-download {
      display: none;
    }
  }
</style>
