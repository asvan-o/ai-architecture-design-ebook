---
import { Image } from 'astro:assets';
import LessonSection from './LessonSection.astro';
import PromptCopyBlock from './PromptCopyBlock.astro';

import gaussianSource from '../../assets/lessons/08/gaussian-render-comparison/01-gaussian-source.png';
import chatgptRender from '../../assets/lessons/08/gaussian-render-comparison/02-chatgpt-render.png';
import geminiPromptRender from '../../assets/lessons/08/gaussian-render-comparison/03-gemini-nano-banana-prompt.jpeg';
import geminiAgentRender from '../../assets/lessons/08/gaussian-render-comparison/04-gemini-nano-banana-agent.jpeg';
import vibe3dRender from '../../assets/lessons/08/gaussian-render-comparison/05-vibe3d-render.png';
import vibe3dRelightRender from '../../assets/lessons/08/gaussian-render-comparison/06-vibe3d-relight-render.png';
import floorPlanBefore from '../../assets/lessons/08/floor-plan-upscale/01-floor-plan-before-upscale.png';
import floorPlanAfter from '../../assets/lessons/08/floor-plan-upscale/02-floor-plan-after-upscale-2x.png';
import runSr1033Source from '../../assets/lessons/08/openvino-sr1033/run_sr1033.py?raw';

interface TimeItem {
  label: string;
  minutes: number;
  mode: 'guide' | 'demo' | 'practice' | 'review';
}

interface Props {
  lessonId?: string;
  timePlan: readonly TimeItem[];
}

const { lessonId = '08', timePlan } = Astro.props;
const totalMinutes = timePlan.reduce((sum, item) => sum + item.minutes, 0);

const workflowSteps = [
  'Gaussian 결과에서 활용할 시점 선택',
  '현실형 건축·인테리어 이미지 후보 생성',
  '도구별 결과를 같은 기준으로 비교',
  '최종 후보 선택과 필요한 영역만 보정',
  'AI Upscale 실행',
  '원본과 대조해 최종 고해상도 이미지 정리',
];

const renderExamples = [
  {
    src: gaussianSource,
    label: 'INPUT',
    title: 'Gaussian 시점 캡처',
    caption: '현실화 작업의 기준 입력이다. 화면에 보이는 공간 관계를 기준으로 후속 결과를 비교한다.',
  },
  {
    src: chatgptRender,
    label: 'ROUTE 01',
    title: 'ChatGPT 이미지 경로 결과',
    caption: '사용자 제공 수업 예시에서 ChatGPT 렌더 결과로 구분된 이미지다.',
  },
  {
    src: geminiPromptRender,
    label: 'ROUTE 02',
    title: 'Gemini · Nano Banana 프롬프트 경로',
    caption: '구조화한 이미지 작업지시를 사용한 수업 예시다.',
  },
  {
    src: geminiAgentRender,
    label: 'ROUTE 03',
    title: 'Gemini · Nano Banana 에이전트 경로',
    caption: '에이전트형 작업 흐름을 거친 수업 예시다. 다른 경로와 결과 차이를 관찰한다.',
  },
  {
    src: vibe3dRender,
    label: 'ROUTE 04',
    title: 'VIBE3D 렌더 경로',
    caption: '전문·유료 보조 도구에서 만든 수업 예시다. 서비스 우열이 아니라 결과 특성을 비교한다.',
  },
  {
    src: vibe3dRelightRender,
    label: 'ROUTE 05',
    title: 'VIBE3D Relight 경로',
    caption: '같은 공간의 조명 재해석 예시다. 밝기 변화와 함께 구조·재질 변화 여부도 확인한다.',
  },
] as const;

const comparisonCriteria = [
  ['구조 보존', '벽체·개구부·공간 관계가 입력과 얼마나 일치하는가?'],
  ['가구', '위치·수량·형태가 의도 없이 달라지지 않았는가?'],
  ['재질', '표현이 자연스럽고 반복 무늬나 경계 오류가 없는가?'],
  ['조명', '공간을 과도하게 재해석하거나 정보 확인을 방해하지 않는가?'],
  ['추가 오브젝트', '원본에 없던 가구·창·문·장식이 생기지 않았는가?'],
  ['후속 활용', '수정·크롭·발표자료 제작에 사용할 만큼 안정적인가?'],
] as const;

const reviewItems = ['외곽선', '내부 벽', '창호', '문', '계단', '가구', '문자', '치수', '재질 패턴'];

const openVinoWingetCheck = 'winget --version';
const openVinoPythonInstall = 'winget install -e --id Python.Python.3.12 --source winget --scope user --accept-source-agreements --accept-package-agreements';
const openVinoPythonCheck = ['python --version', 'python -m pip --version'].join('\n');
const openVinoProjectSetup = [
  '$Desktop = [Environment]::GetFolderPath([Environment+SpecialFolder]::DesktopDirectory)',
  '$Project = Join-Path $Desktop "OpenVINO_SR1033"',
  '',
  'New-Item -ItemType Directory -Force -Path $Project | Out-Null',
  'Set-Location $Project',
  '',
  'Write-Host "현재 작업 위치:" (Get-Location)',
  'explorer .',
].join('\n');
const openVinoVenvSetup = ['python -m venv .venv', 'Test-Path .\\.venv\\Scripts\\python.exe'].join('\n');
const openVinoPackageSetup = [
  '.\\.venv\\Scripts\\python.exe -m pip install --upgrade pip',
  '.\\.venv\\Scripts\\python.exe -m pip install openvino opencv-python numpy',
].join('\n');
const openVinoFolderSetup = [
  'New-Item -ItemType Directory -Force -Path ".\\model" | Out-Null',
  'New-Item -ItemType Directory -Force -Path ".\\input" | Out-Null',
  'New-Item -ItemType Directory -Force -Path ".\\output" | Out-Null',
  '',
  'Get-ChildItem -Directory',
].join('\n');
const openVinoCpuCheck = '.\\.venv\\Scripts\\python.exe -c "import cv2, numpy; from openvino import Core, get_version; print(\'OpenVINO OK:\', get_version()); print(\'Device:\', Core().available_devices); print(\'OpenCV OK:\', cv2.__version__); print(\'NumPy OK:\', numpy.__version__)"';
const openVinoDownloadCommands = [
  '$BaseUrl = "https://storage.openvinotoolkit.org/repositories/open_model_zoo/2023.0/models_bin/1/single-image-super-resolution-1033/FP16"',
  '',
  'Invoke-WebRequest `',
  '-Uri "$BaseUrl/single-image-super-resolution-1033.xml" `',
  '-OutFile ".\\model\\single-image-super-resolution-1033.xml"',
  '',
  'Invoke-WebRequest `',
  '-Uri "$BaseUrl/single-image-super-resolution-1033.bin" `',
  '-OutFile ".\\model\\single-image-super-resolution-1033.bin"',
  '',
  'Write-Host "=== SR1033 모델 다운로드 완료 ==="',
  'Get-ChildItem ".\\model"',
].join('\n');
const openVinoCreateScript = [
  "@'",
  runSr1033Source.trimEnd(),
  "'@ | Set-Content \".\\run_sr1033.py\" -Encoding UTF8",
].join('\n');
const openVinoScriptCheck = 'Test-Path .\\run_sr1033.py';
const openVinoInputOpen = 'explorer .\\input';
const openVinoRun = '.\\.venv\\Scripts\\python.exe .\\run_sr1033.py';
const openVinoOutputOpen = 'explorer .\\output';
const openVinoReuse = [
  '$Desktop = [Environment]::GetFolderPath([Environment+SpecialFolder]::DesktopDirectory)',
  'Set-Location (Join-Path $Desktop "OpenVINO_SR1033")',
  '.\\.venv\\Scripts\\python.exe .\\run_sr1033.py',
].join('\n');

const openVinoTroubleshooting = [
  ['winget 인식 안 됨', 'App Installer와 WinGet 상태를 확인한다.'],
  ['Python 설치 후 python 인식 안 됨', 'PowerShell을 완전히 종료한 뒤 새로 실행한다.'],
  ['폴더 위치를 찾기 어려움', 'DesktopDirectory 명령과 explorer . 실행 여부를 확인한다.'],
  ['No module named openvino', '.\\.venv\\Scripts\\python.exe를 사용했는지 확인한다.'],
  ['모델 없음', 'model 폴더의 XML과 BIN 파일을 확인한다.'],
  ['입력 이미지 없음', 'input 폴더에 지원 형식 이미지가 있는지 확인한다.'],
  ['처리시간이 오래 걸림', '원본 이미지 해상도와 CPU 성능에 따라 시간이 달라질 수 있다.'],
  ['결과가 원본과 달라짐', 'AI 결과를 확정 정보로 사용하지 말고 원본과 대조한다.'],
] as const;
---

<LessonSection id="section-01" number="01" title="차시 소개" class="lesson08-section" {lessonId}>
  <div class="lesson08-hero" data-presentation-group="single">
    <span>LESSON 08</span>
    <h3>Gaussian 결과를 현실적인 제안 이미지로 발전시키고, 정확성을 확인하며 해상도를 높인다</h3>
    <p>제7차시에서 만든 3D 표현을 다시 설명하지 않고, 필요한 시점을 골라 현실화·비교·보정·업스케일하는 후처리 과정에 집중한다.</p>
  </div>
</LessonSection>

<LessonSection id="section-02" number="02" title="제7차시 결과와 오늘의 목표" class="lesson08-section" {lessonId}>
  <div class="lesson08-bridge">
    <p>제7차시에서는 Top View 3D 이미지를 Gaussian Splatting으로 변환하여 여러 시점에서 확인할 수 있는 3D 표현을 만들었다. 이번 차시에서는 그 결과 중 필요한 시점을 선택하고, 실제 건축·인테리어 제안 이미지로 활용할 수 있도록 현실화·보정·업스케일하는 과정을 진행한다.</p>
  </div>
  <div class="lesson08-goals">
    <article><span>01</span><h3>현실화</h3><p>Gaussian 시점 캡처를 현실적인 공간 이미지 후보로 변환한다.</p></article>
    <article><span>02</span><h3>검토</h3><p>여러 도구 결과를 같은 기준으로 비교해 후보를 선택한다.</p></article>
    <article><span>03</span><h3>고해상도화</h3><p>업스케일 결과를 원본과 대조하고 변화가 생긴 부분을 기록한다.</p></article>
  </div>
</LessonSection>

<LessonSection id="section-03" number="03" title="오늘의 전체 워크플로우" class="lesson08-section" {lessonId}>
  <ol class="lesson08-process">
    {workflowSteps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
  </ol>
  <ol class="lesson08-time-plan">
    {timePlan.map((item) => <li><span>{item.label}</span><strong>{item.minutes}분</strong></li>)}
  </ol>
  <p class="lesson08-total">총 {totalMinutes}분</p>
</LessonSection>

<LessonSection id="section-04" number="04" title="Gaussian 결과에서 이미지 시점 선택" class="lesson08-section" {lessonId}>
  <figure class="lesson08-figure lesson08-figure--wide">
    <Image src={gaussianSource} alt="Gaussian Splatting 결과에서 선택한 실내 공간 시점" widths={[720, 1080, 1440, 1920]} sizes="(max-width: 900px) 100vw, 1120px" loading="eager" />
    <figcaption><strong>Gaussian 원본 · 선택 시점</strong><span>가구와 벽체가 비교적 잘 읽히고, 화면 가장자리의 깨짐이 핵심 공간을 가리지 않는 시점을 고른다.</span></figcaption>
  </figure>
  <ul class="lesson08-checklist">
    <li>공간의 중심 관계와 주요 벽체가 읽히는가?</li>
    <li>가구·개구부가 심하게 무너지지 않은 시점인가?</li>
    <li>발표 이미지로 사용할 구도가 확보되는가?</li>
    <li>가장자리의 비어 있는 영역이나 부유물이 후속 작업을 방해하지 않는가?</li>
  </ul>
  <p class="lesson08-boundary">시점 선택은 설계 정보를 새로 확정하는 단계가 아니다. 보이는 결과 중 후처리에 적합한 화면을 고르는 단계다.</p>
</LessonSection>

<LessonSection id="section-05" number="05" title="Gaussian 결과를 현실적인 건축 이미지로 변환" class="lesson08-section" {lessonId}>
  <div class="lesson08-flow"><strong>Gaussian 시점 캡처</strong><i>→</i><strong>구조·시점 유지 조건</strong><i>→</i><strong>현실형 이미지 후보</strong></div>
  <div class="lesson08-rules">
    <article><h3>유지</h3><p>카메라 시점, 벽체와 개구부, 주요 가구 위치, 공간 비례를 기준으로 지정한다.</p></article>
    <article><h3>현실화</h3><p>재질의 표면감, 자연스러운 빛, 그림자와 경계 표현을 개선 대상으로 둔다.</p></article>
    <article><h3>금지</h3><p>새 창·문·가구·구조를 임의로 추가하거나 실제 조건을 확정한 것처럼 표현하지 않는다.</p></article>
  </div>
  <p class="lesson08-key"><strong>현실적으로 보인다는 것과 실제 설계가 정확하다는 것은 같은 의미가 아니다.</strong></p>
</LessonSection>

<LessonSection id="section-06" number="06" title="GPT · Gemini · 유료 보조 도구 결과 비교" class="lesson08-section" {lessonId}>
  <p>아래 이미지는 사용자 제공 수업 예시 파일의 표기를 기준으로 경로를 구분했다. 도구의 성능 순위를 정하는 자료가 아니라, 같은 공간을 서로 다른 서비스와 작업 방식으로 처리했을 때 무엇이 달라지는지 관찰하는 자료다.</p>
  <div class="lesson08-render-grid">
    {renderExamples.map((item) => (
      <figure class:list={['lesson08-render-card', { 'lesson08-render-card--source': item.label === 'INPUT' }]}>
        <Image src={item.src} alt={`${item.title} 공간 이미지 예시`} widths={[480, 720, 1080]} sizes="(max-width: 720px) 100vw, 50vw" loading="lazy" />
        <figcaption><span>{item.label}</span><strong>{item.title}</strong><p>{item.caption}</p></figcaption>
      </figure>
    ))}
  </div>
  <p class="lesson08-key"><strong>같은 입력 이미지를 사용해도 AI 서비스와 모델에 따라 구조 보존, 재질, 조명과 디테일 표현이 달라질 수 있다.</strong></p>
</LessonSection>

<LessonSection id="section-07" number="07" title="결과 비교 기준과 최종 후보 선택" class="lesson08-section" {lessonId}>
  <div class="lesson08-criteria">
    {comparisonCriteria.map(([title, description]) => <article><h3>{title}</h3><p>{description}</p><span>관찰 기록</span></article>)}
  </div>
  <div class="lesson08-selection">
    <h3>최종 후보 선택 순서</h3>
    <ol><li>구조 보존이 우선 기준을 통과하는지 확인한다.</li><li>전체 현실감·재질·조명을 함께 본다.</li><li>추가 오류의 수와 수정 난이도를 기록한다.</li><li>후속 크롭·보드·제안 이미지에 활용하기 좋은 한 장을 선택한다.</li></ol>
  </div>
</LessonSection>

<LessonSection id="section-08" number="08" title="선택 결과 부분 보정" class="lesson08-section" {lessonId}>
  <div class="lesson08-flow"><strong>오류 위치 표시</strong><i>→</i><strong>유지 영역 지정</strong><i>→</i><strong>필요한 영역만 수정</strong><i>→</i><strong>수정 전후 비교</strong></div>
  <p>후보 전체를 다시 생성하면 이미 잘 유지된 구조와 구도가 함께 달라질 수 있다. 이전 차시에서 사용한 부분 수정 또는 인페인팅 방식으로 오류 영역만 좁게 보정한다.</p>
  <ul class="lesson08-checklist"><li>수정 영역 밖의 벽·창·문·가구가 바뀌지 않았는가?</li><li>오류를 없애면서 새로운 오브젝트를 만들지 않았는가?</li><li>수정 경계의 재질·조명·원근이 자연스럽게 이어지는가?</li></ul>
</LessonSection>

<LessonSection id="section-09" number="09" title="Upscale이란?" class="lesson08-section" {lessonId}>
  <div class="lesson08-concept">
    <span>LOW RESOLUTION</span><strong>작은 이미지</strong><i>→</i><span>UPSCALE</span><strong>더 큰 해상도로 사용할 수 있게 확대·재구성</strong>
  </div>
  <p>업스케일은 작은 이미지를 큰 화면, 발표자료, 상세 크롭 등에 사용할 수 있도록 더 높은 해상도로 확대하거나 재구성하는 과정이다.</p>
  <p class="lesson08-key"><strong>업스케일은 원본에 숨어 있던 실제 정보를 되찾는 과정이 아니다.</strong></p>
</LessonSection>

<LessonSection id="section-10" number="10" title="Resize · 일반 AI SR · OpenVINO SR1033" class="lesson08-section" {lessonId}>
  <div class="lesson08-sr-types">
    <article><span>RESIZE</span><h3>Bicubic · Lanczos</h3><p>기존 픽셀 사이를 계산해 크기를 늘린다. 새로운 의미를 생성하는 방식은 아니지만 흐림과 계단 현상이 남을 수 있다.</p></article>
    <article><span>GENERAL AI SR</span><h3>RealESRGAN · ESRGAN 계열</h3><p>사진과 렌더처럼 일반 이미지의 경계와 질감을 재구성한다. 원본에 없던 세부 표현이 생길 수 있다.</p></article>
    <article><span>OPENVINO SR</span><h3>SR1033</h3><p>저해상도 BGR 이미지와 Bicubic 3배 입력을 함께 사용해 3배 결과를 만든다. CPU 실습에서는 일반 보간 결과와 나란히 비교한다.</p></article>
    <article><span>GENERATIVE SR</span><h3>생성형 재구성 방식</h3><p>고해상도처럼 보이는 세부를 적극적으로 재구성할 수 있다. 시각적 품질과 원본 정보 보존을 따로 검토한다.</p></article>
  </div>
  <p class="lesson08-key"><strong>선명해진 것과 정확해진 것은 같은 의미가 아니다.</strong></p>
</LessonSection>

<LessonSection id="section-11" number="11" title="Upscale의 장점·한계와 Hallucination" class="lesson08-section" {lessonId}>
  <div class="lesson08-compare">
    <article><span>활용 가능성</span><ul><li>큰 화면과 발표자료 활용성 향상</li><li>확대 시 픽셀 깨짐 감소</li><li>재질과 경계가 더 선명하게 보일 수 있음</li><li>크롭·상세 이미지와 후속 편집에 유리</li></ul></article>
    <article><span>확인해야 할 변화</span><ul><li>원본에 없던 디테일 생성</li><li>벽선·창호 경계와 가구 형상 변화</li><li>재질 패턴 변화</li><li>작은 문자·숫자·치수 왜곡</li></ul></article>
  </div>
  <p class="lesson08-warning"><strong>도면에서는 보기 좋은 결과보다 원본 정보 보존이 우선이다.</strong> 작은 숫자 <code>3600</code>이 <code>3800</code>처럼 달라질 가능성도 있으므로 공간명·치수·기호·선·표를 원본과 반드시 대조한다.</p>
  <div class="lesson08-hitl-flow"><strong>AI 결과</strong><i>→</i><strong>원본 확대 대조</strong><i>→</i><strong>변경 항목 표시</strong><i>→</i><strong>사람이 사용 여부 결정</strong></div>
  <p class="lesson08-boundary">업스케일 과정에서 원본에 없는 획·숫자·경계가 생기는 현상도 Hallucination의 한 형태로 볼 수 있다. 최종 승인은 사람이 원본과 비교하는 HITL(Human-in-the-loop) 절차로 마무리한다.</p>
</LessonSection>

<LessonSection id="section-12" number="12" title="평면도 Before · After 실제 비교" class="lesson08-section" {lessonId}>
  <p>동일한 평면도 원본과 2배 업스케일 결과를 나란히 본다. 이미지는 학습용 비교 화면으로만 표시하며 다운로드 기능을 제공하지 않는다.</p>
  <div class="lesson08-plan-compare">
    <figure><span>BEFORE · Original</span><Image src={floorPlanBefore} alt="업스케일 전 전체 평면도 원본" widths={[520, 780, 1040]} sizes="(max-width: 720px) 100vw, 50vw" loading="lazy" /><figcaption>원본 · 876 × 1414 px</figcaption></figure>
    <figure><span>AFTER · AI Upscale ×2</span><Image src={floorPlanAfter} alt="2배 AI 업스케일 후 전체 평면도" widths={[520, 780, 1040]} sizes="(max-width: 720px) 100vw, 50vw" loading="lazy" /><figcaption>2배 결과 · 1752 × 2828 px</figcaption></figure>
  </div>
  <div class="lesson08-zoom-check">
    <h3>같은 영역을 확대해 확인</h3>
    <ul>{['작은 문자 획이 다른 글자로 바뀌지 않았는가?', '벽선 두께와 끊김이 달라지지 않았는가?', '가구선이 합쳐지거나 새 선이 생기지 않았는가?', '치수 숫자·기호가 원본과 같은가?'].map((item) => <li>{item}</li>)}</ul>
  </div>
</LessonSection>

<LessonSection id="section-13" number="13" title="ComfyUI Upscale 실습" class="lesson08-section" {lessonId}>
  <p>수업 자료에서 확인한 실제 워크플로 JSON을 사용한다. 이 파일은 여러 이미지를 한 폴더에서 불러오는 <code>VHS_LoadImages</code> 노드를 사용하므로 Video Helper Suite 사용자 노드가 필요하다.</p>
  <ol class="lesson08-node-flow">
    <li><span>01</span><strong>VHS_LoadImages</strong><p>지정 폴더의 이미지를 입력한다.</p></li>
    <li><span>02</span><strong>ImageScale</strong><p>Lanczos, 1120 × 1074, crop disabled로 기준 크기를 맞춘다.</p></li>
    <li><span>03A</span><strong>RealESRGAN_x2.pth</strong><p><code>UpscaleModelLoader → ImageUpscaleWithModel</code> 경로로 2배 결과를 만든다.</p></li>
    <li><span>03B</span><strong>4x-UltraSharp.pth</strong><p>같은 입력을 별도 모델 경로로 처리해 비교 결과를 만든다.</p></li>
    <li><span>04</span><strong>SaveImage</strong><p>Lanczos 기준 결과와 두 모델 결과를 각각 저장한다.</p></li>
  </ol>
  <p class="lesson08-boundary">모델 파일이 로컬의 <code>models/upscale_models</code>에 없으면 실행되지 않는다. 수업 JSON에 기록된 모델명과 노드만 설명하며, 다른 환경에서 같은 결과를 보장하지 않는다.</p>
</LessonSection>

<LessonSection id="section-14" number="14" title="OpenVINO CPU 기반 AI 업스케일" class="lesson08-section" {lessonId}>
  <div class="lesson08-openvino-intro">
    <span>CPU PRACTICE · SR1033</span>
    <h3>저사양 PC에서도 실행하는 SR1033 3× Super Resolution</h3>
    <p>평면도, PDF 래스터 이미지와 캡처 이미지의 해상도가 낮으면 작은 문자와 가는 선이 흐려져 후속 AI 분석이나 시각화에서 정보가 불명확해질 수 있다. 이번 실습은 별도의 NVIDIA GPU나 CUDA 없이 OpenVINO Runtime과 CPU로 이미지를 3배 확대한다.</p>
  </div>
  <div class="lesson08-model-facts" data-lesson08-openvino-model="single-image-super-resolution-1033">
    <article><span>MODEL</span><strong>SR1033 · FP16</strong><p><code>single-image-super-resolution-1033</code> OpenVINO IR 모델을 사용한다.</p></article>
    <article><span>INPUT</span><strong>BGR 3채널 × 2</strong><p>원본 <code>1 × 3 × 360 × 640</code>과 Bicubic 3배 입력을 함께 사용한다.</p></article>
    <article><span>OUTPUT</span><strong>3× Super Resolution</strong><p>기본 타일 기준 <code>1 × 3 × 1080 × 1920</code> 결과를 만든다.</p></article>
    <article><span>DEVICE</span><strong>CPU</strong><p>속도는 CPU와 원본 크기에 따라 달라지며 모든 PC에서 빠르다고 보장하지 않는다.</p></article>
  </div>
  <div class="lesson08-suitability">
    <article><span>수업 준비 테스트에서 확인한 선택 이유</span><p>사용자 제공 Windows 테스트에서는 기존 TextSR 방식보다 일반 이미지와 건축 도면에서 규칙적인 도트·패턴 아티팩트가 적어 SR1033을 수강생 실습 모델로 선택했다. 이 비교는 해당 테스트 자료와 환경에 대한 관찰이며 모든 이미지의 우위를 보장하지 않는다.</p></article>
    <article><span>시작 환경</span><ul><li>Windows 10 또는 Windows 11</li><li>Python 미설치 가능 · Python 3.12 64-bit로 통일</li><li>CUDA와 NVIDIA GPU 없이 CPU 기준</li><li>PowerShell과 인터넷 연결 사용</li></ul></article>
  </div>
  <div class="lesson08-sr-learning-flow" aria-label="OpenVINO SR1033 학습 흐름">
    <strong>원본 이미지</strong><i>→</i><strong>일반 Bicubic 3×</strong><i>→</i><strong>AI SR1033 3×</strong><i>→</i><strong>같은 영역 비교</strong><i>→</i><strong>개선과 변경 구분</strong>
  </div>
  <blockquote class="lesson08-openvino-source-warning"><strong>업스케일 결과는 원본 도면의 정확성을 복원하거나 새로운 설계정보를 확정하는 자료가 아니다.</strong> AI가 선·문자·경계를 변경할 수 있으므로 프로젝트 사실 확인의 기준 Source는 항상 원본 도면이다.</blockquote>
</LessonSection>

<LessonSection id="section-15" number="15" title="실습 · SR1033 CPU 환경 구축과 실행" class="lesson08-section" {lessonId}>
  <p>Python 문법을 학습하는 단계가 아니라, 실제 Windows PC에서 검증한 순서를 그대로 실행해 Bicubic 3배 결과와 AI SR1033 3배 결과를 비교하는 실습이다.</p>

  <div class="lesson08-openvino-step">
    <header><span>STEP 01</span><h3>PowerShell과 WinGet 확인</h3></header>
    <p>Windows 시작 메뉴에서 PowerShell 또는 터미널을 열고 버전 정보가 표시되는지 확인한다.</p>
    <PromptCopyBlock id="lesson08-openvino-winget-check" title="WinGet 확인" prompt={openVinoWingetCheck} label="명령 복사" />
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 02</span><h3>Python 3.12 설치</h3></header>
    <p>Python이 없는 PC에서도 시작할 수 있도록 사용자 범위에 Python 3.12를 설치한다.</p>
    <PromptCopyBlock id="lesson08-openvino-python-install" title="Python 3.12 설치" prompt={openVinoPythonInstall} label="명령 복사" />
    <p class="lesson08-restart-warning"><strong>Python 설치 완료 후 현재 PowerShell 창을 완전히 닫고 새 PowerShell을 다시 실행한다.</strong> 설치 직후 같은 창을 계속 사용하면 <code>python</code> 명령이 아직 인식되지 않을 수 있다.</p>
    <PromptCopyBlock id="lesson08-openvino-python-check" title="새 PowerShell에서 Python과 pip 확인" description="정상이라면 Python 3.12.x와 pip 버전 숫자가 표시된다." prompt={openVinoPythonCheck} label="명령 복사" />
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 03</span><h3>실제 Windows 바탕화면에 프로젝트 생성</h3></header>
    <p><code>DesktopDirectory</code>를 사용하면 사용자명 차이와 OneDrive Desktop 환경을 포함해 Windows가 실제 바탕화면으로 인식하는 위치에 <code>OpenVINO_SR1033</code> 폴더를 만든다. <code>explorer .</code>은 현재 PowerShell이 작업 중인 정확한 폴더를 연다.</p>
    <PromptCopyBlock id="lesson08-openvino-project-setup" title="바탕화면 프로젝트 폴더 생성" prompt={openVinoProjectSetup} label="명령 복사" />
    <pre class="lesson08-tree"><code>바탕화면
└─ OpenVINO_SR1033</code></pre>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 04</span><h3>독립 가상환경 생성</h3></header>
    <p>PowerShell 실행 정책 오류를 피하기 위해 가상환경을 Activate하지 않는다. 이후 모든 Python 명령은 <code>.\.venv\Scripts\python.exe</code>를 직접 호출한다.</p>
    <PromptCopyBlock id="lesson08-openvino-venv-setup" title=".venv 생성과 실행 파일 확인" description="Test-Path 결과가 True인지 확인한다." prompt={openVinoVenvSetup} label="명령 복사" />
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 05</span><h3>OpenVINO 환경 설치</h3></header>
    <PromptCopyBlock id="lesson08-openvino-package-setup" title="pip 업데이트와 패키지 설치" prompt={openVinoPackageSetup} label="명령 복사" />
    <div class="lesson08-package-table" tabindex="0">
      <table><thead><tr><th>패키지</th><th>역할</th></tr></thead><tbody><tr><th>OpenVINO</th><td>AI 모델 실행</td></tr><tr><th>OpenCV</th><td>이미지 읽기·크기 변경·저장</td></tr><tr><th>NumPy</th><td>이미지 배열 처리</td></tr></tbody></table>
    </div>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 06</span><h3>입력·모델·출력 폴더 생성</h3></header>
    <PromptCopyBlock id="lesson08-openvino-folder-setup" title="실습 폴더 자동 생성" prompt={openVinoFolderSetup} label="명령 복사" />
    <pre class="lesson08-tree"><code>OpenVINO_SR1033
├─ .venv   · OpenVINO 전용 Python 환경
├─ input   · 업스케일할 원본 이미지
├─ model   · SR1033 모델
└─ output  · 결과 이미지</code></pre>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 07</span><h3>설치와 CPU 인식 확인</h3></header>
    <PromptCopyBlock id="lesson08-openvino-cpu-check" title="OpenVINO·OpenCV·NumPy와 실행 장치 확인" prompt={openVinoCpuCheck} label="명령 복사" />
    <pre class="lesson08-console-result"><code>OpenVINO OK: ...
Device: ['CPU']
OpenCV OK: ...
NumPy OK: ...</code></pre>
    <p>다른 지원 장치가 있는 PC에서는 <code>['CPU', 'GPU']</code>처럼 표시될 수 있지만 이번 실습은 CPU로 컴파일해 실행한다.</p>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 08</span><h3>SR1033 FP16 모델 다운로드</h3></header>
    <p>Open Model Zoo 저장소에서 <code>single-image-super-resolution-1033</code>의 FP16 XML과 BIN을 같은 <code>model</code> 폴더에 저장한다.</p>
    <PromptCopyBlock id="lesson08-openvino-model-download" title="SR1033 FP16 모델 다운로드" prompt={openVinoDownloadCommands} label="명령 복사" />
    <pre class="lesson08-tree"><code>model
├─ single-image-super-resolution-1033.xml
└─ single-image-super-resolution-1033.bin</code></pre>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 09</span><h3>실행 스크립트 생성</h3></header>
    <p>CPU, 3배 확대, 640 × 360 타일, 10px margin, Bicubic 비교 출력을 유지한다. 임의 sharpening, threshold, median 또는 blur 후처리를 추가하지 않는다.</p>
    <details class="lesson08-code-details">
      <summary><span>LONG CODE</span><strong>run_sr1033.py 전체 생성 명령 열기</strong></summary>
      <PromptCopyBlock id="lesson08-openvino-create-script" title="PowerShell에서 run_sr1033.py 생성" description="열린 코드 전체를 한 번에 복사해 PowerShell에 붙여넣는다." prompt={openVinoCreateScript} label="코드 복사" />
    </details>
    <PromptCopyBlock id="lesson08-openvino-script-check" title="스크립트 생성 확인" description="정상 결과는 True다." prompt={openVinoScriptCheck} label="명령 복사" />
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 10</span><h3>input 폴더에 원본 이미지 넣기</h3></header>
    <PromptCopyBlock id="lesson08-openvino-input-open" title="input 폴더 열기" prompt={openVinoInputOpen} label="명령 복사" />
    <p>PNG·TIFF·BMP를 권장한다. JPG도 사용할 수 있지만 압축 손실 때문에 선과 문자 주변 왜곡이 더 눈에 띌 수 있다.</p>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 11</span><h3>SR1033 실행</h3></header>
    <PromptCopyBlock id="lesson08-openvino-run" title="CPU 업스케일 실행" prompt={openVinoRun} label="명령 복사" />
    <pre class="lesson08-console-result"><code>처리 중: plan.png
원본 크기 : 1200 x 800
출력 예정 : 3600 x 2400
타일 1/...
타일 2/...</code></pre>
    <p>처리시간은 CPU 성능과 원본 이미지 크기에 따라 달라질 수 있다.</p>
  </div>

  <div class="lesson08-openvino-step">
    <header><span>STEP 12</span><h3>Bicubic 3배와 SR1033 3배 결과 비교</h3></header>
    <PromptCopyBlock id="lesson08-openvino-output-open" title="output 폴더 열기" prompt={openVinoOutputOpen} label="명령 복사" />
    <div class="lesson08-openvino-output-grid"><article><span>AI SR</span><strong>plan_SR1033_3x.png</strong></article><article><span>BASELINE</span><strong>plan_Bicubic_3x.png</strong></article></div>
    <ul class="lesson08-checklist"><li>작은 문자 가독성</li><li>가는 선 유지</li><li>벽체와 도면선 경계</li><li>원본에 없던 패턴 발생 여부</li><li>전체 선명도</li></ul>
    <p class="lesson08-warning"><strong>AI Super Resolution 결과가 항상 더 정확한 것은 아니다.</strong> 구조·공간·문자·치수와 같은 도면 정보의 사실 확인은 반드시 원본에서 한다.</p>
  </div>

  <div class="lesson08-reuse-box">
    <span>NEXT USE</span><h3>다음부터는 이렇게 사용</h3>
    <PromptCopyBlock id="lesson08-openvino-reuse" title="새 PowerShell에서 프로젝트로 이동하고 실행" prompt={openVinoReuse} label="명령 복사" />
    <div class="lesson08-sr-learning-flow"><strong>input에 이미지 넣기</strong><i>→</i><strong>OpenVINO_SR1033로 이동</strong><i>→</i><strong>run_sr1033.py 실행</strong><i>→</i><strong>output 확인</strong></div>
  </div>

  <div class="lesson08-troubleshooting" tabindex="0">
    <table><thead><tr><th>증상</th><th>확인</th></tr></thead><tbody>{openVinoTroubleshooting.map(([symptom, check]) => <tr><th><code>{symptom}</code></th><td>{check}</td></tr>)}</tbody></table>
  </div>

  <p class="lesson08-boundary"><strong>검증 범위</strong> · 공식 SR1033 입력·출력 사양, FP16 모델 URL, OpenVINO Python 설치와 CPU 장치 확인 방식을 공식 자료와 대조했다. Windows 명령·타일 스크립트·비교 흐름은 사용자 제공 실제 테스트 결과를 반영했다. 입력 도면과 PC에 따라 처리시간과 품질은 달라질 수 있다.</p>
</LessonSection>

<LessonSection id="section-16" number="16" title="저사양 PC 대안 · Hugging Face Web Upscale" class="lesson08-section" {lessonId}>
  <div class="lesson08-web-option">
    <div><span>WEB FALLBACK</span><h3>Hugging Face Image Upscaling</h3><p>로컬 GPU 환경이 어려울 때 바로 실습하거나 다른 웹 기반 업스케일 도구를 찾아볼 수 있다.</p></div>
    <div class="lesson08-web-links">
      <a href="https://huggingface.co/spaces/bookbot/Image-Upscaling-Playground" target="_blank" rel="noreferrer">빠른 실습 · Image Upscaling Playground</a>
      <a href="https://huggingface.co/spaces?category=image-upscaling" target="_blank" rel="noreferrer">다른 도구 찾기 · Image Upscaling 목록</a>
    </div>
  </div>
  <ul class="lesson08-checklist"><li>Space 실행 상태는 수시로 바뀔 수 있으며, 일부 Space는 Sleeping·Paused·Runtime Error 상태일 수 있다.</li><li>무료 사용량과 GPU 자원은 Space별로 다를 수 있다.</li><li>업로드 전 민감정보 포함 여부와 공개·외부 전송 권한을 확인한다.</li><li>평면도·도면은 업스케일 후에도 문자·치수·벽선이 변형됐는지 원본과 비교한다.</li></ul>
</LessonSection>

<LessonSection id="section-17" number="17" title="동일 원본 비교와 HITL 검수" class="lesson08-section" {lessonId}>
  <div class="lesson08-method-grid">
    <article><span>A</span><h3>원본</h3><p>판단 기준. 확대 결과보다 항상 우선한다.</p></article>
    <article><span>B</span><h3>Bicubic · Lanczos</h3><p>일반 Resize의 흐림과 선 보존 상태를 본다.</p></article>
    <article><span>C</span><h3>일반 AI SR</h3><p>RealESRGAN·4x-UltraSharp 결과의 질감과 왜곡을 본다.</p></article>
    <article><span>D</span><h3>OpenVINO SR1033</h3><p>일반 Bicubic 3배 결과와 AI SR1033 3배 결과의 선·문자·경계 변화를 본다.</p></article>
  </div>
  <p class="lesson08-note">SR1033 실습에서는 결과 이미지를 새 사실로 승인하지 않는다. Bicubic과 AI 결과를 같은 영역에서 비교하고, 선명도 향상과 원본 정보 변경을 구분해 기록한다.</p>
  <div class="lesson08-review-table" tabindex="0">
    <table><thead><tr><th>검토 항목</th><th>유지됨</th><th>변화 있음</th><th>확인 필요</th></tr></thead><tbody>{reviewItems.map((item) => <tr><th>{item}</th><td>□</td><td>□</td><td>□</td></tr>)}</tbody></table>
  </div>
  <p>변화가 있는 항목은 원본과 비교해 사용할 수 있는 변화인지, 다시 보정해야 하는 오류인지 사람이 판단한다. 문자·치수·벽선처럼 정확성이 필요한 정보는 선명도만 보고 승인하지 않는다.</p>
</LessonSection>

<LessonSection id="section-18" number="18" title="최종 결과 정리와 다음 차시 연결" class="lesson08-section" {lessonId}>
  <div class="lesson08-deliverables">
    <article><span>01</span><p>Gaussian 기반 현실형 렌더 후보</p></article>
    <article><span>02</span><p>도구별 결과 비교 기록</p></article>
    <article><span>03</span><p>선택한 최종 렌더</p></article>
    <article><span>04</span><p>Upscale 결과</p></article>
    <article><span>05</span><p>Before · After 검토 기록</p></article>
  </div>
  <ul class="lesson08-final-boundary"><li>AI가 원본에 없는 구조·재질·디테일을 만들 수 있다.</li><li>Upscale은 실제 디테일 복원을 보장하지 않는다.</li><li>실제 치수·구조·법규·설비·시공성은 별도로 확인한다.</li><li>서비스·모델·요금제·UI는 변경될 수 있다.</li></ul>
  <blockquote>다음 차시에서는 여러 시점과 공간 이미지의 관계를 정리하고, 결과 사이의 일관성을 검토하는 흐름으로 확장한다.</blockquote>
</LessonSection>

