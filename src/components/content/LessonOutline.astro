---
import LessonSection from './LessonSection.astro';
import LessonAsset from './LessonAsset.astro';
import ClassifiedList from './ClassifiedList.astro';
import IterativeImageSample from './IterativeImageSample.astro';
import Lesson02PresentationSample from './Lesson02PresentationSample.astro';
import Lesson02Ebook, {
  type ContentCategory,
  type OutlineItem as Lesson02OutlineItem,
} from './Lesson02Ebook.astro';
import EmptySpacePracticeKit from './EmptySpacePracticeKit.astro';
import LessonResourceDownloads from './LessonResourceDownloads.astro';
import StructuredPracticeTemplates from './StructuredPracticeTemplates.astro';
import ProjectReferenceMaterials from './ProjectReferenceMaterials.astro';
import Lesson04ProjectWorkflow from './Lesson04ProjectWorkflow.astro';
import Lesson03ReviewPractice from './Lesson03ReviewPractice.astro';
import Lesson03DesignBriefPractice from './Lesson03DesignBriefPractice.astro';
import Lesson05PlanToIsometric from './Lesson05PlanToIsometric.astro';
import { getStudentLessonAssets } from '../../lib/asset-manifest';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import type { Lesson04Download, Lesson04WorkflowData } from '../../lib/lesson04-workflow';

type OutlineItem = Lesson02OutlineItem;

type ProjectWorkflowOutlineItem = Omit<OutlineItem, 'category'> & {
  category: Exclude<ContentCategory, '디자인 판단'>;
};

const asProjectWorkflowItems = (items: OutlineItem[]) =>
  items as ProjectWorkflowOutlineItem[];
const asOptionalProjectWorkflowItems = (items?: OutlineItem[]) =>
  items as ProjectWorkflowOutlineItem[] | undefined;

type TimeItem = {
  label: string;
  minutes: number;
  mode: 'guide' | 'demo' | 'practice' | 'review';
};

type PracticeItem = {
  id: string;
  title: string;
  minutes: number;
  description: string;
};

type IterationSample = {
  bridge: string;
  principle: string;
  originalPrompt: string;
  originalImage: ImageMetadata;
  originalAlt: string;
  originalCaption: string;
  designerJudgment: string;
  revisionPrompt: string;
  revisedImage: ImageMetadata;
  revisedAlt: string;
  revisedCaption: string;
  comparison: string;
  learningPoint: string;
  caution: string;
  reviewFramework: {
    observationResults: string[];
    changeTypes: string[];
    followUpActions: string[];
    originalReview: {
      label: string;
      items: string[];
    }[];
    revisedReview: {
      label: string;
      items: string[];
    }[];
  };
};

type PracticeKit = {
  prompts: {
    id: string;
    title: string;
    content: string;
  }[];
  images: {
    src: ImageMetadata;
    alt: string;
    caption: string;
  }[];
};

type ResourceDownload = {
  href: string;
  downloadName: string;
  label: string;
  description: string;
  meta: string;
  note?: string;
} & Partial<Pick<Lesson04Download, 'group'>>;

type PracticeTemplate = {
  title: string;
  description: string;
  columns: string[];
  placeholders: string[];
  minimumRows?: number;
  rows?: string[][];
};

type StructuredPractice = {
  tables: PracticeTemplate[];
  briefTitle: string;
  briefDescription: string;
  briefFields: string[];
  evidenceCategories?: string[];
  evidenceNote?: string;
  closingNote?: string;
};

type ProjectReferences = {
  documentLabel?: string;
  priorityItems: {
    title: string;
    details: string[];
  }[];
  materialItems: {
    title: string;
    description: string;
  }[];
  notice: string;
  figures: {
    src: ImageMetadata;
    alt: string;
    title: string;
    caption: string;
  }[];
};

type Lesson03DesignBriefData = Omit<
  ComponentProps<typeof Lesson03DesignBriefPractice>,
  'resourceDownloads' | 'resourceDownloadNote' | 'projectReferences'
>;

interface Props {
  lessonId: string;
  totalMinutes: number;
  sectionLayout?: 'standard' | 'rfp-analysis' | 'project-workflow';
  topic?: {
    number: string;
    title: string;
  };
  openingMessage?: {
    title: string;
    body: string;
  };
  intro: OutlineItem[];
  questions: OutlineItem[];
  questionsTitle?: string;
  goals: OutlineItem[];
  concepts: OutlineItem[];
  scenario: OutlineItem[];
  scenarioTitle?: string;
  materials: OutlineItem[];
  projectReferences?: ProjectReferences;
  projectWorkflow?: Lesson04WorkflowData;
  lesson03Review?: ComponentProps<typeof Lesson03ReviewPractice>;
  lesson03DesignBrief?: Lesson03DesignBriefData;
  ebookTimePlan?: TimeItem[];
  demo: OutlineItem[];
  demoTitle?: string;
  iterationSample?: IterationSample;
  practiceKit?: PracticeKit;
  practice: PracticeItem[];
  practiceGuidance?: OutlineItem[];
  structuredPractice?: StructuredPractice;
  deliverables: OutlineItem[];
  judgments: OutlineItem[];
  errorChecks: OutlineItem[];
  errorCheckDetails?: OutlineItem[];
  assetIds: string[];
  assetsTitle?: string;
  showOnlyReadyAssets?: boolean;
  assetNotes?: OutlineItem[];
  resourceDownloads?: ResourceDownload[];
  resourceDownloadNote?: string;
  verification: OutlineItem[];
  timePlan: TimeItem[];
  reviewPending?: boolean;
  lesson05PlanToIsometric?: boolean;
}

const {
  lessonId,
  totalMinutes,
  sectionLayout = 'standard',
  openingMessage,
  intro,
  questions,
  questionsTitle = '직관적인 핵심 질문',
  goals,
  concepts,
  scenario,
  scenarioTitle = '실무형 가상 문제',
  materials,
  projectReferences,
  projectWorkflow,
  lesson03Review,
  lesson03DesignBrief,
  ebookTimePlan,
  demo,
  demoTitle = '작업 과정 살펴보기',
  iterationSample,
  practiceKit,
  practice,
  practiceGuidance,
  structuredPractice,
  deliverables,
  judgments,
  errorChecks,
  errorCheckDetails,
  assetIds,
  assetsTitle = '필요한 이미지·영상·문서',
  showOnlyReadyAssets = false,
  assetNotes,
  resourceDownloads,
  resourceDownloadNote,
  verification,
  timePlan,
  reviewPending = true,
  lesson05PlanToIsometric = false,
} = Astro.props;

const assets = getStudentLessonAssets(assetIds, Number(lessonId));
const displayedAssets = showOnlyReadyAssets
  ? assets.filter((asset) => asset.status === 'ready' && asset.publicUse)
  : assets;
const isPresentation = Astro.url.pathname.includes('/presentation/');
const isInstructorConsole = Astro.url.pathname.includes('/instructor-console/');
const isLesson02Presentation = isPresentation && lessonId === '02';
const isLesson02Ebook = lessonId === '02' && !isPresentation && !isInstructorConsole;
const isLesson03Ebook = lessonId === '03' && !isPresentation && !isInstructorConsole;
const isLesson05PlanToIsometric = lessonId === '05' && lesson05PlanToIsometric;
const displayedTimePlan = isLesson03Ebook && ebookTimePlan ? ebookTimePlan : timePlan;
const instructorTimelineJson = JSON.stringify({ totalMinutes, items: timePlan })
  .replaceAll('<', '\\u003c')
  .replaceAll('\u2028', '\\u2028')
  .replaceAll('\u2029', '\\u2029');
const isRfpAnalysisLayout = sectionLayout === 'rfp-analysis';
const isProjectWorkflowLayout = sectionLayout === 'project-workflow';
const practiceStepNumber = new Map(
  practice.map((step, index) => [step.id, String(index + 1).padStart(2, '0')]),
);
const rfpReadingSteps = practice.filter((step) => step.id === 'read-campus-lounge-rfp');
const requirementMatrixSteps = practice.filter(
  (step) => step.id === 'build-requirement-matrix',
);
const clientQuestionSteps = practice.filter((step) => step.id === 'write-client-questions');
const geminiAnalysisSteps = practice.filter((step) =>
  ['request-gemini-analysis', 'compare-human-ai-analysis'].includes(step.id),
);
const designBriefSteps = practice.filter((step) => step.id === 'write-design-brief');
const visualEvidenceSteps = practice.filter((step) => [
  'generate-plan-based-existing-image',
  'revise-existing-image',
  'record-plan-image-mismatches',
].includes(step.id));
const alternativeCriteriaSteps = practice.filter(
  (step) => step.id === 'define-alternative-criteria',
);
const getRfpSection = (number: number, title: string) => {
  const renderedNumber = isLesson03Ebook ? number + 6 : number;
  const label = String(renderedNumber).padStart(2, '0');
  return { id: `section-${label}`, number: label, title };
};
const rfpSections = {
  project: getRfpSection(2, '오늘의 프로젝트와 제출 결과물'),
  materials: getRfpSection(3, '실습자료 다운로드 및 현황자료'),
  concepts: getRfpSection(4, 'RFP와 디자인 브리프 핵심 개념'),
  questions: getRfpSection(5, 'RFP를 읽을 때 확인할 핵심 질문'),
  reading: getRfpSection(6, 'RFP 구조 함께 확인하기'),
  matrix: getRfpSection(7, '요구조건 매트릭스 작성'),
  clientQuestions: getRfpSection(8, '발주기관 추가 질의 작성'),
  gemini: getRfpSection(9, 'Gemini 분석 및 사람 분석과 비교'),
  brief: getRfpSection(10, '디자인 브리프 작성'),
  criteria: getRfpSection(11, '현황 이미지 검토와 제4차시 평가기준'),
  deliverables: getRfpSection(12, '제출 결과물 점검'),
  verification: getRfpSection(13, '검증 필요와 정리'),
};
const lesson02FlowItems = [
  '이미지 생성 원리와 안전 기준',
  '플라워 카페 사례 분석',
  '빈 공간 이미지 생성과 수정',
  '전후 비교와 결과 검토',
];
const lesson02PracticeGroups = [
  { title: '빈 공간 선택과 사용 조건', items: practice.slice(0, 3) },
  { title: '요청문 작성과 첫 결과', items: practice.slice(3, 7) },
  { title: '결과 검토와 수정', items: practice.slice(7, 10) },
  { title: '전후 비교와 결과 정리', items: practice.slice(10) },
];
const lesson02ErrorGroups = [
  { title: '공간 보존', items: errorChecks.slice(0, 2) },
  { title: '시각적 오류', items: errorChecks.slice(2, 6) },
  { title: '확인과 후속 조치', items: errorChecks.slice(6) },
];
---

{isInstructorConsole && (
  <script is:inline type="application/json" data-instructor-timeline set:html={instructorTimelineJson} />
)}

{!isLesson02Ebook && !isLesson05PlanToIsometric && <LessonSection id="section-01" number="01" title="차시 소개" class="outline-section" lessonId={lessonId}>
  {openingMessage && (
    <aside class="lesson-opening-message">
      <span>COURSE PRINCIPLE</span>
      <h2>{openingMessage.title}</h2>
      <p>{openingMessage.body}</p>
    </aside>
  )}
  <ClassifiedList items={intro} />
  {isLesson02Presentation ? (
    <div
      class="lesson02-flow"
      data-presentation-group="single"
      data-presentation-layout="lesson02-flow"
    >
      <header>
        <span>TODAY'S FLOW</span>
        <strong>오늘의 수업 흐름</strong>
      </header>
      <ol>
        {lesson02FlowItems.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="time-plan">
      <header>
        <div>
          <span>TODAY'S FLOW</span>
          <strong>오늘의 수업 흐름</strong>
        </div>
      </header>
      <ol class="time-plan__screen-list">
        {displayedTimePlan.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item.label}</strong></li>
        ))}
      </ol>
      <table class="time-plan__print-table">
        <thead>
          <tr><th scope="col">오늘의 수업 흐름</th></tr>
        </thead>
        <tbody>
          {displayedTimePlan.map((item, index) => (
            <tr><th scope="row">{String(index + 1).padStart(2, '0')} · {item.label}</th></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</LessonSection>}

{isLesson03Ebook && lesson03Review && <Lesson03ReviewPractice {...lesson03Review} />}

{isLesson05PlanToIsometric ? (
  <Lesson05PlanToIsometric lessonId={lessonId} timePlan={timePlan} />
) : isLesson02Ebook && practiceKit && iterationSample ? (
  <Lesson02Ebook
    practiceKit={practiceKit}
    iterationSample={iterationSample}
    materials={materials}
    practiceGuidance={practiceGuidance}
    practice={practice}
    deliverables={deliverables}
    judgments={judgments}
    errorChecks={errorChecks}
    errorCheckDetails={errorCheckDetails}
    verification={verification}
  />
) : isRfpAnalysisLayout && isLesson03Ebook && lesson03DesignBrief && resourceDownloads && projectReferences ? (
  <Lesson03DesignBriefPractice
    {...lesson03DesignBrief}
    resourceDownloads={resourceDownloads}
    resourceDownloadNote={resourceDownloadNote}
    projectReferences={projectReferences}
  />
) : isRfpAnalysisLayout ? (
  <>
    <LessonSection
      id={rfpSections.project.id}
      number={rfpSections.project.number}
      title={rfpSections.project.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <div class="lesson-section-group">
        <h3>학습 목표</h3>
        <ClassifiedList items={goals} />
      </div>
      <div class="lesson-section-group">
        <h3>오늘의 프로젝트</h3>
        <ClassifiedList items={scenario} />
      </div>
      <div class="lesson-section-group">
        <h3>제출 결과물</h3>
        <ClassifiedList items={deliverables} />
      </div>
    </LessonSection>

    <LessonSection
      id={rfpSections.materials.id}
      number={rfpSections.materials.number}
      title={rfpSections.materials.title}
      class="outline-section"
      lessonId={lessonId}
    >
      {resourceDownloads && (
        <LessonResourceDownloads items={resourceDownloads} note={resourceDownloadNote} />
      )}
      {assetNotes && <ClassifiedList items={assetNotes} />}
      <ClassifiedList items={materials} />
      {projectReferences && <ProjectReferenceMaterials {...projectReferences} />}
      {practiceKit && lessonId !== '02' && <EmptySpacePracticeKit {...practiceKit} />}
    </LessonSection>

    <LessonSection
      id={rfpSections.concepts.id}
      number={rfpSections.concepts.number}
      title={rfpSections.concepts.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={concepts} />
    </LessonSection>

    <LessonSection
      id={rfpSections.questions.id}
      number={rfpSections.questions.number}
      title={rfpSections.questions.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={questions} />
    </LessonSection>

    <LessonSection
      id={rfpSections.reading.id}
      number={rfpSections.reading.number}
      title={rfpSections.reading.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={demo.slice(0, 3)} />
      <ol class="practice-list">
        {rfpReadingSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id={rfpSections.matrix.id}
      number={rfpSections.matrix.number}
      title={rfpSections.matrix.title}
      class="outline-section"
      lessonId={lessonId}
    >
      {practiceGuidance && <ClassifiedList items={practiceGuidance} />}
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(0, 1)}
          evidenceCategories={structuredPractice.evidenceCategories}
          evidenceNote={structuredPractice.evidenceNote}
          idPrefix={rfpSections.matrix.id}
        />
      )}
      <ol class="practice-list">
        {requirementMatrixSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id={rfpSections.clientQuestions.id}
      number={rfpSections.clientQuestions.number}
      title={rfpSections.clientQuestions.title}
      class="outline-section"
      lessonId={lessonId}
    >
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(1, 2)}
          idPrefix={rfpSections.clientQuestions.id}
          tableLabelOffset={1}
        />
      )}
      <ol class="practice-list">
        {clientQuestionSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id={rfpSections.gemini.id}
      number={rfpSections.gemini.number}
      title={rfpSections.gemini.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={demo.slice(3)} />
      <ol class="practice-list">
        {geminiAnalysisSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id={rfpSections.brief.id}
      number={rfpSections.brief.number}
      title={rfpSections.brief.title}
      class="outline-section"
      lessonId={lessonId}
    >
      {structuredPractice && (
        <StructuredPracticeTemplates
          briefTitle={structuredPractice.briefTitle}
          briefDescription={structuredPractice.briefDescription}
          briefFields={structuredPractice.briefFields}
          closingNote={structuredPractice.closingNote}
          idPrefix={rfpSections.brief.id}
        />
      )}
      <ol class="practice-list">
        {designBriefSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id={rfpSections.criteria.id}
      number={rfpSections.criteria.number}
      title={rfpSections.criteria.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <div class="lesson-section-group">
        <h3>평면도 기반 현황 이미지 생성·수정과 불일치 기록</h3>
        <p>
          생성 이미지가 평면도의 공간 관계를 대신하지 않도록, 생성 결과와 수정 결과를
          평면도에 다시 대조하고 남은 차이를 기록합니다.
        </p>
      </div>
      <ol class="practice-list">
        {visualEvidenceSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(2, 3)}
          idPrefix={rfpSections.criteria.id}
          tableLabelOffset={2}
        />
      )}
      <div class="lesson-section-group">
        <h3>제4차시 대안 평가기준</h3>
      </div>
      <ol class="practice-list">
        {alternativeCriteriaSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(3, 4)}
          idPrefix={`${rfpSections.criteria.id}-handoff`}
          tableLabelOffset={3}
        />
      )}
    </LessonSection>

    <LessonSection
      id={rfpSections.deliverables.id}
      number={rfpSections.deliverables.number}
      title={rfpSections.deliverables.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <div class="lesson-section-group">
        <h3>수강생 판단 항목</h3>
        <ClassifiedList items={judgments} />
      </div>
      <div class="lesson-section-group">
        <h3>오류 확인 체크리스트</h3>
        <ClassifiedList items={errorChecks} checks />
      </div>
    </LessonSection>

    <LessonSection
      id={rfpSections.verification.id}
      number={rfpSections.verification.number}
      title={rfpSections.verification.title}
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={verification} />
      {!isPresentation && reviewPending && (
        <p class="review-state">LESSON {lessonId} · 상세 원고 작성 전 검토 요청 상태</p>
      )}
    </LessonSection>
  </>
) : isProjectWorkflowLayout && projectWorkflow ? (
  <Lesson04ProjectWorkflow
    lessonId={lessonId}
    goals={asProjectWorkflowItems(goals)}
    scenario={asProjectWorkflowItems(scenario)}
    materials={asProjectWorkflowItems(materials)}
    projectReferences={projectReferences}
    demo={asProjectWorkflowItems(demo)}
    practice={practice}
    practiceGuidance={asOptionalProjectWorkflowItems(practiceGuidance)}
    deliverables={asProjectWorkflowItems(deliverables)}
    judgments={asProjectWorkflowItems(judgments)}
    errorChecks={asProjectWorkflowItems(errorChecks)}
    verification={asProjectWorkflowItems(verification)}
    resourceDownloads={resourceDownloads}
    resourceDownloadNote={resourceDownloadNote}
    workflow={projectWorkflow}
  />
) : (
  <>
    <LessonSection id="section-02" number="02" title={questionsTitle} class="outline-section" lessonId={lessonId}>
      {isLesson02Presentation ? (
        <div data-presentation-group="single" data-presentation-layout="lesson02-questions">
          <ClassifiedList items={questions} />
        </div>
      ) : <ClassifiedList items={questions} />}
    </LessonSection>

    <LessonSection id="section-03" number="03" title="학습 목표" class="outline-section" lessonId={lessonId}>
      {isLesson02Presentation ? (
        <div data-presentation-group="single" data-presentation-layout="lesson02-goals">
          <ClassifiedList items={goals} />
        </div>
      ) : <ClassifiedList items={goals} />}
    </LessonSection>

    <LessonSection id="section-04" number="04" title="핵심 개념" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={concepts} />
    </LessonSection>

    <LessonSection id="section-05" number="05" title={scenarioTitle} class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={scenario} />
    </LessonSection>

    <LessonSection id="section-06" number="06" title="제공 자료" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={materials} />
      {projectReferences && <ProjectReferenceMaterials {...projectReferences} />}
      {practiceKit && lessonId !== '02' && <EmptySpacePracticeKit {...practiceKit} />}
    </LessonSection>

    <LessonSection id="section-07" number="07" title={demoTitle} class="outline-section" lessonId={lessonId}>
      {iterationSample
        ? isLesson02Presentation
          ? <Lesson02PresentationSample {...iterationSample} />
          : <IterativeImageSample {...iterationSample} />
        : <ClassifiedList items={demo} />}
      {practiceKit && lessonId === '02' && !isPresentation && <EmptySpacePracticeKit {...practiceKit} />}
    </LessonSection>

    <LessonSection id="section-08" number="08" title={lessonId === '02' ? '이미지 생성·수정 실습' : '수강생 실습'} class="outline-section" lessonId={lessonId}>
      {isLesson02Presentation ? (
        <div class="lesson02-practice-groups">
          {lesson02PracticeGroups.map((group, groupIndex) => (
            <section
              data-presentation-group="single"
              data-presentation-layout="lesson02-practice-group"
            >
              <h3>{group.title}</h3>
              {groupIndex === 0 && practiceGuidance && <ClassifiedList items={practiceGuidance} />}
              <ol class="practice-list">
                {group.items.map((step) => (
                  <li data-step-id={step.id}>
                    <span>STEP {String(practice.indexOf(step) + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.description}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <>
          {practiceGuidance && <ClassifiedList items={practiceGuidance} />}
          {structuredPractice && <StructuredPracticeTemplates {...structuredPractice} />}
          <ol class="practice-list">
            {practice.map((step, index) => (
              <li data-step-id={step.id}>
                <span>STEP {String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </>
      )}
    </LessonSection>

    <LessonSection id="section-09" number="09" title={lessonId === '02' ? '실습 결과물' : '제출 결과물'} class="outline-section" lessonId={lessonId}>
      {isLesson02Presentation ? (
        <div data-presentation-group="single" data-presentation-layout="lesson02-deliverables">
          <ClassifiedList items={deliverables} />
        </div>
      ) : <ClassifiedList items={deliverables} />}
    </LessonSection>

    <LessonSection id="section-10" number="10" title={lessonId === '02' ? '결과 검토 기준' : '수강생이 판단할 항목'} class="outline-section" lessonId={lessonId}>
      {isLesson02Presentation ? (
        <div data-presentation-group="single" data-presentation-layout="lesson02-review-criteria">
          <ClassifiedList items={judgments} />
        </div>
      ) : <ClassifiedList items={judgments} />}
    </LessonSection>

    <LessonSection id="section-11" number="11" title="AI 오류 확인 체크리스트" class="outline-section" lessonId={lessonId}>
      {isLesson02Presentation ? (
        <div
          class="lesson02-error-groups"
          data-presentation-group="single"
          data-presentation-layout="lesson02-error-groups"
        >
          {lesson02ErrorGroups.map((group) => (
            <section>
              <h3>{group.title}</h3>
              <ClassifiedList items={group.items} checks />
            </section>
          ))}
        </div>
      ) : (
        <>
          <ClassifiedList items={errorChecks} checks />
          {errorCheckDetails && (
            <details class="lesson-reference-checks">
              <summary>e-book 상세 참고 체크리스트</summary>
              <ClassifiedList items={errorCheckDetails} checks />
            </details>
          )}
        </>
      )}
    </LessonSection>

    {!isLesson02Presentation && (
      <LessonSection id="section-12" number="12" title={assetsTitle} class="outline-section" lessonId={lessonId}>
        {assetNotes ? (
          <ClassifiedList items={assetNotes} />
        ) : !isPresentation ? (
          <>
            <p class="asset-policy">
              아래는 실제 이미지나 영상을 대신하지 않는 자산 슬롯입니다. 파일은 제작·권리·검증
              상태가 확인되기 전까지 <code>public/</code>에 넣지 않습니다.
            </p>
            <div class="lesson-assets">
              {displayedAssets.map((asset) => <LessonAsset {...asset} />)}
            </div>
          </>
        ) : null}
        {resourceDownloads && (
          <LessonResourceDownloads items={resourceDownloads} note={resourceDownloadNote} />
        )}
      </LessonSection>
    )}

    <LessonSection
      id="section-13"
      number="13"
      title="확인 또는 검증이 필요한 내용"
      class="outline-section"
      lessonId={lessonId}
    >
      {isLesson02Presentation ? (
        <div
          class="lesson02-final-summary"
          data-presentation-group="single"
          data-presentation-layout="lesson02-final-summary"
        >
          <ul>
            <li>생성 이미지는 실제 설계 확정안이 아니다.</li>
            <li>실제 치수·구조·동선·법규·설비·시공성은 별도 확인한다.</li>
            <li>다음 차시에서는 문서 요구조건과 근거를 구조화한다.</li>
          </ul>
        </div>
      ) : <ClassifiedList items={verification} />}
      {!isPresentation && reviewPending && (
        <p class="review-state">LESSON {lessonId} · 상세 원고 작성 전 검토 요청 상태</p>
      )}
    </LessonSection>
  </>
)}
