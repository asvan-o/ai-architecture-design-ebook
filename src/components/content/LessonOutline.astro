---
import LessonSection from './LessonSection.astro';
import LessonAsset from './LessonAsset.astro';
import ClassifiedList from './ClassifiedList.astro';
import IterativeImageSample from './IterativeImageSample.astro';
import EmptySpacePracticeKit from './EmptySpacePracticeKit.astro';
import LessonResourceDownloads from './LessonResourceDownloads.astro';
import StructuredPracticeTemplates from './StructuredPracticeTemplates.astro';
import ProjectReferenceMaterials from './ProjectReferenceMaterials.astro';
import Lesson04ProjectWorkflow from './Lesson04ProjectWorkflow.astro';
import { getStudentLessonAssets } from '../../lib/asset-manifest';
import type { ImageMetadata } from 'astro';
import type { Lesson04Download, Lesson04WorkflowData } from '../../lib/lesson04-workflow';

type ContentCategory =
  | '확인된 사실'
  | '확정된 수업 구성'
  | '학습 목표'
  | '수업 산출물'
  | '교육용 가정'
  | '디자인 제안'
  | '수강생 판단'
  | '수강생 전문 판단'
  | '추가 검증 필요'
  | '강의 전 사실 검증'
  | '추가 출처 확인'
  | '법규·구조·소방 등 해당 전문가 판단';

type OutlineItem = {
  category: ContentCategory;
  text: string;
};

type TimeItem = {
  label: string;
  minutes: number;
  mode: 'guide' | 'demo' | 'practice' | 'review';
};

type PracticeItem = {
  id: string;
  title: string;
  minutes: number;
  description: string;
};

type IterationSample = {
  bridge: string;
  principle: string;
  originalPrompt: string;
  originalImage: ImageMetadata;
  originalAlt: string;
  originalCaption: string;
  designerJudgment: string;
  revisionPrompt: string;
  revisedImage: ImageMetadata;
  revisedAlt: string;
  revisedCaption: string;
  comparison: string;
  learningPoint: string;
  caution: string;
  reviewFramework: {
    observationResults: string[];
    changeTypes: string[];
    followUpActions: string[];
    originalReview: {
      label: string;
      items: string[];
    }[];
    revisedReview: {
      label: string;
      items: string[];
    }[];
  };
};

type PracticeKit = {
  prompts: {
    id: string;
    title: string;
    content: string;
  }[];
  images: {
    src: ImageMetadata;
    alt: string;
    caption: string;
  }[];
};

type ResourceDownload = {
  href: string;
  downloadName: string;
  label: string;
  description: string;
  meta: string;
  note?: string;
} & Partial<Pick<Lesson04Download, 'group'>>;

type PracticeTemplate = {
  title: string;
  description: string;
  columns: string[];
  placeholders: string[];
  minimumRows?: number;
  rows?: string[][];
};

type StructuredPractice = {
  tables: PracticeTemplate[];
  briefTitle: string;
  briefDescription: string;
  briefFields: string[];
  evidenceCategories?: string[];
  evidenceNote?: string;
  closingNote?: string;
};

type ProjectReferences = {
  priorityItems: {
    title: string;
    details: string[];
  }[];
  materialItems: {
    title: string;
    description: string;
  }[];
  notice: string;
  figures: {
    src: ImageMetadata;
    alt: string;
    title: string;
    caption: string;
  }[];
};

interface Props {
  lessonId: string;
  totalMinutes: number;
  sectionLayout?: 'standard' | 'rfp-analysis' | 'project-workflow';
  topic?: {
    number: string;
    title: string;
  };
  openingMessage?: {
    title: string;
    body: string;
  };
  intro: OutlineItem[];
  questions: OutlineItem[];
  questionsTitle?: string;
  goals: OutlineItem[];
  concepts: OutlineItem[];
  scenario: OutlineItem[];
  scenarioTitle?: string;
  materials: OutlineItem[];
  projectReferences?: ProjectReferences;
  projectWorkflow?: Lesson04WorkflowData;
  demo: OutlineItem[];
  demoTitle?: string;
  iterationSample?: IterationSample;
  practiceKit?: PracticeKit;
  practice: PracticeItem[];
  practiceGuidance?: OutlineItem[];
  structuredPractice?: StructuredPractice;
  deliverables: OutlineItem[];
  judgments: OutlineItem[];
  errorChecks: OutlineItem[];
  errorCheckDetails?: OutlineItem[];
  assetIds: string[];
  assetsTitle?: string;
  showOnlyReadyAssets?: boolean;
  assetNotes?: OutlineItem[];
  resourceDownloads?: ResourceDownload[];
  resourceDownloadNote?: string;
  verification: OutlineItem[];
  timePlan: TimeItem[];
  reviewPending?: boolean;
}

const {
  lessonId,
  totalMinutes,
  sectionLayout = 'standard',
  openingMessage,
  intro,
  questions,
  questionsTitle = '직관적인 핵심 질문',
  goals,
  concepts,
  scenario,
  scenarioTitle = '실무형 가상 문제',
  materials,
  projectReferences,
  projectWorkflow,
  demo,
  demoTitle = '작업 과정 살펴보기',
  iterationSample,
  practiceKit,
  practice,
  practiceGuidance,
  structuredPractice,
  deliverables,
  judgments,
  errorChecks,
  errorCheckDetails,
  assetIds,
  assetsTitle = '필요한 이미지·영상·문서',
  showOnlyReadyAssets = false,
  assetNotes,
  resourceDownloads,
  resourceDownloadNote,
  verification,
  timePlan,
  reviewPending = true,
} = Astro.props;

const assets = getStudentLessonAssets(assetIds, Number(lessonId));
const displayedAssets = showOnlyReadyAssets
  ? assets.filter((asset) => asset.status === 'ready' && asset.publicUse)
  : assets;
const allocatedMinutes = timePlan.reduce((sum, item) => sum + item.minutes, 0);
const practiceMinutes = timePlan
  .filter((item) => item.mode === 'practice')
  .reduce((sum, item) => sum + item.minutes, 0);
const practicePercent = Math.round((practiceMinutes / totalMinutes) * 100);
const isPresentation = Astro.url.pathname.includes('/presentation/');
const isRfpAnalysisLayout = sectionLayout === 'rfp-analysis';
const isProjectWorkflowLayout = sectionLayout === 'project-workflow';
const practiceStepNumber = new Map(
  practice.map((step, index) => [step.id, String(index + 1).padStart(2, '0')]),
);
const rfpReadingSteps = practice.filter((step) => step.id === 'read-campus-lounge-rfp');
const requirementMatrixSteps = practice.filter(
  (step) => step.id === 'build-requirement-matrix',
);
const clientQuestionSteps = practice.filter((step) => step.id === 'write-client-questions');
const geminiAnalysisSteps = practice.filter((step) =>
  ['request-gemini-analysis', 'compare-human-ai-analysis'].includes(step.id),
);
const designBriefSteps = practice.filter((step) => step.id === 'write-design-brief');
const visualEvidenceSteps = practice.filter((step) => [
  'generate-plan-based-existing-image',
  'revise-existing-image',
  'record-plan-image-mismatches',
].includes(step.id));
const alternativeCriteriaSteps = practice.filter(
  (step) => step.id === 'define-alternative-criteria',
);
---

<LessonSection id="section-01" number="01" title="차시 소개" class="outline-section" lessonId={lessonId}>
  {openingMessage && (
    <aside class="lesson-opening-message">
      <span>COURSE PRINCIPLE</span>
      <h2>{openingMessage.title}</h2>
      <p>{openingMessage.body}</p>
    </aside>
  )}
  <ClassifiedList items={intro} />
  <div class="time-plan">
    <header>
      <div>
        <span>{isPresentation || !reviewPending ? 'TIME PLAN' : 'TIME PLAN · REVIEW REQUESTED'}</span>
        <strong>{totalMinutes}분 중 수강생 실습 {practiceMinutes}분 · {practicePercent}%</strong>
      </div>
      <span class:list={['practice-ratio', { 'practice-ratio--valid': practiceMinutes >= totalMinutes / 2 }]}>
        실습 절반 이상
      </span>
    </header>
    <ol class="time-plan__screen-list">
      {timePlan.map((item) => (
        <li>
          <span>{item.label}</span>
          <strong>{item.minutes}분</strong>
        </li>
      ))}
    </ol>
    <table class="time-plan__print-table">
      <thead>
        <tr><th scope="col">수업 흐름</th><th scope="col">시간</th></tr>
      </thead>
      <tbody>
        {timePlan.map((item) => (
          <tr><th scope="row">{item.label}</th><td>{item.minutes}분</td></tr>
        ))}
      </tbody>
    </table>
    {allocatedMinutes !== totalMinutes && (
      <p class="time-plan__warning">시간 배분 합계 검토 필요: {allocatedMinutes}분</p>
    )}
  </div>
</LessonSection>

{isRfpAnalysisLayout ? (
  <>
    <LessonSection
      id="section-02"
      number="02"
      title="오늘의 프로젝트와 제출 결과물"
      class="outline-section"
      lessonId={lessonId}
    >
      <div class="lesson-section-group">
        <h3>학습 목표</h3>
        <ClassifiedList items={goals} />
      </div>
      <div class="lesson-section-group">
        <h3>오늘의 프로젝트</h3>
        <ClassifiedList items={scenario} />
      </div>
      <div class="lesson-section-group">
        <h3>제출 결과물</h3>
        <ClassifiedList items={deliverables} />
      </div>
    </LessonSection>

    <LessonSection
      id="section-03"
      number="03"
      title="실습자료 다운로드 및 현황자료"
      class="outline-section"
      lessonId={lessonId}
    >
      {resourceDownloads && (
        <LessonResourceDownloads items={resourceDownloads} note={resourceDownloadNote} />
      )}
      {assetNotes && <ClassifiedList items={assetNotes} />}
      <ClassifiedList items={materials} />
      {projectReferences && <ProjectReferenceMaterials {...projectReferences} />}
      {practiceKit && lessonId !== '02' && <EmptySpacePracticeKit {...practiceKit} />}
    </LessonSection>

    <LessonSection
      id="section-04"
      number="04"
      title="RFP와 디자인 브리프 핵심 개념"
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={concepts} />
    </LessonSection>

    <LessonSection
      id="section-05"
      number="05"
      title="RFP를 읽을 때 확인할 핵심 질문"
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={questions} />
    </LessonSection>

    <LessonSection
      id="section-06"
      number="06"
      title="RFP 구조 함께 확인하기"
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={demo.slice(0, 3)} />
      <ol class="practice-list">
        {rfpReadingSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id="section-07"
      number="07"
      title="요구조건 매트릭스 작성"
      class="outline-section"
      lessonId={lessonId}
    >
      {practiceGuidance && <ClassifiedList items={practiceGuidance} />}
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(0, 1)}
          evidenceCategories={structuredPractice.evidenceCategories}
          evidenceNote={structuredPractice.evidenceNote}
          idPrefix="section-07"
        />
      )}
      <ol class="practice-list">
        {requirementMatrixSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id="section-08"
      number="08"
      title="발주기관 추가 질의 작성"
      class="outline-section"
      lessonId={lessonId}
    >
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(1, 2)}
          idPrefix="section-08"
          tableLabelOffset={1}
        />
      )}
      <ol class="practice-list">
        {clientQuestionSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id="section-09"
      number="09"
      title="Gemini 분석 및 사람 분석과 비교"
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={demo.slice(3)} />
      <ol class="practice-list">
        {geminiAnalysisSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id="section-10"
      number="10"
      title="디자인 브리프 작성"
      class="outline-section"
      lessonId={lessonId}
    >
      {structuredPractice && (
        <StructuredPracticeTemplates
          briefTitle={structuredPractice.briefTitle}
          briefDescription={structuredPractice.briefDescription}
          briefFields={structuredPractice.briefFields}
          closingNote={structuredPractice.closingNote}
          idPrefix="section-10"
        />
      )}
      <ol class="practice-list">
        {designBriefSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection
      id="section-11"
      number="11"
      title="현황 이미지 검토와 제4차시 평가기준"
      class="outline-section"
      lessonId={lessonId}
    >
      <div class="lesson-section-group">
        <h3>평면도 기반 현황 이미지 생성·수정과 불일치 기록</h3>
        <p>
          생성 이미지가 평면도의 공간 관계를 대신하지 않도록, 생성 결과와 수정 결과를
          평면도에 다시 대조하고 남은 차이를 기록합니다.
        </p>
      </div>
      <ol class="practice-list">
        {visualEvidenceSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(2, 3)}
          idPrefix="section-11"
          tableLabelOffset={2}
        />
      )}
      <div class="lesson-section-group">
        <h3>제4차시 대안 평가기준</h3>
      </div>
      <ol class="practice-list">
        {alternativeCriteriaSteps.map((step) => (
          <li data-step-id={step.id}>
            <span>STEP {practiceStepNumber.get(step.id)} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
      {structuredPractice && (
        <StructuredPracticeTemplates
          tables={structuredPractice.tables.slice(3, 4)}
          idPrefix="section-11-handoff"
          tableLabelOffset={3}
        />
      )}
    </LessonSection>

    <LessonSection
      id="section-12"
      number="12"
      title="제출 결과물 점검"
      class="outline-section"
      lessonId={lessonId}
    >
      <div class="lesson-section-group">
        <h3>수강생 판단 항목</h3>
        <ClassifiedList items={judgments} />
      </div>
      <div class="lesson-section-group">
        <h3>오류 확인 체크리스트</h3>
        <ClassifiedList items={errorChecks} checks />
      </div>
    </LessonSection>

    <LessonSection
      id="section-13"
      number="13"
      title="검증 필요와 정리"
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={verification} />
      {!isPresentation && reviewPending && (
        <p class="review-state">LESSON {lessonId} · 상세 원고 작성 전 검토 요청 상태</p>
      )}
    </LessonSection>
  </>
) : isProjectWorkflowLayout && projectWorkflow ? (
  <Lesson04ProjectWorkflow
    lessonId={lessonId}
    goals={goals}
    scenario={scenario}
    materials={materials}
    projectReferences={projectReferences}
    demo={demo}
    practice={practice}
    practiceGuidance={practiceGuidance}
    deliverables={deliverables}
    judgments={judgments}
    errorChecks={errorChecks}
    verification={verification}
    resourceDownloads={resourceDownloads}
    resourceDownloadNote={resourceDownloadNote}
    workflow={projectWorkflow}
  />
) : (
  <>
    <LessonSection id="section-02" number="02" title={questionsTitle} class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={questions} />
    </LessonSection>

    <LessonSection id="section-03" number="03" title="학습 목표" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={goals} />
    </LessonSection>

    <LessonSection id="section-04" number="04" title="핵심 개념" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={concepts} />
    </LessonSection>

    <LessonSection id="section-05" number="05" title={scenarioTitle} class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={scenario} />
    </LessonSection>

    <LessonSection id="section-06" number="06" title="제공 자료" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={materials} />
      {projectReferences && <ProjectReferenceMaterials {...projectReferences} />}
      {practiceKit && lessonId !== '02' && <EmptySpacePracticeKit {...practiceKit} />}
    </LessonSection>

    <LessonSection id="section-07" number="07" title={demoTitle} class="outline-section" lessonId={lessonId}>
      {iterationSample
        ? <IterativeImageSample {...iterationSample} />
        : <ClassifiedList items={demo} />}
      {practiceKit && lessonId === '02' && <EmptySpacePracticeKit {...practiceKit} />}
    </LessonSection>

    <LessonSection id="section-08" number="08" title="수강생 실습" class="outline-section" lessonId={lessonId}>
      {practiceGuidance && <ClassifiedList items={practiceGuidance} />}
      {structuredPractice && <StructuredPracticeTemplates {...structuredPractice} />}
      <ol class="practice-list">
        {practice.map((step, index) => (
          <li data-step-id={step.id}>
            <span>STEP {String(index + 1).padStart(2, '0')} · {step.minutes}분</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </LessonSection>

    <LessonSection id="section-09" number="09" title="제출 결과물" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={deliverables} />
    </LessonSection>

    <LessonSection id="section-10" number="10" title="수강생이 판단할 항목" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={judgments} />
    </LessonSection>

    <LessonSection id="section-11" number="11" title="AI 오류 확인 체크리스트" class="outline-section" lessonId={lessonId}>
      <ClassifiedList items={errorChecks} checks />
      {errorCheckDetails && (
        <details class="lesson-reference-checks">
          <summary>e-book 상세 참고 체크리스트</summary>
          <ClassifiedList items={errorCheckDetails} checks />
        </details>
      )}
    </LessonSection>

    <LessonSection id="section-12" number="12" title={assetsTitle} class="outline-section" lessonId={lessonId}>
      {assetNotes ? (
        <ClassifiedList items={assetNotes} />
      ) : !isPresentation ? (
        <>
          <p class="asset-policy">
            아래는 실제 이미지나 영상을 대신하지 않는 자산 슬롯입니다. 파일은 제작·권리·검증
            상태가 확인되기 전까지 <code>public/</code>에 넣지 않습니다.
          </p>
          <div class="lesson-assets">
            {displayedAssets.map((asset) => <LessonAsset {...asset} />)}
          </div>
        </>
      ) : null}
      {resourceDownloads && (
        <LessonResourceDownloads items={resourceDownloads} note={resourceDownloadNote} />
      )}
    </LessonSection>

    <LessonSection
      id="section-13"
      number="13"
      title="확인 또는 검증이 필요한 내용"
      class="outline-section"
      lessonId={lessonId}
    >
      <ClassifiedList items={verification} />
      {!isPresentation && reviewPending && (
        <p class="review-state">LESSON {lessonId} · 상세 원고 작성 전 검토 요청 상태</p>
      )}
    </LessonSection>
  </>
)}
