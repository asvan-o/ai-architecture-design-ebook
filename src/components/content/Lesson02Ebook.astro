---
import type { ImageMetadata } from 'astro';
import LessonSection from './LessonSection.astro';
import ClassifiedList from './ClassifiedList.astro';
import EmptySpacePracticeKit from './EmptySpacePracticeKit.astro';
import IterativeImageSample, { type Props as IterationSample } from './IterativeImageSample.astro';
import PromptCopyBlock from './PromptCopyBlock.astro';
import AnnotatedPromptBlock from './AnnotatedPromptBlock.astro';
import PracticeResultSample from './PracticeResultSample.astro';
import {
  lesson02AbCommon,
  lesson02AbMinimal,
  lesson02AbNatural,
  lesson02AnnotatedSegments,
  lesson02CompletePrompt,
  lesson02CoreQuestion,
  lesson02Flow,
  lesson02Formula,
  lesson02FoundationConcepts,
  lesson02Goals,
  lesson02PracticeOneSample,
  lesson02PracticeTemplate,
  lesson02PracticeThreeProblem,
  lesson02PracticeThreeRevision,
  lesson02PromptRules,
} from '../../lib/lesson02-ebook';

type ContentCategory =
  | '확인된 사실'
  | '원문에서 확인된 사실'
  | '분석·해석'
  | '확정된 수업 구성'
  | '학습 목표'
  | '수업 산출물'
  | '교육용 가정'
  | '디자인 제안'
  | '디자인 판단'
  | '수강생 판단'
  | '수강생 전문 판단'
  | '추가 검증 필요'
  | '강의 전 사실 검증'
  | '추가 출처 확인'
  | '법규·구조·소방 등 해당 전문가 판단';

type OutlineItem = {
  category: ContentCategory;
  text: string;
  validationKey?: string;
};

type PracticeItem = {
  id: string;
  title: string;
  minutes: number;
  description: string;
};

type PracticeKit = {
  prompts: { id: string; title: string; content: string }[];
  images: { src: ImageMetadata; alt: string; caption: string }[];
};

interface Props {
  practiceKit: PracticeKit;
  iterationSample: IterationSample;
  materials: OutlineItem[];
  practiceGuidance?: OutlineItem[];
  practice: PracticeItem[];
  deliverables: OutlineItem[];
  judgments: OutlineItem[];
  errorChecks: OutlineItem[];
  errorCheckDetails?: OutlineItem[];
  verification: OutlineItem[];
}

const {
  practiceKit,
  iterationSample,
  materials,
  practiceGuidance,
  practice,
  deliverables,
  judgments,
  errorChecks,
  errorCheckDetails,
  verification,
} = Astro.props;

const practiceOneFields = [
  '공간 용도',
  '프로젝트 맥락',
  '주요 사용자',
  '주요 사용 상황',
  '입력 이미지의 역할',
  '유지할 요소',
  '추가할 요소',
  '변경할 요소',
  '삭제할 요소',
  '디자인 콘셉트',
  '재료·색상·조명',
  '금지할 요소',
  '이미지로 확인할 수 없는 조건',
  '출력 이미지 형식',
  '결과 검토 기준',
];

const warmupQuestions = [
  '어떤 프로젝트를 위한 이미지인가?',
  '기존 공간에서 무엇을 유지해야 하는가?',
  '꽃 판매와 음료 중 어느 기능이 중심인가?',
  '어떤 가구와 기능이 필요한가?',
  '‘예쁘게’는 어떤 재료·색상·조명인가?',
  '사람과 문자가 생성돼도 괜찮은가?',
  '어떤 형식의 결과 이미지를 원하는가?',
  '결과가 잘 만들어졌는지 무엇으로 확인할 것인가?',
];

const practiceThreeFindings = [
  '기존 가구 배치를 모두 유지하면서 대형 카운터를 추가하기 어렵다.',
  '좌석 여섯 개를 추가하면서 중앙 통로를 그대로 유지하기 어려울 수 있다.',
  '실제 공간 크기를 확인할 수 없으므로 ‘넓고 여유롭게’ 만들 수 있다고 단정하기 어렵다.',
  '유지할 공간 구조와 변경 가능한 가구 배치가 구분되지 않았다.',
];

const abRows = [
  ['주요 재료', '밝은 목재 중심', '흰색·회색 중심'],
  ['주요 색상', '아이보리·연한 녹색', '흰색·밝은 회색'],
  ['조명', '따뜻하고 부드러움', '균일하고 차분함'],
  ['가구 인상', '자연스럽고 편안함', '단순하고 정돈됨'],
  ['장식 정도', '식물과 자연 소재', '장식 최소화'],
];
---

<LessonSection id="section-01" number="01" title="오늘의 학습 안내" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-learning-guide">
    <section aria-labelledby="lesson02-goals-title">
      <span>GOALS</span>
      <h3 id="lesson02-goals-title">오늘의 목표</h3>
      <ol>{lesson02Goals.map((goal) => <li>{goal}</li>)}</ol>
    </section>
    <section aria-labelledby="lesson02-question-title">
      <span>CORE QUESTION</span>
      <h3 id="lesson02-question-title">오늘의 핵심 질문</h3>
      <blockquote>{lesson02CoreQuestion}</blockquote>
    </section>
    <section aria-labelledby="lesson02-flow-title">
      <span>FLOW</span>
      <h3 id="lesson02-flow-title">오늘의 흐름</h3>
      <ol class="lesson02-flow">
        {lesson02Flow.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>
        ))}
      </ol>
    </section>
  </div>
</LessonSection>

<LessonSection id="section-02" number="02" title="제1차시에서 제2차시로" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-prose">
    <p>제1차시에서는 생성형 AI가 만든 결과를 사실이나 설계 확정안으로 바로 받아들이지 않고, 이미지에서 직접 확인되는 내용과 AI의 해석·추정, 확인할 수 없는 조건과 새 디자인 제안을 구분했다.</p>
    <ul>
      <li>이미지에서 직접 확인되는 내용</li>
      <li>AI가 해석하거나 추정한 내용</li>
      <li>이미지로 확인할 수 없는 조건</li>
      <li>AI가 새롭게 제안한 디자인 방향</li>
    </ul>
    <aside class="lesson02-key-message">
      <strong>AI가 만든 이미지는 실제 설계 확정안이 아니라 검토와 수정을 위한 첫 번째 디자인 제안이다.</strong>
      <p>실제 치수, 구조, 동선, 법규, 설비와 시공 가능성은 생성 이미지 한 장으로 확정할 수 없다.</p>
    </aside>
    <blockquote class="lesson02-bridge">
      어제는 AI가 만든 결과를 어떻게 판단해야 하는지 살펴보았습니다.<br /><br />
      오늘은 빈 공간을 원하는 인테리어 이미지로 바꾸기 위해 AI에게 어떤 작업을 시키고, 어떤 조건을 전달해야 하는지 알아보겠습니다.
    </blockquote>
  </div>
</LessonSection>

<LessonSection id="section-03" number="03" title="프롬프트란 무엇인가" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-prose">
    <aside class="lesson02-key-message lesson02-key-message--strong">
      <strong>프롬프트는 AI에게 보내는 질문이자 작업지시서이다.</strong>
    </aside>
    <p>프롬프트에는 정보를 확인하는 질문도 있고, 특정 결과를 만들기 위한 작업지시도 있다. AI에게 무엇을 해야 하는지, 어떤 자료와 조건을 기준으로 어떤 순서로 작업하며 결과를 무엇으로 검토할지 전달하는 설명문이다.</p>
    <ul class="lesson02-two-column-list">
      <li>무엇을 해야 하는가</li>
      <li>어떤 상황에서 사용하는가</li>
      <li>어떤 자료를 기준으로 하는가</li>
      <li>어떤 순서로 작업해야 하는가</li>
      <li>무엇을 반드시 지켜야 하는가</li>
      <li>무엇을 하지 말아야 하는가</li>
      <li>결과를 어떤 형태로 받아야 하는가</li>
      <li>결과를 무엇으로 검토해야 하는가</li>
    </ul>
    <aside class="lesson02-key-message">
      <strong>프롬프트는 어려운 영어 문장이나 특별한 주문이 아니다.</strong>
      <p>원하는 작업과 조건을 AI가 이해할 수 있도록 전달하는 작업 설명문이다. 길이가 아니라 필요한 정보, 조건 사이의 일관성과 분명한 목적이 중요하다.</p>
    </aside>
  </div>
</LessonSection>

<LessonSection id="section-04" number="04" title="프롬프트를 작성하기 전에 알아야 할 기본 개념" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-foundations">
    {lesson02FoundationConcepts.map((concept) => (
      <article>
        <header>
          <h3>{concept.title}</h3>
          <strong>{concept.keyLine}</strong>
        </header>
        <p>{concept.summary}</p>
        <div class="lesson02-example-pair">
          <section><span>부족한 요청</span><p>{concept.before}</p></section>
          <section><span>개선된 요청</span><p>{concept.after}</p></section>
        </div>
        <details>
          <summary>자세히 보기</summary>
          <ul>{concept.details.map((detail) => <li>{detail}</li>)}</ul>
        </details>
      </article>
    ))}
  </div>
</LessonSection>

<LessonSection id="section-05" number="05" title="정보 확인형 질문과 작업지시형 프롬프트" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-comparison-grid">
    <article>
      <span>INFORMATION</span>
      <h3>정보 확인형 질문</h3>
      <blockquote>소형 플라워 카페 인테리어를 기획할 때 일반적으로 고려할 기능 공간, 필요한 가구, 재료·색상·조명 요소를 항목별로 알려줘.</blockquote>
      <p>일반적인 지식과 아이디어를 정리하는 참고 질문이다. 특정 첨부 이미지의 구조를 분석하거나 이미지를 제작하는 작업은 아니다.</p>
      <details>
        <summary>예상 답변 샘플</summary>
        <p>꽃 판매와 포장 기능을 중심으로 구성하고 음료 좌석은 보조 기능으로 계획할 수 있다. 꽃 진열 선반, 포장 작업대, 수납공간과 소형 좌석을 검토하고 밝은 목재·아이보리·연한 녹색과 따뜻한 조명을 참고할 수 있다.</p>
      </details>
    </article>
    <article>
      <span>WORK ORDER</span>
      <h3>작업지시형 프롬프트</h3>
      <blockquote>첨부한 빈 상업공간 이미지를 분석하고 유지·추가·변경·삭제·금지할 요소와 이미지로 확인할 수 없는 조건을 구분해 작업 조건표를 작성해줘.</blockquote>
      <p>첨부 이미지 분석, 조건 분류와 지정된 출력 형식의 결과물 작성을 지시한다.</p>
    </article>
  </div>
  <div class="lesson-table-wrap" role="region" aria-label="정보 확인형 질문과 작업지시형 프롬프트 비교" tabindex="0">
    <table class="lesson-table lesson02-table">
      <thead><tr><th>구분</th><th>정보 확인형 질문</th><th>작업지시형 프롬프트</th></tr></thead>
      <tbody>
        <tr><th>목적</th><td>지식과 아이디어 확인</td><td>실제 작업 수행</td></tr>
        <tr><th>입력자료</th><td>없어도 가능</td><td>이미지·문서·조건표 사용</td></tr>
        <tr><th>조건</th><td>비교적 단순</td><td>유지·변경·금지 조건 포함</td></tr>
        <tr><th>결과</th><td>일반 설명</td><td>표·프롬프트·체크리스트</td></tr>
        <tr><th>활용</th><td>방향 탐색과 준비</td><td>프로젝트 업무 진행</td></tr>
      </tbody>
    </table>
  </div>
  <aside class="lesson02-key-message"><strong>정보 확인형 질문은 관련 지식을 묻고, 작업지시형 프롬프트는 자료와 조건을 전달해 실제 결과물을 만들게 한다.</strong></aside>
</LessonSection>

<LessonSection id="section-06" number="06" title="좋은 프롬프트의 7가지 공통 규칙" class="outline-section lesson02-ebook-section" lessonId="02">
  <p class="lesson02-section-lead">제2차시의 최상위 규칙은 아래 7개만 사용한다. 유지·추가·변경·삭제·금지·확인 불가는 규칙 5 ‘조건·제한’의 하위 분류다.</p>
  <div class="lesson02-rules">
    {lesson02PromptRules.map((rule, index) => (
      <article>
        <header>
          <span>RULE {String(index + 1).padStart(2, '0')}</span>
          <h3>{rule.title}</h3>
          <strong>{rule.keyLine}</strong>
        </header>
        <p>{rule.meaning}</p>
        <div class="lesson02-example-pair">
          <section><span>인테리어 작업에서 부족한 요청</span><p>{rule.interiorBefore}</p></section>
          <section><span>개선된 요청</span><p>{rule.improved}</p></section>
        </div>
        <aside class="lesson02-check-question"><span>작성 전 확인 질문</span><strong>{rule.checkQuestion}</strong></aside>
        <details>
          <summary>일반 예시와 상세 적용 보기</summary>
          <div class="lesson02-rule-details">
            <section><h4>왜 필요한가</h4><ul>{rule.why.map((item) => <li>{item}</li>)}</ul></section>
            <section><h4>일반적인 AI 작업 예시</h4><p><strong>부족:</strong> {rule.generalBefore}</p><p><strong>개선:</strong> {rule.generalAfter}</p><p>{rule.generalNote}</p></section>
            <section><h4>부족한 이유</h4><ul>{rule.missingReasons.map((item) => <li>{item}</li>)}</ul></section>
            <section><h4>AI가 이해해야 할 핵심</h4><ul>{rule.aiUnderstands.map((item) => <li>{item}</li>)}</ul></section>
            <section><h4>인테리어 적용 범위</h4><ul>{rule.application.map((item) => <li>{item}</li>)}</ul></section>
          </div>
        </details>
      </article>
    ))}
  </div>
</LessonSection>

<LessonSection id="section-07" number="07" title="프롬프트 작성 공통 공식" class="outline-section lesson02-ebook-section" lessonId="02">
  <aside class="lesson02-formula" aria-label="프롬프트 작성 공통 공식">
    <strong>목적 → 맥락 → 입력자료 → 작업 단계 → 조건·제한 → 출력 형식 → 검토 기준</strong>
  </aside>
  <div class="lesson-table-wrap" role="region" aria-label="공통 공식과 7가지 규칙 대응표" tabindex="0">
    <table class="lesson-table lesson02-table">
      <thead><tr><th>공통 공식</th><th>공통 규칙</th></tr></thead>
      <tbody>{lesson02Formula.map(([formula, rule]) => <tr><th>{formula}</th><td>{rule}</td></tr>)}</tbody>
    </table>
  </div>
  <p class="lesson02-easy-formula">무엇을 시킬지 → 어떤 상황인지 → 무엇을 참고할지 → 어떤 순서로 작업할지 → 무엇을 지키고 하지 말아야 할지 → 결과를 어떻게 보여줄지 → 무엇을 확인할지</p>
  <p>이 공식은 Gemini 질문, 문서·이미지 분석, Nano Banana용 프롬프트, 생성 이미지 오류 확인, 수정 요청과 결과 비교에 공통으로 사용할 수 있다.</p>
</LessonSection>

<LessonSection id="section-08" number="08" title="짧은 요청과 구조화된 요청 비교" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-short-request">
    <span>SHORT REQUEST</span>
    <blockquote>이 빈 공간을 예쁜 플라워 카페로 만들어줘.</blockquote>
    <p>문장이 짧아서가 아니라 작업 목적·맥락·입력자료 역할·단계·조건·출력 형식과 검토 기준이 부족하다는 점이 문제다.</p>
  </div>
  <PromptCopyBlock
    id="lesson02-complete-prompt"
    title="7가지 공통 규칙을 적용한 구조화된 요청"
    description="플라워 카페 사례 전체에서 같은 문구를 재사용하는 완성 프롬프트입니다."
    prompt={lesson02CompletePrompt}
  />
</LessonSection>

<LessonSection id="section-09" number="09" title="구조화된 프롬프트 문장 분석" class="outline-section lesson02-ebook-section" lessonId="02">
  <AnnotatedPromptBlock
    id="lesson02-annotated-prompt"
    title="실제 문장과 7가지 공통 규칙 연결"
    prompt={lesson02CompletePrompt}
    segments={[...lesson02AnnotatedSegments]}
  />
</LessonSection>

<LessonSection id="section-10" number="10" title="실습 전 예열과 실습 1 · 작업 조건표" class="outline-section lesson02-ebook-section" lessonId="02">
  <section class="lesson02-practice-block">
    <header><span>WARM-UP · 3~5분</span><h3>실습 전 예열</h3></header>
    <blockquote>이 빈 공간을 예쁜 플라워 카페로 만들어줘.</blockquote>
    <ul class="lesson02-two-column-list">{warmupQuestions.map((question) => <li>{question}</li>)}</ul>
    <p><strong>연결:</strong> 방금 생각한 내용을 AI가 이해할 수 있는 작업 조건으로 정리해보겠습니다.</p>
  </section>
  <section class="lesson02-practice-block">
    <header><span>PRACTICE 01 · 10~15분</span><h3>인테리어 작업 조건표 만들기</h3></header>
    <p>긴 프롬프트를 바로 쓰지 않고 공간 디자인에 필요한 조건을 항목별로 결정한다.</p>
    <ul class="lesson02-field-list">{practiceOneFields.map((field) => <li>{field}</li>)}</ul>
    <PracticeResultSample summary="플라워 카페 조건표의 한 가지 참고안">
      <dl class="lesson02-sample-definition-list">
        {lesson02PracticeOneSample.map(([term, description]) => <div><dt>{term}</dt><dd>{description}</dd></div>)}
      </dl>
      <p class="lesson02-sample-note">이 결과는 하나의 참고안이다. 공간 목적과 디자인 방향에 따라 다른 조건표를 작성할 수 있다.</p>
    </PracticeResultSample>
  </section>
</LessonSection>

<LessonSection id="section-11" number="11" title="실습 2 · 조건표를 작업지시서로 조립하기" class="outline-section lesson02-ebook-section" lessonId="02">
  <section class="lesson02-practice-block">
    <header><span>PRACTICE 02 · 10~15분</span><h3>7가지 공통 규칙의 순서로 조립하기</h3></header>
    <p>실습 1에서 정한 조건을 목적, 맥락, 입력자료, 작업 단계, 조건·제한, 출력 형식과 검토 기준의 순서로 연결한다.</p>
    <PromptCopyBlock id="lesson02-practice-template" title="빈칸형 작업지시서 템플릿" prompt={lesson02PracticeTemplate} />
    <PracticeResultSample summary="완성 프롬프트, 문장별 규칙과 예상되는 결과 변화">
      <PromptCopyBlock id="lesson02-practice-two-result" title="실습 2 완성 프롬프트" prompt={lesson02CompletePrompt} />
      <div class="lesson02-practice-rule-map">
        <h4>문장별 공통 규칙</h4>
        <ol>
          {lesson02AnnotatedSegments.map((segment) => (
            <li>
              <span>{segment.text}</span>
              <strong>{segment.label}</strong>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h4>예상되는 결과 변화</h4>
        <ul><li>꽃 진열 영역과 소형 좌석 추가</li><li>밝은 목재·아이보리와 따뜻한 조명 적용</li><li>사람과 문자 제외</li><li>원본 구조와 카메라 시점은 가능한 유지</li></ul>
        <p class="lesson02-sample-note">예상 결과는 프롬프트의 의도를 설명한 것이다. 실제 생성 결과는 실행 시점과 모델에 따라 달라질 수 있다.</p>
      </div>
    </PracticeResultSample>
  </section>
</LessonSection>

<LessonSection id="section-12" number="12" title="실습 3~4 · 프롬프트 다듬기와 A/B 테스트" class="outline-section lesson02-ebook-section" lessonId="02">
  <section class="lesson02-practice-block">
    <header><span>PRACTICE 03 · 약 10분</span><h3>충돌하거나 모호한 조건 고치기</h3></header>
    <p>프롬프트가 길더라도 조건끼리 충돌하거나 표현이 모호하면 원하는 결과를 얻기 어렵다.</p>
    <PromptCopyBlock id="lesson02-conflict-prompt" title="문제가 있는 요청" prompt={lesson02PracticeThreeProblem} label="문제 요청 복사" />
    <PracticeResultSample summary="충돌 지점과 수정된 프롬프트">
      <div><h4>발견된 문제</h4><ol>{practiceThreeFindings.map((finding) => <li>{finding}</li>)}</ol></div>
      <PromptCopyBlock id="lesson02-conflict-revision" title="수정된 프롬프트" prompt={lesson02PracticeThreeRevision} />
      <div>
        <h4>수정 전후 설명</h4>
        <p>수정 전에는 기존 가구를 모두 유지하면서 새 카운터와 좌석을 추가하고 중앙 통로도 그대로 유지하도록 요청해 조건이 서로 충돌했다. 수정 후에는 벽·창문·출입문과 카메라 시점을 유지 대상으로 한정하고, 가구 배치는 변경할 수 있도록 범위를 구분했다. 실제 치수와 통로 폭은 확인되지 않았으므로 공간이 넓다고 단정하지 않고 소형 카운터와 최소 좌석을 제안하도록 조정했다.</p>
      </div>
    </PracticeResultSample>
  </section>
  <section class="lesson02-practice-block">
    <header><span>PRACTICE 04 · 15~20분</span><h3>한 가지 조건만 바꾸는 A/B 테스트</h3></header>
    <p>공간 용도와 구조 조건은 같게 두고 디자인 스타일 한 가지를 바꾸어 어떤 문장이 결과에 영향을 주는지 비교한다.</p>
    <div class="lesson02-ab-prompts">
      <PromptCopyBlock id="lesson02-ab-common" title="공통 조건" prompt={lesson02AbCommon} />
      <PromptCopyBlock id="lesson02-ab-natural" title="A안 · 내추럴" prompt={lesson02AbNatural} />
      <PromptCopyBlock id="lesson02-ab-minimal" title="B안 · 미니멀" prompt={lesson02AbMinimal} />
    </div>
    <PracticeResultSample summary="실제 A/B 이미지가 아직 없으므로 예상 차이만 표시">
      <p class="lesson02-sample-note"><strong>예상되는 결과 차이</strong>이며 실제 생성 이미지나 성공 결과로 표시하지 않는다.</p>
      <div class="lesson-table-wrap" role="region" aria-label="A안과 B안 예상 차이" tabindex="0">
        <table class="lesson-table lesson02-table"><thead><tr><th>비교 항목</th><th>A안 내추럴</th><th>B안 미니멀</th></tr></thead><tbody>{abRows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th>{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table>
      </div>
      <p>공간 용도, 원본 구조, 카메라 시점, 필수 가구 기능과 사람·문자 금지는 동일하게 유지한다. 생성형 AI의 결과는 실행 시점과 모델에 따라 달라지며 예시와 같은 결과를 보장하지 않는다.</p>
    </PracticeResultSample>
  </section>
</LessonSection>

<LessonSection id="section-13" number="13" title="응용 실습 · 실제 이미지 생성과 수정" class="outline-section lesson02-ebook-section" lessonId="02">
  <div class="lesson02-application">
    <header class="lesson02-application__header">
      <span>APPLICATION</span>
      <h3>빈 공간 선택부터 결과 비교와 저장까지</h3>
      <p>기초 실습에서 정한 조건과 공통 규칙을 기존 실제 이미지 생성·수정 과정에 적용한다.</p>
    </header>
    <section class="lesson02-existing-materials">
      <h3>자료 사용 경계</h3>
      <ClassifiedList items={materials} />
    </section>
    <EmptySpacePracticeKit {...practiceKit} />
    {practiceGuidance && <ClassifiedList items={practiceGuidance} />}
    <ol class="practice-list">
      {practice.map((step, index) => (
        <li data-step-id={step.id}>
          <span>STEP {String(index + 1).padStart(2, '0')} · {step.minutes}분</span>
          <div><h3>{step.title}</h3><p>{step.description}</p></div>
        </li>
      ))}
    </ol>
    <IterativeImageSample {...iterationSample} />
    <section class="lesson02-final-grid">
      <article><h3>실습 결과물</h3><ClassifiedList items={deliverables} /></article>
      <article><h3>결과 검토 기준</h3><ClassifiedList items={judgments} /></article>
    </section>
    <section>
      <h3>AI 오류 확인 체크리스트</h3>
      <ClassifiedList items={errorChecks} checks />
      {errorCheckDetails && (
        <details class="lesson-reference-checks"><summary>상세 참고 체크리스트</summary><ClassifiedList items={errorCheckDetails} checks /></details>
      )}
    </section>
    <section>
      <h3>결과 정리와 다음 차시 연결</h3>
      <ClassifiedList items={verification} />
    </section>
  </div>
</LessonSection>

