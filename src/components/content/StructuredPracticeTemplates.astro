---
type PracticeTable = {
  title: string;
  description: string;
  columns: string[];
  placeholders: string[];
};

interface Props {
  tables?: PracticeTable[];
  briefTitle?: string;
  briefDescription?: string;
  briefFields?: string[];
  evidenceCategories?: string[];
  evidenceNote?: string;
  closingNote?: string;
  idPrefix?: string;
  tableLabelOffset?: number;
  briefLabel?: string;
}

const {
  tables = [],
  briefTitle,
  briefDescription,
  briefFields = [],
  evidenceCategories,
  evidenceNote,
  closingNote,
  idPrefix = 'practice',
  tableLabelOffset = 0,
  briefLabel = 'PRACTICE C',
} = Astro.props;
const briefId = idPrefix === 'practice' ? 'design-brief-fields' : `${idPrefix}-design-brief-fields`;
---

<div class="structured-practice-templates">
  {evidenceCategories && (
    <aside class="structured-practice-evidence" aria-labelledby="practice-evidence-title">
      <header>
        <span>EVIDENCE CLASSIFICATION</span>
        <h3 id="practice-evidence-title">근거와 확인 상태 구분</h3>
        {evidenceNote && <p>{evidenceNote}</p>}
      </header>
      <ul>
        {evidenceCategories.map((category) => <li>{category}</li>)}
      </ul>
    </aside>
  )}

  {tables.map((table, index) => (
    <section
      class="structured-practice-template"
      aria-labelledby={`${idPrefix}-template-${index + 1}`}
    >
      <header>
        <span>PRACTICE {String.fromCharCode(65 + tableLabelOffset + index)}</span>
        <h3 id={`${idPrefix}-template-${index + 1}`}>{table.title}</h3>
        <p>{table.description}</p>
      </header>
      <div
        class="table-scroll structured-practice-template__table"
        tabindex="0"
        role="region"
        aria-label={`${table.title} 작성 구조`}
      >
        <table class="lesson-table">
          <thead>
            <tr>
              {table.columns.map((column) => <th scope="col">{column}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              {table.placeholders.map((placeholder) => <td>{placeholder}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  ))}

  {briefTitle && briefDescription && briefFields.length > 0 && (
    <section
      class="structured-practice-template structured-practice-template--brief"
      aria-labelledby={briefId}
    >
      <header>
        <span>{briefLabel}</span>
        <h3 id={briefId}>{briefTitle}</h3>
        <p>{briefDescription}</p>
      </header>
      <ol>
        {briefFields.map((field, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{field}</strong>
          </li>
        ))}
      </ol>
    </section>
  )}

  {closingNote && <p class="structured-practice-templates__note">{closingNote}</p>}
</div>
