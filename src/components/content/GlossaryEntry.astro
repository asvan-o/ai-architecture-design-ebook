---
import StatusBadge from '../StatusBadge.astro';

interface Props {
  index: string;
  term: string;
  definition: string;
}

const { index, term, definition } = Astro.props;
---

<article>
  <span>{index}</span>
  <div>
    <h3>{term}</h3>
    <p>{definition}</p>
  </div>
  <StatusBadge kind="verificationStatus" value="pending" />
</article>
