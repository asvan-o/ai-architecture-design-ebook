---
import StatusBadge from '../StatusBadge.astro';

interface Props {
  index: string;
  term: string;
  englishName: string;
  definition: string;
  courseUse: string;
  confusedWith: string;
  lessons: string;
  lastReviewed: string;
  definitionBasis: 'official-source' | 'standard-public-reference' | 'course-definition';
  verificationBasis: string;
}

const {
  index,
  term,
  englishName,
  definition,
  courseUse,
  confusedWith,
  lessons,
  lastReviewed,
  definitionBasis,
  verificationBasis,
} = Astro.props;

const definitionBasisCatalog = {
  'official-source': {
    label: '공식 출처 확인',
    statusValue: 'official-source-checked',
  },
  'standard-public-reference': {
    label: '표준·공공 참고',
    statusValue: 'standard-public-reference',
  },
  'course-definition': {
    label: '강의용 정의',
    statusValue: 'course-definition',
  },
} as const;

const definitionBasisMeta = definitionBasisCatalog[definitionBasis];
---

<article>
  <span>{index}</span>
  <div>
    <h3>{term}</h3>
    <p class="term-english">{englishName}</p>
    <p class="term-definition">{definition}</p>
    <dl>
      <div><dt>강의에서 사용하는 의미</dt><dd>{courseUse}</dd></div>
      <div><dt>혼동하기 쉬운 개념</dt><dd>{confusedWith}</dd></div>
      <div><dt>관련 차시</dt><dd>{lessons}</dd></div>
      <div><dt>정의 구분</dt><dd>{definitionBasisMeta.label}</dd></div>
      <div><dt>정의 근거</dt><dd>{verificationBasis}</dd></div>
      <div><dt>마지막 검토일</dt><dd>{lastReviewed}</dd></div>
    </dl>
  </div>
  <StatusBadge kind="verificationStatus" value={definitionBasisMeta.statusValue} />
</article>
