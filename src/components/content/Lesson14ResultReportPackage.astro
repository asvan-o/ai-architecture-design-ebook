---
import LessonSection from './LessonSection.astro';
import {
  finalPackageStructure,
  lesson14TimePlan,
  reportBasicInformation,
  reportSections,
  reportWritingGuides,
} from '../../lib/lesson12-14-portfolio-project';

interface Props {
  lessonId?: string;
  timePlan?: typeof lesson14TimePlan;
}

const { lessonId = '14', timePlan = lesson14TimePlan } = Astro.props;
const totalMinutes = timePlan.reduce((sum, item) => sum + item.minutes, 0);
---

<div class="lesson14-package" data-lesson14-result-report>
  <LessonSection id="section-01" number="01" title="차시 소개 · 결과와 과정을 하나의 제출 패키지로 묶는다" {lessonId}>
    <div class="package-hero">
      <p>LESSON 14 · DOCUMENT · PACKAGE · PRESENT</p>
      <h3>포트폴리오는 보여주고, 결과보고서는 설명하며, 제출 패키지는 두 문서를 다시 확인할 수 있게 연결한다.</h3>
      <span>제14차시는 새로운 이미지를 많이 만드는 시간이 아니라 제12·13차시 결과를 검토하고 기록을 완성하는 6시간 마무리 과정이다.</span>
    </div>
  </LessonSection>

  <LessonSection id="section-02" number="02" title="최종 산출물 2종과 역할" {lessonId}>
    <div class="output-pair">
      <article><span>PORTFOLIO</span><h3>결과를 보여준다.</h3><ul><li>프로젝트 핵심</li><li>시각적 설득</li><li>선별한 최종 결과</li></ul></article>
      <article><span>RESULT REPORT</span><h3>과정을 설명한다.</h3><ul><li>사용 자료</li><li>AI와 프롬프트</li><li>판단·수정·검증</li></ul></article>
    </div>
    <blockquote class="key-message">포트폴리오는 결과를 보여주는 문서이고, 결과보고서는 작업 과정을 설명하는 문서입니다.</blockquote>
  </LessonSection>

  <LessonSection id="section-03" number="03" title="프로젝트 결과보고서 · 공식 구조와 작성 가이드" {lessonId}>
    <p class="section-lead"><strong>문서명: 프로젝트 결과보고서</strong> 아래 공식 항목을 제출 문서의 뼈대로 사용하고, 수업에서 만든 세부 기록은 해당 항목을 구체적으로 작성하는 근거로 연결한다.</p>
    <div class="prompt-record" aria-label="프로젝트 결과보고서 기본 정보">
      {reportBasicInformation.map((item) => <div><strong>{item}</strong><span>제출 대상에 맞는 정보를 확인해 작성한다.</span></div>)}
    </div>
    <ol class="report-list">
      {reportSections.map(([title, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}
    </ol>
    <div class="package-rules" aria-label="공식 결과보고서 항목별 작성 가이드">
      {reportWritingGuides.map(([title, items]) => (
        <article>
          <strong>{title}</strong>
          <ul>{items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <blockquote class="key-message">프로젝트 수행 단계별 사진을 첨부하고, 계획 → 진행 → 결과 순으로 설명을 작성한다.</blockquote>
    <p class="boundary-note">위에 없는 기관 제출 항목을 공식 양식이라고 추가하지 않는다. 세부 기록은 공식 항목의 작성 가이드와 검증 근거로 활용한다.</p>
  </LessonSection>

  <LessonSection id="section-04" number="04" title="사용한 실무 데이터 정리" {lessonId}>
    <div class="record-table" role="table" aria-label="사용한 실무 데이터 기록 항목">
      <div role="row"><strong role="columnheader">자료 ID</strong><strong role="columnheader">자료명</strong><strong role="columnheader">역할</strong><strong role="columnheader">사용 범위</strong><strong role="columnheader">공개 상태</strong></div>
      <div role="row"><span>D-01</span><span>원자료</span><span>사실 확인 기준</span><span>분석·대조</span><span>확인 후 기록</span></div>
      <div role="row"><span>D-02</span><span>작업 입력</span><span>AI 입력자료</span><span>생성 작업</span><span>확인 후 기록</span></div>
      <div role="row"><span>D-03</span><span>결과 후보</span><span>비교·수정 대상</span><span>내부 검토</span><span>확인 후 기록</span></div>
    </div>
    <p class="boundary-note">위 행은 기록 형식 예시다. 실제 프로젝트의 회사명·주소·발주처·개인정보를 그대로 공개 표에 옮기지 않는다.</p>
  </LessonSection>

  <LessonSection id="section-05" number="05" title="AI 활용 과정 정리" {lessonId}>
    <ol class="process-grid">
      {[
        ['목적', '왜 AI를 사용했는가?'],
        ['입력', '어떤 자료와 조건을 제공했는가?'],
        ['도구', '어떤 도구를 어떤 역할로 사용했는가?'],
        ['출력', '무엇이 생성됐는가?'],
        ['사람의 판단', '무엇을 선택·수정·보류했는가?'],
        ['검증', '무엇을 원자료와 다시 대조했는가?'],
      ].map(([title, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{title}</strong><p>{description}</p></li>)}
    </ol>
  </LessonSection>

  <LessonSection id="section-06" number="06" title="사용 프롬프트 정리" {lessonId}>
    <div class="prompt-record">
      <div><strong>프롬프트 ID</strong><span>P-01, P-02처럼 식별한다.</span></div>
      <div><strong>목적</strong><span>표지 생성, 텍스트 검증 등 역할을 적는다.</span></div>
      <div><strong>입력자료</strong><span>함께 사용한 자료 ID를 연결한다.</span></div>
      <div><strong>원문·버전</strong><span>실제 사용한 전체 문장과 수정 버전을 보존한다.</span></div>
      <div><strong>결과</strong><span>생성 결과 ID와 선택 여부를 연결한다.</span></div>
      <div><strong>검토</strong><span>오류·수정·보류 이유를 기록한다.</span></div>
    </div>
    <p class="boundary-note">“비슷한 프롬프트를 사용함”이라고 요약하지 않는다. 최종 결과와 연결된 실제 원문을 남긴다.</p>
  </LessonSection>

  <LessonSection id="section-07" number="07" title="결과 선택·수정·검증 기록" {lessonId}>
    <div class="decision-grid">
      <article><span>KEEP</span><h3>유지</h3><p>목적과 기준에 맞아 최종 결과에 포함한다.</p></article>
      <article><span>REVISE</span><h3>수정</h3><p>문구·구성·이미지 오류를 특정해 다시 작업한다.</p></article>
      <article><span>HOLD</span><h3>보류</h3><p>근거나 권한이 부족해 최종 결과에서 잠시 제외한다.</p></article>
      <article><span>EXCLUDE</span><h3>제외</h3><p>목적과 맞지 않거나 오류가 커서 제외 이유를 남긴다.</p></article>
    </div>
  </LessonSection>

  <LessonSection id="section-08" number="08" title="포트폴리오 최종 점검" {lessonId}>
    <ul class="check-grid">
      {['표지부터 최종 요약까지 프로젝트 이야기가 이어지는가?', '가장 중요한 결과가 먼저 보이는가?', '문구·로고·캡션에 오탈자와 AI 이상 문자가 없는가?', '실제 참여 범위와 팀·AI 작업을 구분했는가?', '도면·이미지·재료·법규 관련 표현이 확인된 범위를 넘지 않는가?', '공개 권한이 없는 자료와 식별정보를 제거했는가?'].map((item) => <li><span aria-hidden="true">□</span><strong>{item}</strong></li>)}
    </ul>
  </LessonSection>

  <LessonSection id="section-09" number="09" title="결과보고서 최종 점검" {lessonId}>
    <ul class="check-grid">
      {['사용한 원자료와 AI 입력자료가 구분됐는가?', '도구별 역할과 실제 사용 프롬프트를 기록했는가?', '후보 선택과 수정 이유가 남아 있는가?', 'AI 결과를 원자료와 어떻게 대조했는지 설명했는가?', '확인하지 못한 내용과 추가 검증 항목을 적었는가?', '최종 포트폴리오의 파일명·버전과 연결되는가?'].map((item) => <li><span aria-hidden="true">□</span><strong>{item}</strong></li>)}
    </ul>
  </LessonSection>

  <LessonSection id="section-10" number="10" title="최종 제출 패키지 구성" {lessonId}>
    <pre class="package-tree"><code>{finalPackageStructure.join('\n')}</code></pre>
    <div class="package-rules">
      <article><strong>원자료 보호</strong><p>제출에 필요하지 않은 회사·프로젝트 원본은 패키지에 복사하지 않는다.</p></article>
      <article><strong>최종본 식별</strong><p>제출할 파일명과 버전을 한 번만 확정하고 중복 후보를 제거한다.</p></article>
      <article><strong>링크 확인</strong><p>결과보고서의 자료·프롬프트 ID가 실제 포함 파일과 연결되는지 확인한다.</p></article>
    </div>
  </LessonSection>

  <LessonSection id="section-11" number="11" title="제출 전 권리·보안·사실성 경계" {lessonId}>
    <div class="boundary-panel">
      <h3>공개 가능 여부는 파일마다 다시 판단한다.</h3>
      <ul>
        <li>회사 업무자료와 파생 결과의 외부 공개 허용 여부</li>
        <li>사람·주소·계정·로컬 경로 등 식별정보 포함 여부</li>
        <li>외부 이미지·폰트·로고·제품 자료의 사용 범위</li>
        <li>AI 생성 결과의 오류·추정·확인 불가 영역 표시</li>
        <li>법규·구조·성능·시공 가능성을 확정하는 표현 여부</li>
      </ul>
    </div>
  </LessonSection>

  <LessonSection id="section-12" number="12" title="발표 준비" {lessonId}>
    <ol class="presentation-flow">
      <li><span>01</span><strong>프로젝트</strong><p>무엇을 해결하려 했는가?</p></li>
      <li><span>02</span><strong>결과</strong><p>무엇을 만들었는가?</p></li>
      <li><span>03</span><strong>AI 활용</strong><p>어디에 AI를 사용했는가?</p></li>
      <li><span>04</span><strong>사람의 판단</strong><p>무엇을 선택·수정·검증했는가?</p></li>
      <li><span>05</span><strong>한계</strong><p>무엇을 아직 확인해야 하는가?</p></li>
    </ol>
  </LessonSection>

  <LessonSection id="section-13" number="13" title="최종 제출 Gate" {lessonId}>
    <div class="gate-grid">
      {['포트폴리오 최종본', '결과보고서 최종본', '실제 사용 프롬프트', '공개 가능한 근거·검토 기록', '최종 파일명·버전', '권리·보안·식별정보 점검', '깨진 링크·누락 파일 점검', '발표용 핵심 메시지'].map((item) => <div><span aria-hidden="true">□</span><strong>{item}</strong></div>)}
    </div>
    <blockquote class="key-message key-message--small">모든 칸을 채웠다는 사실보다, 확인하지 못한 내용을 확정한 것처럼 보이지 않게 정리했는지가 더 중요하다.</blockquote>
  </LessonSection>

  <LessonSection id="section-14" number="14" title="360분 운영과 과정 마무리" {lessonId}>
    <div class="time-grid" data-lesson14-time-total={totalMinutes}>
      {timePlan.map(({ label, minutes, mode }, index) => <article class={`time-card time-card--${mode}`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong><small>{minutes}분</small></article>)}
    </div>
    <p class="time-total">총 {totalMinutes}분</p>
    <blockquote class="closing-message">보여줄 결과와 설명할 과정을 분리해서 만들고, 마지막에는 서로 연결해 하나의 검토 가능한 프로젝트로 제출한다.</blockquote>
  </LessonSection>
</div>

<style>
  .lesson14-package{--l14-ink:#26322e;--l14-accent:#a84930;--l14-warm:#f4eadc;--l14-green:#e9f0eb;display:grid;min-width:0;max-width:100%}.lesson14-package>:global(.lesson-section){min-width:0;max-width:100%}.package-hero{display:grid;gap:.75rem;padding:clamp(1.2rem,3vw,2rem);border:1px solid var(--line-dark);background:linear-gradient(135deg,var(--l14-green),#fff)}.package-hero p,.package-hero h3,.package-hero span{margin:0}.package-hero p{color:var(--l14-accent);font-size:.74rem;font-weight:900;letter-spacing:.12em}.package-hero h3{max-width:25ch;font-family:var(--serif);font-size:clamp(2rem,4vw,3.3rem);line-height:1.15}.package-hero span{color:var(--muted);line-height:1.72}.output-pair,.process-grid,.decision-grid,.package-rules,.presentation-flow,.gate-grid,.time-grid{display:grid;gap:1rem}.output-pair{grid-template-columns:repeat(2,minmax(0,1fr))}.output-pair article{padding:1.2rem;border:1px solid var(--line-dark);background:#fff}.output-pair article:first-child{background:var(--l14-warm)}.output-pair article:last-child{background:var(--l14-green)}.output-pair span{color:var(--l14-accent);font-size:.74rem;font-weight:900;letter-spacing:.1em}.output-pair h3{margin:.45rem 0}.output-pair ul{margin:0;padding-left:1.2rem;line-height:1.7}.key-message,.closing-message{margin:1rem 0 0;padding:1.1rem 1.3rem;border-left:5px solid var(--l14-accent);background:#fff0e8;font-size:clamp(1.05rem,2vw,1.25rem);font-weight:800;line-height:1.65}.key-message--small{font-size:1.05rem}.closing-message{background:var(--l14-green)}.section-lead,.boundary-note{line-height:1.72}.section-lead{margin:0 0 1rem}.boundary-note{margin:1rem 0 0;padding:1rem;border-left:5px solid var(--l14-accent);background:#fff0e8}
  .report-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:0;padding:0;list-style:none}.report-list li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.75rem;padding:1rem;border:1px solid var(--line-dark);background:#fff}.report-list span,.process-grid span,.presentation-flow span{color:var(--l14-accent);font-size:.74rem;font-weight:900}.report-list p,.process-grid p,.presentation-flow p{margin:.25rem 0 0;color:var(--muted);line-height:1.55}.record-table{display:grid;max-width:100%;overflow-x:auto;border:1px solid var(--line-dark)}.record-table>div{display:grid;grid-template-columns:7rem repeat(4,minmax(0,1fr));min-width:48rem;border-bottom:1px solid var(--line)}.record-table>div:last-child{border-bottom:0}.record-table span,.record-table strong{padding:.75rem}.record-table>div:first-child{background:var(--l14-ink);color:#fff}.process-grid{grid-template-columns:repeat(3,minmax(0,1fr));margin:0;padding:0;list-style:none}.process-grid li{padding:1rem;border-top:3px solid var(--l14-accent);background:#fff}.process-grid strong{display:block;margin-top:.3rem}.prompt-record{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.prompt-record div{display:grid;gap:.35rem;padding:1rem;border:1px solid var(--line-dark);background:#fff}.prompt-record span{color:var(--muted)}
  .decision-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.decision-grid article{padding:1rem;border:1px solid var(--line-dark);background:#fff}.decision-grid span{color:var(--l14-accent);font-size:.72rem;font-weight:900}.decision-grid h3,.decision-grid p{margin:.35rem 0 0}.decision-grid p{color:var(--muted);line-height:1.55}.check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:0;padding:0;list-style:none}.check-grid li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.6rem;padding:1rem;border:1px solid var(--line-dark);background:#fff;line-height:1.55}.check-grid span{color:var(--l14-accent)}.package-tree{margin:0;padding:1.2rem;overflow-x:auto;border:1px solid var(--line-dark);background:var(--l14-ink);color:#fff;font-size:1rem;line-height:1.9;white-space:pre-wrap}.package-rules{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:1rem}.package-rules article{padding:1rem;border:1px solid var(--line-dark);background:#fff}.package-rules p{margin:.35rem 0 0;color:var(--muted);line-height:1.55}.boundary-panel{padding:1.2rem;border:2px solid var(--l14-accent);background:#fff0e8}.boundary-panel h3{margin:0}.boundary-panel ul{margin:.8rem 0 0;padding-left:1.2rem;line-height:1.75}.presentation-flow{grid-template-columns:repeat(5,minmax(0,1fr));margin:0;padding:0;list-style:none}.presentation-flow li{padding:1rem;border-top:3px solid var(--l14-accent);background:#fff}.presentation-flow strong{display:block;margin-top:.3rem}.gate-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gate-grid div{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.55rem;padding:.9rem;border:1px solid var(--line-dark);background:#fff}.gate-grid span{color:var(--l14-accent)}.time-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.time-card{display:grid;gap:.3rem;padding:1rem;border-top:3px solid var(--l14-ink);background:#f8f5ee}.time-card--practice{border-color:var(--l14-accent)}.time-card--review{border-color:#527064}.time-card span,.time-card small{color:var(--muted)}.time-total{text-align:right;font-weight:900}
  @media(max-width:760px){.output-pair,.report-list,.process-grid,.prompt-record,.decision-grid,.check-grid,.package-rules,.presentation-flow,.gate-grid,.time-grid{grid-template-columns:minmax(0,1fr)}.record-table>div{min-width:44rem}}
  @media print{.package-hero,.output-pair article,.report-list li,.process-grid li,.prompt-record div,.decision-grid article,.check-grid li,.package-rules article,.boundary-panel,.presentation-flow li,.gate-grid div,.time-card{break-inside:avoid;page-break-inside:avoid}.output-pair,.report-list,.prompt-record,.check-grid,.gate-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.process-grid,.package-rules{grid-template-columns:repeat(3,minmax(0,1fr))}.decision-grid,.time-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.presentation-flow{grid-template-columns:repeat(5,minmax(0,1fr))}}
</style>
