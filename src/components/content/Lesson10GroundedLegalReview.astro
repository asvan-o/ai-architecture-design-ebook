---
import LessonSection from './LessonSection.astro';
import PromptCopyBlock from './PromptCopyBlock.astro';
import {
  legalChecklistSample,
  legalSources,
  lesson10Prompts,
  projectErrorExamples,
  projectReferenceSample,
  projectSources,
} from '../../lib/lesson10-grounded-legal-review';

interface TimePlanItem {
  label: string;
  minutes: number;
  mode: 'guide' | 'practice' | 'review';
}

interface Props {
  lessonId: string;
  timePlan: readonly TimePlanItem[];
}

const { lessonId, timePlan } = Astro.props;

const promptById = new Map(lesson10Prompts.map((prompt) => [prompt.id, prompt]));
const getPrompt = (id: string) => {
  const prompt = promptById.get(id);
  if (!prompt) throw new Error(`Lesson 10 prompt not found: ${id}`);
  return prompt;
};

---

<div class="lesson10-grounded-review" data-lesson10-workflow>
  <LessonSection id="section-01" number="01" title="차시 소개" lessonId="10">
    <div class="hero-card">
      <p class="eyebrow">PROJECT GROUNDING · CROSS-VALIDATION</p>
      <h3>AI에게 프로젝트 문서와 법규를 한꺼번에 넣으면 정확한 설계 검토가 가능할까?</h3>
      <p>
        이번 차시는 문서를 많이 넣는 법보다, <strong>프로젝트 사실</strong>과
        <strong>공식 검토 근거</strong>를 나눠 관리하는 법을 익힌다.
      </p>
    </div>
    <blockquote class="boundary-callout">
      이번 실습의 목표는 AI로 법규 적합 여부를 자동 판정하는 것이 아닙니다.
      프로젝트 사실과 공식 근거를 분리해 정리하고, 이후 설계 검토에 사용할
      신뢰 가능한 검토 기준을 만드는 과정입니다.
    </blockquote>
    <div class="time-grid" aria-label="제10차시 180분 시간표">
      {timePlan.map(({ label, minutes, mode }, index) => (
        <div class:list={['time-card', `time-card--${mode}`]}>
          <span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong><small>{minutes}분</small>
        </div>
      ))}
    </div>
  </LessonSection>

  <LessonSection id="section-02" number="02" title="실습 프로젝트와 정보 혼합 위험" lessonId={lessonId}>
    <div class="split-grid">
      <article class="info-card info-card--accent">
        <span>PROJECT</span>
        <h3>서산시 반다비 체육센터 건립사업</h3>
        <p>건축기획서, 설계공모 질의·답변, 지구단위계획 자료, 현황측량도를 함께 읽는 수업 사례다.</p>
      </article>
      <article class="info-card">
        <span>NEARBY EXISTING FACILITY</span>
        <h3>인접 기존 국민체육센터</h3>
        <p>기존시설의 면적·배치·주차 정보는 신축 사업의 값이 아니다. 같은 부지 맥락에 있어도 별도 데이터로 관리한다.</p>
      </article>
    </div>
    <div class="flow-strip" aria-label="정보 혼합 방지 원칙">
      <strong>현재 신축 사업</strong><span>≠</span><strong>인접 기존시설</strong><span>→</span><strong>Source별 분리</strong>
    </div>
  </LessonSection>

  <LessonSection id="section-03" number="03" title="왜 NotebookLM을 A와 B로 나누는가" lessonId="10">
    <div class="workflow-grid">
      <article class="workflow-card">
        <span>NOTEBOOK A</span>
        <h3>이 프로젝트는 무엇인가?</h3>
        <ol>
          <li>프로젝트 원자료 A01~A07</li><li>문서 역할 구분</li><li>조건·상태 정리</li>
          <li>오류 재확인</li><li>Project Grounded Reference</li>
        </ol>
      </article>
      <article class="workflow-card workflow-card--dark">
        <span>NOTEBOOK B</span>
        <h3>무엇을 어떤 기준으로 확인할 것인가?</h3>
        <ol>
          <li>B00 + 공식 법규 Source</li><li>현재 검토 가능 범위</li><li>NotebookLM 분석</li>
          <li>ChatGPT 교차검증</li><li>사람의 공식 원문 확인</li><li>AI 법규검토 체크리스트</li>
        </ol>
      </article>
    </div>
    <p class="plain-note">두 노트북을 나누면 프로젝트의 사실을 법규 결론으로 잘못 바꾸는 위험과 서로 다른 시설의 수치를 섞는 위험을 줄일 수 있다.</p>
  </LessonSection>

  <LessonSection id="section-04" number="04" title="이번 차시의 두 결과물" lessonId="10">
    <div class="result-grid">
      <article class="result-card">
        <span>OUTPUT A</span>
        <h3>Project Grounded Reference</h3>
        <p>프로젝트 조건 기준서. 수업 준비 원본의 예시 파일명은 <code>A99_반다비체육관_프로젝트조건_법규검토준비기준서.docx</code>다.</p>
        <p>Notebook B로 전달할 때 같은 내용을 <strong>B00</strong>으로 이름만 바꾼다. 새로운 분석 결과가 아니다.</p>
      </article>
      <article class="result-card">
        <span>OUTPUT B</span>
        <h3>AI 법규검토 체크리스트</h3>
        <p><code>B99</code>는 프로젝트 조건과 공식 Source를 연결하고 필요한 설계자료와 사람의 확인 작업을 정리한다.</p>
        <p><strong>최종 법규 적합성 검토서가 아니다.</strong></p>
      </article>
    </div>
  </LessonSection>

  <LessonSection id="section-05" number="05" title="Notebook A · 프로젝트 원자료의 역할 확인" lessonId="10">
    <div class="source-grid" data-lesson10-source-pack="a01-a07">
      {projectSources.map((item) => (
        <article class="source-card">
          <span>{item.code}</span>
          <h3>{item.fileName}</h3>
          <dl><dt>성격</dt><dd>{item.nature}</dd><dt>역할</dt><dd>{item.role}</dd><dt>출처</dt><dd>{item.source}</dd></dl>
        </article>
      ))}
    </div>
    <p class="privacy-note">수업 원본 PDF·DOCX는 저장소와 공개 e-book에 포함하지 않는다. 화면에는 문서의 역할과 검증 방법만 공개한다.</p>
  </LessonSection>

  <LessonSection id="section-06" number="06" title="Notebook A · 프로젝트 조건 기준서 만들기" lessonId="10">
    <div class="prompt-stack">
      {['lesson10-prompt-a00', 'lesson10-prompt-a01', 'lesson10-prompt-a02', 'lesson10-prompt-a025'].map((id) => {
        const prompt = getPrompt(id);
        return <PromptCopyBlock {...prompt} />;
      })}
    </div>
    <div class="table-wrap" data-lesson10-normalized-table>
      <table>
        <caption>정규화 표의 고정 열과 허용 상태</caption>
        <thead><tr><th>구분</th><th>항목</th><th>최종 확인 내용</th><th>상태</th><th>Source</th><th>후속 검증 필요 여부</th></tr></thead>
        <tbody><tr><td colspan="6">상태는 확정 · 계획조건 · 예시 · 추가 확인 필요 중 하나만 사용한다.</td></tr></tbody>
      </table>
    </div>
  </LessonSection>

  <LessonSection id="section-07" number="07" title="반드시 잡아야 할 오류와 과도한 해석" lessonId="10">
    <div class="error-grid">
      {projectErrorExamples.map((item, index) => (
        <article class="error-card"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.problem}</p><strong>{item.response}</strong></article>
      ))}
    </div>
  </LessonSection>

  <LessonSection id="section-08" number="08" title="Project Grounded Reference 결과 예시" lessonId="10">
    <p class="section-lead">여기서 처음으로 A99 결과 샘플을 확인한다. 전체 정답표가 아니라 상태·Source·후속 검증을 어떻게 분리하는지 보는 예시다.</p>
    <div class="table-wrap" data-lesson10-result-sample="a99">
      <table>
        <caption>A99 프로젝트 조건 기준서 일부 예시</caption>
        <thead><tr><th>구분</th><th>항목</th><th>최종 확인 내용</th><th>상태</th><th>Source</th><th>후속 검증 필요 여부</th></tr></thead>
        <tbody>{projectReferenceSample.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="plain-note">A99의 내용을 Notebook B에 전달할 때 파일명은 B00으로 바뀌지만 근거와 상태는 그대로 유지한다.</p>
  </LessonSection>

  <LessonSection id="section-09" number="09" title="Notebook B · 현재 자료로 가능한 검토 범위 묻기" lessonId="10">
    <div class="boundary-grid">
      <article><span>INPUT 01</span><strong>B00 프로젝트 조건 기준서</strong><p>프로젝트가 요구하는 조건과 추가 확인 항목</p></article>
      <article><span>INPUT 02</span><strong>기본 법규 Source</strong><p>현재 확보한 공식 원문의 범위</p></article>
      <article><span>FIRST QUESTION</span><strong>지금 어디까지 검토할 수 있는가?</strong><p>빠진 자료의 정답을 미리 주지 않고 분석 경계를 찾는다.</p></article>
    </div>
    <PromptCopyBlock {...getPrompt('lesson10-prompt-b01')} />
  </LessonSection>

  <LessonSection id="section-10" number="10" title="NotebookLM 분석을 ChatGPT로 교차검증" lessonId="10">
    <div class="cross-flow" aria-label="NotebookLM과 ChatGPT 교차검증 흐름">
      <strong>NotebookLM 분석문</strong><span>→</span><strong>ChatGPT 텍스트 교차검증</strong><span>→</span><strong>공식 원문 후보</strong><span>→</span><strong>사람이 확인</strong>
    </div>
    <blockquote class="boundary-callout">
      NotebookLM은 현재 가진 자료 안에서 분석하고, ChatGPT는 그 분석을 외부 정보와 교차검증하는 데 활용합니다.
      최종 근거는 AI의 답변이 아니라 사람이 확인한 공식 원문입니다.
    </blockquote>
    <PromptCopyBlock {...getPrompt('lesson10-prompt-x01')} />
  </LessonSection>

  <LessonSection id="section-11" number="11" title="공식 Source를 단계적으로 보강하기" lessonId="10">
    <p class="section-lead">본문 조문만으로 결론을 내리지 않는다. 필요한 경우 별표와 지역 조례를 추가하고, 기준일·시행일·적용 범위를 다시 확인한다.</p>
    <div class="source-grid source-grid--legal">
      {legalSources.map((item) => (
        <article class="source-card">
          <span>{item.code}</span><h3>{item.fileName}</h3>
          <dl><dt>성격</dt><dd>{item.nature}</dd><dt>역할</dt><dd>{item.role}</dd><dt>출처</dt><dd>{item.source}</dd></dl>
          {item.officialUrl && <a href={item.officialUrl} target="_blank" rel="noreferrer">공식 원문에서 현행 상태 확인 ↗</a>}
          {item.note && <p class="source-note">{item.note}</p>}
        </article>
      ))}
    </div>
    <PromptCopyBlock {...getPrompt('lesson10-prompt-b02')} />
  </LessonSection>

  <LessonSection id="section-12" number="12" title="AI 법규검토 체크리스트 결과 예시" lessonId="10">
    <p class="section-lead">B99는 검토 질문과 필요한 설계자료를 연결하는 작업표다. 도면이 없는 항목을 적합 또는 부적합으로 확정하지 않는다.</p>
    <div class="status-grid">
      {['기준 확인 완료', '적용 여부 확인 필요', '설계자료 필요', '추가 공식 Source 필요'].map((status) => <span>{status}</span>)}
    </div>
    <div class="table-wrap" data-lesson10-result-sample="b99">
      <table>
        <caption>B99 AI 법규검토 체크리스트 일부 예시</caption>
        <thead><tr><th>검토 분야</th><th>검토 질문</th><th>프로젝트 근거</th><th>법규 근거</th><th>상태</th><th>필요한 설계자료</th></tr></thead>
        <tbody>{legalChecklistSample.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </LessonSection>

  <LessonSection id="section-13" number="13" title="다음 차시 · 실제 설계자료와 대조" lessonId="10">
    <div class="next-grid">
      {['각 층 평면도', '단면도', '면적표', '계단·출구', '위생시설', '배치·주차계획'].map((item) => <span>{item}</span>)}
    </div>
    <p class="next-message">다음 차시에서는 B99의 질문을 실제 설계자료와 대조한다. 프로젝트 조건 기준서와 법규 Source는 판단을 대신하는 정답지가 아니라, 무엇을 어디에서 확인할지 잃지 않게 하는 검토 지도다.</p>
  </LessonSection>
</div>

<style>
  .lesson10-grounded-review{display:grid;min-width:0;max-width:100%;gap:0}.lesson10-grounded-review>:global(.lesson-section){min-width:0;max-width:100%}.hero-card,.info-card,.workflow-card,.result-card,.source-card,.error-card,.boundary-grid article{border:1px solid var(--line-dark);background:#fff;padding:clamp(1rem,2.5vw,1.6rem)}
  .hero-card{display:grid;gap:.8rem;background:linear-gradient(135deg,#f5f1e7,#fff)}.hero-card h3,.hero-card p,.info-card h3,.info-card p,.workflow-card h3,.result-card h3,.result-card p,.source-card h3,.error-card h3,.error-card p{margin:0}.hero-card h3{max-width:24ch;font-family:var(--serif);font-size:clamp(1.8rem,4vw,3rem);line-height:1.18;text-wrap:balance}.eyebrow,.info-card>span,.workflow-card>span,.result-card>span,.source-card>span,.error-card>span,.boundary-grid span{color:var(--accent-dark);font-size:.74rem;font-weight:800;letter-spacing:.12em}
  .boundary-callout{margin:1.25rem 0 0;padding:1.2rem 1.4rem;border-left:5px solid var(--accent);background:#f6eee6;font-size:clamp(1.05rem,2vw,1.24rem);font-weight:700;line-height:1.7}.time-grid,.split-grid,.workflow-grid,.result-grid,.source-grid,.error-grid,.boundary-grid,.status-grid,.next-grid{display:grid;gap:1rem;margin-top:1.25rem}.time-grid{grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))}.time-card{display:grid;gap:.25rem;padding:.85rem;border-top:3px solid var(--line-dark);background:#f7f5ef}.time-card span,.time-card small{color:var(--muted)}.time-card--practice{border-color:var(--accent)}.split-grid,.workflow-grid,.result-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.info-card,.workflow-card,.result-card{display:grid;gap:.65rem}.info-card--accent{background:#f7efe6}.workflow-card ol{margin:.4rem 0 0;padding-left:1.25rem;line-height:1.8}.workflow-card--dark{color:#fff;background:#23302b}.workflow-card--dark>span{color:#f0b48f}.flow-strip,.cross-flow{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.75rem;margin-top:1rem;padding:1rem;border:1px solid var(--line);background:#faf8f2;text-align:center}.source-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.source-card{display:grid;gap:.6rem;min-width:0}.source-card h3{overflow-wrap:anywhere}.source-card dl{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:.45rem .7rem;margin:0;font-size:.92rem;line-height:1.55}.source-card dt{font-weight:800}.source-card dd{margin:0}.source-card a{width:fit-content;color:var(--accent-dark);font-weight:800}.source-note,.privacy-note,.plain-note,.section-lead{margin:1rem 0 0;color:var(--muted);line-height:1.7}.privacy-note{padding:1rem;border:1px dashed var(--line-dark)}.prompt-stack{display:grid;gap:1.2rem}.table-wrap{width:100%;min-width:0;max-width:100%;box-sizing:border-box;margin-top:1.25rem;overflow-x:auto;border:1px solid var(--line-dark)}table{width:100%;min-width:56rem;border-collapse:collapse;background:#fff}caption{padding:.8rem;text-align:left;font-weight:800;background:#eee9df}th,td{padding:.75rem;border:1px solid var(--line);text-align:left;vertical-align:top;line-height:1.55}th{background:#f6f2ea}.error-grid{grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}.error-card{display:grid;gap:.55rem}.error-card strong{color:var(--accent-dark);line-height:1.6}.boundary-grid{grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:1.25rem}.boundary-grid article{display:grid;gap:.5rem}.status-grid,.next-grid{grid-template-columns:repeat(auto-fit,minmax(10rem,1fr))}.status-grid span,.next-grid span{padding:.8rem;border:1px solid var(--line-dark);background:#f8f5ee;font-weight:800;text-align:center}.next-message{max-width:60rem;margin:1.25rem 0 0;font-size:1.08rem;line-height:1.8}.result-card code{overflow-wrap:anywhere}.source-grid--legal{margin-bottom:1.25rem}
  @media(max-width:760px){.split-grid,.workflow-grid,.result-grid,.source-grid,.boundary-grid{grid-template-columns:1fr}.flow-strip,.cross-flow{align-items:stretch;flex-direction:column}.flow-strip span,.cross-flow span{transform:rotate(90deg)}.source-card dl{grid-template-columns:1fr}.source-card dd{margin-bottom:.35rem}.time-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:420px){.time-grid{grid-template-columns:1fr}.hero-card,.info-card,.workflow-card,.result-card,.source-card,.error-card,.boundary-grid article{padding:1rem}.boundary-callout{padding:1rem}}
  @media print{.hero-card,.info-card,.workflow-card,.result-card,.source-card,.error-card,.boundary-grid article,.boundary-callout{break-inside:avoid;page-break-inside:avoid}.source-grid,.error-grid{display:block}.source-card,.error-card{margin-bottom:4mm}.table-wrap{overflow:visible;border:0}table{min-width:0;font-size:8pt}th,td{padding:2mm}.source-card a{display:none}.time-grid{grid-template-columns:repeat(4,1fr)}}
</style>
