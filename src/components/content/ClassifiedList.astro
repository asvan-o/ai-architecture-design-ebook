---
type ContentCategory =
  | '확인된 사실'
  | '원문에서 확인된 사실'
  | '분석·해석'
  | '확정된 수업 구성'
  | '학습 목표'
  | '수업 산출물'
  | '교육용 가정'
  | '디자인 제안'
  | '수강생 판단'
  | '수강생 전문 판단'
  | '추가 검증 필요'
  | '강의 전 사실 검증'
  | '추가 출처 확인'
  | '법규·구조·소방 등 해당 전문가 판단';

interface Props {
  items: Array<{
    category: ContentCategory;
    text: string;
    validationKey?: string;
  }>;
  checks?: boolean;
}

const { items, checks = false } = Astro.props;

const categoryClass = (category: ContentCategory) =>
  `outline-category--${category
    .replaceAll(' ', '-')
    .replace('확정된-수업-구성', 'structure')
    .replace('학습-목표', 'goal')
    .replace('수업-산출물', 'deliverable')
    .replace('원문에서-확인된-사실', 'fact')
    .replace('확인된-사실', 'fact')
    .replace('분석·해석', 'judgment')
    .replace('교육용-가정', 'assumption')
    .replace('디자인-제안', 'proposal')
    .replace('수강생-전문-판단', 'judgment')
    .replace('수강생-판단', 'judgment')
    .replace('강의-전-사실-검증', 'verification')
    .replace('추가-출처-확인', 'verification')
    .replace('추가-검증-필요', 'verification')
    .replace('법규·구조·소방-등-해당-전문가-판단', 'expert')}`;
---

<ul class:list={['outline-list', { 'outline-list--checks': checks }]}>
  {items.map((item) => (
    <li data-validation-key={item.validationKey}>
      <span class:list={['outline-category', categoryClass(item.category)]}>{item.category}</span>
      <p>{item.text}</p>
    </li>
  ))}
</ul>
