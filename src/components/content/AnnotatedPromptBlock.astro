---
import PromptCopyBlock from './PromptCopyBlock.astro';

interface Segment {
  text: string;
  label: string;
}

interface Props {
  id: string;
  title: string;
  prompt: string;
  segments: Segment[];
}

const { id, title, prompt, segments } = Astro.props;
---

<div class="annotated-prompt" aria-labelledby={`${id}-title`}>
  <header>
    <span>7-RULE ANALYSIS</span>
    <h3 id={`${id}-title`}>{title}</h3>
    <p>각 문장을 공통 규칙과 연결합니다. 화살표와 규칙 라벨은 복사 대상에 포함되지 않습니다.</p>
  </header>
  <PromptCopyBlock
    id={`${id}-copy`}
    title="구조화된 프롬프트 전체"
    description="아래 문장 분석에 사용한 프롬프트 원문을 그대로 복사합니다."
    prompt={prompt}
    showBody={false}
  />
  <ol class="annotated-prompt__list">
    {segments.map((segment, index) => (
      <li>
        <span class="annotated-prompt__number">{String(index + 1).padStart(2, '0')}</span>
        <p>{segment.text}</p>
        <span class="annotated-prompt__arrow" aria-hidden="true">→</span>
        <strong>{segment.label}</strong>
      </li>
    ))}
  </ol>
</div>

<style>
  .annotated-prompt {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .annotated-prompt > header {
    max-width: 68ch;
  }

  .annotated-prompt > header span {
    color: var(--accent-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .annotated-prompt h3,
  .annotated-prompt > header p {
    margin: 0;
  }

  .annotated-prompt h3 {
    margin-top: 0.4rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    text-wrap: balance;
  }

  .annotated-prompt > header p {
    margin-top: 0.65rem;
    color: var(--muted);
  }

  .annotated-prompt__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-dark);
  }

  .annotated-prompt__list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2rem minmax(9rem, 0.35fr);
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .annotated-prompt__number {
    color: var(--accent-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .annotated-prompt__list p {
    min-width: 0;
    margin: 0;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .annotated-prompt__arrow {
    color: var(--accent);
    font-size: 1.25rem;
    text-align: center;
  }

  .annotated-prompt__list strong {
    padding: 0.65rem 0.8rem;
    border-left: 3px solid var(--accent);
    background: #f3efe7;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .annotated-prompt__list li {
      grid-template-columns: 2rem minmax(0, 1fr);
      align-items: start;
    }

    .annotated-prompt__arrow {
      display: none;
    }

    .annotated-prompt__list strong {
      grid-column: 2;
      width: fit-content;
    }
  }

  @media print {
    .annotated-prompt__list li {
      grid-template-columns: 8mm minmax(0, 1fr) 6mm 38mm;
      gap: 2mm;
      padding: 3mm 0;
      break-inside: avoid-page;
      page-break-inside: avoid;
    }

    .annotated-prompt__list p,
    .annotated-prompt__list strong {
      font-size: 8.8pt;
    }
  }
</style>
