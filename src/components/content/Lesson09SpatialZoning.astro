    Corridor -> Office [dir=both, label="문 통과"];
    Corridor -> Storage [dir=both, label="LW개구부"];
    Corridor -> TOM [dir=both, label="문 통과"];
    Corridor -> TOW [dir=both, label="문 통과"];
    Corridor -> Elevator [dir=both, label="슬라이딩 도어"];
    Corridor -> Stairs [dir=both, label="출입구"];
    Office -> Pantry [dir=both, label="내부 연결"];

    edge [style=dashed, color="#A6A6A6", arrowhead=none];
    Meeting -> Model [label="벽체 공유"];
    Model -> Director [label="벽체 공유"];
    Director -> Office [label="벽체 공유"];
    Pantry -> Storage [label="인접"];
    Elevator -> PS [label="밀폐 구조벽"];

    edge [style=dotted, color="#D9D9D9", arrowhead=none];
    Deck1 -> Meeting [label="외벽 접합"];
    Deck2 -> Office [label="외벽 접합"];
    Deck3 -> Stairs [label="외벽 접합"];
}`;

const reviewRows = [
  '전체 외곽 형태',
  '내부 벽체',
  '공간명',
  '공간 위치',
  '출입구',
  '창호',
  '계단 위치',
  '계단 방향',
  '엘리베이터',
  'P.S',
  '주요 공간 관계',
] as const;

const functionGroups = [
  ['업무 영역', '사무소 · 소장실'],
  ['회의·협업 영역', '회의실 · 모형실'],
  ['이동·공용 영역', '복도 · 계단실 · 엘리베이터'],
  ['지원·서비스 영역', '탕비실 · 창고 · P.S'],
  ['위생 영역', 'TO.M · TO.W'],
  ['외부·휴게 영역', '휴게데크-1 · 휴게데크-2 · 휴게데크-3'],
] as const;
---

<LessonSection id="section-01" number="01" title="차시 소개" class="lesson09-section" {lessonId}>
  <div class="lesson09-hero">
    <span>LESSON 09</span>
    <h3>3D 이미지를 만드는 것에서 끝내지 않고, 원도면과 비교해 공간 기능과 관계를 다시 읽는다</h3>
    <p>이번 차시의 목표는 멋있는 3D 이미지가 아니라 원자료에 근거한 분석, 검증, 공간 관계의 구조화와 2D 개념 조닝이다.</p>
  </div>
</LessonSection>

<LessonSection id="section-02" number="02" title="제8차시 복습과 오늘의 질문" class="lesson09-section" {lessonId}>
  <div class="lesson09-recap">
    <span>제8차시</span><strong>Gaussian 결과</strong><i>→</i><strong>현실형 이미지</strong><i>→</i><strong>결과 비교</strong><i>→</i><strong>Upscale</strong>
  </div>
  <blockquote>이미지가 더 현실적이고 선명해졌다고 원래 도면과 정확히 일치한다고 볼 수 있을까?</blockquote>
  <p>시각적 완성도와 원자료 정확성은 별개의 검토 항목이다. 제9차시에서는 결과를 원도면에 다시 연결해 공간 기능과 관계를 읽는다.</p>
</LessonSection>

<LessonSection id="section-03" number="03" title="오늘의 전체 워크플로우" class="lesson09-section" {lessonId}>
  <ol class="lesson09-workflow">
    {workflowSteps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
  </ol>
  <ol class="lesson09-time-plan">
    {timePlan.map((item) => <li><span>{item.label}</span><strong>{item.minutes}분</strong></li>)}
  </ol>
  <p class="lesson09-total">총 {totalMinutes}분</p>
</LessonSection>

<LessonSection id="section-04" number="04" title="원자료를 먼저 분석하는 이유" class="lesson09-section" {lessonId}>
  <p class="lesson09-key"><strong>AI에게 원본을 보여주는 것과 원본을 기준으로 작업하게 만드는 것은 다르다.</strong></p>
  <div class="lesson09-principles">
    <article><span>01</span><h3>원문 기준</h3><p>PDF를 업로드했다는 사실만으로 구조 보존이 보장되지 않는다. 원도면에서 직접 확인되는 내용을 먼저 분리한다.</p></article>
    <article><span>02</span><h3>확인 불가 유지</h3><p>원자료에서 확인되지 않는 높이·재질·조명·성능은 추정하지 않고 확인 불가로 남긴다.</p></article>
    <article><span>03</span><h3>결과 재검토</h3><p>분석표와 이미지를 만든 뒤에도 원도면으로 돌아가 공간명·벽체·문·창·계단·코어를 다시 비교한다.</p></article>
  </div>
</LessonSection>

<LessonSection id="section-05" number="05" title="NotebookLM 원본 평면도 분석" class="lesson09-section" {lessonId}>
  <div class="lesson09-source-boundary">
    <span>LOCAL CLASS MATERIAL</span>
    <h3>원본 평면도는 사실 확인의 최우선 기준자료</h3>
    <p>공간명, 구획, 벽체, 출입구, 창호, 계단, 엘리베이터와 P.S를 확인한다. 원본 PDF에는 프로젝트 식별정보가 포함될 수 있어 공개 e-book에서 파일·미리보기·다운로드를 제공하지 않는다.</p>
  </div>
  <PromptCopyBlock id="lesson09-prompt-01" title="원본 평면도 정보 분석" description="NotebookLM에서 원본 PDF만을 근거로 확인 정보와 확인 불가 정보를 나눈다." prompt={notebookPlanAnalysisPrompt} />
</LessonSection>

<LessonSection id="section-06" number="06" title="도면 기준표와 사람이 정리한 입력자료" class="lesson09-section" {lessonId}>
  <PromptCopyBlock id="lesson09-prompt-02" title="후속 AI용 3D 이미지 생성 도면 기준표" description="NotebookLM 분석을 후속 이미지 작업에 전달할 KEEP·UNKNOWN·CHANGE 기준표로 정리한다." prompt={floorPlanCriteriaPrompt} />
  <figure class="lesson09-figure lesson09-figure--wide">
    <Image src={cleanedFloorPlan} alt="사람이 원본 도면에서 불필요한 선을 정리한 평면도 수업 예시" widths={[720, 1080, 1440]} sizes="(max-width: 900px) 100vw, 1120px" loading="eager" />
    <figcaption><strong>사람이 정리한 AI 입력용 선화</strong><span>원본 도면에서 AI 입력에 불필요하다고 판단한 선을 사람이 직접 정리한 수업 예시입니다.</span></figcaption>
  </figure>
  <p class="lesson09-boundary">이는 AI 자동 전처리 결과가 아니라 사람이 입력자료를 판단하고 정리한 사례다. 정리본도 원본 도면을 대체하지 않으며, CAD 레이어·노이즈·비식별화와 Clean Plan 제작은 제10차시에서 다룬다.</p>
</LessonSection>

<LessonSection id="section-07" number="07" title="GPT Top View 3D 생성" class="lesson09-section" {lessonId}>
  <PromptCopyBlock id="lesson09-prompt-03" title="구조 검토용 Top View 3D 생성" description="원본, 기준표, 사람이 정리한 선화의 우선순위를 명시한다." prompt={topViewPrompt} />
  <figure class="lesson09-figure lesson09-figure--wide">
    <Image src={topView3d} alt="정리된 평면도를 기준으로 GPT가 생성한 Top View 3D 수업 결과" widths={[720, 1080, 1440]} sizes="(max-width: 900px) 100vw, 1120px" loading="lazy" />
    <figcaption><strong>GPT Top View 3D 시각화 결과</strong><span>선정리본과 기준자료를 바탕으로 만든 AI 시각화다. CAD·BIM 모델, 정확한 3D 복원 또는 설계 확정안이 아니다.</span></figcaption>
  </figure>
</LessonSection>

<LessonSection id="section-08" number="08" title="원도면과 Top View 3D 검토" class="lesson09-section" {lessonId}>
  <div class="lesson09-image-compare">
    <figure><span>INPUT SUPPORT</span><Image src={cleanedFloorPlan} alt="사람이 정리한 평면도 입력 예시" widths={[520, 780, 1040]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /><figcaption>사람이 정리한 선화 · 원도면 대조 필요</figcaption></figure>
    <figure><span>AI OUTPUT</span><Image src={topView3d} alt="원도면과 비교하여 검토할 GPT Top View 3D 결과" widths={[520, 780, 1040]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /><figcaption>GPT Top View 3D · 해석 오류 검토 대상</figcaption></figure>
  </div>
  <div class="lesson09-observations">
    <h3>이 결과에서 실제로 확인할 오류 후보</h3>
    <ul><li>일부 공간명이 원본과 다른 단어로 표현되어 있다.</li><li>계단·코어·개구부의 위치와 연결을 원도면에서 다시 확인해야 한다.</li><li>원도면이 확정하지 않은 가구·높이·마감이 시각적으로 추가되어 있다.</li></ul>
  </div>
  <div class="lesson09-table" tabindex="0">
    <table><thead><tr><th>검토 항목</th><th>일치</th><th>불일치</th><th>확인 불가</th><th>원본 근거</th></tr></thead><tbody>{reviewRows.map((row) => <tr><th>{row}</th><td>□</td><td>□</td><td>□</td><td>페이지·도면 위치 기록</td></tr>)}</tbody></table>
  </div>
  <p class="lesson09-key"><strong>Grounding은 오류를 줄이는 방법이지 이미지 생성 정확도를 보장하는 기능이 아니다.</strong></p>
</LessonSection>

<LessonSection id="section-09" number="09" title="공간 기능·공간 인접 관계·주요 동선 분석" class="lesson09-section" {lessonId}>
  <div class="lesson09-terms">
    <article><h3>공간 기능</h3><p>업무, 회의·협업, 지원·서비스, 이동·공용, 위생, 외부·휴게로 원도면의 공간을 분류한다.</p></article>
    <article><h3>공간 인접 관계(Adjacency)</h3><p>직접 연결, 인접하지만 비연결, 공용공간을 통한 연결, 확인 불가를 구분한다.</p></article>
    <article><h3>주요 동선(Circulation)</h3><p>출입, 복도 연결, 계단·엘리베이터 수직동선과 외부 접합을 원도면 근거로 정리한다.</p></article>
  </div>
  <PromptCopyBlock id="lesson09-prompt-04" title="공간 기능·공간 인접 관계·주요 동선 분석" description="3D 이미지는 기준에서 제외하고 원본 평면도와 기준표만 사용한다." prompt={spatialAnalysisPrompt} />
</LessonSection>

<LessonSection id="section-10" number="10" title="NotebookLM 분석 결과 검증" class="lesson09-section" {lessonId}>
  <p>NotebookLM의 답변도 원자료 자체가 아니다. 공간 목록, 직접 연결 여부, 데크 접합, 계단·엘리베이터·P.S 관계를 원본에 다시 대조하고 최종 검증본 한 개만 남긴다.</p>
  <PromptCopyBlock id="lesson09-prompt-05" title="분석 결과 검증 및 최종 인계본 정리" description="원본 근거가 없는 해석을 제거하거나 해석·확인 불가로 표시한다." prompt={validationPrompt} />
</LessonSection>

<LessonSection id="section-11" number="11" title="Graphviz(DOT) 구조화 데이터 만들기" class="lesson09-section" {lessonId}>
  <p>Graphviz(DOT)는 이번 실습에서 검증된 공간 관계를 노드와 연결선으로 표현하기 위한 텍스트 기반 그래프 정의 방식이다. 건축 표준 설계도구나 공식 설계 절차가 아니다.</p>
  <PromptCopyBlock id="lesson09-prompt-06" title="Graphviz(DOT) 코드 생성" description="검증된 공간·관계·동선만 DOT 코드로 변환한다." prompt={graphvizPrompt} />
  <details class="lesson09-code">
    <summary>실제 수업에서 사용한 DOT 코드 전체 보기</summary>
    <p>아래 코드는 제공된 실제 수업 실행본이다. 공간 관계와 숫자 표기를 그대로 사실로 승인하지 말고, 원도면 검증본과 대조한 뒤 사용한다.</p>
    <pre><code>{actualDotCode}</code></pre>
  </details>
</LessonSection>

<LessonSection id="section-12" number="12" title="2D 공간 관계 다이어그램 시각화" class="lesson09-section" {lessonId}>
  <div class="lesson09-tools">
    <a href="http://webgraphviz.com/" target="_blank" rel="noreferrer"><span>WEB TOOL</span><strong>WebGraphviz</strong><small>DOT 코드 붙여넣기</small></a>
    <a href="https://viz-js.com/" target="_blank" rel="noreferrer"><span>WEB TOOL</span><strong>Viz.js</strong><small>브라우저에서 그래프 렌더링</small></a>
  </div>
  <p class="lesson09-service-note">외부 서비스의 실행 상태와 화면은 변경될 수 있으므로 사용 시점에 확인한다.</p>
  <figure class="lesson09-figure lesson09-figure--diagram">
    <Image src={relationshipDiagram} alt="검증된 공간 관계 데이터를 노드와 연결선으로 시각화한 2D 공간 관계 다이어그램" widths={[720, 1080, 1440, 1896]} sizes="(max-width: 900px) 100vw, 1120px" loading="lazy" />
    <figcaption><strong>검증된 공간 관계 데이터를 시각화한 2D 공간 관계 다이어그램</strong><span>기능별 공간, 직접 연결, 인접 관계, 주요 동선과 외부 공간 접합을 보는 관계도다. 실제 평면도와 같은 형상·치수를 표현하는 도면이 아니다.</span></figcaption>
  </figure>
</LessonSection>

<LessonSection id="section-13" number="13" title="공간 관계 다이어그램 읽기" class="lesson09-section" {lessonId}>
  <div class="lesson09-legend">
    <article><span class="line line--solid"></span><h3>직접 연결</h3><p>문·개구부처럼 원도면에서 확인한 연결만 표시한다.</p></article>
    <article><span class="line line--dash"></span><h3>인접</h3><p>경계를 공유해도 직접 출입 관계가 확인되지 않으면 구분한다.</p></article>
    <article><span class="line line--arrow"></span><h3>주요 이동</h3><p>시작·경유·도착이 검증된 동선만 방향 관계로 표시한다.</p></article>
  </div>
  <p>공간 인접 관계 다이어그램(Adjacency Diagram)은 공간 사이의 연결을 단순화한다. 노드 위치는 실제 평면 위치나 거리, 면적을 의미하지 않는다.</p>
</LessonSection>

<LessonSection id="section-14" number="14" title="공간 관계에서 개념 조닝으로" class="lesson09-section" {lessonId}>
  <div class="lesson09-difference">
    <article><span>RELATIONSHIP DIAGRAM</span><h3>공간 관계 다이어그램</h3><p><strong>어떤 공간이 어떤 공간과 연결되거나 인접하는가?</strong></p><ul><li>개별 공간</li><li>직접 연결</li><li>인접</li><li>동선</li></ul></article>
    <article><span>CONCEPT ZONING</span><h3>개념 조닝(Concept Zoning)</h3><p><strong>각 공간을 어떤 기능 영역으로 묶을 수 있는가?</strong></p><ul><li>기능 그룹</li><li>영역 사이 관계</li><li>주요 이동</li><li>확인 필요 조건</li></ul></article>
  </div>
  <p class="lesson09-key"><strong>분석 결과를 그대로 이미지 생성 AI에 전달하지 않고, 작업 목적에 필요한 정보만 골라 생성 규칙으로 다시 정리한다.</strong></p>
  <ol class="lesson09-filter-flow"><li>분석 결과</li><li>조닝 정보 선택</li><li>기능 그룹 확정</li><li>관계를 조닝 규칙으로 변환</li><li>확인 불가 정리</li><li>GPT 전달</li></ol>
  <p>상세 바닥 단차, 계단참 레벨, 엘리베이터 정원, 벽체 마감, 가구, 재질과 조명은 원도면 검증에는 필요할 수 있지만 이번 조닝 입력에서는 제외한다.</p>
</LessonSection>

<LessonSection id="section-15" number="15" title="GPT 개념 조닝 · 구조 확인 후 제작" class="lesson09-section" {lessonId}>
  <PromptCopyBlock id="lesson09-prompt-07" title="GPT 개념 조닝 사전 구조 확인" description="다이어그램 생성 전에 기능 영역·관계·동선 표를 먼저 검토한다." prompt={zoningStructurePrompt} />
  <div class="lesson09-human-check"><span>HUMAN CHECK</span><strong>기능 분류와 관계를 사람이 확인</strong><i>→</i><strong>승인 후 최종 제작</strong></div>
  <PromptCopyBlock id="lesson09-prompt-08" title="확인된 구조로 개념 조닝 제작" description="사람이 확인한 구조를 변경하지 않는 최종 제작 지시다." prompt={zoningFinalPrompt} />
  <div class="lesson09-schematic" role="img" aria-label="업무, 회의 협업, 이동 공용, 지원 서비스, 위생, 외부 휴게 기능 영역을 단순화한 개념 설명용 도식">
    <p>개념 설명용 도식 · 실제 AI 생성 결과가 아님</p>
    <div>{functionGroups.map(([group, spaces]) => <article><strong>{group}</strong><span>{spaces}</span></article>)}</div>
  </div>
  <p class="lesson09-boundary">현재 자료 폴더에는 최종 GPT 개념 조닝 결과 이미지가 없다. 따라서 임의 결과 이미지를 만들지 않고, 기능 영역 표와 확인 후 제작 흐름까지만 제공한다.</p>
</LessonSection>

<LessonSection id="section-16" number="16" title="결과 정리와 제10차시 연결" class="lesson09-section" {lessonId}>
  <div class="lesson09-deliverables">
    <article><span>01</span><p>원본 평면도 분석과 도면 기준표</p></article>
    <article><span>02</span><p>Top View 3D 원도면 비교표</p></article>
    <article><span>03</span><p>검증된 공간 기능·인접 관계·동선 데이터</p></article>
    <article><span>04</span><p>Graphviz DOT 코드와 공간 관계 다이어그램</p></article>
    <article><span>05</span><p>개념 조닝 사전 구조와 최종 제작 지시</p></article>
  </div>
  <ul class="lesson09-final-boundary"><li>AI 분석 결과를 원도면 사실로 자동 확정하지 않는다.</li><li>Top View 3D는 실제 설계도면이나 정확한 3D 모델이 아니다.</li><li>관계 다이어그램과 개념 조닝은 실제 평면도 복원이 아니다.</li><li>확인되지 않는 치수·구조·법규·설비·시공성을 추정하지 않는다.</li></ul>
  <blockquote>제10차시에서는 원본 CAD/PDF 노이즈, 레이어 선택, 불필요한 치수·해치·주석 정리, 비식별화와 AI 인식용 Clean Plan 제작을 본격적으로 다룬다.</blockquote>
</LessonSection>

