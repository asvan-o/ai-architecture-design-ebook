---
import type { CollectionEntry } from 'astro:content';
import { getLessonTopicSummary } from '../../lib/lesson-topics';
import { formatCourseDuration } from '../../lib/duration';

interface Props {
  lesson: CollectionEntry<'lessons'>;
  first?: boolean;
}

const { lesson, first = false } = Astro.props;
const dayLabel = String(lesson.data.day).padStart(2, '0');
const topic = getLessonTopicSummary(dayLabel);
const dateLabel = lesson.data.date === 'pending'
  ? '일정 확인 예정'
  : lesson.data.date.replaceAll('-', '.');
const durationLabel = lesson.data.durationMinutes === null
  ? '수업시간 확인 예정'
  : formatCourseDuration(lesson.data.durationMinutes);
---

<article
  class:list={['print-lesson', { 'print-lesson--first': first }]}
  data-print-lesson-id={lesson.id}
>
  <header class="print-lesson__cover">
    {topic && (
      <div class="print-lesson__topic">
        <span>주제 {topic.number}</span>
        <strong>{topic.title}</strong>
      </div>
    )}
    <p>LESSON {dayLabel}</p>
    <h1 class="print-lesson__title">{lesson.data.title}</h1>
    <dl>
      <div><dt>날짜</dt><dd>{dateLabel}</dd></div>
      <div><dt>수업시간</dt><dd>{durationLabel}</dd></div>
    </dl>
  </header>
  <div class="print-lesson__content">
    <slot />
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('.print-lesson[data-print-lesson-id="01"]').forEach((root) => {
    const summary = root.querySelector('.lesson-summary-grid > div:first-child strong');
    if (summary?.textContent?.includes('총 180분')) summary.textContent = '3시간 수업';
    const toolLabel = root.querySelector('.lesson-tool-landscape__header > span');
    if (toolLabel?.textContent?.includes('분')) toolLabel.textContent = toolLabel.textContent.replace(/^\s*\d+분\s*/, '');
    const analysisLabel = root.querySelector('.lesson-classification-examples > header > span');
    if (analysisLabel?.textContent?.includes('분')) analysisLabel.textContent = analysisLabel.textContent.replace(/\s*·\s*\d+분\s*$/, '');
    root.querySelectorAll('.lesson-practice-block > header strong').forEach((label) => {
      if (label.textContent?.includes('분')) label.textContent = label.textContent.replace(/\s*·\s*\d+분\s*$/, '');
    });
  });
</script>
