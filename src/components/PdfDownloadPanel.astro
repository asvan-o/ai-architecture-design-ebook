---
import { withBase } from '../lib/site';

type DownloadItem = {
  href: string;
  label: string;
  meta: string;
};

interface Props {
  eyebrow?: string;
  items: DownloadItem[];
  compact?: boolean;
}

const {
  eyebrow = 'PRINTABLE PDF',
  items,
  compact = false,
} = Astro.props;
const downloadsEnabled =
  import.meta.env.PROD &&
  import.meta.env.PUBLIC_PDF_DOWNLOADS_ENABLED === 'true';
---

{downloadsEnabled && items.length > 0 && (
  <aside class:list={['pdf-download-panel', { 'pdf-download-panel--compact': compact }]}>
    <p>{eyebrow}</p>
    <div>
      {items.map((item) => (
        <a href={withBase(item.href)} download>
          <span>{item.label}</span>
          <small>{item.meta}</small>
          <strong aria-hidden="true">↓</strong>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .pdf-download-panel {
    display: grid;
    grid-template-columns: minmax(10rem, 0.28fr) 1fr;
    gap: 2rem;
    align-items: start;
    margin: 0 0 4rem;
    padding: 1.2rem;
    border: 1px solid var(--line-dark);
    background: var(--surface);
  }

  .pdf-download-panel--compact {
    margin: 0;
    border-width: 0 0 1px;
  }

  .pdf-download-panel > p {
    margin: 0;
    color: var(--accent-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .pdf-download-panel > div {
    display: grid;
    gap: 0.6rem;
  }

  .pdf-download-panel a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 1rem;
    align-items: center;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-dark);
    text-decoration: none;
  }

  .pdf-download-panel a:hover {
    background: var(--paper-deep);
  }

  .pdf-download-panel span {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .pdf-download-panel small {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .pdf-download-panel strong {
    grid-column: 2;
    grid-row: 1 / 3;
    font-size: 1.4rem;
  }

  @media (max-width: 620px) {
    .pdf-download-panel {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
