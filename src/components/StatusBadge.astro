---
import { getStatusMeta, type StatusKind } from '../lib/content-status';

interface Props {
  kind: StatusKind;
  value: string;
}

const { kind, value } = Astro.props;
const status = getStatusMeta(kind, value);
---

<span class:list={['status-badge', `status-badge--${status.tone}`]}>
  <span aria-hidden="true"></span>{status.label}
</span>
