---
import { getCourseProfiles } from '../../../scripts/course-registry.mjs';
import '../../styles/global.css';
const profiles = getCourseProfiles() as { course: { courseId: string; routeSlug: string; regionLabel: string; contentStatus: string } }[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>과정 선택 | AI Lecture 건축디자인</title>
  </head>
  <body>
    <main class="course-portal">
      <p class="eyebrow">AI LECTURE · ARCHITECTURE DESIGN</p>
      <h1>학습할 과정을<br />선택하세요.</h1>
      <p>과정별 강의자료와 안내를 확인할 수 있습니다.</p>
      <nav class="course-list" aria-label="강의 과정 선택">
        {profiles.map(({ course }) => (
          <a class="course-card" href={`${base}/${course.routeSlug}/`} data-course-link={course.courseId}>
            <span>{course.regionLabel}</span>
            <h2>{course.regionLabel} 과정</h2>
            <p>{course.contentStatus === 'approved' ? '강의자료 열기' : '과정 설계 중 · 안내 보기'}</p>
            <strong aria-hidden="true">→</strong>
          </a>
        ))}
      </nav>
    </main>
  </body>
</html>
<style>
  .course-portal{max-width:66rem;margin:auto;padding:clamp(2rem,7vw,6rem) 1.5rem}.course-portal h1{font-family:var(--serif);font-size:clamp(2.6rem,6vw,4.8rem);line-height:1.2}.course-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin-top:3rem}.course-card{position:relative;padding:2rem;border:1px solid var(--line-dark);background:var(--surface);text-decoration:none}.course-card h2{font-size:2rem}.course-card>span{color:var(--accent-dark)}.course-card strong{position:absolute;right:2rem;bottom:2rem}.course-card:hover{background:var(--paper-deep)}.course-card:focus-visible{outline:3px solid var(--accent);outline-offset:5px}@media(max-width:600px){.course-list{grid-template-columns:1fr}}
</style>
