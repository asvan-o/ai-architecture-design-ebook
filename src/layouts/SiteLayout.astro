---
import { mainNav, siteTitle, withBase } from '../lib/site';
import { getVisibleLessons } from '../lib/lessons';
import { getLessonTopics } from '../lib/lesson-topics';
import SearchPanel from '../components/SearchPanel';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: string;
  hideSidebar?: boolean;
}

const {
  title,
  description = '2026년 8월 AI 건축디자인 강의를 위한 학생용 웹 전자서적',
  section,
  hideSidebar = false,
} = Astro.props;
const lessons = await getVisibleLessons();
const lessonsById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
const topicGroups = getLessonTopics().map((topic) => ({
  topic,
  lessons: topic.lessonIds.flatMap((lessonId) => {
    const lesson = lessonsById.get(lessonId);
    return lesson ? [lesson] : [];
  }),
}));
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const currentLessonId = currentPath.match(/\/lessons\/(\d{2})/)?.[1];
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <title>{title} | {siteTitle}</title>
  </head>
  <body class:list={{ 'has-sidebar': !hideSidebar }}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="mobile-header">
      <a class="mobile-brand" href={withBase('/')}>
        <span>AI × ARCH</span>
        <strong>AI 건축디자인 바이블</strong>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-menu-open>
        <span aria-hidden="true">☰</span><span>목차</span>
      </button>
    </header>

    <aside class="site-sidebar" aria-label="전자서적 목차">
      <div class="sidebar-brand">
        <a href={withBase('/')}>
          <span class="eyebrow">2026 · STUDENT EDITION</span>
          <strong>AI 건축디자인<br />바이블</strong>
        </a>
        <p>48H COURSE READER</p>
      </div>
      <nav class="primary-nav" aria-label="주요 메뉴">
        {mainNav.map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{item.marker}</span>{item.label}
          </a>
        ))}
      </nav>
      <div class="sidebar-lessons">
        <p class="nav-label">TOPICS · 7 / LESSONS · 14</p>
        <nav aria-label="주제별 강의 차시">
          {topicGroups.map(({ topic, lessons: topicLessons }) => (
            <section class:list={['sidebar-topic', { 'is-current-topic': topic.lessonIds.includes(currentLessonId ?? '') }]}>
              <p class="sidebar-topic__heading">
                <span>주제 {topic.number}</span>
                <strong>{topic.title}</strong>
              </p>
              <div class="sidebar-topic__lessons">
                {topicLessons.map((lesson) => (
                  <a
                    href={withBase(`/lessons/${lesson.id}/`)}
                    aria-current={currentPath.includes(`/lessons/${lesson.id}`) ? 'page' : undefined}
                  >
                    <span>{String(lesson.data.day).padStart(2, '0')}</span>
                    <span>{lesson.data.title.replace(/^제\d+차시\s*·?\s*/, '')}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </nav>
      </div>
      <div class="sidebar-footer">
        <span>LAST UI UPDATE</span>
        <time datetime="2026-07-28">2026.07.28</time>
      </div>
    </aside>

    <dialog class="mobile-menu" id="mobile-navigation" data-mobile-menu>
      <div class="mobile-menu__header">
        <strong>전체 목차</strong>
        <button type="button" class="icon-button" aria-label="목차 닫기" data-menu-close>×</button>
      </div>
      <nav aria-label="모바일 주요 메뉴">
        {mainNav.map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{item.marker}</span>{item.label}
          </a>
        ))}
      </nav>
      <p class="nav-label">주제 7개 · 차시 14개</p>
      <nav class="mobile-lessons" aria-label="모바일 주제별 강의 차시">
        {topicGroups.map(({ topic, lessons: topicLessons }) => (
          <section class:list={['mobile-topic', { 'is-current-topic': topic.lessonIds.includes(currentLessonId ?? '') }]}>
            <p class="mobile-topic__heading">
              <span>주제 {topic.number}</span>
              <strong>{topic.title}</strong>
            </p>
            <div>
              {topicLessons.map((lesson) => (
                <a
                  href={withBase(`/lessons/${lesson.id}/`)}
                  aria-current={currentPath.includes(`/lessons/${lesson.id}`) ? 'page' : undefined}
                >
                  <span>{String(lesson.data.day).padStart(2, '0')}</span>
                  <span>{lesson.data.title.replace(/^제\d+차시\s*·?\s*/, '')}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </nav>
    </dialog>

    <main id="main-content" class:list={['site-main', { 'site-main--wide': hideSidebar }]}>
      <div class="utility-bar">
        <p><span>AI ARCHITECTURE DESIGN BIBLE</span><span aria-hidden="true">/</span><strong>{section ?? title}</strong></p>
        <SearchPanel client:idle searchUrl={withBase('/search-index.json')} />
      </div>
      <slot />
      <footer class="site-footer">
        <p>{siteTitle}</p>
        <p>학생용 웹 전자서적 · UI 골격</p>
        <a href="#main-content">맨 위로 ↑</a>
      </footer>
    </main>

    <script>
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      const updateProgress = () => {
        if (!progress) return;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = height > 0 ? Math.min(window.scrollY / height, 1) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);

      const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
      const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
      const closeMenu = () => {
        if (dialog?.open) dialog.close();
      };
      const handleMenuClosed = () => {
        openButton?.setAttribute('aria-expanded', 'false');
        openButton?.focus();
      };
      openButton?.addEventListener('click', () => {
        if (!dialog?.open) dialog?.showModal();
        openButton.setAttribute('aria-expanded', 'true');
        closeButton?.focus();
      });
      closeButton?.addEventListener('click', closeMenu);
      dialog?.addEventListener('close', handleMenuClosed);
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) closeMenu();
      });
    </script>
  </body>
</html>
