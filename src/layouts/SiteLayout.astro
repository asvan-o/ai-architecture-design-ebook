---
import { mainNav, siteTitle, withBase } from '../lib/site';
import { getVisibleLessons } from '../lib/lessons';
import { getLessonTopics } from '../lib/lesson-topics';
import SearchPanel from '../components/SearchPanel';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: string;
  hideSidebar?: boolean;
}

const {
  title,
  description = '2026년 8월 AI 건축디자인 강의를 위한 학생용 웹 전자서적',
  section,
  hideSidebar = false,
} = Astro.props;
const lessons = await getVisibleLessons();
const lessonsById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
const topicGroups = getLessonTopics().map((topic) => ({
  topic,
  lessons: topic.lessonIds.flatMap((lessonId) => {
    const lesson = lessonsById.get(lessonId);
    return lesson ? [lesson] : [];
  }),
})).filter(({ lessons: topicLessons }) => topicLessons.length > 0);
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const currentLessonId = currentPath.match(/\/lessons\/(\d{2})/)?.[1];
const currentLesson = currentLessonId ? lessonsById.get(currentLessonId) : undefined;
const currentLocationLabel = currentLesson
  ? `제${currentLesson.data.day}차시`
  : currentPath.startsWith('/course-overview')
    ? '과정 안내'
    : section ?? title;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <title>{title} | {siteTitle}</title>
  </head>
  <body class:list={{ 'has-sidebar': !hideSidebar }}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="mobile-header">
      <a class="mobile-brand" href={withBase('/')}>
        <span>AI × ARCH</span>
        <strong>AI 건축디자인 바이블</strong>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-menu-open>
        <span aria-hidden="true">☰</span><span>목차</span>
      </button>
    </header>

    <aside class="site-sidebar" aria-label="전자서적 목차">
      <div class="sidebar-brand">
        <a href={withBase('/')}>
          <span class="eyebrow">2026 · STUDENT EDITION</span>
          <strong>AI 건축디자인<br />바이블</strong>
        </a>
        <p>48H COURSE READER</p>
        <button
          type="button"
          class="sidebar-toggle sidebar-toggle--collapse"
          aria-label="왼쪽 목차 접기"
          aria-expanded="true"
          aria-controls="desktop-navigation"
          data-sidebar-collapse
        >
          <span aria-hidden="true">←</span><span>목차 접기</span>
        </button>
      </div>
      <div id="desktop-navigation">
      <nav class="primary-nav" aria-label="주요 메뉴">
        {mainNav.map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{item.marker}</span>{item.label}
          </a>
        ))}
      </nav>
      <div class="sidebar-lessons">
        <p class="nav-label">TOPICS · {topicGroups.length} / LESSONS · {lessons.length}</p>
        <nav aria-label="주제별 강의 차시">
          {topicGroups.map(({ topic, lessons: topicLessons }) => (
            <section class:list={['sidebar-topic', { 'is-current-topic': topic.lessonIds.includes(currentLessonId ?? '') }]}>
              <p class="sidebar-topic__heading">
                <span>주제 {topic.number}</span>
                <strong>{topic.title}</strong>
              </p>
              <div class="sidebar-topic__lessons">
                {topicLessons.map((lesson) => (
                  <>
                    <a
                      href={withBase(`/lessons/${lesson.id}/`)}
                      aria-current={currentPath.includes(`/lessons/${lesson.id}`) ? 'page' : undefined}
                    >
                      <span>{String(lesson.data.day).padStart(2, '0')}</span>
                      <span>{lesson.data.title.replace(/^제\d+차시\s*·?\s*/, '')}</span>
                    </a>
                    {currentLessonId === lesson.id && (
                      <nav class="current-lesson-toc" aria-label={`제${lesson.data.day}차시 내부 목차`} data-current-lesson-toc="desktop" hidden>
                        <p>현재 차시 목차</p>
                        <ol data-current-lesson-toc-list></ol>
                      </nav>
                    )}
                  </>
                ))}
              </div>
            </section>
          ))}
        </nav>
      </div>
      <div class="sidebar-footer">
        <span>LAST UI UPDATE</span>
        <time datetime="2026-07-28">2026.07.28</time>
      </div>
      </div>
    </aside>

    <dialog class="mobile-menu" id="mobile-navigation" data-mobile-menu>
      <div class="mobile-menu__header">
        <strong>전체 목차</strong>
        <button type="button" class="icon-button" aria-label="목차 닫기" data-menu-close>×</button>
      </div>
      <nav aria-label="모바일 주요 메뉴">
        {mainNav.map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{item.marker}</span>{item.label}
          </a>
        ))}
      </nav>
      <p class="nav-label">주제 {topicGroups.length}개 · 차시 {lessons.length}개</p>
      <nav class="mobile-lessons" aria-label="모바일 주제별 강의 차시">
        {topicGroups.map(({ topic, lessons: topicLessons }) => (
          <section class:list={['mobile-topic', { 'is-current-topic': topic.lessonIds.includes(currentLessonId ?? '') }]}>
            <p class="mobile-topic__heading">
              <span>주제 {topic.number}</span>
              <strong>{topic.title}</strong>
            </p>
            <div>
              {topicLessons.map((lesson) => (
                <>
                  <a
                    href={withBase(`/lessons/${lesson.id}/`)}
                    aria-current={currentPath.includes(`/lessons/${lesson.id}`) ? 'page' : undefined}
                  >
                    <span>{String(lesson.data.day).padStart(2, '0')}</span>
                    <span>{lesson.data.title.replace(/^제\d+차시\s*·?\s*/, '')}</span>
                  </a>
                  {currentLessonId === lesson.id && (
                    <nav class="current-lesson-toc current-lesson-toc--mobile" aria-label={`제${lesson.data.day}차시 내부 목차`} data-current-lesson-toc="mobile" hidden>
                      <p>현재 차시 목차</p>
                      <ol data-current-lesson-toc-list></ol>
                    </nav>
                  )}
                </>
              ))}
            </div>
          </section>
        ))}
      </nav>
    </dialog>

    <main id="main-content" class:list={['site-main', { 'site-main--wide': hideSidebar }]}>
      <div class="utility-bar">
        <div class="utility-bar__location">
          <button
            type="button"
            class="sidebar-toggle sidebar-toggle--expand"
            aria-label={`왼쪽 목차 펼치기 · 현재 위치 ${currentLocationLabel}`}
            aria-expanded="false"
            aria-controls="desktop-navigation"
            data-sidebar-expand
          ><span aria-hidden="true">☰</span><span>목차 열기</span></button>
          <p><span>AI ARCHITECTURE DESIGN BIBLE</span><span aria-hidden="true">/</span><strong>{section ?? title}</strong></p>
        </div>
        <SearchPanel client:idle searchUrl={withBase('/search-index.json')} />
      </div>
      <slot />
      <footer class="site-footer">
        <p>{siteTitle}</p>
        <p>학생용 웹 전자서적 · UI 골격</p>
        <a href="#main-content">맨 위로 ↑</a>
      </footer>
    </main>

    <script>
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      const updateProgress = () => {
        if (!progress) return;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = height > 0 ? Math.min(window.scrollY / height, 1) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);

      const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
      const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
      const closeMenu = () => {
        if (dialog?.open) dialog.close();
      };
      let revealActiveLessonSection = () => {};
      const handleMenuClosed = () => {
        openButton?.setAttribute('aria-expanded', 'false');
        document.documentElement.removeAttribute('data-mobile-menu-open');
        openButton?.focus({ preventScroll: true });
      };
      openButton?.addEventListener('click', () => {
        if (!dialog?.open) dialog?.showModal();
        openButton.setAttribute('aria-expanded', 'true');
        document.documentElement.setAttribute('data-mobile-menu-open', 'true');
        closeButton?.focus();
        window.requestAnimationFrame(revealActiveLessonSection);
      });
      closeButton?.addEventListener('click', closeMenu);
      dialog?.addEventListener('close', handleMenuClosed);
      dialog?.addEventListener('cancel', () => closeMenu());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) closeMenu();
      });
      dialog?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

      const lessonSections = Array.from(
        document.querySelectorAll<HTMLElement>('.lesson-content [data-lesson-section][id]'),
      );
      const currentLessonTocs = Array.from(
        document.querySelectorAll<HTMLElement>('[data-current-lesson-toc]'),
      );

      if (lessonSections.length > 1 && currentLessonTocs.length > 0) {
        const linksBySection = new Map<string, HTMLAnchorElement[]>();

        currentLessonTocs.forEach((toc) => {
          const list = toc.querySelector<HTMLOListElement>('[data-current-lesson-toc-list]');
          if (!list) return;
          list.replaceChildren();

          lessonSections.forEach((section, index) => {
            const sectionId = section.id;
            const number = section.dataset.sectionNumber
              ?? String(index + 1).padStart(2, '0');
            const title = section.dataset.sectionTitle
              ?? section.querySelector('h2')?.textContent?.trim()
              ?? `섹션 ${number}`;
            const item = document.createElement('li');
            const link = document.createElement('a');
            const numberLabel = document.createElement('span');
            const titleLabel = document.createElement('span');

            link.href = `#${sectionId}`;
            link.dataset.lessonSectionLink = sectionId;
            numberLabel.textContent = number;
            titleLabel.textContent = title;
            link.append(numberLabel, titleLabel);
            link.addEventListener('click', () => {
              setActiveSection(sectionId, false);
              if (toc.closest('[data-mobile-menu]')) {
                closeMenu();
                window.requestAnimationFrame(() => section.scrollIntoView({ block: 'start' }));
              }
            });
            item.append(link);
            list.append(item);
            linksBySection.set(sectionId, [...(linksBySection.get(sectionId) ?? []), link]);
          });

          toc.hidden = false;
        });

        let activeSectionId = '';
        const setActiveSection = (sectionId: string, reveal = true) => {
          if (!linksBySection.has(sectionId)) return;
          activeSectionId = sectionId;
          linksBySection.forEach((links, id) => {
            links.forEach((link) => {
              if (id === sectionId) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          });
          if (!reveal) return;
          const visibleLink = linksBySection.get(sectionId)?.find((link) => link.offsetParent !== null);
          visibleLink?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        };

        revealActiveLessonSection = () => {
          if (activeSectionId) setActiveSection(activeSectionId);
        };

        const sectionAtHash = () => {
          const hashId = decodeURIComponent(window.location.hash.replace(/^#/, ''));
          return linksBySection.has(hashId) ? hashId : '';
        };
        setActiveSection(sectionAtHash() || lessonSections[0].id, false);
        window.addEventListener('hashchange', () => {
          const hashId = sectionAtHash();
          if (hashId) setActiveSection(hashId);
        });

        const visibleSections = new Set<string>();
        const sectionObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visibleSections.add(entry.target.id);
            else visibleSections.delete(entry.target.id);
          });
          const activationLine = window.innerHeight * 0.1;
          const nextActive = lessonSections
            .filter((section) => visibleSections.has(section.id))
            .sort((a, b) => (
              Math.abs(a.getBoundingClientRect().top - activationLine)
              - Math.abs(b.getBoundingClientRect().top - activationLine)
            ))[0];
          if (nextActive) setActiveSection(nextActive.id);
        }, {
          rootMargin: '-10% 0px -72% 0px',
          threshold: [0, 0.01],
        });
        lessonSections.forEach((section) => sectionObserver.observe(section));
      }

      const sidebarStorageKey = 'ai-architecture-ebook-sidebar-v1';
      const collapseButton = document.querySelector<HTMLButtonElement>('[data-sidebar-collapse]');
      const expandButton = document.querySelector<HTMLButtonElement>('[data-sidebar-expand]');
      const applySidebarState = (collapsed: boolean) => {
        document.documentElement.dataset.sidebarState = collapsed ? 'collapsed' : 'expanded';
        collapseButton?.setAttribute('aria-expanded', String(!collapsed));
        expandButton?.setAttribute('aria-expanded', String(!collapsed));
      };
      const storedSidebarState = localStorage.getItem(sidebarStorageKey);
      applySidebarState(storedSidebarState === 'collapsed');
      collapseButton?.addEventListener('click', () => {
        localStorage.setItem(sidebarStorageKey, 'collapsed');
        applySidebarState(true);
        expandButton?.focus();
      });
      expandButton?.addEventListener('click', () => {
        localStorage.setItem(sidebarStorageKey, 'expanded');
        applySidebarState(false);
        collapseButton?.focus();
      });
    </script>
  </body>
</html>
