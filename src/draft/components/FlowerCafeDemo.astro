---
import {flowerCafe} from '../../../scripts/daejeon-gwangju-reuse.mjs';
import ReviewPrompt from './ReviewPrompt.astro';
import Lesson01Image from './Lesson01Image.astro';
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const href=(image:{file:string;outputPath?:string})=>base+'/'+(image.outputPath||'practice/GW-L02/'+image.file);
const stages=[
  {title:'① 기준 빈 공간',image:flowerCafe.before,description:'첨부할 원본 빈 상업공간의 역할입니다. 창호·출입구·바닥·카메라를 먼저 확인합니다.'},
  {title:'② 짧은 한 줄 요청 결과',image:flowerCafe.original,description:'초기 생성 · 꽃과 가구가 밀집해 동선과 사용 목적을 다시 확인할 단계입니다.'},
  {title:'③ 구조화 수정 요청 결과',image:flowerCafe.revised,description:'수정 완료 예시 · 동선·조명·재질이 요청 조건에 맞게 정리됐는지 비교합니다.'},
];
---
<div id="flower-cafe-demo" data-flower-cafe-demo>
  <h3>플라워 카페 · 빈 공간에서 요청과 수정 결과까지</h3>
  <p>기준 공간 → 짧은 요청 결과 → 조건을 더한 수정 결과의 역할을 나란히 봅니다.</p>
  {enabled ? <div class="review-cards" data-flower-cafe-comparison>
    {stages.map((stage,index)=><figure class="review-card">
      <h4>{stage.title}</h4><Lesson01Image id={'flower-stage-'+index} src={href(stage.image)} alt={stage.image.alt} />
      <figcaption>{stage.image.caption}</figcaption><p>{stage.description}</p>
      <a class="review-download" href={href(stage.image)} download={stage.image.file}>이미지 개별 다운로드</a>
    </figure>)}
  </div> : <p class="review-callout">실습 이미지는 제공된 자료에서 확인합니다.</p>}
  <p class="review-source-list">빈 공간은 기존 두 결과의 건축 골격과 시점을 참고해 새로 재구성한 교육용 이미지입니다. 과거 최초 생성에 실제로 입력했던 원본을 복원한 기록은 아닙니다. 두 결과는 기존 교육용 생성 예시이며 실제 현장 사진·실측 자료가 아닙니다.</p>
  <h4>짧은 요청에서 빠진 조건 읽기</h4><blockquote>{flowerCafe.originalPrompt}</blockquote>
  <ul><li>사람·상호·문자가 요청에 필요한가?</li><li>꽃 판매와 카페 이용 동선이 함께 읽히는가?</li><li>유지·변경할 요소와 이미지로 확인할 수 없는 실제 조건은 무엇인가?</li></ul>
  <ReviewPrompt id="flower-cafe-revision" title="플라워 카페 예시 · 수정 요청" prompt={flowerCafe.revisionPrompt} href={enabled?base+'/practice/GW-L02/03-revision-prompt.txt':undefined} filename="03-revision-prompt.txt" />
  <p>{flowerCafe.comparison}</p><aside class="review-callout"><strong>{flowerCafe.learningPoint}</strong><p>{flowerCafe.caution}</p></aside>
</div>
