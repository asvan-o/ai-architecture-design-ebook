---
interface Props{before:{outputPath:string;width:number;height:number};after:{outputPath:string};id:string;title:string;}
const{before,after,id,title}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
---
{enabled&&<div class="plan-overlay" data-plan-overlay>
 <h3>{title}</h3><div class="plan-overlay-images"><img src={base+'/'+before.outputPath} alt={title+' · 원본'} width={before.width} height={before.height} loading="lazy" /><img data-overlay-layer src={base+'/'+after.outputPath} alt={title+' · 수정본 중첩'} width={before.width} height={before.height} loading="lazy" style="opacity:0.5" /></div>
 <label for={id}>수정본 겹침 강도 <output data-overlay-value for={id}>50%</output></label><input id={id} type="range" min="0" max="100" value="50" data-overlay-opacity />
 <p>왼쪽 끝은 원본, 오른쪽 끝은 수정본입니다. 경계·문폭·개폐호·치수·문자의 위치를 대조합니다.</p>
</div>}
<script>document.querySelectorAll<HTMLElement>('[data-plan-overlay]').forEach(root=>{const range=root.querySelector<HTMLInputElement>('[data-overlay-opacity]')!,layer=root.querySelector<HTMLElement>('[data-overlay-layer]')!,value=root.querySelector<HTMLOutputElement>('[data-overlay-value]')!;range.addEventListener('input',()=>{layer.style.opacity=String(Number(range.value)/100);value.value=range.value+'%';});});</script>
<style>.plan-overlay{min-width:0;margin:1rem 0;padding:1rem;border:1px solid var(--line-dark);background:white}.plan-overlay-images{position:relative}.plan-overlay img{display:block;width:100%;height:auto}.plan-overlay [data-overlay-layer]{position:absolute;inset:0}.plan-overlay input{width:100%;min-width:0}.plan-overlay label{display:block;margin:.8rem 0}output{font-weight:700}</style>
