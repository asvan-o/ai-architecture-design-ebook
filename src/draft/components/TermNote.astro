---
import {workbookGlossary, sectionTermNotes} from '../content/workbook-glossary';
import {glossaryLessonKey} from '../content/workbook-glossary-ui';
interface Props {sectionId: string;}
const {sectionId}=Astro.props;
const lessonKey=glossaryLessonKey(Astro.url.pathname);
const noteKey=lessonKey?`${lessonKey}:${sectionId}`:undefined;
const ids=noteKey?(sectionTermNotes as Record<string,readonly string[]>)[noteKey]??[]:[];
const terms=ids.map(id=>{
  const term=workbookGlossary.find(term=>term.id===id);
  if(!term)throw new Error(`용어 주석의 사전 항목이 없습니다: ${noteKey} / ${id}`);
  return term;
});
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const titleId=`term-note-${lessonKey}-${sectionId}`;
---
{terms.length>0&&<aside class="term-note" aria-labelledby={titleId} data-term-note={noteKey}>
  <p class="term-note-heading" id={titleId}><span aria-hidden="true">💡</span> 용어 주석</p>
  <ul>{terms.map(term=><li data-term-note-id={term.id}>
    <a href={`${base}/glossary/#${term.id}`} class="term-note-link">{term.korean}<span class="term-note-english"> · {term.acronym||term.english}</span><span class="term-note-link-hint"> 용어 사전 ↗</span></a>
    <p>{term.definition}</p>
  </li>)}</ul>
</aside>}
<style>
 .term-note{margin:0 0 1.1rem;padding:.85rem 1rem;border:1px solid var(--line);border-left:3px solid var(--accent-dark);background:var(--paper-deep);font-size:.86rem;line-height:1.65;overflow-wrap:anywhere;min-width:0;break-inside:avoid-page}
 .term-note .term-note-heading{margin:0 0 .4rem;font-size:.77rem;font-weight:800;color:var(--accent-dark)}
 .term-note ul{list-style:none;margin:0;padding:0}.term-note li+li{margin-top:.55rem;padding-top:.55rem;border-top:1px solid var(--line)}
 .term-note-link{font-weight:700;text-decoration:none}.term-note-english{font-size:.82em;font-weight:400}.term-note-link-hint{font-size:.72em;font-weight:400;white-space:nowrap}
 .term-note li p{margin:.15rem 0 0}.term-note-link:focus-visible{outline:2px solid var(--accent-dark);outline-offset:3px}
 @media print{.term-note{padding:7pt 9pt;margin:0 0 9pt;border-left-width:2pt;font-size:8.2pt;line-height:1.55;background:#f5f4ef;break-inside:avoid-page}.term-note-link{color:inherit}.term-note-link-hint{display:none}.term-note a[href]::after{content:none!important}}
</style>
