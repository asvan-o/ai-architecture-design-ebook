---
import {humanizeLegalText, beginnerWorkflow} from '../content/lesson10-beginner';
import LessonSection from './GwangjuLegalSection.astro';
import PromptCopyBlock from './GwangjuLegalPrompt.astro';
import {lesson10Prompts} from '../content/gwangju-legal/lesson10-grounded-legal-review';
import {
  b00ReviewChecks,
  crossValidationRisks,
  humanReviewChecks,
  lesson11Prompts,
  lesson11TimePlan,
  loopStopChecks,
} from '../content/gwangju-legal/lesson11-legal-cross-validation';

interface Props {
  lessonId: string;
  selectedSections: readonly string[];
  sectionMap: Record<string,{id:string;index:number;title:string;minutes:number}>;
  timePlan?: readonly {
    label: string;
    minutes: number;
    mode: 'guide' | 'practice' | 'review';
  }[];
}

const { lessonId, timePlan = lesson11TimePlan, selectedSections, sectionMap } = Astro.props;
const promptById = new Map(lesson11Prompts.map((prompt) => [prompt.id, prompt]));
const getPrompt = (id: string) => {
  const prompt = promptById.get(id);
  if (!prompt) throw new Error(`Lesson 11 prompt not found: ${id}`);
  return prompt;
};
const promptContextLabels = [
  ['now', '지금 무엇을 하는가'],
  ['why', '왜 하는가'],
  ['inputs', '사용할 파일·Source'],
  ['output', '결과를 어디에 쓰는가'],
  ['caution', '주의할 점'],
] as const;
const rolePrompt = getPrompt('lesson11-prompt-01');
const researchPrompt = getPrompt('lesson11-prompt-02');
const checklistPrompt = getPrompt('lesson11-prompt-03');
const baseChecklistPrompt=lesson10Prompts.find(p=>p.id==='lesson10-prompt-b02')!;
const crossCheckPrompt = getPrompt('lesson11-prompt-04');
const revisePrompt = getPrompt('lesson11-prompt-05');
const recheckPrompt = getPrompt('lesson11-prompt-06');
---

<div class="lesson11-cross-validation" data-lesson11-cross-validation>
  {selectedSections.includes('01')&&<><LessonSection id={sectionMap['gw11-01'].id} number={String(sectionMap['gw11-01'].index).padStart(2,'0')} minutes={sectionMap['gw11-01'].minutes} title={sectionMap['gw11-01'].title} lessonId={lessonId}>
    <div class="hero-card">
      <p class="eyebrow">REPRODUCE · CROSS-VALIDATE · HUMAN REVIEW</p>
      <h3>제10차시의 법규검토 준비 과정을 처음부터 다시 따라 해본다.</h3>
      <p>새로운 AI 기능을 배우는 차시가 아니다. 프로젝트 사실과 공식 근거를 분리하고 서로 다른 경로로 반복 검증하는 순서를 혼자 재현하는 실습이다.</p>
    </div>
    <blockquote class="key-message">
      자료를 정리하고, 근거를 찾고, 서로 다른 AI로 반복 검증하되 최종 판단은 사람이 한다.
    </blockquote>
    <ol class="workflow" aria-label="제10차시 전체 법규검토 워크플로우">
      {beginnerWorkflow.map((step, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong>{index===0&&<small>A01~A07</small>}{index===2&&<small>조건 기준서의 내용은 그대로 전달</small>}</li>
      ))}
    </ol>
  </LessonSection></>}

  {selectedSections.includes('02')&&<><LessonSection id={sectionMap['gw11-02'].id} number={String(sectionMap['gw11-02'].index).padStart(2,'0')} minutes={sectionMap['gw11-02'].minutes} title={sectionMap['gw11-02'].title} lessonId={lessonId}>
    <div class="role-grid">
      <article class="role-card role-card--a">
        <span>NOTEBOOK A</span>
        <h3>우리 프로젝트의 조건은 무엇인가?</h3>
        <ul>
          <li>프로젝트 원자료의 역할과 우선순위 분류</li>
          <li>확정 · 계획조건 · 미확정 · 추가 확인 필요 구분</li>
          <li>자료 간 충돌과 누락 확인</li>
          <li>노트북 B로 옮긴 프로젝트 조건 기준서(B00) 제작</li>
        </ul>
      </article>
      <article class="role-card">
        <span>NOT THIS</span>
        <h3>NotebookLM A는 법규 판단용 Notebook이 아니다.</h3>
        <p>법규 결론을 만들기 전에 프로젝트 원자료의 사실관계를 정리하는 공간이다. 이번 차시에서는 제10차시에서 만든 노트북 B로 옮긴 조건 기준서(B00)의 상태만 짧게 다시 확인한다.</p>
      </article>
    </div>
  </LessonSection></>}

  {selectedSections.includes('03')&&<><LessonSection id={sectionMap['gw11-03'].id} number={String(sectionMap['gw11-03'].index).padStart(2,'0')} minutes={sectionMap['gw11-03'].minutes} title={sectionMap['gw11-03'].title} lessonId={lessonId}>
    <div class="definition-card">
      <span>PROJECT GROUNDED REFERENCE</span>
      <h3>노트북 B로 옮긴 조건 기준서(B00)은 법규가 아니라 프로젝트 조건의 기준점이다.</h3>
      <p>원자료를 검증·정리하여 이후 법규 조사와 검토에 사용하는 문서다. AI가 확정·계획조건·미확정·추가 확인 필요 상태를 임의로 바꾸면 안 된다.</p>
    </div>
    <ul class="check-grid" data-lesson11-b00-checks>
      {b00ReviewChecks.map((item) => <li><span aria-hidden="true">□</span><strong>{humanizeLegalText(item)}</strong></li>)}
    </ul>
  </LessonSection></>}

  {selectedSections.includes('04')&&<><LessonSection id={sectionMap['gw11-04'].id} number={String(sectionMap['gw11-04'].index).padStart(2,'0')} minutes={sectionMap['gw11-04'].minutes} title={sectionMap['gw11-04'].title} lessonId={lessonId}>
    <div class="prep-grid">
      <article><span>01</span><h3>작업 공간</h3><p>ChatGPT에서 <strong>건축 프로젝트 법규검토</strong>라는 프로젝트 또는 동일 목적의 대화를 준비한다.</p></article>
      <article><span>02</span><h3>핵심 파일</h3><p>처음에는 프로젝트 원자료 전체가 아니라 <strong>노트북 B로 옮긴 프로젝트 조건 기준서(B00)</strong>를 핵심 파일로 사용한다.</p></article>
      <article><span>03</span><h3>지속할 맥락</h3><p>역할 설정, 공식 근거자료 후보, 체크리스트 검증과 재검증 기록을 한 작업 맥락에서 이어간다.</p></article>
    </div>
    <aside class="service-note">
      <strong>무료 환경 안내</strong>
      <p>무료 계정은 파일 업로드 및 사용량에 제한이 있을 수 있으므로 핵심 파일 중심으로 작업합니다. 프로젝트 기능이나 파일 업로드 가능 여부는 계정과 서비스 환경에 따라 다를 수 있으며, 특정 메뉴 이름보다 필요한 기능의 사용 가능 여부를 기준으로 진행합니다.</p>
    </aside>
  </LessonSection></>}

  {selectedSections.includes('05')&&<><LessonSection id={sectionMap['gw11-05'].id} number={String(sectionMap['gw11-05'].index).padStart(2,'0')} minutes={sectionMap['gw11-05'].minutes} title={sectionMap['gw11-05'].title} lessonId={lessonId}>
    <p class="section-lead">GPT에게 단순히 “법규를 검토해줘”라고 명령하면 프로젝트 분석, 법규 조사, 적합성 판단을 한 번에 수행하려 할 수 있다. 이번 워크플로우에서는 GPT를 외부 법규 조사 및 검증 보조자로 제한한다.</p>
    <dl class="prompt-context" data-lesson11-prompt-context={rolePrompt.id}>
      {promptContextLabels.map(([key, label]) => <div><dt>{label}</dt><dd>{humanizeLegalText(rolePrompt.context[key])}</dd></div>)}
    </dl>
    <PromptCopyBlock {...rolePrompt} />
  </LessonSection></>}

  {selectedSections.includes('06')&&<><LessonSection id={sectionMap['gw11-06'].id} number={String(sectionMap['gw11-06'].index).padStart(2,'0')} minutes={sectionMap['gw11-06'].minutes} title={sectionMap['gw11-06'].title} lessonId={lessonId}>
    <div class="stage-banner"><span>RESEARCH FIRST</span><strong>이 단계에서는 아직 체크리스트를 만들지 않는다.</strong><p>목적은 “이 프로젝트를 검토하기 위해 어떤 공식 법규 Source가 필요한지 찾기”다.</p></div>
    <dl class="prompt-context" data-lesson11-prompt-context={researchPrompt.id}>
      {promptContextLabels.map(([key, label]) => <div><dt>{label}</dt><dd>{humanizeLegalText(researchPrompt.context[key])}</dd></div>)}
    </dl>
    <PromptCopyBlock {...researchPrompt} />
  </LessonSection></>}

  {selectedSections.includes('07')&&<><LessonSection id={sectionMap['gw11-07'].id} number={String(sectionMap['gw11-07'].index).padStart(2,'0')} minutes={sectionMap['gw11-07'].minutes} title={sectionMap['gw11-07'].title} lessonId={lessonId}>
    <blockquote class="source-warning">ChatGPT 답변 ≠ 법적 근거 근거자료</blockquote>
    <div class="flow-strip" aria-label="공식 법규 근거자료 확보 흐름">
      <strong>GPT가 필요한 법규를 찾음</strong><span>→</span><strong>공식 페이지 확인</strong><span>→</span><strong>공식 원문 근거자료 확보</strong><span>→</span><strong>NotebookLM B에 추가</strong>
    </div>
    <div class="official-grid">
      <article><h3>우선 확인할 곳</h3><p>국가법령정보센터, 해당 지방자치단체의 공식 자치법규, 정부·공공기관의 공식 원문을 우선한다.</p></article>
      <article><h3>사람이 기록할 것</h3><p>법령명, 관련 조항, 시행 상태, 적용 이유, 확인 날짜와 공식 URL을 남긴다.</p></article>
      <article><h3>근거로 쓰지 않을 것</h3><p>GPT의 요약 문장, 블로그·카페·홍보성 게시글을 최종 법적 근거로 사용하지 않는다.</p></article>
      <article class="official-links">
        <h3>공식 원문 확인</h3>
        <a href="https://www.law.go.kr/" target="_blank" rel="noreferrer">국가법령정보센터</a>
        <a href="https://www.elis.go.kr/" target="_blank" rel="noreferrer">자치법규정보시스템</a>
        <p>검색 결과의 법령명·시행일·소관기관과 자치단체를 다시 확인한다.</p>
      </article>
    </div>
  </LessonSection></>}

  {selectedSections.includes('08')&&<><LessonSection id={sectionMap['gw11-08'].id} number={String(sectionMap['gw11-08'].index).padStart(2,'0')} minutes={sectionMap['gw11-08'].minutes} title={sectionMap['gw11-08'].title} lessonId={lessonId}>
    <div class="source-equation" aria-label="NotebookLM B 기본 근거자료 구성">
      <article><span>PROJECT CONDITION</span><strong>노트북 B로 옮긴 프로젝트 조건 기준서(B00)</strong></article><b>+</b><article><span>LEGAL EVIDENCE</span><strong>확인한 공식 법규 근거자료</strong></article>
    </div>
    <aside class="boundary-box">
      <h3>왜 원자료 전체를 다시 넣지 않는가</h3>
      <p>NotebookLM A에서 원자료의 역할·우선순위·충돌·확정 여부를 이미 분석해 노트북 B로 옮긴 조건 기준서(B00)으로 정리했다. 원자료 전체를 NotebookLM B에 다시 넣으면 프로젝트 조건을 다시 해석해 NotebookLM A와 다른 판단을 만들 수 있다.</p>
      <div class="mini-flow"><span>원자료</span><i>→</i><span>NotebookLM A</span><i>→</i><span>노트북 B로 옮긴 조건 기준서(B00)</span><i>→</i><span>NotebookLM B</span></div>
    </aside>
  </LessonSection></>}

  {selectedSections.includes('09')&&<><LessonSection id={sectionMap['gw11-09'].id} number={String(sectionMap['gw11-09'].index).padStart(2,'0')} minutes={sectionMap['gw11-09'].minutes} title={sectionMap['gw11-09'].title} lessonId={lessonId}>
    <div class="role-legend"><span><b>노트북 B로 옮긴 조건 기준서(B00)</b> 프로젝트 조건</span><span><b>공식 근거자료</b> 법규 판단 근거</span></div>
    <dl class="prompt-context" data-lesson11-prompt-context={checklistPrompt.id}>
      {promptContextLabels.map(([key, label]) => <div><dt>{label}</dt><dd>{humanizeLegalText(checklistPrompt.context[key])}</dd></div>)}
    </dl>
    <PromptCopyBlock {...baseChecklistPrompt} />
    <PromptCopyBlock {...checklistPrompt} />
  </LessonSection></>}

  {selectedSections.includes('10')&&<><LessonSection id={sectionMap['gw11-10'].id} number={String(sectionMap['gw11-10'].index).padStart(2,'0')} minutes={sectionMap['gw11-10'].minutes} title={sectionMap['gw11-10'].title} lessonId={lessonId}>
    <p class="section-lead">NotebookLM B가 만든 체크리스트는 최종 정답이 아니다. 근거자료 안에서 잘 정리했더라도 적용 범위·현행성·누락을 다른 조사 경로로 다시 확인해야 한다.</p>
    <div class="risk-grid">
      {crossValidationRisks.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><strong>{humanizeLegalText(item)}</strong></article>)}
    </div>
    <p class="loop-entry">여기서부터 <strong>반복형 교차검증 루프</strong>를 시작한다.</p>
  </LessonSection></>}

  {selectedSections.includes('11')&&<><LessonSection id={sectionMap['gw11-11'].id} number={String(sectionMap['gw11-11'].index).padStart(2,'0')} minutes={sectionMap['gw11-11'].minutes} title={sectionMap['gw11-11'].title} lessonId={lessonId}>
    <div class="input-pair"><span>노트북 B로 옮긴 프로젝트 조건 기준서(B00)</span><b>+</b><span>NotebookLM B 체크리스트</span></div>
    <p class="plain-note">NotebookLM B에 넣은 모든 법규 Source를 GPT에 그대로 다시 제공해 같은 자료를 요약시키지 않는다. GPT는 웹에서 공식 근거를 독립적으로 다시 조사하는 검증자다.</p>
    <dl class="prompt-context" data-lesson11-prompt-context={crossCheckPrompt.id}>
      {promptContextLabels.map(([key, label]) => <div><dt>{label}</dt><dd>{humanizeLegalText(crossCheckPrompt.context[key])}</dd></div>)}
    </dl>
    <PromptCopyBlock {...crossCheckPrompt} />
  </LessonSection></>}

  {selectedSections.includes('12')&&<><LessonSection id={sectionMap['gw11-12'].id} number={String(sectionMap['gw11-12'].index).padStart(2,'0')} minutes={sectionMap['gw11-12'].minutes} title={sectionMap['gw11-12'].title} lessonId={lessonId}>
    <div class="branch-grid">
      <article class="branch-card branch-card--legal">
        <span>법규 문제</span><h3>공식 법규 Source를 보강한다.</h3>
        <p>적용 법령 누락, 잘못된 조항, 최신 조례·BF·소방 근거자료 부족처럼 법규 근거에 문제가 있는 경우다.</p>
        <ol><li>ChatGPT 문제 발견</li><li>공식 법규 근거자료 확인</li><li>NotebookLM B 근거자료 보완</li><li>체크리스트 수정</li></ol>
      </article>
      <article class="branch-card branch-card--project">
        <span>프로젝트 사실 문제</span><h3>NotebookLM A와 노트북 B로 옮긴 조건 기준서(B00)으로 돌아간다.</h3>
        <p>대지면적·용도·발주처 조건처럼 프로젝트 원자료의 사실관계가 부족하거나 충돌하는 경우다.</p>
        <ol><li>문제 발견</li><li>NotebookLM A에서 원자료 확인</li><li>노트북 B로 옮긴 조건 기준서(B00) 수정</li><li>수정 노트북 B로 옮긴 조건 기준서(B00)을 NotebookLM B에 반영</li></ol>
      </article>
    </div>
  </LessonSection></>}

  {selectedSections.includes('13')&&<><LessonSection id={sectionMap['gw11-13'].id} number={String(sectionMap['gw11-13'].index).padStart(2,'0')} minutes={sectionMap['gw11-13'].minutes} title={sectionMap['gw11-13'].title} lessonId={lessonId}>
    <blockquote class="source-warning source-warning--small">ChatGPT 답변은 새로운 공식 Source가 아니라 검토 요청사항이다.</blockquote>
    <dl class="prompt-context" data-lesson11-prompt-context={revisePrompt.id}>
      {promptContextLabels.map(([key, label]) => <div><dt>{label}</dt><dd>{humanizeLegalText(revisePrompt.context[key])}</dd></div>)}
    </dl>
    <PromptCopyBlock {...revisePrompt} />
  </LessonSection></>}

  {selectedSections.includes('14')&&<><LessonSection id={sectionMap['gw11-14'].id} number={String(sectionMap['gw11-14'].index).padStart(2,'0')} minutes={sectionMap['gw11-14'].minutes} title={sectionMap['gw11-14'].title} lessonId={lessonId}>
    <p class="section-lead">NotebookLM B 수정 결과를 같은 ChatGPT 작업 맥락에서 다시 검증한다. 매번 파일을 새로 업로드하기보다 최신 수정 결과나 변경 항목을 복사해 사용할 수 있다.</p>
    <dl class="prompt-context" data-lesson11-prompt-context={recheckPrompt.id}>
      {promptContextLabels.map(([key, label]) => <div><dt>{label}</dt><dd>{humanizeLegalText(recheckPrompt.context[key])}</dd></div>)}
    </dl>
    <PromptCopyBlock {...recheckPrompt} />
  </LessonSection></>}

  {selectedSections.includes('15')&&<><LessonSection id={sectionMap['gw11-15'].id} number={String(sectionMap['gw11-15'].index).padStart(2,'0')} minutes={sectionMap['gw11-15'].minutes} title={sectionMap['gw11-15'].title} lessonId={lessonId}>
    <ol class="loop-flow" aria-label="NotebookLM B와 ChatGPT 반복 교차검증 루프">
      {['NotebookLM B · 체크리스트 작성', 'ChatGPT · 독립 검증', '오류·누락 발견', '공식 근거자료 보완', 'NotebookLM B · 체크리스트 수정', 'ChatGPT · 재검증', '필요하면 반복', '사람 최종검수'].map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}
    </ol>
  </LessonSection></>}

  {selectedSections.includes('16')&&<><LessonSection id={sectionMap['gw11-16'].id} number={String(sectionMap['gw11-16'].index).padStart(2,'0')} minutes={sectionMap['gw11-16'].minutes} title={sectionMap['gw11-16'].title} lessonId={lessonId}>
    <blockquote class="boundary-box boundary-box--plain">AI가 “완벽합니다”라고 말하는 것을 종료조건으로 사용하지 않는다.</blockquote>
    <ul class="check-grid check-grid--stop" data-lesson11-loop-stop>
      {loopStopChecks.map((item) => <li><span aria-hidden="true">□</span><strong>{humanizeLegalText(item)}</strong></li>)}
    </ul>
  </LessonSection></>}

  {selectedSections.includes('17')&&<><LessonSection id={sectionMap['gw11-17'].id} number={String(sectionMap['gw11-17'].index).padStart(2,'0')} minutes={sectionMap['gw11-17'].minutes} title={sectionMap['gw11-17'].title} lessonId={lessonId}>
    <div class="human-grid">
      <ul>{humanReviewChecks.map((item) => <li>{humanizeLegalText(item)}</li>)}</ul>
      <aside><span>FINAL HANDOFF</span><h3>필요한 사람에게 넘긴다.</h3><p>건축사, 관련 기술자, 발주처, 인허가 담당기관 등 실제 권한과 전문성을 가진 사람이 적용 여부와 최종 판단을 확인한다.</p></aside>
    </div>
  </LessonSection></>}

  {selectedSections.includes('18')&&<><LessonSection id={sectionMap['gw11-18'].id} number={String(sectionMap['gw11-18'].index).padStart(2,'0')} minutes={sectionMap['gw11-18'].minutes} title={sectionMap['gw11-18'].title} lessonId={lessonId}>
    <blockquote class="key-message">AI 두 개가 같은 답을 했다고 해서 사실이 되는 것이 아니다.</blockquote>
    <div class="role-grid">
      <article class="role-card role-card--a"><span>NOTEBOOKLM B</span><h3>첨부 근거자료 안에서 연결</h3><p>노트북 B로 옮긴 조건 기준서(B00) + 공식 근거자료 → 체크리스트 작성</p></article>
      <article class="role-card"><span>ChatGPT</span><h3>다른 경로로 독립 조사</h3><p>노트북 B로 옮긴 조건 기준서(B00) + 체크리스트 → 공식 법규를 웹에서 다시 조사 → 오류·누락 검증</p></article>
    </div>
    <p class="final-boundary">교차검증은 AI끼리 답을 투표하는 과정이 아니다. 서로 다른 경로에서 근거를 확인하고, 최종 판단은 사람이 한다.</p>
  </LessonSection></>}

  {selectedSections.includes('19')&&<><LessonSection id={sectionMap['gw11-19'].id} number={String(sectionMap['gw11-19'].index).padStart(2,'0')} minutes={sectionMap['gw11-19'].minutes} title={sectionMap['gw11-19'].title} lessonId={lessonId}>
    <p class="section-lead">시간표보다 실습 순서 이해가 우선이다. 아래 시간은 180분 수업을 운영하기 위한 기준이며 실제 진행 상황에 맞게 조정할 수 있다.</p>
    <div class="time-grid" aria-label="제11차시 180분 시간표">
      {timePlan.map(({ label, minutes, mode }, index) => (
        <article class:list={['time-card', `time-card--${mode}`]}><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong><small>{minutes}분</small></article>
      ))}
    </div>
    <blockquote class="closing-message">자료를 정리하고, 근거를 찾고, 서로 다른 AI로 반복 검증하되 최종 판단은 사람이 한다.</blockquote>
  </LessonSection></>}
</div>

