---
interface Props {compact?:boolean}
const {compact=false}=Astro.props;
const steps=[
 {label:'1단계 · 노트북 A',title:'프로젝트 조건 기준서 만들기',description:'발주처 원자료인 건축기획서부터 현황측량도까지 노트북 A에 넣습니다. 옆 부지 기존 건물의 정보와 섞이지 않게 신축 건물의 조건만 정리합니다.'},
 {label:'2단계 · 기준서 이동과 법규 검색',title:'기준서를 노트북 B로 옮기고 법규 찾기',description:'노트북 A에서 만든 조건 기준서를 내용 그대로 노트북 B로 옮깁니다. ChatGPT의 검색 보조를 받아 필요한 법규·조례·별표의 공식 원문을 모읍니다.'},
 {label:'3단계 · 노트북 B',title:'1차 법규검토 체크리스트 만들기',description:'노트북 B의 프로젝트 조건 기준서와 공식 법규 원문을 대조합니다. 설계자가 무엇을 어떤 조항으로 확인할지 체크리스트로 정리합니다.'},
 {label:'4단계 · 교차검증과 사람 확인',title:'ChatGPT로 재확인하고 사람이 최종 확인',description:'조건 기준서와 체크리스트를 ChatGPT에 주고 공식 근거를 독립적으로 다시 찾아 빠진 법규·오류를 확인합니다. 필요한 자료를 보완한 뒤 사람이 최종 판단합니다.'},
];
---
{compact?<aside class="legal-logic legal-logic--compact" data-legal-core-logic="recap"><strong>오늘 할 일은 이 네 단계입니다.</strong><p>노트북 A에서 조건 기준서 만들기 → 노트북 B로 옮기고 공식 법규 찾기 → 노트북 B에서 체크리스트 만들기 → ChatGPT 교차검증과 사람 최종 확인</p><p>두 노트북은 서로 다른 역할의 작업 공간입니다. 파일 번호를 외우기 전에 ‘앞 단계의 기준서가 다음 단계의 입력자료가 된다’는 흐름부터 기억합니다.</p></aside>:<section class="legal-logic" data-legal-core-logic="first" aria-labelledby="l10-core-logic-title"><h2 id="l10-core-logic-title">오늘의 법규 검토 핵심 로직 <span>한눈에 보는 순서도</span></h2><ol>{steps.map((step,index)=><li><span class="logic-step">{step.label}</span><h3>{step.title}</h3><p>{step.description}</p>{index<3&&<span class="logic-arrow" aria-hidden="true">→</span>}</li>)}</ol><p class="logic-summary">기억할 두 결과물: <strong>프로젝트 조건 기준서</strong> → <strong>1차 법규검토 체크리스트</strong>. AI가 만든 결론을 바로 사용하지 않고 근거와 부족한 자료를 사람이 확인합니다.</p></section>}
<style>
 .legal-logic{box-sizing:border-box;min-width:0;margin:0 0 1.5rem;padding:clamp(1rem,2.5vw,1.6rem);border:2px solid var(--accent-dark);background:var(--surface);overflow-wrap:anywhere}.legal-logic h2{margin:0 0 1rem;font-size:clamp(1.3rem,2.3vw,1.8rem)}h2 span{display:block;font-size:.85rem;font-weight:500;color:var(--muted);margin-top:.3rem}ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem;padding:0;list-style:none;margin:0}li{position:relative;min-width:0;padding:1rem;background:var(--paper-deep);border:1px solid var(--line)}.logic-step{font-size:.8rem;color:var(--accent-dark);font-weight:800}h3{font-size:1.03rem;line-height:1.5;margin:.5rem 0}p{font-size:.92rem;line-height:1.75;margin:.4rem 0}.logic-arrow{position:absolute;right:-1rem;top:1rem;font-size:1.1rem;font-weight:800}.logic-summary{margin:1rem 0 0;padding-top:.8rem;border-top:1px solid var(--line)}.legal-logic--compact{margin:0 0 1.1rem;border-width:1px}
 @media(max-width:1000px){ol{grid-template-columns:repeat(2,minmax(0,1fr))}.logic-arrow{display:none}}@media(max-width:600px){ol{grid-template-columns:minmax(0,1fr);gap:.8rem}li{padding:.9rem}.legal-logic{padding:1rem}}
</style>
