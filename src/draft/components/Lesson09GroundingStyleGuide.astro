    margin-bottom: 0.25rem;
  }
  .l09-dev-note {
    margin: 0 0 0.75rem;
    font-size: 0.83rem;
    color: #334155;
  }
  .l09-dev-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .l09-dev-card {
    padding: 0.8rem 0.85rem;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .l09-dev-card p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.52;
    color: #1e293b;
  }
  .l09-subhead {
    margin: 1.25rem 0 0.8rem;
