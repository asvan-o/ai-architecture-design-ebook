    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e3a8a;
  }
  .l09-mini-details .l09-code-card {
    margin-top: 0.75rem;
  }
  .l09-code-card {
    padding: 0.9rem 1rem;
