---
import {lesson02ProgramFiles} from '../../../scripts/daejeon-file-sorter-assets.mjs';
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div class="l02-ab-downloads" data-exercise-downloads="A">
  {enabled?lesson02ProgramFiles.map(file=><a class="review-download" href={base+'/'+file.outputPath} download={file.file} data-exercise-file={'A:'+file.key}>{file.title}</a>):<p>실습자료는 제공받은 파일을 사용합니다.</p>}
</div>
