---
import {lesson06Images,lesson06Prompt} from '../../../scripts/daejeon-lesson06-assets.mjs';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
---
<div class="l03-input-panel" data-l06-workbench>
 <h3>만들 단계와 입력 자료 선택</h3>
 <label>확인할 단계<select data-l06-stage>{lesson06Images.map(image=><option value={image.key}>{image.title}</option>)}</select></label>
 <p data-l06-selection aria-live="polite">선택한 단계의 입력 자료와 요청문 위치를 확인합니다.</p>
 {lesson06Images.map((image,i)=>{const p=lesson06Prompt[image.key];return<div data-l06-stage-panel={image.key} hidden={i!==0}><h4>{image.title}</h4><p>{image.description}</p><strong>첨부 이미지 · 아래 순서로 준비</strong><ol>{p.attachments?.map(a=><li>{enabled?<a href={base+'/'+a.outputPath} download={a.file.split('/').pop()}>{a.file.split('/').pop()}</a>:a.file.split('/').pop()} — {a.role}</li>)}</ol><p><a href={'#'+image.section} data-l06-jump>이 단계의 전후 비교와 Prompt로 이동 →</a></p></div>;})}
 <p class="l03-note">입력 자료의 순서와 공간 구성을 함께 따라가며, 같은 평면이 입체·분해도·관계도로 바뀌는 과정을 확인합니다.</p>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-l06-workbench]').forEach(root=>{
  const select=root.querySelector<HTMLSelectElement>('[data-l06-stage]');
  select?.addEventListener('change',()=>{
   root.querySelectorAll<HTMLElement>('[data-l06-stage-panel]').forEach(panel=>{panel.hidden=panel.dataset.l06StagePanel!==select.value;});
   const live=root.querySelector<HTMLElement>('[data-l06-selection]');if(live)live.textContent=(select.selectedOptions[0]?.textContent||'')+' · 입력 순서와 역할을 확인한 뒤 해당 단계로 이동합니다.';
  });
 });
</script>
