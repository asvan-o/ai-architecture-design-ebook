---
const icons = import.meta.glob<string>('../assets/home-design/icons/*.svg', {query:'?raw',import:'default',eager:true});
interface Props {name:string;}
const {name}=Astro.props;
const svg=icons[`../assets/home-design/icons/${name}.svg`];
if(!svg)throw new Error(`Unknown home design icon: ${name}`);
---
<span class="home-design-icon" aria-hidden="true" set:html={svg} />
<style>
 .home-design-icon{display:inline-flex;flex:none;width:1.2em;height:1.2em;vertical-align:middle}
 .home-design-icon :global(svg){width:100%;height:100%;stroke-width:1.65}
</style>
