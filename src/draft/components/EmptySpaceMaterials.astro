---
import {emptyBases} from '../../../scripts/daejeon-gwangju-reuse.mjs';
import Lesson01Image from './Lesson01Image.astro';
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<div id="additional-practice-images" data-empty-base-materials>
  <h3>추가 실습 이미지 선택 · BASE 01~05</h3>
  <p>아래 빈 공간 중 하나를 골라 작업지시 작성과 첫 생성·수정을 연습합니다. 후반부에는 의뢰서가 있는 실습 A 또는 실습 B로 이어갑니다.</p>
  {enabled ? <div class="review-cards">{emptyBases.map((image)=><figure class="review-card" data-empty-base={image.number}>
    <h4>BASE {image.number}</h4>
    <Lesson01Image id={`empty-${image.number}`} src={`${base}/practice/GW-L02/${image.file}`} alt={image.alt} />
    <figcaption>{image.caption} · 교육용 AI 생성 입력 이미지</figcaption>
    <a class="review-download" href={`${base}/practice/GW-L02/${image.file}`} download={image.file}>BASE {image.number} 이미지 다운로드</a>
  </figure>)}</div> : <p class="review-callout">실습 이미지는 제공된 자료에서 확인합니다.</p>}
  <p class="review-source-list">교육용 Google AI 생성 이미지입니다. 실제 치수·구조·법규 조건의 근거로 사용하지 않습니다.</p>
</div>
