---
import { packages } from '../../../scripts/daejeon-review-assets.mjs';
interface Props { stage: 'early'|'rfp'|'example'|'instructor'|'evidence'; }
const { stage } = Astro.props;
const enabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{enabled ? <div class="review-cards project-materials" data-material-stage={stage}>
  {packages.map((project) => <article class="review-card">
    <p class="review-eyebrow">{project.id} · {project.kind}</p><h3>{project.title}</h3>
    {['early','rfp'].includes(stage) && <figure><img src={`${base}/practice/${project.id}/${project.id}_${stage==='early'?project.image:project.diagram}`} alt={`${project.id} ${stage==='early'?'같은 시점 비교를 위한 현황 이미지':'교육용 기준 도면'}`} loading="lazy" /><figcaption>{stage==='early'?'첫 생성의 편집 원본 · 교육용 가상 공간':project.diagramRole}</figcaption></figure>}
    {stage === 'early' && <><p><strong>유지:</strong> {project.keep}</p><p><strong>변경:</strong> {project.change}</p><p><strong>제외:</strong> {project.exclude}</p></>}
    <ul class="review-downloads">{project.assets.filter((a)=>a.stage===stage || stage==='rfp'&&a.stage==='early').map((asset)=><li><a href={`${base}/practice/${project.id}/${asset.file}`} download={asset.file}>{asset.label}</a></li>)}</ul>
  </article>)}
</div> : <p class="review-callout">실습 파일은 강사가 제공하는 로컬 검토용 preview에서 확인·다운로드합니다. 이 과정은 설계 검토 중입니다.</p>}
