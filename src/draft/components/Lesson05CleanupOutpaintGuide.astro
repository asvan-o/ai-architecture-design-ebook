<script>
  const initL05CleanupOutpaint = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-l05-co-copy]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const text = btn.dataset.l05CoCopy || '';
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.textContent;
          btn.textContent = '복사됨 ✓';
          setTimeout(() => {
            btn.textContent = orig;
          }, 1400);
        } catch {
          // fallback ignored
        }
      });
    });

    document.querySelectorAll<HTMLElement>('[data-l05-keyword-builder]').forEach((root) => {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';
      const output = root.querySelector<HTMLElement>('[data-l05-builder-output]');
      const hint = root.querySelector<HTMLElement>('[data-l05-builder-hint]');
      const copyBtn = root.querySelector<HTMLButtonElement>('[data-l05-builder-copy]');

      const domainHints: Record<string, string> = {
        '2d-cleanup': '2D 평면 클린업 모드: 입력과 출력이 모두 2D 평면도이므로 카메라 구도는 정사영 2D 탑뷰로, 마감은 흰 배경 2D 선화로 자동 고정됩니다. (3D 구도·야외 조경·날씨 비활성화)',
        '2d-inpaint': '2D 평면 인페인팅 모드: 기존 2D 평면의 실내 가구·문만 수정하므로 카메라 구도는 정사영 2D 탑뷰, 마감은 흰 배경 2D 선화로 자동 고정됩니다.',
        '2d-outpaint': '2D Pivot 아웃페인팅 모드: 좌측 원본 평면과 같은 정사영 2D 탑뷰·선화를 유지하면서, 우측 여백에 추가할 외부 요소를 2D 평면 심볼로 선택할 수 있습니다.',
        '3d-photo': '외관·조감도 사진 아웃페인팅 모드: 원본 건물 사진·투시도의 구도를 유지하면서 Pivot 여백에 주변 조경과 날씨·광원을 자연스럽게 확장합니다.',
        '3d-from-plan': '평면도 → 3D 입체 전환 모드: 2D 평면도를 참고해 3D 건축 이미지로 입체화하는 응용 단계이므로 버드뷰·조감도·아이소메트릭·눈높이 구도와 조경·날씨를 자유롭게 조합할 수 있습니다.',
      };

      const chipsOf = (key: string) =>
        [...root.querySelectorAll<HTMLButtonElement>(`.l05-co-chip[data-builder-key="${key}"]`)];

      const activateChip = (key: string, chip: HTMLButtonElement | undefined) => {
        if (!chip) return;
        chipsOf(key).forEach((sib) => {
          const on = sib === chip;
          sib.classList.toggle('is-active', on);
          sib.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      };

      const activeChip = (key: string) =>
        root.querySelector<HTMLButtonElement>(`.l05-co-chip.is-active[data-builder-key="${key}"]`);

      const applyDomainRules = (domain: string) => {
        const is2d = domain.startsWith('2d-');
        const allowLandscape = domain === '2d-outpaint' || !is2d;

        // ② 카메라 구도 허용 규칙
        chipsOf('view').forEach((c) => {
          const kind = c.dataset.builderKind || '';
          let allowed = false;
          if (is2d) allowed = kind === '2d';
          else if (domain === '3d-photo') allowed = kind === '3d';
          else allowed = kind === '3d' || kind === '3d-plan';
          c.disabled = !allowed;
        });
        if (!activeChip('view') || activeChip('view')?.disabled) {
          const fallback = chipsOf('view').find((c) => !c.disabled && c.dataset.builderId === (is2d ? 'top' : 'birdseye'))
            || chipsOf('view').find((c) => !c.disabled);
          activateChip('view', fallback);
        }

        // ③ 조경물 추가 허용 규칙
        chipsOf('landscape').forEach((c) => {
          const kind = c.dataset.builderKind || '';
          const allowed = allowLandscape ? (domain === '2d-outpaint' ? kind === 'ext' : true) : kind === 'none';
          c.disabled = !allowed;
        });
        if (!activeChip('landscape') || activeChip('landscape')?.disabled) {
          const fallback = chipsOf('landscape').find((c) => !c.disabled && c.dataset.builderId === (allowLandscape ? 'deck-planter' : 'none'))
            || chipsOf('landscape').find((c) => !c.disabled);
          activateChip('landscape', fallback);
        }

        // ④ 환경 · 날씨 허용 규칙
        chipsOf('weather').forEach((c) => {
          const kind = c.dataset.builderKind || '';
          const allowed = is2d ? kind === '2d' : kind === '3d';
          c.disabled = !allowed;
        });
        if (!activeChip('weather') || activeChip('weather')?.disabled) {
          const fallback = chipsOf('weather').find((c) => !c.disabled && c.dataset.builderId === (is2d ? 'cad-white' : 'golden'))
            || chipsOf('weather').find((c) => !c.disabled);
          activateChip('weather', fallback);
        }

        if (hint && domainHints[domain]) {
          hint.textContent = domainHints[domain];
        }
      };

      const render = () => {
        if (!output) return;
        const t = activeChip('task');
        const v = activeChip('view');
        const l = activeChip('landscape');
        const w = activeChip('weather');
        const domain = t?.dataset.builderDomain || '3d-from-plan';
        const is2d = domain.startsWith('2d-');

        const taskText = t?.dataset.builderText || '';
        const viewText = v?.dataset.builderText || '';
        const landText = domain === '2d-outpaint'
          ? (l?.dataset.builderText2d || '')
          : (l?.dataset.builderText || '');
        const weatherText = w?.dataset.builderText || '';

        const lines = [
          taskText,
          viewText ? `${is2d ? '도면 시점' : '카메라 구도'}: ${viewText}.` : '',
          landText
            ? (domain === '2d-outpaint'
              ? `외부 확장 요소(2D 평면): ${landText}을 기존 도면 축척에 맞춰 그려 주세요.`
              : `조경 요소: ${landText}를 조화롭게 배치해 주세요.`)
            : '',
          weatherText ? `${is2d ? '도면 마감' : '환경 및 마감'}: ${weatherText}.` : '',
        ].filter(Boolean);
        output.textContent = lines.join('\n');
      };

      applyDomainRules(activeChip('task')?.dataset.builderDomain || '3d-from-plan');
      render();

      root.querySelectorAll<HTMLButtonElement>('.l05-co-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          if (chip.disabled) return;
          const k = chip.dataset.builderKey;
          if (!k) return;
          activateChip(k, chip);
          if (k === 'task') {
            applyDomainRules(chip.dataset.builderDomain || '3d-from-plan');
          }
          render();
        });
      });

      copyBtn?.addEventListener('click', async () => {
        const text = output?.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          const orig = copyBtn.textContent;
          copyBtn.textContent = '복사됨 ✓';
          setTimeout(() => {
            copyBtn.textContent = orig;
          }, 1400);
        } catch {
          // fallback ignored
        }
      });
    });
  };

  initL05CleanupOutpaint();
  document.addEventListener('astro:page-load', initL05CleanupOutpaint);
</script>

