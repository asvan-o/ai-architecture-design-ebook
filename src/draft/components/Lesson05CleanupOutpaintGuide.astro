---
import {
  l05CleanupBefore,
  l05CleanupAfter,
  l05PivotDiagram,
  l05OutpaintBefore,
  l05OutpaintCleanInput,
  l05OutpaintAfter,
  l05BirdseyeAfter,
  l05ShortPromptsTxt,
  l05CleanupOutpaintZip,
} from '../../../scripts/daejeon-lesson05-cleanup-outpaint.mjs';

interface Props {
  mode: 'cleanup' | 'outpaint-keywords';
}

const { mode } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';

const cleanupPrompt = `이 2D 건축 평면도에서 기존 가구, 치수선, 축선 번호, 공간명, 빨간 검토 메모를 모두 지워 주세요.
외벽, 내부 경량벽체, 기둥, 창문, 출입문(문짝·개폐호)의 위치와 두께는 원본 그대로 유지하세요.
흰색 배경에 깔끔한 흑백 2D 건축 선화(Orthographic Top-Down Plan)로만 정리해 주세요.`;

const outpaintPrompt = `왼쪽에 배치된 기존 카페 평면도(벽, 창문, 문, 바 카운터, 실내 좌석, 치수)는 위치와 비율을 절대 바꾸지 말고 그대로 유지하세요.
오른쪽 흰색 빈 여백에만 카페 우측 외벽(W3)과 자연스럽게 이어지는 외부 우드 데크 테라스를 2D 평면도(Orthographic Top-Down)로 확장해 그려 주세요.
테라스에는 2인용 원형 야외 테이블 3개, 아래쪽 야외 벤치, 북·동쪽 경계 조경 플랜터(수목 심볼), 우측 진입 디딤석을 기존 도면과 같은 깔끔한 흑백·연녹색 선 스타일로 추가해 주세요.`;

const birdseyePrompt = `이 소형 카페와 우측 우드 데크 테라스를 45도 버드뷰(Bird's-Eye View) 건축 시각화 이미지로 표현해 주세요.
건물 좌측의 단층 콘크리트·유리 파사드는 유지하고, 우측 데크 테라스 둘레에 석재 플랜터, 다간형 수목(Multi-stem Trees), 억새류 그라스, 진입 디딤석과 보행 포장을 추가해 주세요.
늦은 오후 골든아워(Golden Hour)의 따뜻한 대각선 그림자와 맑은 주간 광원으로 사실적인 건축 사진 스타일로 완성해 주세요. 글자나 워터마크는 넣지 마세요.`;

const keywordGroups = [
  {
    category: '카메라 구도 (Camera View)',
    items: [
      { ko: '탑뷰 · 정사영 평면', en: 'Orthographic Top-Down Plan, 90-degree flat 2D view', use: '도면 클린업, 가구 재배치, 데크·조경 평면 확장' },
      { ko: '버드뷰 · 부감도', en: "Bird's-Eye View, 45-degree high-angle architectural view", use: '지붕 형태, 중정, 외부 데크와 주변 조경 연계 검토' },
      { ko: '조감도 · 드론 뷰', en: 'Aerial Perspective, Drone View, 30-degree site overview', use: '건물 매스 + 전면 도로 + 인접 필지·도시 맥락 제안' },
      { ko: '아이소메트릭', en: 'Isometric 3D Cutaway, Axonometric Diagram', use: '층별 공간 구성과 동선·조닝을 입체 다이어그램으로 설명' },
      { ko: '눈높이 투시도', en: 'Eye-Level View, Two-Point Perspective, straight verticals', use: '입구 인지성, 마감 질감, 보행자 스케일·날씨 분위기 비교' },
    ],
  },
  {
    category: '도면 클린업 (Cleanup)',
    items: [
      { ko: '가구·집기 일괄 제거', en: 'Remove all furniture, fixtures, and clutter', use: '빈 구조 바탕면을 확보해 새 배치안 실험' },
      { ko: '문자·치수·메모 제거', en: 'Remove text labels, dimension lines, grid bubbles, red markups', use: '현장 메모나 혼잡한 주석을 지워 AI 오인 방지' },
      { ko: '구조선만 유지', en: 'Keep only structural walls, columns, windows, doors with swing arcs', use: '외벽·내벽·개구부 기하학 고정' },
      { ko: '2D 흑백 선화 통일', en: 'Clean black-and-white 2D CAD linework on pure white background', use: '스케치·스캔 도면을 일관된 평면 톤으로 정돈' },
    ],
  },
  {
    category: '인페인팅 · 아웃페인팅 / Pivot',
    items: [
      { ko: '지정 영역만 수정', en: 'Edit only inside the target zone; keep everything else unchanged', use: '회의실 가구 교체, 출입문 D2 이동 등 국소 인페인팅' },
      { ko: 'Pivot 좌측 고정 확장', en: 'Keep the left-aligned original drawing locked; extend only into the right white margin', use: '원본을 한쪽으로 밀어 여백에 증축·테라스 아웃페인팅' },
      { ko: '선 두께·축척 유지', en: 'Match original line weight, drawing scale, and projection', use: '기존 도면과 새로 그린 영역의 이질감 최소화' },
      { ko: '경계 외벽 자연 연결', en: 'Seamless architectural continuity along the exterior boundary wall', use: '기존 창호·외벽과 외부 데크·캐노피 이음새 정리' },
    ],
  },
  {
    category: '조경물 추가 (Landscape)',
    items: [
      { ko: '우드 데크 테라스', en: 'Natural timber wood deck terrace with outdoor seating & linear bench', use: '카페·상업·주택 외부 휴게 공간 확장' },
      { ko: '다층 석재 플랜터', en: 'Low architectural concrete/stone planters along the perimeter', use: '경계부 시선 분리와 깔끔한 공간 구획' },
      { ko: '다간형 수목 · 그라스', en: 'Multi-stem ornamental trees, ornamental grasses, evergreen shrubs', use: '과도한 숲 대신 현대 건축에 어울리는 절제된 식재' },
      { ko: '보행 포장 · 디딤석', en: 'Concrete pedestrian paving, rectangular stone stepping stones over gravel', use: '도로·주차장에서 건물 입구까지 진입 동선 표현' },
      { ko: '점경 인물 (선택)', en: 'Subtle architectural scale figures walking naturally', use: '공간 크기 체감(과밀 배치는 피하고 소수만 배치)' },
    ],
  },
  {
    category: '환경 · 날씨 · 시간대 (Atmosphere)',
    items: [
      { ko: '맑은 주간', en: 'Crisp clear daylight, soft natural architectural shadows', use: '형태·재료·조경 구성을 가장 객관적으로 확인' },
      { ko: '골든아워 · 석양', en: 'Warm late afternoon golden hour sunlight, long diagonal shadows, warm interior glow', use: '카페·주거·문화시설의 따뜻한 체류감 강조' },
      { ko: '흐린 확산광', en: 'Soft overcast diffused light, neutral architectural photography tone', use: '강한 그림자 없이 재료 색감과 입면 비례 집중 검토' },
      { ko: '비 온 뒤 · 젖은 포장', en: 'After-rain damp paving with subtle reflections, fresh foliage', use: '바닥 반사감과 깊이 있는 대기 연출' },
      { ko: '계절 · 도시 맥락', en: 'Early autumn foliage, quiet neighborhood street context', use: '건물이 놓일 주변 가로·계절 분위기 통합 제안' },
    ],
  },
];

const builderOptions = {
  task: [
    {
      id: 'cleanup',
      domain: '2d-cleanup',
      label: '2D 도면 클린업',
      text: '이 2D 건축 평면도에서 기존 가구, 치수선, 축선 번호, 공간명, 빨간 검토 메모를 모두 지우고 외벽·내벽·기둥·창문·출입문만 남겨 주세요.',
    },
    {
      id: 'inpaint',
      domain: '2d-inpaint',
      label: '2D 부분 수정 (인페인팅)',
      text: '이 2D 평면도에서 지정한 실내 영역의 가구·출입문만 교체해 주세요. 외벽, 기둥, 창문, 주변 공간과 기존 치수·글자는 원본 그대로 유지하세요.',
    },
    {
      id: 'outpaint-2d',
      domain: '2d-outpaint',
      label: '2D Pivot 확장 (아웃페인팅)',
      text: '왼쪽에 배치된 기존 2D 평면도(벽, 창문, 문, 실내 배치, 치수)는 위치와 비율을 절대 바꾸지 말고, 오른쪽 흰색 빈 여백에만 외부 공간을 2D 평면도로 자연스럽게 확장해 그려 주세요.',
    },
    {
      id: 'outpaint-photo',
      domain: '3d-photo',
      label: '외관·조감도 사진 Pivot 아웃페인팅',
      text: '원본 건물 사진(또는 투시도)의 형태와 구도는 그대로 고정하고, Pivot을 옮겨 확보한 바깥쪽 빈 여백에만 주변 대지·조경·도로 맥락을 자연스럽게 확장해 그려 주세요.',
    },
    {
      id: 'plan-to-3d',
      domain: '3d-from-plan',
      label: '평면도 → 3D 입체 전환 (응용)',
      text: '첨부한 2D 평면도의 벽체·창호·출입문·공간 배치 비율을 참고해 사실적인 3D 건축 시각화 이미지로 입체화해 주세요.',
    },
  ],
  view: [
    { id: 'top', kind: '2d', label: '2D 탑뷰 (Orthographic Top-Down)', text: '수직 정사영 2D 평면 탑뷰(Orthographic Top-Down Plan, 투시 왜곡 없음)' },
    { id: 'birdseye', kind: '3d', label: "버드뷰 (Bird's-Eye 45°)", text: "상공 45도 버드뷰(Bird's-Eye View, High-Angle Architectural View)" },
    { id: 'aerial', kind: '3d', label: '조감도 (Aerial / Drone View)', text: '원거리 30도 드론 조감도(Aerial Perspective / Drone View, 전면 도로와 주변 맥락 포함)' },
    { id: 'iso', kind: '3d-plan', label: '아이소메트릭 (Isometric 3D)', text: '3D 아이소메트릭 단면 조감(Isometric 3D Architectural Cutaway, 공간 조닝 명확화)' },
    { id: 'eye', kind: '3d', label: '눈높이 (Eye-Level 2-Point)', text: '보행자 눈높이 2점 투시도(Eye-Level Two-Point Perspective, 수직선 수직 보정)' },
  ],
  landscape: [
    { id: 'none', kind: 'none', label: '조경 없음 (실내·도면 전용)', text: '', text2d: '' },
    {
      id: 'deck-planter',
      kind: 'ext',
      label: '우드 데크 + 석재 플랜터',
      text: '자연 목재 우드 데크 테라스(Natural Timber Deck), 야외 원형 테이블과 벤치, 경계부 석재 플랜터(Concrete Planters)',
      text2d: '외부 우드 데크 해치선, 2인용 원형 야외 테이블·벤치, 경계부 조경 플랜터의 2D 평면 심볼',
    },
    {
      id: 'trees-grass',
      kind: 'ext',
      label: '다간형 수목 + 억새류 그라스',
      text: '다간형 교목(Multi-stem Trees), 억새류 그라스(Ornamental Grasses), 낮은 상록 관목 식재',
      text2d: '수목 수관 원형 심볼(교목·관목 군식)과 식재 경계선 2D 도면 표기',
    },
    {
      id: 'stepping-street',
      kind: 'ext',
      label: '진입 디딤석 + 보행 포장',
      text: '자갈 위 직사각 디딤석(Stone Stepping Stones)과 밝은 콘크리트 보행 포장 진입 동선',
      text2d: '직사각 진입 디딤석 배열과 외부 보행 동선 2D 평면 표기',
    },
  ],
  weather: [
    { id: 'cad-white', kind: '2d', label: '흰 배경 2D 선화 (날씨 없음)', text: '순백색 배경, 기존 도면과 통일된 깔끔한 흑백 2D 건축 선 두께와 축척 유지, 불필요한 글자·워터마크 금지' },
    { id: 'clear', kind: '3d', label: '맑은 주간 (Clear Daylight)', text: '맑은 주간 자연광(Crisp Clear Daylight), 부드러운 건축 그림자, 사실적인 건축 사진 스타일, 글자·워터마크 금지' },
    { id: 'golden', kind: '3d', label: '골든아워 · 석양 (Golden Hour)', text: '늦은 오후 골든아워(Warm Golden Hour Sunlight), 긴 대각선 그림자와 은은한 실내 전구색 조명, 글자·워터마크 금지' },
    { id: 'overcast', kind: '3d', label: '흐린 확산광 (Overcast)', text: '부드러운 흐린 날 확산광(Soft Overcast Diffused Light), 과장 없는 중립 건축 사진 톤, 글자·워터마크 금지' },
    { id: 'after-rain', kind: '3d', label: '비 온 뒤 반사 (After Rain)', text: '비 온 뒤 촉촉한 포장 반사(After-Rain Damp Paving Reflections), 선명한 식재 색감, 글자·워터마크 금지' },
  ],
};
---

{mode === 'cleanup' && (
  <section class="l05-co-panel" data-l05-cleanup-guide>
    <div class="l05-co-head">
      <span class="l05-co-badge">4차시 클린업 로직 확장 · 2D 도면 버전</span>
      <h3>도면 클린업(Before → After) · 먼저 잡음을 비우고 구조선만 남기기</h3>
      <p>
        4차시에서 외관 사진의 전선·차량·간판을 먼저 비운 것처럼, 2D 평면도에서도 기존 가구·치수선·검토 메모가
        많을수록 AI가 벽과 가구를 혼동하기 쉽습니다. 아래처럼 <strong>구조선(외벽·내벽·기둥·창·문)만 남기는 클린업</strong>을
        먼저 실행하면 이후 가구 재배치와 평면 확장 정확도가 크게 올라갑니다.
      </p>
    </div>

    <div class="l05-co-ba-grid">
      <figure class="l05-co-figure">
        <span class="l05-co-pill l05-co-pill-before">Before · 클린업 전</span>
        {enabled && (
          <img
            src={`${base}/${l05CleanupBefore.outputPath}`}
            alt={l05CleanupBefore.title}
            width={l05CleanupBefore.width}
            height={l05CleanupBefore.height}
            loading="lazy"
          />
        )}
        <figcaption>
          <strong>기존 가구 · 치수 · 축선 · 검토 메모 혼재</strong>
          <span>빨간 원·안내 문구·기존 책상과 회의실 테이블이 함께 들어 있어 바로 수정하면 주변 선이 흔들리기 쉬운 상태입니다.</span>
        </figcaption>
      </figure>

      <figure class="l05-co-figure">
        <span class="l05-co-pill l05-co-pill-after">After · 구조선 클린업 완료</span>
        {enabled && (
          <img
            src={`${base}/${l05CleanupAfter.outputPath}`}
            alt={l05CleanupAfter.title}
            width={l05CleanupAfter.width}
            height={l05CleanupAfter.height}
            loading="lazy"
          />
        )}
        <figcaption>
          <strong>외벽 · 경량벽체 · 기둥 · 창 · 문만 유지</strong>
          <span>불필요한 가구·치수·메모가 깔끔히 제거되어 새 배치안(6석 확장, 동선 재구성, 용도 변경)의 깨끗한 기준 도면이 됩니다.</span>
        </figcaption>
      </figure>
    </div>

    <div class="l05-co-prompt-card">
      <div class="l05-co-prompt-head">
        <strong>ChatGPT 실전 짧은 프롬프트 · 도면 클린업 (3줄 기준)</strong>
        <button type="button" class="l05-co-copy-btn" data-l05-co-copy={cleanupPrompt}>프롬프트 복사</button>
      </div>
      <pre class="l05-co-pre">{cleanupPrompt}</pre>
      <p class="l05-co-tip">
        <strong>ChatGPT 활용 팁:</strong> 처음부터 긴 규격서를 적기보다 <strong>① 무엇을 지울지 → ② 무엇을 남길지 → ③ 어떤 그림 스타일로 정리할지</strong>
        3문장으로 지시하고, 누락된 요소가 있으면 한 줄씩 후속 대화로 다듬는 편이 훨씬 안정적입니다.
      </p>
    </div>
  </section>
)}

{mode === 'outpaint-keywords' && (
  <section class="l05-co-panel l05-co-panel-outpaint" data-l05-outpaint-guide>
    <div class="l05-co-head">
      <span class="l05-co-badge l05-co-badge-teal">아웃페인팅 · Pivot 이동 · 카메라/조경 키워드 응용</span>
      <h3>원본 Pivot 위치 이동으로 도면 아웃페인팅(Outpainting) 하기</h3>
      <p>
        내부만 고치는 <strong>인페인팅(Inpainting)</strong>과 달리, 건물 바깥쪽 테라스·증축·조경·대지 맥락을 새로 그려 넣는 작업이
        <strong>아웃페인팅(Outpainting)</strong>입니다. 원본 이미지가 화면 정중앙에 꽉 차 있으면 AI가 확장할 물리적 여백이 없어
        기존 도면을 억지로 축소하거나 왜곡합니다. 핵심 해법은 <strong>원본의 배치 기준점(Pivot)을 확장 반대쪽으로 밀어 빈 흰 여백을 먼저 확보하는 것</strong>입니다.
