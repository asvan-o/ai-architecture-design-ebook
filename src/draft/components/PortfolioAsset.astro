---
interface Props { asset:{outputPath:string;filename:string;title:string;caption:string;width?:number;height?:number};instance:string; }
const {asset,instance}=Astro.props;
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const href=base+'/'+asset.outputPath.split('/').map(encodeURIComponent).join('/');
const id='portfolio-image-'+instance;
---
<figure class="portfolio-asset" data-portfolio-asset={asset.filename}>
 {enabled&&<img src={href} alt={asset.title} width={asset.width} height={asset.height} loading="lazy" />}
 <figcaption><strong>{asset.title}</strong><p>{asset.caption}</p>
 {enabled&&<div class="asset-actions"><button type="button" data-portfolio-open={id}>확대 보기</button><a href={href} download={asset.filename}>{asset.filename} 다운로드</a></div>}
 </figcaption>
 {enabled&&<dialog id={id} aria-label={asset.title}><header><h3>{asset.title}</h3><button type="button" data-portfolio-close>닫기</button></header><div class="image-scroll"><img src={href} alt={asset.title} width={asset.width} height={asset.height} loading="lazy" /></div><p>{asset.caption}</p></dialog>}
</figure>
<style>
 .portfolio-asset{margin:0;min-width:0;border:1px solid var(--line);background:var(--surface);padding:.8rem;overflow-wrap:anywhere}.portfolio-asset>img{width:100%;height:auto;max-height:38rem;object-fit:contain;background:#f3f1eb}figcaption{font-size:.88rem;margin-top:.6rem}figcaption p{margin:.4rem 0}.asset-actions{display:flex;gap:.6rem;flex-wrap:wrap}.asset-actions>*{max-width:100%;overflow-wrap:anywhere}button{font:inherit;cursor:pointer;border:1px solid var(--line);border-radius:3px;padding:.3rem .6rem;background:var(--paper-deep);color:var(--ink)}dialog{width:min(95vw,1200px);max-width:95vw;max-height:94vh;padding:1rem;border:1px solid var(--line);background:var(--surface);color:var(--ink)}dialog::backdrop{background:#0009}dialog header{display:flex;align-items:start;justify-content:space-between;gap:1rem}dialog h3{margin:0;font-size:1rem}.image-scroll{max-height:72vh;overflow:auto}.image-scroll img{display:block;width:100%;height:auto}button:focus-visible{outline:3px solid var(--blue);outline-offset:3px}@media print{dialog,.asset-actions{display:none}}
</style>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-portfolio-open]').forEach(button=>{
  const dialog=document.getElementById(button.dataset.portfolioOpen||'') as HTMLDialogElement|null;if(!dialog)return;
  button.addEventListener('click',()=>{const img=dialog.querySelector('img');if(img)img.loading='eager';dialog.showModal();});
  dialog.querySelector('[data-portfolio-close]')?.addEventListener('click',()=>dialog.close());
  dialog.addEventListener('close',()=>button.focus());
 });
</script>
