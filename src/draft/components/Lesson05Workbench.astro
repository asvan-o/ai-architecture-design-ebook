---
import ReviewPrompt from './ReviewPrompt.astro';
import {lesson05Plans,lesson05Prompt,lesson05Crops} from '../../../scripts/daejeon-lesson05-assets.mjs';
interface Props {area:'selection'|'prompts';}
const {area}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const firstPrompt=lesson05Prompt['plan01-edit'];
const firstCrop=lesson05Crops[0];
---
{area==='selection'?<div class="l03-input-panel">
 <label>사용할 평면도<select data-l05-plan>{lesson05Plans.map(plan=><option value={plan.id}>{plan.title}</option>)}</select></label>
 <p data-l05-selection aria-live="polite">선택한 도면의 가구 수정 요청을 Part 2 Prompt에 반영합니다.</p>
</div>:<>
 <p data-l05-prompt-attachment>첨부 이미지: {enabled?<a href={base+'/'+firstCrop.outputPath} data-l05-crop-link download={firstCrop.file.split('/').pop()}>{firstCrop.file.split('/').pop()}</a>:<span data-l05-crop-link>{firstCrop.file.split('/').pop()}</span>} · 가구와 주변 경계가 보이는 부분 도면입니다.</p>
 <div data-l05-prompt-panel><ReviewPrompt id="l05-my-prompt" title="가구 부분 수정 · 실행 Prompt" prompt={firstPrompt.text} href={enabled?base+'/'+firstPrompt.outputPath:undefined} filename={firstPrompt.file.split('/').pop()} /></div>
 <p>목적·맥락·입력자료·작업 단계·조건과 제한·출력 형식·검토 기준을 읽고, 선택한 Crop과 함께 사용합니다.</p>
</>}
