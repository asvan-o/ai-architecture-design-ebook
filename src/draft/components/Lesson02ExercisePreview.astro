---
import {automationFiles} from '../../../scripts/daejeon-automation-ab-assets.mjs';
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const file=automationFiles.A.desktop;
---
{enabled&&<figure class="l02-ab-preview" data-exercise-preview="A"><a href={base+'/'+file.outputPath} target="_blank" rel="noreferrer" aria-label="파일 자동 정리 프로그램 실제 실행 화면 크게 보기"><img src={base+'/'+file.outputPath} alt="파일 자동 정리 프로그램의 처리 상태와 사람확인 목록" width="1440" height="1000" loading="lazy" /></a><figcaption>제공 완성 예제의 실제 실행 화면 · 이미지를 누르면 크게 볼 수 있습니다.</figcaption></figure>}
