---
import { commencementFiles } from '../../../scripts/daejeon-commencement-assets.mjs';
const enabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const desktop = commencementFiles.desktop;
const pending = commencementFiles.pending;
---
{enabled && (
  <div class="l02-preview-grid">
    <figure class="l02-ab-preview" data-exercise-preview="A">
      <a href={base + '/' + desktop.outputPath} target="_blank" rel="noreferrer" aria-label="착수계 4종 자동 생성기 자동 조립 완료 화면 크게 보기">
        <img
          src={base + '/' + desktop.outputPath}
          alt="착수계 행정서류 4종 자동 생성기의 한글 계약금액 계산 요약과 자동 조립 완료 서식 미리보기"
          width="1440"
          height="1000"
          loading="lazy"
        />
      </a>
      <figcaption>실제 실행 화면 ① · 필수 항목 충족 시 한글 금액·부가세·과업일수 계산 및 4종 서식 자동 조립 완료</figcaption>
    </figure>
    <figure class="l02-ab-preview" data-exercise-preview="pending">
      <a href={base + '/' + pending.outputPath} target="_blank" rel="noreferrer" aria-label="착수계 4종 자동 생성기 사람 확인 검수 대기 화면 크게 보기">
        <img
          src={base + '/' + pending.outputPath}
          alt="자격번호와 변경 사유 누락 시 사람 확인 검수 대기 배너와 경고 목록을 띄운 착수계 생성기 화면"
          width="1440"
          height="1000"
          loading="lazy"
        />
      </a>
      <figcaption>실제 실행 화면 ② · 자격번호·변경사유 누락 시 임의 생성하지 않고 사람 확인(검수 대기)으로 분리</figcaption>
    </figure>
  </div>
)}
<style>
  .l02-preview-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin:1rem 0; }
  @media (max-width:900px) { .l02-preview-grid { grid-template-columns:1fr; } }
</style>
