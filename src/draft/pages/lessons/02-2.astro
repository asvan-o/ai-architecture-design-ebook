---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import TopicProgress from '../../components/TopicProgress.astro';
import { commencementFiles } from '../../../../scripts/daejeon-commencement-assets.mjs';
import '../../styles/lesson02.css';
import '../../styles/lesson02-automation.css';
import '../../styles/lesson02-exercises.css';
import {
  lesson02EasyTitle,
  lesson02EasyLead,
  easySections,
  easyPeriods,
  easyGoals,
  openAiEnvCoreSentence,
  openAiThreeEnvCards,
  openAiEnvComparisonRows,
  openAiTimelineNote,
  openAiWorkflowContrast,
  openAiCommonMisconceptions,
  comparisonWithStandardL02,
  twoAiRoleCards,
  setupTwoMinuteSteps,
  chatGptPrompt1Role,
  chatGptPrompt2Topic,
  chatGptStep3Questions,
  chatGptPrompt4Answers,
  chatGptPrompt5SpecRequest,
  codexPrompt1Role,
  codexBackupSpecPrompt,
  step3ChatGptAuditSteps,
  chatGptPrompt6AuditMessage,
  finalThreeMinuteChecks,
} from '../../content/daejeon-lesson02-2-easy';

const sectionProps = (id: string) => ({
  ...easySections.find((s) => s.id === id)!,
  index: easySections.findIndex((s) => s.id === id) + 1,
});

const tocGroups = easyPeriods.map((period, index) => ({
  id: period.id,
  title: 'Part ' + (index + 1) + ' · ' + period.title,
  items: [{ id: period.id, title: 'Part ' + (index + 1) + ' 시작' }, ...period.sections],
}));
const toc = tocGroups.flatMap((g) => g.items);
const enabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const handoffSvg = commencementFiles.handoffSvg;
const easyUiPreview = commencementFiles.easyUiPreview;
const easyPrintPreview = commencementFiles.easyPrintPreview;
const easyStarterZip = commencementFiles.easyStarterZip;
---
<ReviewLayout
  title={lesson02EasyTitle}
  lead={lesson02EasyLead}
  page="lesson"
  lessonId="02-2"
  eyebrow="LESSON 02-2 · EASY START"
  sharedScreen
  {toc}
  {tocGroups}
>
<div class="lesson02-review lesson02-automation l022-easy">

  <TopicProgress
    lesson="02"
    items={[{
      topic: 2,
      status: '완결',
      note: 'OpenAI 3가지 작업 환경(Chat · Work · Codex) 차이를 구분하고, 플랜·검수자 ChatGPT(파일 직접 첨부)와 구현자 Codex(6.1 Sol) 분업으로 착수신고서·선임계 단일 파일 도구를 완성합니다.',
    }]}
  />

  <div class="lesson02-summary">
    {easyPeriods.map((period, index) => (
      <article>
        <h2>Part {index + 1} · {period.title}</h2>
        <p>{period.output}</p>
      </article>
    ))}
  </div>

  <h2>학습 목표</h2>
  <ol class="lesson02-goals">
    {easyGoals.map((goal) => <li>{goal}</li>)}
  </ol>

  {easyPeriods.map((period, periodIndex) => (
    <div class="day-period" id={period.id} data-period={periodIndex + 1} data-teaching-minutes="50">
      <header class="period-heading">
        <p>Part {periodIndex + 1}</p>
        <h2>{period.title}</h2>
        <p>파트 산출물: {period.output}</p>
      </header>

      {periodIndex === 0 && <>
        <ReviewSection {...sectionProps('l022-openai-modes')} summary="Chat · Work · Codex는 지능 차이가 아니라 사용 목적·파일 접근 권한·실행 도구가 다른 세 가지 작업 환경입니다.">
          <aside class="lesson02-decision" data-openai-core-callout>
            <h3>핵심 한 줄 정리</h3>
            <p><strong>“{openAiEnvCoreSentence}”</strong> — 세 환경은 기능이 일부 겹치므로 AI의 능력만이 아니라 <strong>실행 환경, 로컬 파일 접근 권한, 최종 결과물의 성격</strong>을 기준으로 선택합니다.</p>
          </aside>

          <div class="l022-env-grid" data-openai-env-cards>
            {openAiThreeEnvCards.map((env) => (
              <article class="l02-ab-card l022-env-card">
                <h3>{env.name}</h3>
                <dl>
                  <dt><strong>핵심 역할</strong></dt>
                  <dd>{env.role}</dd>
                  <dt><strong>적합한 작업</strong></dt>
                  <dd>{env.strengths}</dd>
                  <dt><strong>권한·한계 기준</strong></dt>
                  <dd>{env.boundary}</dd>
                </dl>
              </article>
            ))}
          </div>

          <div class="lesson02-table" data-openai-comparison-table>
            <table>
              <caption>Chat · Work · Codex 기능 및 권한 비교 (◎ 주력 / ○ 지원 / △ 환경·권한 조건부 / × 기본 미지원)</caption>
              <thead>
                <tr>
                  <th scope="col">비교 항목</th>
                  <th scope="col">Chat</th>
                  <th scope="col">Work</th>
                  <th scope="col">Codex</th>
                </tr>
              </thead>
              <tbody>
                {openAiEnvComparisonRows.map(([label, chatVal, workVal, codexVal]) => (
                  <tr>
                    <th scope="row" data-label="비교 항목">{label}</th>
                    <td data-label="Chat">{chatVal}</td>
                    <td data-label="Work">{workVal}</td>
                    <td data-label="Codex"><strong>{codexVal}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="l022-footnote">{openAiTimelineNote}</p>

          <div class="lesson02-decision" data-easy-prompt-block>
            <h3>왜 단일 HTML 실습에서도 <code>Chat + 로컬 Codex</code> 분업을 익히나요?</h3>
            <ul class="l022-contrast-list">
              {openAiWorkflowContrast.map(([head, body]) => (
                <li><strong>{head}</strong>: {body}</li>
              ))}
            </ul>
          </div>

          <h3>시작 전 꼭 바로잡을 오해 5가지</h3>
          <ol class="lesson02-checklist" data-openai-misconceptions>
            {openAiCommonMisconceptions.map(([title, desc]) => (
              <li>
                <strong>{title}</strong>
                <p>{desc}</p>
              </li>
            ))}
          </ol>
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-why-simple')} summary="별도 설치 없이 파일 1개로 작동하며, 착수신고서와 책임기술자 선임계 2장을 한 번 입력으로 생성합니다.">
          <p class="l02-definition">
            이번 <strong>제2-2차시</strong>에서는 서버 구동이나 다중 폴더 없이 <strong>단일 <code>.html</code> 파일 1개</strong>로 작동하는 <strong>착수신고서 · 책임기술자 선임계 자동 작성 도구</strong>(신규 양식 · 다수 책임기술자 입력 · 편집 가능한 Word 저장 · 2쪽 분리 인쇄)를 제작합니다.
          </p>

          <div class="lesson02-table" data-easy-vs-standard-table>
            <table>
              <caption>제2-2차시(초간단 입문편) vs 제2차시(4종 표준편) 비교</caption>
              <thead>
                <tr>
                  <th scope="col">비교 항목</th>
                  <th scope="col">제2-2차시 · 초간단 입문편</th>
                  <th scope="col">제2차시 · 4종 표준편</th>
                </tr>
              </thead>
              <tbody>
                {comparisonWithStandardL02.map(([item, easyVal, stdVal]) => (
                  <tr>
                    <th scope="row" data-label="비교 항목">{item}</th>
                    <td data-label="제2-2차시(입문)"><strong>{easyVal}</strong></td>
                    <td data-label="제2차시(표준)">{stdVal}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {enabled && easyStarterZip && (
            <aside class="lesson02-decision l022-download-box" data-easy-starter-download>
              <h3>완성 샘플 &amp; 단계별 입력 지시문 ZIP 다운로드</h3>
              <p>압축 해제 후 <code>착수계_선임계_초간단생성기.html</code>을 실행하면 다수 책임기술자 추가, 한글 금액 자동 표기, Word(<code>.doc</code>) 저장, 2페이지 분리 인쇄가 적용된 완성 샘플과 지시문 모음을 바로 확인할 수 있습니다.</p>
              <p class="l022-web-only">
                <a class="review-download" href={`${base}/${easyStarterZip.outputPath}`} download={easyStarterZip.file}>
                  📦 초간단 착수계·선임계 완성 샘플 &amp; 지시문 ZIP 다운로드 ({Math.round(easyStarterZip.bytes / 1024)} KB)
                </a>
              </p>
            </aside>
          )}

          {enabled && easyUiPreview && easyPrintPreview && (
            <div class="l022-preview-pair">
              <figure class="l02-ab-preview">
                <a href={`${base}/${easyUiPreview.outputPath}`} target="_blank" rel="noreferrer" aria-label="초간단 생성기 실행 화면 크게 보기">
                  <img
                    src={`${base}/${easyUiPreview.outputPath}`}
                    alt="공통 계약 정보 및 다수 책임기술자 입력 패널과 우측 착수신고서·책임기술자 선임계 실시간 미리보기 화면"
                    width="1440"
                    height="920"
                    loading="lazy"
                  />
                </a>
                <figcaption>실행 화면 · 기본 계약 항목과 다수 책임기술자를 입력하면 두 문서가 동시에 갱신됩니다.</figcaption>
              </figure>
              <figure class="l02-ab-preview">
                <a href={`${base}/${easyPrintPreview.outputPath}`} target="_blank" rel="noreferrer" aria-label="2페이지 분리 출력 결과 크게 보기">
                  <img
                    src={`${base}/${easyPrintPreview.outputPath}`}
                    alt="Word 및 A4 인쇄 시 1페이지 용역 착수신고서와 2페이지 책임기술자 선임계가 별도 페이지로 분리 출력된 화면"
                    width="1992"
                    height="1459"
                    loading="lazy"
                  />
                </a>
                <figcaption>출력 결과 · 편집 가능한 Word 파일 및 A4 인쇄 시 1쪽(착수신고서)과 2쪽(선임계)이 페이지 분리됩니다.</figcaption>
              </figure>
            </div>
          )}
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-two-roles')} summary="ChatGPT는 플랜 수립·검수를 맡고, Codex(6.1 Sol)는 파일 생성과 완료 보고를 맡습니다.">
          {enabled && handoffSvg && (
            <figure class="l02-infographic" data-handoff-diagram>
              <img
                src={`${base}/${handoffSvg.outputPath}`}
                alt="플랜·검수자 ChatGPT와 사람 전달, 개발·구현자 Codex 6.1 Sol 사이의 역할 지정·문답·완료보고 및 산출 파일 직접 첨부 검수 흐름도"
                width="1200"
                height="540"
                loading="lazy"
              />
              <figcaption>
                <strong>진행 핵심: 일반 웹 ChatGPT는 PC 내부 파일을 읽지 못하므로, 코덱스가 생성한 결과 파일(<code>.html</code>, <code>.md</code> 등)을 직접 첨부해 검수받습니다.</strong>
              </figcaption>
            </figure>
          )}

          <div class="l022-role-grid">
            {twoAiRoleCards.map((item) => (
              <article class="l02-ab-card">
                <h3>{item.role}</h3>
                <dl>
                  <dt><strong>담당 역할</strong></dt>
                  <dd>{item.canDo}</dd>
                  <dt><strong>주의 사항</strong></dt>
                  <dd>{item.cannotDo}</dd>
                  <dt><strong>연결 방법</strong></dt>
                  <dd><strong>{item.howToBridge}</strong></dd>
                </dl>
              </article>
            ))}
          </div>
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-folder-setup')} summary="빈 폴더 1개를 만들고 왼쪽에 ChatGPT, 오른쪽에 Codex(6.1 Sol)를 배치합니다.">
          <ol class="lesson02-checklist" data-easy-setup-steps>
            {setupTwoMinuteSteps.map(([stepTitle, desc]) => (
              <li>
                <strong>{stepTitle}</strong>
                <p>{desc}</p>
              </li>
            ))}
          </ol>
        </ReviewSection>
      </>}

      {periodIndex === 1 && <>
        <ReviewSection {...sectionProps('l022-step1-gpt-plan')} summary="왼쪽 ChatGPT 창에 역할과 주제를 전달하고, 사전 확인 질문(Q1~Q3) 답변 후 [1차 구현 지시문]을 받습니다.">
          <p>왼쪽 <strong>ChatGPT 채팅창</strong>에서 아래 <strong>1번 ~ 5번 순서대로</strong> 진행합니다.</p>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span><strong>ChatGPT 1번</strong> · 플랜 수립자 및 검수자 역할 지정</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-gpt-1">복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-gpt-1">{chatGptPrompt1Role}</pre>
          </div>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span><strong>ChatGPT 2번</strong> · 제작 주제 전달 및 사전 확인 질문 요청</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-gpt-2">복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-gpt-2">{chatGptPrompt2Topic}</pre>
          </div>

          <aside class="lesson02-decision" data-easy-prompt-block>
            <h4><strong>ChatGPT 3번</strong> · 2번 질문에 대한 ChatGPT의 사전 확인 질문</h4>
            <ul class="l022-qa-list">
              {chatGptStep3Questions.map((q) => <li><strong>{q}</strong></li>)}
            </ul>
          </aside>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span><strong>ChatGPT 4번</strong> · 사전 확인 질문에 대한 답변 입력</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-gpt-4">복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-gpt-4">{chatGptPrompt4Answers}</pre>
          </div>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span><strong>ChatGPT 5번</strong> · 핵심 규칙 확정 및 <code>[1차 구현 지시문]</code> 작성 요청</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-gpt-5">복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-gpt-5">{chatGptPrompt5SpecRequest}</pre>
          </div>

          <p>ChatGPT가 코드 없이 코덱스 전달용 <strong><code>[1차 구현 지시문]</code></strong>을 출력하면 그대로 복사해 오른쪽 Codex(<code>6.1 Sol</code>) 창으로 이동합니다.</p>
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-step2-codex-build')} summary="오른쪽 Codex(6.1 Sol)에 개발·구현자 역할을 먼저 지정한 뒤, ChatGPT의 구현 지시문을 붙여 넣어 파일과 완료 보고를 생성합니다.">
          <p>빈 실습 폴더가 연결된 오른쪽 <strong>Codex(<code>6.1 Sol</code>) 창</strong>에서 아래 <strong>1번 ~ 3번 순서대로</strong> 진행합니다.</p>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span><strong>Codex 1번</strong> · 개발·구현자 역할 및 완료 보고 규칙 지정</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-codex-1">복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-codex-1">{codexPrompt1Role}</pre>
          </div>

          <ol class="lesson02-checklist" data-easy-setup-steps>
            <li>
              <strong>Codex 2번 · ChatGPT <code>[1차 구현 지시문]</code> 복사해 붙여넣기</strong>
              <p>앞 단계(ChatGPT 5번)에서 생성된 <code>[1차 구현 지시문]</code>을 복사해 Codex 창에 그대로 붙여 넣고 실행합니다.</p>
            </li>
            <li>
              <strong>Codex 3번 · 작업 완료 보고 및 생성 산출물 확인</strong>
              <p>구현이 끝나면 채팅창에 <code>[작업 완료 보고]</code>(생성 파일명·구현 기능·확인 사항)가 정리되어 나오고, 실습 폴더 안에 <code>.html</code> 파일과 완료 보고 문서(<code>.md</code> 등) 산출물이 생성됩니다. <code>.html</code> 파일을 더블클릭해 동작을 확인합니다.</p>
            </li>
          </ol>

          <details class="l022-backup-details" open>
            <summary>참고 · ChatGPT 지시문 대신 바로 비교·실행할 수 있는 표준 구현 지시문 (백업용)</summary>
            <div class="l022-prompt-card" data-easy-prompt-block>
              <div class="l022-prompt-head">
                <span>Codex 2번 백업 · 표준 <code>[1차 구현 지시문]</code></span>
                <button type="button" class="l022-copy-btn" data-l022-copy="l022-codex-backup">복사하기</button>
              </div>
              <pre class="lesson02-program-tree" id="l022-codex-backup">{codexBackupSpecPrompt}</pre>
            </div>
          </details>
        </ReviewSection>
      </>}

      {periodIndex === 2 && <>
        <ReviewSection {...sectionProps('l022-step3-gpt-audit')} summary="코덱스의 완료 보고와 생성된 .html·.md 파일을 ChatGPT에 직접 첨부(+)해 검수받고 샘플 제작을 완료합니다.">
          <aside class="review-callout" style="border-left: 4px solid #ea580c; background: #fff7ed;">
            <strong>필수 확인 · 결과 파일 직접 첨부(+)</strong>
            <p>ChatGPT는 PC 내부 폴더를 읽을 수 없으므로, 반드시 실습 폴더에 생성된 <strong><code>.html</code> 파일 및 완료 보고 문서(<code>.md</code> 등)를 입력창에 직접 첨부</strong>하고 코덱스의 완료 보고를 함께 전달해야 합니다.</p>
          </aside>

          <ol class="lesson02-checklist" data-easy-audit-steps>
            {step3ChatGptAuditSteps.map(([title, desc]) => (
              <li>
                <strong>{title}</strong>
                <p>{desc}</p>
              </li>
            ))}
          </ol>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span><strong>ChatGPT 6번</strong> · 산출 파일(<code>.html</code>, <code>.md</code> 등) 첨부 후 검수 요청 입력문</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-gpt-6">복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-gpt-6">{chatGptPrompt6AuditMessage}</pre>
          </div>

