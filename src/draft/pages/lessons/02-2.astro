---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import TopicProgress from '../../components/TopicProgress.astro';
import { commencementFiles } from '../../../../scripts/daejeon-commencement-assets.mjs';
import '../../styles/lesson02.css';
import '../../styles/lesson02-automation.css';
import '../../styles/lesson02-exercises.css';
import {
  lesson02EasyTitle,
  lesson02EasyLead,
  easySections,
  easyPeriods,
  easyGoals,
  comparisonWithStandardL02,
  twoAiRoleCards,
  setupTwoMinuteSteps,
  step1ChatGptPrompt,
  step2CodexBackupPrompt,
  step3ChatGptAuditSteps,
  step3ChatGptAuditPrompt,
  step4CodexOptionalPrompt,
  finalThreeMinuteChecks,
} from '../../content/daejeon-lesson02-2-easy';

const sectionProps = (id: string) => ({
  ...easySections.find((s) => s.id === id)!,
  index: easySections.findIndex((s) => s.id === id) + 1,
});

const tocGroups = easyPeriods.map((period, index) => ({
  id: period.id,
  title: 'Part ' + (index + 1) + ' · ' + period.title,
  items: [{ id: period.id, title: 'Part ' + (index + 1) + ' 시작' }, ...period.sections],
}));
const toc = tocGroups.flatMap((g) => g.items);
const enabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const handoffSvg = commencementFiles.handoffSvg;
const easyUiPreview = commencementFiles.easyUiPreview;
const easyPrintPreview = commencementFiles.easyPrintPreview;
const easyStarterZip = commencementFiles.easyStarterZip;
---
<ReviewLayout
  title={lesson02EasyTitle}
  lead={lesson02EasyLead}
  page="lesson"
  lessonId="02-2"
  eyebrow="LESSON 02-2 · EASY START"
  sharedScreen
  {toc}
  {tocGroups}
>
<div class="lesson02-review lesson02-automation l022-easy">

  <TopicProgress
    lesson="02"
    items={[{
      topic: 2,
      status: '완결',
      note: '가장 쉬운 단일 HTML 파일(착수신고서+책임기술자 선임계 2종)을 검수자 ChatGPT(파일 직접 첨부)와 설계자 Codex(6.1 Sol) 2인 분업으로 완성하는 입문 실습입니다.',
    }]}
  />

  <div class="lesson02-summary">
    {easyPeriods.map((period, index) => (
      <article>
        <h2>Part {index + 1} · {period.title}</h2>
        <p>{period.output}</p>
      </article>
    ))}
  </div>

  <h2>이번 입문 차시의 학습 목표</h2>
  <ol class="lesson02-goals">
    {easyGoals.map((goal) => <li>{goal}</li>)}
  </ol>

  {easyPeriods.map((period, periodIndex) => (
    <div class="day-period" id={period.id} data-period={periodIndex + 1} data-teaching-minutes="50">
      <header class="period-heading">
        <p>Part {periodIndex + 1}</p>
        <h2>{period.title}</h2>
        <p>이번 파트의 결과: {period.output}</p>
      </header>

      {periodIndex === 0 && <>
        <ReviewSection {...sectionProps('l022-why-simple')} summary="복잡한 서버·다중 파일을 걷어내고, 꼭 필요한 문서 2장과 단일 .html 파일 1개에만 집중합니다.">
          <p class="l02-definition">
            처음 바이브코딩을 배울 때는 파일을 여러 개로 나누거나 서버를 띄우는 과정 자체가 장벽이 됩니다. 이번 <strong>제2-2차시</strong>에서는 모든 화면과 계산식·인쇄 서식을 <strong><code>착수계_선임계_생성기.html</code> 딱 1개 파일</strong> 안에 담아 더블클릭만으로 바로 실행합니다.
          </p>

          <div class="lesson02-table" data-easy-vs-standard-table>
            <table>
              <caption>제2-2차시(초간단 입문편) vs 제2차시(4종 표준·심화편) 한눈 비교</caption>
              <thead>
                <tr>
                  <th scope="col">비교 항목</th>
                  <th scope="col">제2-2차시 · 초간단 입문편 (오늘 실습)</th>
                  <th scope="col">제2차시 · 4종 표준편 (심화 확장)</th>
                </tr>
              </thead>
              <tbody>
                {comparisonWithStandardL02.map(([item, easyVal, stdVal]) => (
                  <tr>
                    <th scope="row" data-label="비교 항목">{item}</th>
                    <td data-label="제2-2차시(입문)"><strong>{easyVal}</strong></td>
                    <td data-label="제2차시(표준)">{stdVal}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {enabled && easyStarterZip && (
            <aside class="lesson02-decision l022-download-box" data-easy-starter-download>
              <h3>완성 작동 예시 &amp; 단계별 질문 모음 ZIP 먼저 내려받기</h3>
              <p>수업을 시작하기 전 아래 ZIP을 내려받아 압축을 풀고 <code>착수계_선임계_초간단생성기.html</code>을 더블클릭해 보세요. 오늘 우리가 4단계로 직접 만들 최종 목표 화면을 5초 만에 미리 체험할 수 있습니다.</p>
              <p class="l022-web-only">
                <a class="review-download" href={`${base}/${easyStarterZip.outputPath}`} download={easyStarterZip.file}>
                  📦 초간단 착수계·선임계 완성본 &amp; 지시문 ZIP 다운로드 ({Math.round(easyStarterZip.bytes / 1024)} KB)
                </a>
              </p>
            </aside>
          )}

          {enabled && easyUiPreview && easyPrintPreview && (
            <div class="l022-preview-pair">
              <figure class="l02-ab-preview">
                <a href={`${base}/${easyUiPreview.outputPath}`} target="_blank" rel="noreferrer" aria-label="초간단 생성기 실행 화면 크게 보기">
                  <img
                    src={`${base}/${easyUiPreview.outputPath}`}
                    alt="왼쪽 공통 정보 7칸 입력창과 오른쪽 착수신고서·책임기술자 선임계 실시간 미리보기가 나란히 배치된 단일 HTML 실행 화면"
                    width="1440"
                    height="920"
                    loading="lazy"
                  />
                </a>
                <figcaption>완성 목표 화면 · 왼쪽 7칸만 고치면 오른쪽 착수신고서와 선임계 두 문서가 동시에 바뀝니다.</figcaption>
              </figure>
              <figure class="l02-ab-preview">
                <a href={`${base}/${easyPrintPreview.outputPath}`} target="_blank" rel="noreferrer" aria-label="A4 2페이지 분리 인쇄 결과 크게 보기">
                  <img
                    src={`${base}/${easyPrintPreview.outputPath}`}
                    alt="A4 인쇄 시 1페이지 용역 착수신고서와 2페이지 책임기술자 선임계가 이어 붙지 않고 각각 별도 페이지로 깔끔히 나뉘어 출력된 모습"
                    width="1992"
                    height="1459"
                    loading="lazy"
                  />
                </a>
                <figcaption>A4 인쇄 / PDF 저장 결과 · 입력창은 사라지고 1쪽(착수신고서)과 2쪽(책임기술자 선임계)이 정확히 2페이지로 분리됩니다.</figcaption>
              </figure>
            </div>
          )}
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-two-roles')} summary="ChatGPT는 내 PC 폴더를 직접 못 읽으므로 결과 .html 파일을 마우스로 끌어다 첨부해 감리를 맡깁니다.">
          <p>
            오늘 수업에서 수강생이 직접 복잡한 코딩 명령어를 고민할 필요는 없습니다. 건축 실무에서 <strong>감리자(검수자)</strong>와 <strong>시공자(설계·제작자)</strong>를 나누듯 두 AI에게 역할을 나누어 맡깁니다.
          </p>

          {enabled && handoffSvg && (
            <figure class="l02-infographic" data-handoff-diagram>
              <img
                src={`${base}/${handoffSvg.outputPath}`}
                alt="검수자 ChatGPT와 사람 파일 전달, 설계자 Codex 6.1 Sol 사이의 지시문 복사 및 단일 HTML 파일 직접 첨부 검수 흐름도"
                width="1200"
                height="540"
                loading="lazy"
              />
              <figcaption>
                <strong>핵심 원리: ChatGPT는 내 컴퓨터 폴더 안을 볼 수 없으므로, 코덱스가 만든 <code>.html</code> 파일 1개를 마우스로 끌어다 직접 첨부합니다.</strong>
                <p>결과물이 파일 1개뿐이기 때문에 압축할 필요도 없이 탐색기에서 바로 끌어다 놓으면 ChatGPT가 전체 코드를 읽고 감리해 줍니다.</p>
              </figcaption>
            </figure>
          )}

          <div class="l022-role-grid">
            {twoAiRoleCards.map((item) => (
              <article class="l02-ab-card">
                <h3>{item.role}</h3>
                <dl>
                  <dt><strong>잘하는 일</strong></dt>
                  <dd>{item.canDo}</dd>
                  <dt><strong>주의할 한계</strong></dt>
                  <dd>{item.cannotDo}</dd>
                  <dt><strong>사람이 연결하는 방법</strong></dt>
                  <dd><strong>{item.howToBridge}</strong></dd>
                </dl>
              </article>
            ))}
          </div>

          <aside class="review-callout">
            <strong>왜 파일 1개(<code>.html</code>) 방식이 ChatGPT 첨부 검수에 압도적으로 유리한가요?</strong>
            <p>파일이 7~8개로 나뉘어 여러 폴더에 흩어져 있으면 초보자가 ChatGPT에 어떤 파일을 올려야 할지 헷갈리고 누락이 생깁니다. 반면 <strong>단일 <code>.html</code> 파일 1개</strong>에는 화면·계산식·인쇄 규칙이 모두 들어 있어, <strong>그 파일 하나만 ChatGPT에 올리면 100% 완벽한 코드 감리</strong>가 가능합니다.</p>
          </aside>
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-folder-setup')} summary="Node.js 설치 없이 새 빈 폴더 1개만 만들고 왼쪽에 ChatGPT, 오른쪽에 Codex(6.1 Sol)를 띄웁니다.">
          <ol class="lesson02-checklist" data-easy-setup-steps>
            {setupTwoMinuteSteps.map(([stepTitle, desc]) => (
              <li>
                <strong>{stepTitle}</strong>
                <p>{desc}</p>
              </li>
            ))}
          </ol>
          <div class="lesson02-decision">
            <strong>모델 선택 확인 · 왜 Codex에서 <code>6.1 Sol</code> 모델을 선택하나요?</strong>
            <p><code>6.1 Sol</code> 모델은 단일 HTML 화면 구성, 한글 금액 산식, 인쇄용 페이지 분리(<code>@media print</code>)를 빠르고 군더더기 없이 한 파일로 작성하는 데 적합합니다. Codex 입력창 아래(또는 상단) 모델 표시가 <strong><code>6.1 Sol</code></strong>로 되어 있는지 확인하세요.</p>
          </div>
        </ReviewSection>
      </>}

      {periodIndex === 1 && <>
        <ReviewSection {...sectionProps('l022-step1-gpt-plan')} summary="먼저 왼쪽 일반 ChatGPT 창에 원하는 기능을 쉽게 말하고, Codex에게 넘길 제작 지시문을 받아 냅니다.">
          <p>
            첫 단계는 코덱스가 아니라 <strong>왼쪽의 일반 ChatGPT 채팅창(검수자)</strong>에서 시작합니다. 아래 상자의 글을 복사해 ChatGPT에 그대로 붙여 넣으세요. 마지막 줄에 <em>“너는 HTML 코드를 직접 짜지 말고 코덱스에게 줄 지시문만 써 줘”</em>라고 적어 두었기 때문에, ChatGPT가 코덱스용 깔끔한 명령문을 대신 만들어 줍니다.
          </p>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span>STEP 1 · 왼쪽 <strong>일반 ChatGPT 창</strong>에 붙여 넣을 요청문</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-p1">요청문 복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-p1">{step1ChatGptPrompt}</pre>
          </div>

          <aside class="lesson02-decision">
            <h4>ChatGPT 답변이 나오면 딱 2가지만 눈으로 확인하세요</h4>
            <ul>
              <li><strong>① 코덱스에게 붙여 넣을 <code>[코덱스 제작 지시문]</code> 상자</strong>가 깔끔하게 하나로 정리되어 나왔나요?</li>
              <li><strong>② 결과물을 여러 파일이 아닌 <code>착수계_선임계_생성기.html</code> 단일 파일 1개</strong>로 만들라는 조건과 <strong>1쪽·2쪽 페이지 분리 인쇄</strong> 조건이 들어 있나요? 확인됐다면 그 지시문 블록을 복사해 Step 2로 넘어갑니다.</li>
            </ul>
          </aside>
        </ReviewSection>

        <ReviewSection {...sectionProps('l022-step2-codex-build')} summary="방금 ChatGPT가 써 준 지시문을 오른쪽 Codex(6.1 Sol) 창에 붙여 넣어 내 폴더에 실제 .html 파일을 생성합니다.">
          <ol class="lesson02-checklist">
            <li>
              <strong>1. 오른쪽 Codex(<code>6.1 Sol</code>) 창에 지시문 붙여 넣기</strong>
              <p>Step 1에서 ChatGPT가 만들어 준 <code>[코덱스 제작 지시문]</code>을 복사해 빈 실습 폴더(<code>착수계_초간단실습</code>)가 연결된 Codex 창에 붙여 넣고 실행합니다.</p>
            </li>
            <li>
              <strong>2. 탐색기에서 생성된 <code>착수계_선임계_생성기.html</code> 더블클릭하기</strong>
              <p>코덱스가 파일 생성을 마치면 내 컴퓨터 <code>착수계_초간단실습</code> 폴더 안에 <code>착수계_선임계_생성기.html</code> 파일 1개가 나타납니다. 더블클릭하면 크롬이나 엣지 브라우저에서 바로 화면이 열립니다.</p>
            </li>
            <li>
              <strong>3. 샘플 버튼과 인쇄 미리보기 한 번 눌러 보기</strong>
              <p>화면의 <code>[연습 샘플 넣기]</code> 버튼과 <code>[A4 인쇄 / PDF 저장]</code>을 한 번 눌러 어떻게 보이는지 가볍게 확인한 뒤, 곧바로 Step 3(ChatGPT 파일 첨부 감리)으로 이동합니다.</p>
            </li>
          </ol>

          <details class="l022-backup-details" open>
            <summary>참고 · 바로 Codex(6.1 Sol)에 넣어 비교해 볼 수 있는 표준 제작 지시문 (백업본)</summary>
            <p>만약 ChatGPT 답변이 너무 짧거나 HTML 코드를 직접 짜 버렸다면, 아래 검증된 표준 지시문을 복사해 Codex(<code>6.1 Sol</code>) 창에 바로 붙여 넣어도 됩니다.</p>
            <div class="l022-prompt-card" data-easy-prompt-block>
              <div class="l022-prompt-head">
                <span>STEP 2 백업 · 오른쪽 <strong>Codex (6.1 Sol)</strong> 직접 입력용 표준 지시문</span>
                <button type="button" class="l022-copy-btn" data-l022-copy="l022-p2">표준 지시문 복사하기</button>
              </div>
              <pre class="lesson02-program-tree" id="l022-p2">{step2CodexBackupPrompt}</pre>
            </div>
          </details>
        </ReviewSection>
      </>}

      {periodIndex === 2 && <>
        <ReviewSection {...sectionProps('l022-step3-gpt-audit')} summary="내 폴더를 못 보는 ChatGPT에게 방금 만들어진 .html 파일을 마우스로 끌어다 첨부하고 깐깐한 감리를 맡깁니다.">
          <aside class="review-callout" style="border-left: 4px solid #ea580c; background: #fff7ed;">
            <strong>가장 중요한 실전 포인트 · 파일을 반드시 직접 첨부(+)하세요!</strong>
            <p>일반 ChatGPT 창에 글로만 <em>“내 폴더에 있는 파일 검사해 줘”</em>라고 치면 ChatGPT는 내 PC를 읽지 못해 추측으로 대답합니다. 반드시 <strong>탐색기에서 <code>착수계_선임계_생성기.html</code> 파일을 마우스로 끌어 ChatGPT 메시지 창에 첨부</strong>한 뒤 아래 글을 보내세요.</p>
          </aside>

          <ol class="lesson02-checklist" data-easy-audit-steps>
            {step3ChatGptAuditSteps.map(([title, desc]) => (
              <li>
                <strong>{title}</strong>
                <p>{desc}</p>
              </li>
            ))}
          </ol>

          <div class="l022-prompt-card" data-easy-prompt-block>
            <div class="l022-prompt-head">
              <span>STEP 3 · <code>.html</code> 파일을 첨부한 뒤 왼쪽 <strong>ChatGPT 창</strong>에 붙여 넣을 감리 요청문</span>
              <button type="button" class="l022-copy-btn" data-l022-copy="l022-p3">감리 요청문 복사하기</button>
            </div>
            <pre class="lesson02-program-tree" id="l022-p3">{step3ChatGptAuditPrompt}</pre>
          </div>

          <div class="lesson02-decision">
            <h4>ChatGPT 감리에서 자주 잡아내는 대표 구멍 3가지</h4>
            <ul>
              <li><strong>1억 원 한글 표기 실수</strong>: <code>100,000,000</code>원을 넣었을 때 <code>“일금 일억원정”</code> 대신 <code>“일금 일억만원정”</code>처럼 잘못 찍히는 코드 구멍</li>
              <li><strong>인쇄 페이지 붙음 현상</strong>: 화면에서는 두 장처럼 보이지만 실제 인쇄(<code>Ctrl + P</code>)를 누르면 1쪽 아래에 2쪽 제목이 딸려 올라오는 CSS 누락</li>
              <li><strong>입력창 같이 인쇄됨</strong>: 인쇄할 때 왼쪽 입력칸이나 상단 버튼이 숨겨지지 않고 A4 용지에 그대로 찍히는 문제</li>
            </ul>
          </div>
        </ReviewSection>

