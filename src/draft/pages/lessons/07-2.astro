    type BlenderProfile,
    type VersionPolicy,
  } from '../../content/daejeon-all-in-one-installer';

  const initL062Page = () => {
    // 1. Static copy buttons
    document.querySelectorAll<HTMLButtonElement>('[data-l062-copy]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const text = btn.dataset.l062Copy || '';
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.textContent;
          btn.textContent = '복사됨 ✓';
          setTimeout(() => {
            btn.textContent = orig;
          }, 1400);
        } catch {
          // ignore
        }
      });
    });

    // 2. Interactive All-in-One PowerShell Builder
    const builder = document.querySelector<HTMLElement>('[data-l062-builder]');
    if (!builder || builder.dataset.bound === '1') return;
    builder.dataset.bound = '1';

    const customSkillEl = document.getElementById('l062-custom-skill-json');
    const customSkillMd: string = customSkillEl ? JSON.parse(customSkillEl.textContent || '""') : '';

    const modBoxes = Array.from(builder.querySelectorAll<HTMLInputElement>('[data-l062-mod]'));
    const profileRadios = Array.from(builder.querySelectorAll<HTMLInputElement>('input[name="l062-blender-profile"]'));
    const policyRadios = Array.from(builder.querySelectorAll<HTMLInputElement>('input[name="l062-version-policy"]'));
    const presetBtns = Array.from(builder.querySelectorAll<HTMLButtonElement>('[data-l062-preset]'));
    const warningBox = builder.querySelector<HTMLElement>('[data-l062-warnings]');
    const countPill = builder.querySelector<HTMLElement>('[data-l062-count]');
    const scriptPre = builder.querySelector<HTMLElement>('[data-l062-script-output]');
    const copyGenBtn = builder.querySelector<HTMLButtonElement>('[data-l062-copy-generated]');
    const dlPs1Btn = builder.querySelector<HTMLButtonElement>('[data-l062-download-ps1]');
    const expandBtn = builder.querySelector<HTMLButtonElement>('[data-l062-expand-script]');

    const readSelection = (): InstallerSelection => {
      const sel: InstallerSelection = { ...defaultInstallerSelection };
      for (const box of modBoxes) {
        const key = box.dataset.l062Mod as keyof InstallerSelection;
        if (key && typeof sel[key] === 'boolean') {
          (sel[key] as boolean) = box.checked;
        }
      }
      const chosenProfile = profileRadios.find((r) => r.checked)?.value as BlenderProfile | undefined;
      if (chosenProfile) sel.blenderProfile = chosenProfile;
      const chosenPolicy = policyRadios.find((r) => r.checked)?.value as VersionPolicy | undefined;
      if (chosenPolicy) sel.versionPolicy = chosenPolicy;
      return sel;
    };

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const renderBuilder = () => {
      const sel = readSelection();
      const checkedCount = modBoxes.filter((b) => b.checked).length;
      if (countPill) {
        countPill.textContent = `선택됨: ${checkedCount} / ${modBoxes.length}개 구간`;
      }

      const warnings = evaluateSetupWarnings(sel);
      if (warningBox) {
        if (warnings.length === 0) {
          warningBox.hidden = true;
          warningBox.innerHTML = '';
        } else {
          warningBox.hidden = false;
          warningBox.innerHTML = warnings
            .map(
              (w) => `<div class="l062-warn-item" data-warn-id="${escapeHtml(w.id)}">
                <strong>⚠️ ${escapeHtml(w.title)}</strong>
                <p>${escapeHtml(w.detail)}</p>
              </div>`,
            )
            .join('');
        }
      }

      const scriptText = buildAllInOnePowerShell(sel, customSkillMd);
      if (scriptPre) {
        scriptPre.textContent = scriptText;
      }
    };

    const applyPreset = (preset: string) => {
      const targetKeys: Record<string, boolean> = {
        git: preset !== 'none',
        node: preset === 'all',
        pythonUv: preset !== 'none',
        optA: preset === 'all' || preset === 'l072',
        optB: preset === 'all' || preset === 'l072',
        blender: preset === 'all' || preset === 'blender',
        codexConfig: preset !== 'none',
        skills: preset === 'all',
      };
      for (const box of modBoxes) {
        const k = box.dataset.l062Mod || '';
        if (k in targetKeys) box.checked = targetKeys[k];
      }
      presetBtns.forEach((b) => {
        const active = b.dataset.l062Preset === preset;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      renderBuilder();
    };

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => applyPreset(btn.dataset.l062Preset || 'all'));
    });

    [...modBoxes, ...profileRadios, ...policyRadios].forEach((input) => {
      input.addEventListener('change', () => {
        presetBtns.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        renderBuilder();
      });
    });

    copyGenBtn?.addEventListener('click', async () => {
      const text = scriptPre?.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
        const orig = copyGenBtn.textContent;
        copyGenBtn.textContent = '맞춤 명령어 복사됨 ✓';
        setTimeout(() => {
          copyGenBtn.textContent = orig;
        }, 1500);
      } catch {
        // ignore
      }
    });

    dlPs1Btn?.addEventListener('click', () => {
      const text = scriptPre?.textContent || '';
      // UTF-8 with BOM ensures Windows PowerShell 5.1 reads Korean text cleanly when executed as a .ps1 file
      const blob = new Blob(['\uFEFF' + text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'setup-arch-all-in-one.ps1';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    expandBtn?.addEventListener('click', () => {
      if (!scriptPre) return;
      const expanded = scriptPre.classList.toggle('is-expanded');
      expandBtn.textContent = expanded ? '코드 창 접어 두기' : '코드 창 크게 보기';
    });

    renderBuilder();
  };

  initL062Page();
  document.addEventListener('astro:page-load', initL062Page);
</script>

