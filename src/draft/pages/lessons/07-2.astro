---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import TopicProgress from '../../components/TopicProgress.astro';
import '../../styles/lesson03.css';
import '../../styles/lesson04.css';
import {
  lesson062Title,
  lesson062Lead,
  lesson062Sections,
  lesson062Periods,
  veoFirstFramePrompt,
  veoLastFrameOpenTopPrompt,
  veoLastFrameExteriorPrompt,
  veoAnimOpenTopPrompt,
  veoAnimExteriorPrompt,
  setupConceptCards,
  fastPromptRules,
  freeCadHeadlessPrompt,
  cadDoctorCmd,
  l062QuickIndex,
  mcpPracticeScenarios,
  customSkillTemplate,
  customSkillCallPrompt,
  customSkillBriefElements,
  customSkillFolderTree,
  customSkillCreatorPrompt,
  customSkillUsageExamples,
  customSkillEditCmd,
  cadSkillExamples,
  archSoftwareRows,
  troubleshootingRows,
  generalMcpSteps,
  manualMcpToolGuides,
  optionBPathMap,
  optionBPathFindCmd,
  manualConfigTomlSnippet,
  generalSkillMethods,
} from '../../content/daejeon-lesson06-2-mcp';
import {
  defaultInstallerSelection,
  installerModuleMeta,
  buildAllInOnePowerShell,
} from '../../content/daejeon-all-in-one-installer';
import {
  l062WorkflowSvg,
  l062SkillCadPreview,
  l062SkillConceptPlan3d,
  l062SkillConceptSet,
  l062SkillGridlinePlan,
  l062SampleOfficeDxf,
  l062SampleSiteBrief,
} from '../../../../scripts/daejeon-lesson06-2-assets.mjs';
import { lesson05Plans } from '../../../../scripts/daejeon-lesson05-assets.mjs';

const sampleOfficePlanImg = lesson05Plans[0].base;
const initialPowerShellScript = buildAllInOnePowerShell(
  defaultInstallerSelection,
  customSkillTemplate,
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';
const tocGroups = lesson062Periods.map((period, index) => ({
  id: period.id,
  title: 'Part ' + (index + 1) + ' · ' + period.title,
  items: period.sections,
}));
const toc = tocGroups.flatMap((g) => g.items);
const sectionIndex = (id: string) => lesson062Sections.findIndex((s) => s.id === id) + 1;
---

<ReviewLayout
  title={lesson062Title}
  lead={lesson062Lead}
  page="lesson"
  lessonId="07-2"
  eyebrow="LESSON 07-2 · RENEWAL · VEO VIDEO · ALL-IN-ONE MCP SETUP · SCENARIOS & SKILLS"
  sharedScreen
  {toc}
  {tocGroups}
>
  <div class="lesson03-review lesson04-review l062-renewal" data-l062-page>
    <TopicProgress
      lesson="07"
      items={[
        {
          topic: 4,
          status: '리뉴얼 연결',
          note: '평면도 입체화 영상(Veo)과 3DGS·건축 프로그램 개념을 먼저 잡은 뒤, 체크박스형 PowerShell 올인원 설치 → 옵션 A·B 실무 시나리오 → Codex 건축 스킬 확장 순서로 진행합니다.',
        },
      ]}
    />

    <div class="l03-period-summary">
      {lesson062Periods.map((period, index) => (
        <article>
          <h2>Part {index + 1} · {period.title}</h2>
        </article>
      ))}
    </div>

    <aside class="review-callout">
      <h2>한눈에 보는 학습 순서 (이론 최소화 → 통합 설치 → 실전 시나리오 → 스킬 확장)</h2>
      <p>
        기존 <strong>제6차시 · 제7차시 · 제8차시</strong> 원본 교재는 그대로 보존됩니다. 이 페이지는 복잡한 수동 폴더 이동과 반복 설치 설명을 없애고,
        <strong>① Veo 입체화 영상 → ② 설치할 프로그램 역할 개념만 간단히 확인 → ③ 체크박스 PowerShell 올인원 한방 설치 → ④ 샘플 3종으로 옵션 A·B 실무 시나리오 바로 실습 → ⑤ 심화 건축 스킬 활용</strong> 순서로 막힘 없이 이어집니다.
      </p>
    </aside>

    <nav class="l062-quick-index" aria-label="제7-2차시 세부 단락 빠른 이동">
      <div class="l062-quick-index-head">
        <strong>빠른 단락 인덱스 이동</strong>
        <span>번호 배지(<code>01</code>~<code>07-5</code>)를 눌러 원하는 단계로 바로 이동하세요.</span>
      </div>
      <div class="l062-quick-index-grid">
        {l062QuickIndex.map((item) => (
          <a href={item.href} class="l062-quick-chip">
            <span class="l062-quick-code">{item.code}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </nav>

    {lesson062Periods.map((period, periodIndex) => (
      <div class="day-period" id={period.id} data-period={periodIndex + 1} data-teaching-minutes="50">
        <header class="period-heading">
          <p>Part {periodIndex + 1}</p>
          <h2>{period.title}</h2>
        </header>

        {period.sections.map((section) => (
          <ReviewSection
            id={section.id}
            title={section.title}
            minutes={section.minutes}
            index={sectionIndex(section.id)}
          >
            <dl class="l03-step-context">
              <div><dt>지금 할 일</dt><dd>{section.action}</dd></div>
              <div><dt>왜 하는가</dt><dd>{section.reason}</dd></div>
              <div><dt>다음에 사용할 것</dt><dd>{section.next}</dd></div>
            </dl>

            {section.id === 'l062-video-principle' && (
              <>
                <p>
                  2D 평면도에서 3D 건물이 솟아오르는 건축 시공 타임랩스 영상은 평면도 PNG 한 장을 영상 AI에 바로 넣어서 만들지 않습니다.
                  핵심은 <strong>이미지 AI로 시작 프레임(First)과 종료 프레임(Last) 2장을 같은 카메라 각도로 먼저 고정</strong>한 뒤,
                  <strong>Veo의 <code>Frames to Video</code>(First → Last)</strong> 기능으로 1샷 연결하는 것입니다.
                </p>
                <div class="l04-table">
                  <table>
                    <thead>
                      <tr>
                        <th>구성 선택</th>
                        <th>First Frame → Last Frame</th>
                        <th>무료 Veo(Fast) 성공률</th>
                        <th>실습 특징</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><strong>안 A · 추천</strong></td>
                        <td>45° 종이 위 평면도 → <strong>같은 45° 종이 위 3D 모형</strong></td>
                        <td><strong>매우 높음</strong></td>
                        <td>카메라와 종이 위치가 고정되어 벽선이 정확히 수직 압출되고 모핑(녹아내림)이 거의 없음</td>
                      </tr>
                      <tr>
                        <td><strong>안 B · 심화</strong></td>
                        <td>45° 종이 위 평면도 → 정면 눈높이 실제 건물</td>
                        <td>보통 (재생성 필요)</td>
                        <td>짧은 길이 안에 벽 압출 + 카메라 하강 + 배경 전환을 모두 처리해야 하므로 구간 분할 지시 필수</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div class="review-cards">
                  <article class="review-card">
                    <h3>규칙 1 · 종이 위 45° 샷 먼저 만들기</h3>
                    <p>수직 90° 평면도를 그대로 넣으면 Z축 높이가 없어 화면이 흐리게 겹칩니다. 반드시 책상 위 종이에 인쇄된 45° 부감 사진(First)으로 변환해 시작합니다.</p>
                  </article>
                  <article class="review-card">
                    <h3>규칙 2 · Last는 반드시 First를 편집(Edit)해 생성</h3>
                    <p>종료 프레임을 새 대화에서 따로 뽑으면 종이 각도가 틀어집니다. First 이미지를 첨부해 같은 각도·책상·치수선 위에 3D 모형만 올리도록 요청합니다.</p>
                  </article>
                  <article class="review-card">
                    <h3>규칙 3 · Last와 프롬프트 구조 100% 일치</h3>
                    <p>Last가 지붕 없는 <strong>오픈형 단면 모형</strong>이라면 프롬프트에 “지붕 슬래브”를 쓰지 말고 “지붕 없는 오픈형 단면 유지”를 명시해야 뭉개짐이 없습니다.</p>
                  </article>
                </div>
              </>
            )}

            {section.id === 'l062-video-prompts' && (
              <>
                <p>
                  아래 프롬프트는 모두 한글로 바로 입력해 사용할 수 있습니다. <strong>First와 Last의 화면 비율(가로 16 대 9 또는 세로 9 대 16)</strong>을
                  Veo 생성 비율과 반드시 통일하세요.
                </p>

                <div class="l062-code-card">
                  <div class="l062-code-head">
                    <strong>1단계 · ChatGPT용 First Frame 프롬프트 (2D 평면도 → 45° 종이 도면)</strong>
                    <button type="button" class="l062-copy-btn" data-l062-copy={veoFirstFramePrompt}>복사</button>
                  </div>
                  <pre class="l062-pre">{veoFirstFramePrompt}</pre>
                </div>

                <div class="l062-code-card">
                  <div class="l062-code-head">
                    <strong>2단계-A · ChatGPT용 Last Frame 프롬프트 (오픈형 단면 3D 오피스 모형 · First 첨부)</strong>
                    <button type="button" class="l062-copy-btn" data-l062-copy={veoLastFrameOpenTopPrompt}>복사</button>
                  </div>
                  <pre class="l062-pre">{veoLastFrameOpenTopPrompt}</pre>
                </div>

                <div class="l062-code-card">
                  <div class="l062-code-head">
                    <strong>2단계-B · ChatGPT용 Last Frame 프롬프트 (지붕 포함 완성형 주택·카페 모형 · First 첨부)</strong>
                    <button type="button" class="l062-copy-btn" data-l062-copy={veoLastFrameExteriorPrompt}>복사</button>
                  </div>
                  <pre class="l062-pre">{veoLastFrameExteriorPrompt}</pre>
                </div>

                <div class="l062-code-card l062-code-card-teal">
                  <div class="l062-code-head">
                    <strong>3단계-A · Veo 무료(Veo Fast · Frames to Video) 1샷 한글 프롬프트 (오픈형 단면 오피스용)</strong>
                    <button type="button" class="l062-copy-btn" data-l062-copy={veoAnimOpenTopPrompt}>복사</button>
                  </div>
                  <pre class="l062-pre">{veoAnimOpenTopPrompt}</pre>
                </div>

                <div class="l062-code-card l062-code-card-teal">
                  <div class="l062-code-head">
                    <strong>3단계-B · Veo 무료(Veo Fast · Frames to Video) 1샷 한글 프롬프트 (지붕 포함 완성 모형용)</strong>
                    <button type="button" class="l062-copy-btn" data-l062-copy={veoAnimExteriorPrompt}>복사</button>
                  </div>
                  <pre class="l062-pre">{veoAnimExteriorPrompt}</pre>
                </div>
              </>
            )}

            {section.id === 'l062-3dgs-summary' && (
              <>
                <p>
                  기존 <a href={`${base}/lessons/07/`}>제7차시</a>에서는 단일 이미지 기반의 <strong>3D Gaussian Splatting(3DGS)</strong>과
                  고화질 업스케일을 다룹니다. 리뉴얼 트랙에서는 3DGS의 <strong>원리와 실무 한계</strong>를 먼저 정확히 구분한 뒤,
                  실제 도면·3D 데이터를 직접 제어하는 <strong>MCP 단계</strong>로 연결하고, <strong>업스케일은 MCP 실무 시나리오의 최종 이미지 마감 단계</strong>에서 활용합니다.
                </p>
                <div class="l04-table">
                  <table>
                    <thead>
                      <tr>
                        <th>3D 표현 방식</th>
                        <th>내부 구조</th>
                        <th>강점</th>
                        <th>건축 실무에서의 한계</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><strong>Polygon Mesh</strong><br />(SketchUp · Blender)</td>
                        <td>점·선·면(삼각형/사각형)</td>
                        <td>형태 편집·재질·조명·렌더링 자유도 높음</td>
                        <td>단순 면 껍데기라 BIM 물량/속성 자동 연동은 별도 작업 필요</td>
                      </tr>
                      <tr>
                        <td><strong>Point Cloud</strong><br />(3D 라이다 스캔)</td>
                        <td>수백만 개의 3차원 점 좌표</td>
                        <td>현장 실측·지형·기존 건물 현황 측정에 정확</td>
                        <td>표면이 비어 보이고 그대로 설계 편집 불가</td>
                      </tr>
                      <tr>
                        <td><strong>3D Gaussian Splatting (3DGS)</strong></td>
                        <td>방향·색·투명도를 가진 3D 가우시안 입자(타원체)</td>
                        <td>드론·스마트폰 촬영으로 <strong>현장 대지를 사실적인 3D로 빠르게 재현</strong></td>
                        <td><strong>편집 가능한 CAD/BIM 도면이 아님</strong> · 단일 이미지 추정 시 뒷면이 뭉개져 실시설계 투입 불가</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <aside class="review-callout">
                  <strong>리뉴얼 파이프라인 요약</strong>
                  <p>
                    시각화 이미지 단계(1~6차시 + 3DGS 개념) → <strong>올인원 환경 구축 후 실제 도면·3D 데이터를 다루는 MCP 실무 시나리오</strong>
                    → <strong>최종 제안서 컷 고화질 업스케일(7차시 ComfyUI / OpenVINO 기법 적용)</strong> 순서로 연결하면 실무 완성도가 훨씬 높아집니다.
                  </p>
                </aside>
              </>
            )}

            {section.id === 'l062-arch-software' && (
              <>
                <p>
                  설치 명령어를 실행하기 전에, <strong>왜 이 프로그램들을 쓰는지 역할과 호환 원리만 가볍게 확인</strong>합니다.
                  복잡한 파일 복사와 경로 지정은 바로 다음 단계의 <strong>올인원 통합 설치 빌더</strong>가 전부 자동으로 처리합니다.
                </p>

                <h3>1 · 건축 실무 소프트웨어 4대장과 무료 실습 조합</h3>
                <div class="l04-table">
                  <table>
                    <thead>
                      <tr>
                        <th>구분</th>
                        <th>쉬운 비유</th>
                        <th>대표 유료 툴</th>
                        <th>무료 실습 MCP 조합</th>
                        <th>대표 확장자</th>
                        <th>주된 역할</th>
                      </tr>
                    </thead>
                    <tbody>
                      {archSoftwareRows.map((row) => (
                        <tr>
                          <th>{row.role}</th>
                          <td>{row.analogy}</td>
                          <td>{row.paid}</td>
                          <td><strong>{row.freeMcp}</strong></td>
                          <td><code>{row.ext}</code></td>
                          <td>{row.usage}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <h3>2 · 왜 AutoCAD 없이도 도면 호환이 될까? (DWG vs DXF 핵심)</h3>
                <div class="l04-table">
                  <table>
                    <thead>
                      <tr>
                        <th>항목</th>
                        <th>DWG (AutoCAD 전용)</th>
                        <th>DXF (표준 교환 도면 · 실습 기본 형식)</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <th>성격</th>
                        <td>비공개 바이너리 도면 파일</td>
                        <td>Autodesk가 공개한 <strong>표준 텍스트 도면 파일</strong></td>
                      </tr>
                      <tr>
                        <th>AI · MCP 제어</th>
                        <td>외부 무료 도구가 직접 편집하기 어려움</td>
                        <td><strong>AI · Python(<code>ezdxf</code>) · MCP · LibreCAD · FreeCAD · Blender가 직접 생성·수정 가능</strong></td>
                      </tr>
                      <tr>
                        <th>실무 호환</th>
                        <td>AutoCAD 기본 저장 형식</td>
                        <td><strong>회사 정품 AutoCAD에서 그대로 열리며 레이어(<code>A-WALL</code> 등)·치수·블록 100% 호환</strong></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <p class="l062-note">
                  <strong>실무 변환 팁:</strong> 회사 AutoCAD에서는 <code>다른 이름으로 저장 → DXF</code>로 즉시 변환되며, AutoCAD가 없는 PC에서도 무료 <strong>ODA File Converter</strong>로 <code>DWG ↔ DXF</code> 일괄 변환이 가능합니다.
                </p>

                <h3>3 · 오늘 올인원 빌더가 설치·연결해 줄 4가지 구성 요소</h3>
                <div class="l062-concept-grid">
                  {setupConceptCards.map((card) => (
                    <article class="l062-concept-card">
                      <span class="l062-skill-badge l062-skill-badge-navy">{card.badge}</span>
                      <h4>{card.title}</h4>
                      <p class="l062-concept-role">{card.role}</p>
                      <ul>
                        {card.points.map((pt) => <li>{pt}</li>)}
                      </ul>
                    </article>
                  ))}
                </div>
              </>
            )}

            {section.id === 'l062-all-in-one-setup' && (
              <>
                <p>
                  차시마다 프로그램을 따로 찾아 깔거나 숨김 폴더(<code>AppData</code> · <code>.codex</code>)로 파일을 옮길 필요가 없습니다.
                  아래에서 <strong>내 PC 사양과 필요한 항목만 체크</strong>하면, 이미 깔린 최신 파일은 건너뛰고 선택한 MCP만 <code>config.toml</code>에 안전하게 병합해 주는
                  <strong>맞춤형 PowerShell 올인원 명령어</strong>가 실시간으로 완성됩니다.
                </p>

                <div class="l062-builder" data-l062-builder>
                  <div class="l062-builder-top">
                    <div>
                      <strong>빠른 프리셋 선택</strong>
                      <span>처음 세팅하는 PC는 기본 선택된 <strong>전체 올인원 세팅</strong>을 그대로 복사해 실행하면 됩니다.</span>
                    </div>
                    <div class="l062-preset-row">
                      <button type="button" class="l062-preset-btn is-active" data-l062-preset="all" aria-pressed="true">추천 · 전체 올인원 세팅</button>
