---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import Lesson02AutomationPractice from '../../components/Lesson02AutomationPractice.astro';
import Lesson02ClassificationGuide from '../../components/Lesson02ClassificationGuide.astro';
import Lesson02Infographic from '../../components/Lesson02Infographic.astro';
import TopicProgress from '../../components/TopicProgress.astro';
import '../../styles/lesson02.css';
import '../../styles/lesson02-automation.css';
import {
  lesson02Title,
  lesson02Lead,
  sections,
  periods,
  goals,
  recap,
  automationDefinition,
  automationExamples,
  vibeVsMcpBridge,
  creditSavingTips,
  humanDecisions,
  environmentSteps,
  referenceLinks,
  architectureRoles,
  hierarchyTree,
} from '../../content/daejeon-lesson02-automation';

const sectionProps = (id: string) => ({
  ...sections.find((s) => s.id === id)!,
  index: sections.findIndex((s) => s.id === id) + 1,
});
const tocGroups = periods.map((period, index) => ({
  id: period.id,
  title: 'Part ' + (index + 1) + ' · ' + period.title,
  items: [{ id: period.id, title: 'Part ' + (index + 1) + ' 시작' }, ...period.sections],
}));
const toc = tocGroups.flatMap((group) => group.items);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ReviewLayout title={lesson02Title} lead={lesson02Lead} page="lesson" lessonId="02" eyebrow="LESSON 02" sharedScreen {toc} {tocGroups}>
<div class="lesson02-review lesson02-automation">

  <TopicProgress lesson="02" items={[{ topic: 2, status: '완결', note: '반복 행정서류의 계산·동기화 규칙과 사람의 검수 경계를 정하고, 크레딧 절약형 Vibe Coding으로 착수계 4종 자동 생성기를 구현·실행하며 대주제 2를 마무리합니다.' }]} />
  <div class="lesson02-summary">{periods.map((period, index) => <article><h2>Part {index + 1} · {period.title}</h2><p>{period.output}</p></article>)}</div>
  <h2>이번 차시의 학습 목표</h2><ol class="lesson02-goals">{goals.map((goal) => <li>{goal}</li>)}</ol>

  {periods.map((period, periodIndex) => <div class="day-period" id={period.id} data-period={periodIndex + 1} data-teaching-minutes="50">
    <header class="period-heading"><p>Part {periodIndex + 1}</p><h2>{period.title}</h2><p>이번 파트의 결과: {period.output}</p></header>
    {periodIndex === 0 && <>
      <ReviewSection {...sectionProps('l02-recap')} summary={recap.subtitle}>
        <div data-recap-introduction>{recap.introduction.map((text) => <p>{text}</p>)}</div>
        <h3>지난 차시의 작업 흐름</h3>
        <ol class="l02-recap-flow" data-recap-previous-flow aria-label="지난 차시의 작업 순서">{recap.previousFlow.map((step) => <li>{step}</li>)}</ol>
        <div class="l02-recap-roles" data-recap-roles>{recap.roles.map((role) => <article><h3>{role.title}</h3><ul>{role.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
        <h3>같은 원칙으로 프로그램 만들기</h3><p>{recap.connection}</p>
        <ol class="l02-recap-flow" data-recap-planning-flow aria-label="프로그램을 만들 때 확인할 순서">{recap.planningFlow.map((step) => <li>{step}</li>)}</ol>
        <h3>오늘의 작업 흐름</h3>
        <ol class="l02-recap-flow" data-recap-today-flow aria-label="오늘의 작업 순서">{recap.todayFlow.map((step) => <li>{step}</li>)}</ol>
        <div class="l02-recap-transition" data-recap-transition>{recap.transition.map((text) => <p>{text}</p>)}</div>
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-automation')} summary="착수·설계변경·연장 때마다 반복 작성하는 행정서류에서 규칙화할 부분을 찾습니다.">
        <p class="l02-definition">{automationDefinition}</p>
        <div class="lesson02-summary">
          <article><h3>기존 수작업</h3><p>착수신고서·선임계·명단·보안각서 파일을 각각 열어 금액 한글 표기와 날짜를 일일이 고칩니다.</p></article>
          <article><h3>로컬 자동화</h3><p>계약 정보를 1회 입력하면 한글 금액·부가세·일수를 계산해 4종 서식에 동시에 채웁니다.</p></article>
          <article><h3>사람 최종 판단</h3><p>자격번호·변경사유 누락을 보완하고 예정공정표 첨부 및 대표 건축사 직인을 날인합니다.</p></article>
        </div>
        <h3>건축사사무소 반복 행정 업무에서 바로 효과 보는 지점</h3>
        <ul>{automationExamples.map(([title, note]) => <li><strong>{title}</strong> — {note}</li>)}</ul>
        <div class="lesson02-decision">
          <strong>오늘은 착수계·반복 행정서류 4종 자동 생성기 하나를 완성합니다.</strong>
          <p>모든 관공서 고유 양식을 한꺼번에 다루지 않고, 가장 자주 반복되는 4종 서식 동기화와 금액·날짜 검증 규칙부터 정확히 구현합니다.</p>
        </div>
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-vibe-coding')} summary="원하는 동작을 자연어로 설계해 로컬 도구를 만들고, 크레딧 절약 전략과 MCP와의 차이를 이해합니다.">
        <p class="l02-flow-line">반복 행정 문제 → 규칙 분리 → 크레딧 절약형 Vibe Coding (실행 크레딧 0원)</p>
        <p>착수계 서류를 쓸 때마다 AI 채팅창에 문서를 만들어 달라고 하면 매번 토큰(크레딧)이 소모되고 숫자 할루시네이션 위험도 남습니다. 반대로 <strong>원하는 계산·검증 규칙을 자연어로 설명해 로컬 생성기 프로그램을 한 번 만들어 두면(Vibe Coding)</strong>, 이후 실무에서 백 번을 실행해도 AI 크레딧이 전혀 들지 않습니다.</p>

        <h3>Codex 크레딧 소모를 확 줄이는 실전 4원칙</h3>
        <ol class="lesson02-checklist" data-credit-saving-tips>
          {creditSavingTips.map(([title, note]) => (
            <li><strong>{title}</strong><p>{note}</p></li>
          ))}
        </ol>

        <h3>미리 보는 큰 그림 · 오늘 배우는 Vibe Coding vs 제8·9차시 MCP</h3>
        <figure class="l02-infographic" data-vibe-vs-mcp-diagram>
          <img
            src={`${base}/images/daejeon/lesson-08/mcp-vs-vibecoding-bridge.svg`}
            alt="바이브 코딩 로컬 문서 생성기와 MCP 외부 3D 도구 실시간 제어의 작동 방식 및 크레딧 구조 비교 도해"
            width="1200"
            height="430"
            loading="lazy"
          />
          <figcaption>
            <strong>같은 AI 에이전트(Codex)라도 작업 성격에 따라 활용 방식이 다릅니다.</strong>
            <p>정형 계산·반복 행정서류는 로컬 도구를 만들어 크레딧 0원으로 돌리고, 실행 중인 Blender 3D 씬 조작은 제8·9차시에서 MCP로 실시간 연결합니다.</p>
          </figcaption>
        </figure>
        <div class="lesson02-table">
          <table>
            <caption>Vibe Coding 로컬 생성기 제작 vs MCP 외부 소프트웨어 실시간 제어</caption>
            <thead>
              <tr>
                <th scope="col">구분</th>
                <th scope="col">적합한 건축 실무</th>
                <th scope="col">크레딧(토큰) 소모 구조</th>
                <th scope="col">핵심 강점</th>
              </tr>
            </thead>
            <tbody>
              {vibeVsMcpBridge.map((row) => (
                <tr>
                  <th scope="row" data-label="구분">{row.mode}</th>
                  <td data-label="적합한 건축 실무">{row.target}</td>
                  <td data-label="크레딧(토큰) 소모 구조">{row.creditCost}</td>
                  <td data-label="핵심 강점">{row.strength}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3>사람이 먼저 정할 여섯 가지</h3>
        <ol class="lesson02-checklist">{humanDecisions.map((item) => <li>{item}</li>)}</ol>
        <div class="review-question">
          <strong>내 사무소 업무에 적용하기</strong>
          <p>우리 사무소에서 용역 착수·기성·준공 때마다 숫자나 날짜만 바꿔 반복 제출하는 서류 묶음을 떠올려 보고, 자동 계산할 항목과 사람이 도장 찍기 전 확인할 항목을 한 줄씩 적어 봅니다.</p>
        </div>
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-environment')} summary="ChatGPT Desktop에서 Codex와 빈 실습 폴더를 연결하고 작업 범위를 확인합니다.">
        <h3>본 실습 · ChatGPT Desktop + Codex</h3>
        <p>Codex는 사람이 정한 요구사항을 실제 로컬 폴더의 코드와 실행 파일로 구현하는 에이전트 도구입니다. 빈 실습 폴더를 연결하고 작은 계산기부터 단계별로 완성합니다.</p>
        <ol class="lesson02-checklist" data-codex-environment>{environmentSteps.map(([title, note]) => <li><strong>{title}</strong><p>{note}</p></li>)}</ol>
        <aside class="lesson02-decision" data-node-guidance>
          <h3>Node.js LTS · 로컬 서버 실행환경 + 무설치 단일실행본 지원</h3>
          <p>Node.js는 Codex 자체 설치 요건이 아니라 완성된 로컬 웹 서버(<code>START.bat</code> → <code>127.0.0.1:4175</code>)와 <code>output/</code> 버전 저장 기능을 실행하기 위한 환경입니다. 명령 창에서 <code>node --version</code>으로 확인합니다(권장 LTS 22.x 이상).</p>
          <p>만약 강의실·사내 PC 보안 정책 때문에 Node.js 설치가 어렵더라도 걱정하지 마세요. 제공 예제에는 브라우저만 있으면 더블클릭 즉시 작동하는 <code>AI_착수계자동작성_단일실행본.html</code>도 함께 들어 있습니다.</p>
        </aside>
        <p>CLI 방식의 Codex, Git, VS Code, WSL 설치는 이번 기본 실습의 필수조건이 아닙니다.</p>
        <aside class="review-callout" data-alternative-environment>
          <strong>대체 환경 소개 · Antigravity / Claude Code / Cursor</strong>
          <p>동일한 단계별 요청문은 Antigravity, Claude Code, Cursor 등 로컬 폴더 연결을 지원하는 다른 코딩 에이전트에서도 그대로 사용할 수 있습니다. 이번 본 실습은 ChatGPT Desktop + Codex 기준으로 안내합니다.</p>
        </aside>
        <div class="l02-reference-links" data-reference-links>
          <h3>참고 링크</h3>
          <h4>OpenAI 공식 안내</h4>
          <ul>{referenceLinks.openai.map((link) => <li><a href={link.href} target="_blank" rel="noreferrer">{link.label}</a></li>)}</ul>
          <h4>실행환경</h4>
          <ul><li><a href={referenceLinks.runtime.href} target="_blank" rel="noreferrer">{referenceLinks.runtime.label}</a></li></ul>
        </div>
      </ReviewSection>
    </>}

    {periodIndex === 1 && <>
      <ReviewSection {...sectionProps('l02-architecture')} summary="입력부터 계산·검증·4종 조립·버전 저장까지의 역할과 연결 구조를 정합니다.">
        <p>건축에서 실별 조닝과 동선을 먼저 계획하듯, 프로그램도 기능의 역할과 데이터 흐름을 먼저 나눕니다. 이것이 프로그램의 큰 구조, <strong>Architecture</strong>입니다.</p>
        <Lesson02Infographic imageKey="flow" instance="architecture" />
        <ol class="lesson02-architecture-flow" data-architecture-flow>
          {architectureRoles.map(([term, title, note]) => (
            <li><strong>{title}</strong><span>{term}</span><p>{note}</p></li>
          ))}
        </ol>
        <p>계산기(<code>CALCULATOR</code>)와 판정기(<code>VALIDATOR</code>)를 서식 조립기(<code>TEMPLATES</code>) 앞에 두어야 틀린 날짜나 빠진 자격번호가 조용히 서류에 인쇄되는 사고를 막을 수 있습니다.</p>
        <div class="review-question">
          <strong>역할 연결하기</strong>
          <p>변경착수계인데 변경 사유가 비어 있다면 어느 역할이 경고를 띄우나요? 같은 용역의 금액이 바뀌었을 때 이전 파일을 덮어쓰지 않고 <code>_v02</code>를 붙이는 일은 누가 맡나요?</p>
        </div>
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-hierarchy')} summary="각 역할을 실제 폴더와 파일(app·samples·projects·output)로 깔끔하게 나눕니다.">
        <div class="lesson02-reference-pair">
          <aside class="lesson02-decision"><h3>프로그램의 큰 구조 · Architecture</h3><p>무슨 기능이 필요하고 어떻게 연결되는가?</p></aside>
          <aside class="lesson02-decision"><h3>폴더와 파일 구성 · Hierarchy</h3><p>그 기능을 어느 폴더·파일에 나누어 담을 것인가?</p></aside>
        </div>
        <pre class="lesson02-program-tree" data-hierarchy-tree>{hierarchyTree}</pre>
        <p>계산(<code>calculator.js</code>), 검증(<code>validator.js</code>), 서식 문구(<code>templates.js</code>), 규칙(<code>rules.json</code>)을 분리해 두면 나중에 우리 사무소 주소나 서식 문구만 고칠 때 해당 파일 하나만 열어 안전하게 수정할 수 있습니다.</p>
        <div class="review-task">
          <strong>수정할 위치 찾아보기</strong>
          <p>“보안각서 문구를 우리 발주처 양식에 맞게 바꿀 때 열어야 할 파일”과 “생성된 Word·HTML 패키지가 버전별로 쌓이는 폴더”를 위 트리에서 찾아봅니다.</p>
        </div>
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-rules')} summary="명확한 금액·일수 계산은 자동화하고, 누락·모순은 사람 확인(검수 대기)으로 멈춥니다.">
        <Lesson02Infographic imageKey="rules" instance="rules" />
        <Lesson02ClassificationGuide />
        <div class="review-question">
          <strong>자동화의 안전 경계 정하기</strong>
          <p>책임기술자 자격번호가 비어 있을 때 프로그램이 예시 번호를 임의로 넣어 버리면 어떤 실무 문제가 생길까요? “모르면 비워 두고 사람 확인 배너 띄우기”가 왜 핵심 기능인지 생각해 봅니다.</p>
        </div>
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-first-request')} summary="빈 실습 폴더에 기본 구조와 한글 계약금액·부가세·과업일수 계산기부터 만듭니다.">
        <Lesson02AutomationPractice stage="step" step={1} />
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-plan-review')} summary="같은 프로그램에 필수 항목·자격번호 누락과 날짜 역전을 잡는 검수 대기 분기를 추가합니다.">
        <Lesson02AutomationPractice stage="step" step={2} />
      </ReviewSection>
    </>}

    {periodIndex === 2 && <>
      <ReviewSection {...sectionProps('l02-implementation-spec')} summary="행정서류 4종 동시 조립 템플릿과 SHA-256 중복·_v02 버전 보호 기능을 이어서 구현합니다.">
        <Lesson02AutomationPractice stage="step" step={3} />
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-implement')} summary="127.0.0.1:4175 화면과 외부 JSON 읽기 전용 가져오기, A4 인쇄·Word 출력을 연결합니다. 크레딧 절약형 통합 예시문도 함께 제공합니다.">
        <Lesson02AutomationPractice stage="step" step={4} />
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-run')} summary="완성 프로그램을 실행하고 DOC_TEST 6개 시나리오 기준표와 자동 조립·사람 확인 결과를 직접 비교합니다.">
        <Lesson02AutomationPractice stage="run" />
      </ReviewSection>

      <ReviewSection {...sectionProps('l02-wrap-up')} summary="한 번 만들어 크레딧 0원으로 반복 사용하는 로컬 자동화 원칙을 정리하고 다음 차시로 이어갑니다.">
        <Lesson02AutomationPractice stage="wrap" />
      </ReviewSection>
    </>}
  </div>)}
</div>
</ReviewLayout>
