---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import TopicProgress from '../../components/TopicProgress.astro';
import Lesson03AssetCard from '../../components/Lesson03AssetCard.astro';
import Lesson03Comparison from '../../components/Lesson03Comparison.astro';
import Lesson05Workbench from '../../components/Lesson05Workbench.astro';
import Lesson05CleanupOutpaintGuide from '../../components/Lesson05CleanupOutpaintGuide.astro';
import PlanOverlay from '../../components/PlanOverlay.astro';
import ReviewPrompt from '../../components/ReviewPrompt.astro';
import {lesson05Title,lesson05Sections,lesson05Periods,lesson05Boundary} from '../../content/daejeon-lesson05';
import {lesson05Plans,lesson05Legacy,lesson05Door,lesson05RawOutputs,lesson05Crops,lesson05Prompt,lesson05Analysis,lesson05Precision,lesson05Zip} from '../../../../scripts/daejeon-lesson05-assets.mjs';
import '../../styles/lesson03.css';
import '../../styles/lesson04.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const enabled=import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS==='true';
const tocGroups=lesson05Periods.map((period,index)=>({id:period.id,title:'Part '+(index+1)+' · '+period.title,items:period.sections}));
const toc=tocGroups.flatMap(period=>period.items);
const filename=(asset:{file:string})=>asset.file.split('/').pop();
const prompt=(key:string)=>{
 const asset=lesson05Prompt[key];
 return {id:'l05-prompt-'+key,title:asset.title,prompt:asset.text,attachments:asset.attachments,href:enabled?base+'/'+asset.outputPath:undefined,filename:filename(asset)};
};
const choices=lesson05Plans.map((plan,index)=>{
 const asset=lesson05Prompt[index===0?'plan01-edit':'plan02-edit'];
 const crop=lesson05Crops[index];
 return {id:plan.id,title:plan.title,text:asset.text,attachments:asset.attachments||[],cropPath:crop.outputPath,cropFilename:filename(crop),promptPath:asset.outputPath,promptFilename:filename(asset)};
});
const attachmentStages=(lesson05Prompt.recompose.attachmentBundles||[]).map(bundle=>({
 id:bundle.id,title:bundle.title,recompose:bundle.attachments,
 overlay:lesson05Prompt.overlay.attachmentBundles?.find(item=>item.id===bundle.id)?.attachments||[],
}));
const shortFurniturePrompt=`이 평면도에서 오른쪽 위 회의실의 4인용 테이블과 의자만 6인용 긴 테이블(양쪽 3석씩)로 바꿔 주세요.
외벽, 기둥, 창문, 출입문(D1·D2·D3), 왼쪽 업무공간 4석, 아래 탕비실, 모든 치수와 글자는 그대로 유지하세요.
원본과 같은 흑백 2D 도면 선 두께와 스타일로 자연스럽게 그려 주세요.`;
const shortDoorPrompt=`이 평면도에서 회의실로 들어가는 D2 출입문을 현재 위치에서 약 1m 아래쪽으로 옮겨 주세요.
기존 문 자리는 경량벽체 복선으로 매끄럽게 닫고, 새 위치에 문짝·90도 개폐호·D2 표기를 하나만 그려 주세요.
회의실 6석 테이블, 업무공간, 탕비실 D3, 외벽과 치수는 절대 바꾸지 마세요.`;
---
<ReviewLayout title={lesson05Title} lead="평면도를 읽고 클린업·인페인팅(가구·문 이동)을 거친 뒤, Pivot 이동 아웃페인팅과 카메라·조경·날씨 키워드 조합까지 실전 ChatGPT 흐름으로 익힙니다." page="lesson" lessonId="05" eyebrow="LESSON 05 · FLOOR PLAN CLEANUP, INPAINTING & OUTPAINTING" sharedScreen {toc} {tocGroups}>
<div class="lesson03-review lesson04-review lesson05-review" data-l05-workbench data-l05-base={base} data-l05-assets-enabled={String(enabled)} data-l05-prompts={JSON.stringify(choices)} data-l05-attachment-stages={JSON.stringify(attachmentStages)}>
 <TopicProgress lesson="05" items={[{topic:3,status:'완결',note:'실내·외관 인페인팅에 이어 2D 평면도 클린업·인페인팅·아웃페인팅으로 초기 기획 이미지 수정 과정을 마무리합니다.'}]} />
 <div class="l03-period-summary">{lesson05Periods.map((period,index)=><article><h2>Part {index+1} · {period.title}</h2></article>)}</div>
 <p>실습 기준 평면도 2종(오피스·카페)의 외곽은 모두 <strong>14,400 × 8,400 mm</strong>입니다. 먼저 도면 클린업으로 구조 기준선을 확인한 뒤, 오피스는 회의실 4→6석 확장과 D2 문 이동을, 카페는 중앙 4→6석 확장과 우측 Pivot 이동 아웃페인팅(외부 데크·조경 확장)을 실습합니다.</p>
 <aside class="review-callout"><h2>치수 기준과 예시 도면 안내</h2><p>업무 책상은 2인 대면 모듈 <strong>1,600 × 1,400 mm</strong> 두 조이며, 4석 테이블(<strong>1,800 × 1,000 mm</strong>)은 중심과 깊이를 유지한 채 길이만 <strong>2,700 mm</strong>로 늘려 3+3석을 배치합니다. 제공된 전체 비교 도면은 치수와 좌표를 맞춰 작도한 검수 기준본이며, 실제 ChatGPT 생성 출력은 정밀 기준본과 선·비율을 대조해 검수합니다.</p></aside>
 {lesson05Periods.map((period,periodIndex)=><div class="day-period" id={period.id} data-period={periodIndex+1} data-teaching-minutes="50">
  <header class="period-heading"><p>Part {periodIndex+1}</p><h2>{period.title}</h2></header>
  {period.sections.map(section=><ReviewSection id={section.id} title={section.title} minutes={section.minutes} index={lesson05Sections.findIndex(item=>item.id===section.id)+1}>
   <dl class="l03-step-context"><div><dt>지금 할 일</dt><dd>{section.action}</dd></div><div><dt>왜 하는가</dt><dd>{section.reason}</dd></div><div><dt>다음에 사용할 것</dt><dd>{section.next}</dd></div></dl>
   {section.id==='l05-recap'&&<>
    <p>4차시 외관 사진에서 클린업(방해 요소 제거) → 인페인팅(부분 수정) → 시점·분위기 확장을 익혔습니다. 2D 도면도 같은 논리로 <strong>클린업(구조선 확보) → 인페인팅(가구·문 수정) → 아웃페인팅(Pivot 이동으로 외부 확장)</strong> 순서로 진행하며, <strong>선·문자·기호·치수·문 개폐 방향</strong>을 고정 기준으로 삼습니다.</p>
    <ol class="l03-workflow">{['원본 보존·비식별화','도면 판독·클린업','유지·변경 영역 지정','인페인팅(가구·문)','원본 중첩 검수','Pivot 이동 아웃페인팅'].map(text=><li>{text}</li>)}</ol>
   </>}
   {section.id==='l05-elements'&&<>
    <Lesson03AssetCard image={lesson05Plans[0].base} title="구성 요소 읽기 · 오피스 평면 (PLAN-BASE-01)" description="좌측 업무공간, 우측 상부 회의실, 우측 하부 탕비·수납 코어를 읽습니다. D2와 D3는 각각 업무공간에서 진입합니다." instance="l05-read" downloadName={filename(lesson05Plans[0].base)} />
    <div class="l04-table"><table><thead><tr><th>요소</th><th>함께 읽을 것</th></tr></thead><tbody>{[['벽·기둥','외벽 200 mm, 경량벽체 LW 100 mm, 기둥 400 × 400 mm와 접합 위치'],['문·개폐호','개구부·문짝·회전 중심·90도 개폐호와 D1/D2/D3'],['창','복선 창틀, W1/W2/W3의 위치와 벽·기둥 사이 간격'],['가구·집기','업무 4석·회의 4석과 탕비 카운터·수납장'],['치수·축선','전체 치수, 구간 치수, X1~X3·Y1~Y3와 실제 벽체 위치']].map(row=><tr><th>{row[0]}</th><td>{row[1]}</td></tr>)}</tbody></table></div>
   </>}
   {section.id==='l05-inputs'&&<>
    <div class="review-cards"><article class="review-card"><h3>기준 CAD / PDF</h3><p>원자료의 레이어·문자·치수와 도면 범위를 확인하고, 원본을 별도 보관합니다.</p></article><article class="review-card"><h3>편집할 평면도 이미지</h3><p>허용된 범위를 이미지로 준비해 분석·클린업·부분 수정·결과 비교에 사용합니다.</p></article></div>
    <ul><li>주소·회사/프로젝트명·표제란·이름·연락처·메모를 비식별화하고 업로드 권한을 확인합니다.</li><li>숨은 레이어·블록 속성·외부참조의 식별정보도 확인합니다.</li><li>수정 결과는 별도 파일로 저장합니다. 제공된 두 평면도는 실습용 가상 공간입니다.</li></ul>
    <h3>실제 축척으로 출력할 도면 PDF</h3><p>교보재 본문 이미지는 읽기 위해 축소 수록됩니다. 아래 별도 PDF는 <strong>A3 가로 · 실제 크기/100% 인쇄에서 1:100</strong>입니다. 페이지 맞춤을 끄고 외곽 144 × 84 mm와 0~2m 스케일바 길이 20 mm를 자로 확인합니다.</p>
    {enabled&&<ul data-l05-precision-downloads>{lesson05Precision.map(asset=><li><a class="review-download" href={base+'/'+asset.outputPath} download={filename(asset)}>{asset.title} 다운로드</a></li>)}</ul>}
   </>}
   {section.id==='l05-reading'&&<>
    <Lesson05Workbench area="selection" />
    <div data-l05-plan-bases>
     <Lesson03AssetCard image={lesson05Plans[1].base} title={lesson05Plans[1].title+' · 원본 (PLAN-BASE-02)'} description={lesson05Plans[1].description + ' (오피스 원본 PLAN-BASE-01은 섹션 02에 수록되어 있습니다.)'} instance="l05-base" downloadName={filename(lesson05Plans[1].base)} />
    </div>
    <p><strong>이 단계는 공통 오피스 판독입니다.</strong> 섹션 02의 <code>PLAN-BASE-01.png</code> 원본 한 장을 ChatGPT에 올려 판독합니다. 위 선택 메뉴는 Part 2 가구 실습의 입력과 프롬프트만 전환합니다.</p>
    <details><summary>평면도 분석 Prompt</summary><ReviewPrompt {...prompt('analysis')} /></details>
    <p>응답에서 원도면에 직접 보이는 항목, AI가 해석한 항목, 읽히지 않는 항목을 구분해 기록합니다.</p>
   </>}
   {section.id==='l05-correct'&&<>
    <div class="l04-table"><table><thead><tr><th>원본에서 볼 것</th><th>대조할 내용</th><th>남길 기록</th></tr></thead><tbody><tr><td>전체 14,400 × 8,400</td><td>가로·세로 표기와 도면 외곽 비율</td><td>직접 읽은 표기값과 판독 불가 항목</td></tr><tr><td>오피스 X2 · 7,800 / 6,600</td><td>세로 경량벽체와 축선 위치</td><td>치수선·벽체의 대응 관계</td></tr><tr><td>카페 X2 · 4,800 / 9,600</td><td>W1과 W2가 경계벽 양쪽에 분리되는지</td><td>창·기둥·가벽의 위치</td></tr><tr><td>문짝과 90도 개폐호</td><td>문폭·회전 중심·열리는 방향</td><td>D2·D3의 진입 관계와 누락 표기</td></tr></tbody></table></div>
    <p>원본에서 확인한 내용을 기준으로 AI 분석 목록의 누락과 오독을 바로잡습니다.</p>
   </>}
   {section.id==='l05-principle'&&<>
    <Lesson05CleanupOutpaintGuide mode="cleanup" />
    <p>클린업으로 구조 기준을 확인했다면, 실제 부분 수정(인페인팅)에서는 <strong>가구·의자·접하는 빈 바탕</strong>만 변경 영역으로 묶고 <strong>벽·창·문자·치수선</strong>은 유지 영역으로 남깁니다.</p>
    <details>
     <summary>참고 사례 · 주택 식탁 부분 수정 (6석 → 8석 비교)</summary>
     <div class="l03-asset-grid" data-l05-track-a>{lesson05Legacy.map(asset=><Lesson03AssetCard image={asset} title={asset.title} description={asset.description} instance="l05-a" downloadName={filename(asset)} />)}</div>
     <p>원본과 결과의 식탁 길이, 긴 변 3+3석과 양 끝 각 1석을 비교합니다. 잘린 범위가 다르면 고정 선을 먼저 맞춥니다.</p>
    </details>
   </>}
   {section.id==='l05-mask'&&<>
    <h3>부분 수정 입력을 준비하는 두 가지 방법</h3>
    <div class="review-cards" data-l05-chatgpt-guide><article class="review-card"><h4>방법 1 · ChatGPT 화면에서 바로 지정</h4><ol><li>평면도를 ChatGPT에 올리고 편집(브러시·영역 선택) 또는 위치 문장으로 가구 영역만 지정합니다.</li><li>변경할 내용과 유지할 선을 짧은 3문장으로 적습니다.</li><li>결과에서 경계선과 주변 벽·치수가 흔들리지 않았는지 대조합니다.</li></ol></article><article class="review-card"><h4>방법 2 · 부분 확대(Crop) 이미지 사용</h4><ol><li>선택한 도면의 Crop PNG를 첨부해 세부 가구 선명도를 높입니다.</li><li>수정 결과를 저장한 뒤 고정 선을 맞춰 전체 도면에 재반영합니다.</li><li>전체 합성이 어려울 때는 제공된 <code>PLAN-BASE-01-result.png</code>로 다음 D2 실습을 이어갑니다.</li></ol></article></div>
    <div class="l03-asset-grid" data-l05-masks>{lesson05Plans.map(plan=><Lesson03AssetCard image={plan.marked} title={plan.title+' · 수정 영역'} description={plan.marked.description} instance="l05-mask" downloadName={filename(plan.marked)} />)}</div>
    <p>붉은 표시는 수정 범위 안내입니다. 실제 편집에서는 가구와 의자만 선택하고 벽·기둥·문·창·공간명·치수·기호를 제외합니다.</p>
   </>}
   {section.id==='l05-prompt-a'&&<>
    <div class="l05-short-prompt-box">
     <div class="l05-short-prompt-head">
      <strong>ChatGPT 실전 짧은 프롬프트 · 회의실 가구 인페인팅 (4석 → 6석)</strong>
      <button type="button" class="l05-short-copy-btn" data-l05-co-copy={shortFurniturePrompt}>프롬프트 복사</button>
     </div>
     <pre class="l05-short-pre">{shortFurniturePrompt}</pre>
     <p class="l05-short-note">카페(<code>PLAN-BASE-02</code>)를 선택했다면 “오른쪽 위 회의실”을 “중앙 라운지 4인용 테이블”로, 유지 조건을 “우측 하단 2인석과 좌측 바 카운터”로만 바꿔 입력하면 됩니다.</p>
    </div>
    <Lesson05Workbench area="prompts" />
   </>}
   {section.id==='l05-run-a'&&<>
    <ol class="review-flow"><li><div><strong>부분 도면과 짧은 Prompt 실행</strong><span>ChatGPT에 원본 또는 Crop을 올리고 3문장 프롬프트를 실행합니다.</span></div></li><li><div><strong>선·좌석·비율 검수</strong><span>양쪽 3+3석 배치와 주변 벽·문·치수 유지 여부를 확인합니다.</span></div></li><li><div><strong>Before ↔ After 비교</strong><span>아래 정밀 비교본과 대조해 흔들린 선이 있으면 한 줄로 재수정합니다.</span></div></li></ol>
    <div data-l05-results>{lesson05Plans.map(plan=><Lesson03Comparison before={plan.base} after={plan.result} beforeTitle={'Before · '+plan.title+' 원본'} afterTitle={'After · '+plan.title+' 가구 수정'} beforeDescription={plan.description} afterDescription={plan.result.description} beforeDownloadName={filename(plan.base)} afterDownloadName={filename(plan.result)} instance={'l05-furniture-'+plan.id} />)}</div>
    <details>
     <summary>참고 비교 · 부분 Crop 입력 ↔ 실제 AI 생성 출력 사례 보기</summary>
     <p>실제 생성형 AI의 부분 출력은 좌석 수가 맞아도 테이블 길이·깊이·선 두께가 미세하게 달라질 수 있습니다. 아래 사례를 보며 검수 포인트를 확인합니다.</p>
     <div data-l05-raw-results>{lesson05Crops.slice(0,2).map((crop,index)=><Lesson03Comparison before={crop} after={lesson05RawOutputs[index]} beforeTitle={'Input · '+crop.title} afterTitle={'Output · '+lesson05RawOutputs[index].title} beforeDescription={crop.description} afterDescription={lesson05RawOutputs[index].description} beforeDownloadName={filename(crop)} afterDownloadName={filename(lesson05RawOutputs[index])} instance={'l05-raw-'+index} />)}</div>
    </details>
   </>}
   {section.id==='l05-crop-flow'&&<>
    <ol class="l03-workflow">{['전체 도면 확인','수정할 부분 확대','변경 영역 지정','부분 도면 수정','원래 자리 전체 재반영'].map(text=><li>{text}</li>)}</ol>
    <div class="l04-table"><table><thead><tr><th>단계</th><th>확인할 연결</th></tr></thead><tbody><tr><td>가구 수정</td><td>4석 원본 → 가구 Crop 또는 영역 지정 → 6석 전체 결과</td></tr><tr><td>문 이동</td><td>6석 전체 결과 → D2·라벨 포함 영역 → 문 이동 결과</td></tr><tr><td>중첩 비교</td><td>각 단계의 입력 전체 도면과 해당 단계의 재반영본</td></tr></tbody></table></div>
