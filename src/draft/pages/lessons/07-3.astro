---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import TopicProgress from '../../components/TopicProgress.astro';
import '../../styles/lesson03.css';
import '../../styles/lesson04.css';
import {
  lesson073Title,
  lesson073Lead,
  lesson073Periods,
  lesson073Sections,
  l073QuickIndex,
  commercialTrialRows,
  autocadTrialSteps,
  sketchupTrialSteps,
  uvInstallWinCmd,
  uvInstallWinFallbackCmd,
  uvInstallMacCmd,
  uvVerifyCmd,
  manualAutoCadJson,
  manualAutoCadToml,
  manualSketchUpJson,
  manualSketchUpToml,
  manualBothJson,
  port9876CheckCmd,
  sketchUpRpcTestCmd,
  autocadTestPrompt,
  sketchupTestPrompt,
  practiceChecklistItems,
  troubleshootingFaq,
} from '../../content/daejeon-lesson07-3-cad-skp-mcp';
import {
  defaultCadSkpSelection,
  cadSkpModuleMeta,
  buildCadSkpAllInOnePowerShell,
  buildCadSkpJsonSnippet,
  buildCadSkpCodexSnippet,
} from '../../content/daejeon-lesson07-3-installer';

const initialPs1 = buildCadSkpAllInOnePowerShell(defaultCadSkpSelection);
const initialJson = buildCadSkpJsonSnippet(defaultCadSkpSelection);
const initialCodex = buildCadSkpCodexSnippet(defaultCadSkpSelection);

const tocGroups = lesson073Periods.map((period, index) => ({
  id: period.id,
  title: 'Part ' + (index + 1) + ' · ' + period.title,
  items: period.sections,
}));
const toc = tocGroups.flatMap((g) => g.items);
const sectionIndex = (id: string) => lesson073Sections.findIndex((s) => s.id === id) + 1;
---

<ReviewLayout
  title={lesson073Title}
  lead={lesson073Lead}
  page="lesson"
  lessonId="07-3"
  eyebrow="LESSON 07-3 · AUTOCAD & SKETCHUP MCP · ALL-IN-ONE & BEGINNER GUIDE"
  sharedScreen
  {toc}
  {tocGroups}
>
  <div class="lesson03-review lesson04-review l073-page" data-l073-page>
    <TopicProgress
      lesson="07"
      items={[
        {
          topic: 4,
          status: '상용 CAD·3D MCP 확장',
          note: '맨 위쪽 체크박스 올인원 빌더로 AutoCAD·SketchUp MCP를 빠르게 연결하거나, 아래쪽 일반 설치 안내를 따라 체험판 설치부터 수동 연동·검증까지 차근차근 진행합니다.',
        },
      ]}
    />

    <div class="l03-period-summary">
      {lesson073Periods.map((period, index) => (
        <article>
          <h2>Part {index + 1} · {period.title}</h2>
        </article>
      ))}
    </div>

    <aside class="review-callout">
      <h2>한눈에 보는 진행 안내 (상용 본체는 직접 설치 → MCP·플러그인은 올인원 또는 수동 연동)</h2>
      <p>
        <strong>AutoCAD(15일 체험)</strong>와 <strong>SketchUp(7일 체험)</strong>은 계정 인증이 필요한 상용 프로그램이므로 본체는 공식 홈페이지에서 직접 내려받아 설치해야 합니다.
        <strong>이미 설치되어 있다면 본체 단계는 그대로 건너뛰고</strong>, 바로 아래 <strong>[Part 1 · 올인원 체크박스 빌더]</strong>에서 원하는 MCP와 AI 도구만 체크해 한 번에 연결하세요.
        원리를 보며 직접 설치하고 싶다면 아래 <strong>[Part 2~3 · 일반 설치 안내]</strong>를 순서대로 따라 하면 됩니다.
      </p>
    </aside>

    <nav class="l073-quick-index" aria-label="제7-3차시 세부 단락 빠른 이동">
      <div class="l073-quick-index-head">
        <strong>빠른 단락 인덱스 이동</strong>
        <span>번호 배지(<code>01</code>~<code>06</code>)를 눌러 원하는 단계로 바로 이동하세요.</span>
      </div>
      <div class="l073-quick-index-grid">
        {l073QuickIndex.map((item) => (
          <a href={item.href} class="l073-quick-chip">
            <span class="l073-quick-code">{item.code}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </nav>

    {lesson073Periods.map((period, periodIndex) => (
      <div class="day-period" id={period.id} data-period={periodIndex + 1}>
        <header class="period-heading">
          <p>Part {periodIndex + 1}</p>
          <h2>{period.title}</h2>
        </header>

        {period.sections.map((section) => (
          <ReviewSection
            id={section.id}
            title={section.title}
            index={sectionIndex(section.id)}
          >
            <dl class="l03-step-context">
              <div><dt>지금 할 일</dt><dd>{section.action}</dd></div>
              <div><dt>왜 하는가</dt><dd>{section.reason}</dd></div>
              <div><dt>다음에 사용할 것</dt><dd>{section.next}</dd></div>
            </dl>

            {/* ================= 01: ALL-IN-ONE CHECKBOX BUILDER (TOP) ================= */}
            {section.id === 'l073-all-in-one-setup' && (
              <>
                <div class="l073-notice-amber">
                  <strong>📌 시작 전 확인 · 상용 본체 프로그램 설치 여부</strong>
                  <p>
                    AutoCAD와 SketchUp 본체는 상용 체험판이라 스크립트가 대신 로그인·설치할 수 없습니다.
                    <strong>이미 설치된 PC는 본체를 건드리지 않고 자동 패스</strong>하며, 아직 미설치 상태라면 아래 공식 체험판 링크에서 먼저 설치한 뒤 진행해 주세요.
                  </p>
                  <div class="l073-link-row">
                    <a class="l073-ext-btn" href="https://www.autodesk.co.kr/products/autocad/free-trial" target="_blank" rel="noopener">AutoCAD 15일 체험판 받기 ↗</a>
                    <a class="l073-ext-btn" href="https://www.sketchup.com/ko-kr/try-sketchup" target="_blank" rel="noopener">SketchUp 7일 체험판 받기 ↗</a>
                    <a class="l073-ext-btn l073-ext-btn-sub" href="#l073-trial-howto">↓ 체험판 설치 순서 먼저 보기</a>
                  </div>
                </div>

                <div class="l073-builder" data-l073-builder>
                  <div class="l073-builder-top">
                    <div>
                      <strong>빠른 프리셋 선택</strong>
                      <span>처음 세팅하는 PC는 기본 선택된 <strong>전체 올인원 (캐드 + 스케치업)</strong>을 그대로 복사하거나 <code>.bat</code>로 내려받아 실행하면 됩니다.</span>
                    </div>
                    <div class="l073-preset-row">
                      <button type="button" class="l073-preset-btn is-active" data-l073-preset="all" aria-pressed="true">추천 · 전체 올인원 (캐드+스케치업)</button>
                      <button type="button" class="l073-preset-btn" data-l073-preset="sketchup" aria-pressed="false">스케치업 MCP만</button>
                      <button type="button" class="l073-preset-btn" data-l073-preset="autocad" aria-pressed="false">오토캐드 MCP만</button>
                      <button type="button" class="l073-preset-btn" data-l073-preset="none" aria-pressed="false">전체 해제 (직접 고르기)</button>
                    </div>
                  </div>

                  <div class="l073-builder-options">
                    <fieldset class="l073-option-group">
                      <legend>① AutoCAD MCP 연결 엔진 방식</legend>
                      <label class="l073-radio-card">
                        <input type="radio" name="l073-cad-backend" value="auto" checked />
                        <div>
                          <strong>auto — 자동 선택 <span class="l073-rec-pill">추천</span></strong>
                          <p>Windows 일반 AutoCAD가 켜져 있으면 실시간 COM으로 작도하고, AutoCAD LT이거나 미설치 상태면 <code>ezdxf</code>로 표준 <code>.dxf</code> 도면을 자동 생성합니다.</p>
                        </div>
                      </label>
                      <label class="l073-radio-card">
                        <input type="radio" name="l073-cad-backend" value="com" />
                        <div>
                          <strong>com — Windows AutoCAD 실시간 제어 전용</strong>
                          <p>실행 중인 일반 AutoCAD(체험판 포함) 모델 공간에 직접 선·레이어·치수를 그립니다. (LT 버전 불가)</p>
                        </div>
                      </label>
                      <label class="l073-radio-card">
                        <input type="radio" name="l073-cad-backend" value="ezdxf" />
                        <div>
                          <strong>ezdxf — AutoCAD 없이 DXF 파일 직접 생성</strong>
                          <p>AutoCAD 미설치 PC나 LT 환경에서 도면 파일(<code>.dxf</code>)만 즉시 생성·검수할 때 적합합니다.</p>
                        </div>
                      </label>
                    </fieldset>

                    <fieldset class="l073-option-group">
                      <legend>② 이미 설치된 도구·플러그인 처리 방식</legend>
                      <label class="l073-radio-card">
                        <input type="radio" name="l073-existing-policy" value="skip" checked />
                        <div>
                          <strong>이미 정상 설치되어 있으면 그대로 패스 <span class="l073-rec-pill">추천</span></strong>
                          <p><code>uvx</code>나 정상 1계층 <code>su_mcp</code>가 이미 있으면 건너뛰고 빠진 항목과 AI 설정만 빠르게 연결합니다. (이중 중첩 오류는 자동 수정)</p>
                        </div>
                      </label>
                      <label class="l073-radio-card">
                        <input type="radio" name="l073-existing-policy" value="update" />
                        <div>
                          <strong>최신 파일로 덮어쓰기 갱신 (기존 설정은 .bak 백업)</strong>
                          <p><code>uv</code>와 SketchUp <code>su_mcp</code> 파일을 최신 버전으로 다시 내려받아 깔끔하게 덮어씁니다.</p>
                        </div>
                      </label>
                    </fieldset>
                  </div>

                  <fieldset class="l073-check-fieldset">
                    <legend>③ 설치·연동할 항목 체크박스 (체크한 항목만 스크립트와 설정 코드에 반영됩니다)</legend>
                    <div class="l073-check-grid">
                      {cadSkpModuleMeta.map((item) => (
                        <label class="l073-check-card">
                          <input
                            type="checkbox"
                            data-l073-mod={item.key}
                            checked={defaultCadSkpSelection[item.key]}
                          />
                          <div class="l073-check-body">
                            <div class="l073-check-badges">
                              <span class="l073-mod-group">{item.group}</span>
                              <span class="l073-mod-badge">{item.badge}</span>
                            </div>
                            <strong>{item.title}</strong>
                            <p>{item.summary}</p>
                          </div>
                        </label>
                      ))}
                    </div>
                  </fieldset>

                  <div class="l073-warning-list" data-l073-warnings hidden aria-live="polite"></div>

                  <div class="l073-output-panel">
                    <div class="l073-output-bar">
                      <div class="l073-output-title">
                        <strong>완성된 맞춤 PowerShell 올인원 명령어</strong>
                        <span class="l073-count-pill" data-l073-count>선택됨: 9 / 10개 항목</span>
                      </div>
                      <div class="l073-output-actions">
                        <button type="button" class="l073-sub-btn" data-l073-expand-script>코드 창 크게 보기</button>
                        <button type="button" class="l073-sub-btn" data-l073-download-ps1>ps1 파일로 저장</button>
                        <button type="button" class="l073-bat-btn" data-l073-download-bat>⚡ 더블클릭 .bat 다운로드</button>
                        <button type="button" class="l073-copy-btn l073-copy-main-btn" data-l073-copy-generated>전체 명령어 복사</button>
                      </div>
                    </div>
                    <p class="l073-output-howto">
                      <strong>초간단 실행 방법 (2가지 중 택 1):</strong><br />
                      • <strong>방법 1 (더블클릭):</strong> 위 <strong>⚡ 더블클릭 .bat 다운로드</strong> 클릭 → 내려받은 <code>setup-cad-sketchup-mcp.bat</code> 더블클릭 (Windows 파란 경고창이 뜨면 <em>추가 정보 → 실행</em>)<br />
                      • <strong>방법 2 (붙여넣기):</strong> 위 <strong>전체 명령어 복사</strong> 클릭 → 시작 메뉴에서 <strong>Windows PowerShell</strong>(일반 사용자 창 권장) 실행 → 붙여넣기 후 <strong>Enter</strong>
                    </p>
                    <pre class="l073-pre l073-pre-scroll" data-l073-script-output>{initialPs1}</pre>
                  </div>

                  <details class="l073-details">
                    <summary>체크박스 맞춤 AI 설정 코드 미리보기 (JSON · Codex TOML 직접 붙여넣기용)</summary>
                    <div class="l073-preview-grid">
                      <div class="l073-code-card">
                        <div class="l073-code-head">
                          <strong>Antigravity · Claude Desktop · Cursor (JSON)</strong>
                          <button type="button" class="l073-copy-btn" data-l073-copy-json>JSON 복사</button>
                        </div>
                        <pre class="l073-pre" data-l073-json-output>{initialJson}</pre>
                      </div>
                      <div class="l073-code-card l073-code-card-teal">
                        <div class="l073-code-head">
                          <strong>OpenAI Codex (config.toml)</strong>
                          <button type="button" class="l073-copy-btn" data-l073-copy-codex>TOML 복사</button>
                        </div>
                        <pre class="l073-pre" data-l073-codex-output>{initialCodex}</pre>
                      </div>
                    </div>
                  </details>
                </div>

                <h3 id="l073-after-rules">올인원 실행 직후 꼭 지켜야 할 마무리 규칙 3가지</h3>
                <div class="review-cards">
                  <article class="review-card">
                    <h3>1 · SketchUp 무전기 켜기 (매번 필수)</h3>
                    <p>SketchUp을 <strong>완전히 껐다가 다시 켠 뒤</strong>, 상단 메뉴 <strong><code>확장(X) → MCP Server → Start Server</code></strong>를 클릭해야 포트 <code>9876</code>이 열립니다.</p>
                  </article>
                  <article class="review-card">
                    <h3>2 · AutoCAD 도면 열기 &amp; 권한 일치</h3>
                    <p>실시간 제어를 쓸 때는 일반 AutoCAD를 먼저 실행해 <strong>새 도면 창</strong>을 열어 두세요. AutoCAD와 AI 앱은 <strong>둘 다 일반 사용자 권한</strong>으로 맞춰야 COM 연결이 막히지 않습니다.</p>
                  </article>
                  <article class="review-card">
                    <h3>3 · AI 프로그램 완전 재시작</h3>
                    <p>Codex · Antigravity · Claude Desktop · Cursor 중 연결한 프로그램을 <strong>완전히 종료했다가 새로 실행</strong>하면 <code>autocad</code>와 <code>sketchup</code> 도구가 자동으로 인식됩니다.</p>
                  </article>
                </div>
              </>
            )}

            {/* ================= 02: CONCEPT & COMMERCIAL TRIALS ================= */}
            {section.id === 'l073-concept-and-trials' && (
              <>
                <p>
                  여기서부터는 올인원 스크립트를 쓰지 않고 <strong>원리를 이해하며 하나씩 직접 설치하는 일반 가이드</strong>입니다.
                  평소 AI는 문장으로 답만 해 줄 뿐 내 PC의 AutoCAD나 SketchUp을 직접 만질 수 없습니다.
                  <strong>MCP(Model Context Protocol)</strong>는 <strong>AI(두뇌)</strong>와 <strong>건축 프로그램(손발)</strong> 사이에 놓아주는 <strong>전용 무전기</strong>입니다.
                </p>

                <div class="l073-svg-box" role="img" aria-label="AI 클라이언트와 AutoCAD, SketchUp 사이의 MCP 연동 구조도">
                  <svg viewBox="0 0 920 264" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <marker id="l073-arr-navy" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 1 L 10 5 L 0 9 z" fill="#1e3a8a" />
                      </marker>
                      <marker id="l073-arr-teal" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 1 L 10 5 L 0 9 z" fill="#0f766e" />
                      </marker>
                    </defs>
                    <rect x="16" y="48" width="218" height="168" rx="12" fill="#0f172a" stroke="#0f172a" stroke-width="2" />
                    <text x="125" y="82" fill="#93c5fd" font-size="11.5" font-weight="800" text-anchor="middle" letter-spacing="1.2">AI CLIENT (두뇌)</text>
                    <text x="125" y="112" fill="#ffffff" font-size="15.5" font-weight="700" text-anchor="middle">Codex · Antigravity</text>
                    <text x="125" y="136" fill="#ffffff" font-size="15.5" font-weight="700" text-anchor="middle">Claude · Cursor</text>
                    <line x1="40" y1="156" x2="210" y2="156" stroke="#334155" stroke-width="1" />
                    <text x="125" y="180" fill="#cbd5e1" font-size="12" text-anchor="middle">"6x4m 벽체와 3D 매스 만들어줘"</text>
                    <text x="125" y="198" fill="#94a3b8" font-size="11" text-anchor="middle">자연어 작업 지시</text>

                    <path d="M 234 98 L 326 72" fill="none" stroke="#1e3a8a" stroke-width="2.2" marker-end="url(#l073-arr-navy)" marker-start="url(#l073-arr-navy)" />
                    <path d="M 234 166 L 326 192" fill="none" stroke="#0f766e" stroke-width="2.2" marker-end="url(#l073-arr-teal)" marker-start="url(#l073-arr-teal)" />
                    <text x="278" y="69" fill="#1e3a8a" font-size="11" font-weight="700" text-anchor="middle">stdio</text>
                    <text x="278" y="207" fill="#0f766e" font-size="11" font-weight="700" text-anchor="middle">stdio</text>

                    <rect x="332" y="20" width="244" height="96" rx="12" fill="#eff6ff" stroke="#1e3a8a" stroke-width="2" />
                    <text x="454" y="45" fill="#1e3a8a" font-size="11" font-weight="800" text-anchor="middle">MCP 무전기 ① (uvx 자동 실행)</text>
                    <text x="454" y="71" fill="#0f172a" font-size="15" font-weight="800" text-anchor="middle">autocad-mcp-pro[com]</text>
                    <text x="454" y="94" fill="#475569" font-size="12" text-anchor="middle">Windows COM + ezdxf 듀얼 엔진</text>

                    <rect x="332" y="148" width="244" height="96" rx="12" fill="#f0fdfa" stroke="#0f766e" stroke-width="2" />
                    <text x="454" y="173" fill="#0f766e" font-size="11" font-weight="800" text-anchor="middle">MCP 무전기 ② (uvx 자동 실행)</text>
                    <text x="454" y="199" fill="#0f172a" font-size="15" font-weight="800" text-anchor="middle">sketchup-mcp</text>
                    <text x="454" y="222" fill="#475569" font-size="12" text-anchor="middle">로컬 TCP 127.0.0.1:9876 통신</text>

                    <line x1="576" y1="68" x2="660" y2="68" stroke="#1e3a8a" stroke-width="2.2" marker-end="url(#l073-arr-navy)" marker-start="url(#l073-arr-navy)" />
                    <text x="618" y="58" fill="#1e3a8a" font-size="11" font-weight="700" text-anchor="middle">COM / DXF</text>

                    <line x1="576" y1="196" x2="660" y2="196" stroke="#0f766e" stroke-width="2.2" marker-end="url(#l073-arr-teal)" marker-start="url(#l073-arr-teal)" />
                    <text x="618" y="186" fill="#0f766e" font-size="11" font-weight="700" text-anchor="middle">Port 9876</text>

                    <rect x="666" y="20" width="238" height="96" rx="12" fill="#ffffff" stroke="#0f172a" stroke-width="2" />
