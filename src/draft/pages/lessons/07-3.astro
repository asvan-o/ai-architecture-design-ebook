<script>
  import {
    defaultCadSkpSelection,
    evaluateCadSkpWarnings,
    buildCadSkpAllInOnePowerShell,
    buildCadSkpJsonSnippet,
    buildCadSkpCodexSnippet,
    type CadSkpInstallerSelection,
    type AutoCadBackend,
    type ExistingPolicy,
  } from '../../content/daejeon-lesson07-3-installer';

  const escapeHtml = (s: string) =>
    s
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');

  const utf8ToBase64 = (str: string) => {
    const bytes = new TextEncoder().encode(str);
    let bin = '';
    for (let i = 0; i < bytes.length; i += 1) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  };

  const buildBatFromPs1 = (ps1Content: string) => {
    const b64 = utf8ToBase64(ps1Content);
    const echoLines: string[] = [];
    for (let i = 0; i < b64.length; i += 76) {
      echoLines.push('echo ' + b64.slice(i, i + 76));
    }
    return [
      '@echo off',
      'chcp 65001 >nul',
      'setlocal',
      'title Lesson 07-3 AutoCAD & SketchUp MCP All-in-One Setup',
      'set "B64=%TEMP%\\l073_cad_skp_mcp.b64"',
      'set "PS1=%TEMP%\\l073_cad_skp_mcp.ps1"',
      'del /f /q "%B64%" "%PS1%" >nul 2>&1',
      '(',
      ...echoLines,
      ') > "%B64%"',
      'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$b=[Convert]::FromBase64String(((Get-Content -Raw \'%B64%\') -replace \'\\s\',\'\')); [IO.File]::WriteAllBytes(\'%PS1%\', [byte[]](0xEF,0xBB,0xBF) + $b); & \'%PS1%\'"',
      'del /f /q "%B64%" "%PS1%" >nul 2>&1',
      'echo.',
      'pause',
      'endlocal',
      '',
    ].join('\r\n');
  };

  const copyWithFeedback = async (text: string, btn: HTMLButtonElement | null, okLabel = '복사됨 ✓') => {
    try {
      await navigator.clipboard.writeText(text);
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = okLabel;
        setTimeout(() => {
          btn.textContent = orig;
        }, 1500);
      }
    } catch {
      // ignore
    }
  };

  const initL073Page = () => {
    const root = document.querySelector<HTMLElement>('[data-l073-page]');
    if (!root || root.dataset.l073Bound === 'true') return;
    root.dataset.l073Bound = 'true';

    // Static copy buttons
    root.querySelectorAll<HTMLButtonElement>('[data-l073-copy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        copyWithFeedback(btn.dataset.l073Copy || '', btn);
      });
    });

    // Interactive All-in-One Builder
    const builder = root.querySelector<HTMLElement>('[data-l073-builder]');
    if (builder) {
      const modBoxes = Array.from(builder.querySelectorAll<HTMLInputElement>('[data-l073-mod]'));
      const backendRadios = Array.from(builder.querySelectorAll<HTMLInputElement>('input[name="l073-cad-backend"]'));
      const policyRadios = Array.from(builder.querySelectorAll<HTMLInputElement>('input[name="l073-existing-policy"]'));
      const presetBtns = Array.from(builder.querySelectorAll<HTMLButtonElement>('[data-l073-preset]'));
      const countEl = builder.querySelector<HTMLElement>('[data-l073-count]');
      const warnEl = builder.querySelector<HTMLElement>('[data-l073-warnings]');
      const ps1Pre = builder.querySelector<HTMLElement>('[data-l073-script-output]');
      const jsonPre = builder.querySelector<HTMLElement>('[data-l073-json-output]');
      const codexPre = builder.querySelector<HTMLElement>('[data-l073-codex-output]');
      const expandBtn = builder.querySelector<HTMLButtonElement>('[data-l073-expand-script]');
      const dlPs1Btn = builder.querySelector<HTMLButtonElement>('[data-l073-download-ps1]');
      const dlBatBtn = builder.querySelector<HTMLButtonElement>('[data-l073-download-bat]');
      const copyGenBtn = builder.querySelector<HTMLButtonElement>('[data-l073-copy-generated]');
      const copyJsonBtn = builder.querySelector<HTMLButtonElement>('[data-l073-copy-json]');
      const copyCodexBtn = builder.querySelector<HTMLButtonElement>('[data-l073-copy-codex]');

      const readSelection = (): CadSkpInstallerSelection => {
        const sel: CadSkpInstallerSelection = { ...defaultCadSkpSelection };
        for (const box of modBoxes) {
          const k = box.dataset.l073Mod as keyof CadSkpInstallerSelection;
          if (k && typeof sel[k] === 'boolean') {
            (sel as unknown as Record<string, boolean>)[k] = box.checked;
          }
        }
        const checkedBackend = backendRadios.find((r) => r.checked)?.value as AutoCadBackend | undefined;
        if (checkedBackend) sel.autocadBackend = checkedBackend;
        const checkedPolicy = policyRadios.find((r) => r.checked)?.value as ExistingPolicy | undefined;
        if (checkedPolicy) sel.existingPolicy = checkedPolicy;
        return sel;
      };

      const renderBuilder = () => {
        const sel = readSelection();
        const checkedCount = modBoxes.filter((b) => b.checked).length;
        if (countEl) countEl.textContent = `선택됨: ${checkedCount} / ${modBoxes.length}개 항목`;

        const warnings = evaluateCadSkpWarnings(sel);
        if (warnEl) {
          if (warnings.length === 0) {
            warnEl.hidden = true;
            warnEl.innerHTML = '';
          } else {
            warnEl.hidden = false;
            warnEl.innerHTML = warnings
              .map(
                (w) => `<div class="l073-warn-item" data-warn-id="${escapeHtml(w.id)}">
                  <strong>⚠️ ${escapeHtml(w.title)}</strong>
                  <p>${escapeHtml(w.detail)}</p>
                </div>`,
              )
              .join('');
          }
        }

        if (ps1Pre) ps1Pre.textContent = buildCadSkpAllInOnePowerShell(sel);
        if (jsonPre) jsonPre.textContent = buildCadSkpJsonSnippet(sel);
        if (codexPre) codexPre.textContent = buildCadSkpCodexSnippet(sel);
      };

      const applyPreset = (preset: string) => {
        const map: Record<string, boolean> = {
          pythonUv: preset !== 'none',
          autocadMcp: preset === 'all' || preset === 'autocad',
          sketchupPlugin: preset === 'all' || preset === 'sketchup',
          sketchupMcp: preset === 'all' || preset === 'sketchup',
          codexConfig: preset !== 'none',
          antigravityConfig: preset !== 'none',
          claudeConfig: preset !== 'none',
          cursorConfig: false,
          backupExisting: preset !== 'none',
          runDiagnostics: preset !== 'none',
        };
        for (const box of modBoxes) {
          const k = box.dataset.l073Mod || '';
          if (k in map) box.checked = map[k];
        }
        presetBtns.forEach((b) => {
          const active = b.dataset.l073Preset === preset;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        renderBuilder();
      };

      presetBtns.forEach((btn) => {
        btn.addEventListener('click', () => applyPreset(btn.dataset.l073Preset || 'all'));
      });

      [...modBoxes, ...backendRadios, ...policyRadios].forEach((input) => {
        input.addEventListener('change', () => {
          presetBtns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          renderBuilder();
        });
      });

      copyGenBtn?.addEventListener('click', () => copyWithFeedback(ps1Pre?.textContent || '', copyGenBtn, '맞춤 명령어 복사됨 ✓'));
      copyJsonBtn?.addEventListener('click', () => copyWithFeedback(jsonPre?.textContent || '', copyJsonBtn, 'JSON 복사됨 ✓'));
      copyCodexBtn?.addEventListener('click', () => copyWithFeedback(codexPre?.textContent || '', copyCodexBtn, 'TOML 복사됨 ✓'));

      dlPs1Btn?.addEventListener('click', () => {
        const text = ps1Pre?.textContent || '';
        const blob = new Blob(['\uFEFF' + text], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'setup-cad-sketchup-mcp.ps1';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });

      dlBatBtn?.addEventListener('click', () => {
        const bat = buildBatFromPs1(ps1Pre?.textContent || '');
        const blob = new Blob([bat], { type: 'application/x-msdos-program' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'setup-cad-sketchup-mcp.bat';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });

      expandBtn?.addEventListener('click', () => {
        if (!ps1Pre) return;
        const expanded = ps1Pre.classList.toggle('is-expanded');
        expandBtn.textContent = expanded ? '코드 창 접어 두기' : '코드 창 크게 보기';
      });

      renderBuilder();
    }

    // Practice Checklist with localStorage
    const clWrap = root.querySelector<HTMLElement>('[data-l073-checklist]');
    if (clWrap) {
      const STORAGE_KEY = 'daejeon-2026:l073-cad-skp-checklist-v1';
      const boxes = Array.from(clWrap.querySelectorAll<HTMLInputElement>('[data-l073-cl-id]'));
      const pctEl = clWrap.querySelector<HTMLElement>('[data-l073-cl-pct]');
      const fillEl = clWrap.querySelector<HTMLElement>('[data-l073-cl-fill]');
      const resetBtn = clWrap.querySelector<HTMLButtonElement>('[data-l073-cl-reset]');

      const syncChecklist = () => {
        const state: Record<string, boolean> = {};
        let done = 0;
        for (const box of boxes) {
          const id = box.dataset.l073ClId || '';
          state[id] = box.checked;
          box.closest('.l073-cl-item')?.classList.toggle('is-done', box.checked);
          if (box.checked) done += 1;
        }
        const pct = Math.round((done / boxes.length) * 100);
        if (pctEl) pctEl.textContent = `${done} / ${boxes.length} 완료 (${pct}%)`;
        if (fillEl) fillEl.style.width = `${pct}%`;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch {
          // ignore
        }
      };

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') as Record<string, boolean>;
        for (const box of boxes) {
          const id = box.dataset.l073ClId || '';
          if (saved[id]) box.checked = true;
        }
      } catch {
        // ignore
      }

      boxes.forEach((b) => b.addEventListener('change', syncChecklist));
      resetBtn?.addEventListener('click', () => {
        boxes.forEach((b) => {
          b.checked = false;
        });
        syncChecklist();
      });
      syncChecklist();
    }
  };

  initL073Page();
  document.addEventListener('astro:page-load', initL073Page);
</script>

