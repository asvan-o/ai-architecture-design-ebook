---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ReviewSection from '../../components/ReviewSection.astro';
import Lesson01Position from '../../components/Lesson01Position.astro';
import Lesson01CopyrightNotice from '../../components/Lesson01CopyrightNotice.astro';
import ReviewPrompt from '../../components/ReviewPrompt.astro';
import PromptPlatformGuide from '../../components/PromptPlatformGuide.astro';
import ProjectMaterials from '../../components/ProjectMaterials.astro';
import FlowerCafeDemo from '../../components/FlowerCafeDemo.astro';
import EmptySpaceMaterials from '../../components/EmptySpaceMaterials.astro';
import AnnotatedPromptBlock from '../../../components/content/AnnotatedPromptBlock.astro';
import {lesson02FoundationConcepts as source_lesson02FoundationConcepts,lesson02PromptRules as source_lesson02PromptRules,lesson02Formula as source_lesson02Formula,lesson02PracticeThreeProblem as source_lesson02PracticeThreeProblem,lesson02PracticeThreeRevision as source_lesson02PracticeThreeRevision} from '../../../lib/lesson02-ebook';
import promptAlignment from '../../content/prompt-alignment-overrides.json';
import type {PromptPlatformGuide as PlatformGuideData} from '../../content/prompt-platform-guides';
import {flowerPrompt,flowerSegments,assembleTemplate,assembleExample,revisionExample} from '../../content/lesson01-prompt-adaptations';
import Lesson01Prompt from '../../components/Lesson01Prompt.astro';
import Lesson01Image from '../../components/Lesson01Image.astro';
import {practice,learnerText,learnerData,basicPrinciples,answerGroups} from '../../content/lesson01-learner';
const lesson02FoundationConcepts=learnerData(source_lesson02FoundationConcepts);
const lesson02PromptRules=learnerData(source_lesson02PromptRules);
const lesson02Formula=learnerData(source_lesson02Formula);
const lesson02CompletePrompt=flowerPrompt;
const lesson02AnnotatedSegments=flowerSegments;
const lesson02PracticeTemplate=assembleTemplate;
const lesson02PracticeThreeProblem=learnerData(source_lesson02PracticeThreeProblem);
const lesson02PracticeThreeRevision=learnerData(source_lesson02PracticeThreeRevision);
import {lessonTitle,lessonGoal,dayGoals,roles,safety,periods,sections,analysisAreas,briefAreas,resultChecks,revisionPrompt,workflowSummary} from '../../content/daejeon-2026';
import {packages,promptText,simpleBriefPrompt} from '../../../../scripts/daejeon-review-assets.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const assetsEnabled = import.meta.env.PUBLIC_DAEJEON_REVIEW_ASSETS === 'true';
const assetHref = (id:string,suffix:string) => assetsEnabled?`${base}/practice/${id}/${id}_${suffix}`:undefined;
const sectionFor = (id:string) => sections.find((s)=>s.id===id)!;
const tocGroups = periods.map((p,i)=>({id:p.id,title:`Part ${i+1} · ${p.title}`,items:[{id:p.id,title:`Part ${i+1} 시작`}, ...(i===0?[{id:'course-start',title:'COURSE OVERVIEW'}]:[]), ...p.sections.map(sectionFor)]}));
const toc = tocGroups.flatMap((group)=>group.items);
const annotatedText = lesson02AnnotatedSegments.map((s)=>s.text).join('\n\n');
const projectName = (id:string) => practice(id).name;
const projectLabel = (id:string) => practice(id).label;
const completeExampleId = (id:string,letter:string) => `${id}-example-${letter}-execution`;
const completeExampleGuide = (id:string,letter:string) => (promptAlignment as unknown as Record<string,PlatformGuideData>)[completeExampleId(id,letter)];
const exampleStrategyLinks:Record<string,string> = {
  'DJ-CF-01':'R6의 서로 다른 공간 사용 대안 요구를 작업 기준서에서 “빠른 이용·픽업 편의”와 “짧은 체류·편안함”으로 구체화한 예시입니다.',
  'DJ-CF-02':'R6의 서로 다른 외관 대안 요구를 작업 기준서에서 “입구의 한 점 강조”와 “거리의 수평 리듬”으로 구체화한 예시입니다.',
};
const strategyDerivationExamples = [
  {id:'DJ-CF-01',title:'실습 A · 실내 카페',keep:'같은 현황 이미지02·기준 평면도·카메라, 문·창·기둥·외곽 벽체·천장 높이, 기존 카운터(K1)와 서비스영역(S1)의 위치·기능을 함께 고정합니다.',
    alternatives:[
      {name:'전략 A · 빠른 이용·픽업 편의',action:'우측 카운터 전면의 픽업 접근·대기 동선을 비우고, 고객공간(Z1) 전경·중경에 사각 테이블·경량 좌석을 구성합니다.',basis:'R1 이용 흐름을 우선해 접근과 착석의 간섭을 줄이는 방향입니다.'},
      {name:'전략 B · 짧은 체류·편안함',action:'고객공간(Z1) 전경·창가 쪽에 독립형 낮은 쿠션 벤치·원형 테이블·라운지 좌석을 대화 단위로 묶습니다. 우측 카운터 접근과 서비스영역 앞 완충 공간을 비우고, 벤치를 후면 벽까지 잇지 않습니다.',basis:'R3의 1인·2인 이용과 R4의 사용성을 바탕으로 머무는 편안함을 강조합니다.'},
    ]},
  {id:'DJ-CF-02',title:'실습 B · 2층 상가 외관',keep:'같은 현황 이미지01·기준 입면도·카메라, 건물 매스·층수·지붕선, 주 출입구(D1)·창호(W1~W5)·간판 영역(SZ1), 보도·도로·인접 건물 관계를 함께 고정합니다.',
    alternatives:[
      {name:'전략 A · 입구의 한 점 강조',action:'우측 주 출입구(D1) 주변의 얇은 브론즈 포털·작고 얕은 캐노피·국부 조명에 시선을 모읍니다. 좌측 1층 벽과 나머지 외벽은 중립적인 밝은 미장으로 둡니다.',basis:'R1 출입 인지성을 국소적인 대비로 해결합니다.'},
      {name:'전략 B · 거리의 수평 리듬',action:'1층 불투명 전면 벽에 따뜻한 점토벽돌 마감을 적용하고, 간판 영역(SZ1) 하단 수평 선형조명과 벽등 3개를 반복합니다. 출입구에는 보조 빛을 두고 돌출 캐노피·세로 포털은 추가하지 않습니다.',basis:'R3 외관 정체성·R5 주변 관계를 전면의 반복과 연속성으로 풀면서 출입 인지성도 유지합니다.'},
    ]},
] as const;
const strategyToPromptPrinciples = [
  ['목적','선택한 전략이 해결할 목표를 씁니다.'],
  ['맥락','작업 기준서의 사용자·설계 문제·우선순위를 연결합니다.'],
  ['입력자료','현황 이미지는 편집 원본, 도면은 고정 조건, 작업 기준서는 전략의 근거로 구분합니다.'],
  ['작업 단계','공통 조건 확인 → 지정한 위치에 전략 적용 순서로 나눕니다.'],
  ['조건·제한','A/B 공통의 유지·금지 조건과 각 전략의 변경 행동·위치를 함께 적습니다.'],
  ['출력 형식','같은 원본·시점으로 안마다 이미지 1장을 요청합니다.'],
  ['검토 기준','생성 뒤 사람이 원본·결과를 대조할 기준을 정합니다. §31에서 비교하며 이미지 생성과 구분합니다.'],
] as const;
const exampleCaptions:Record<string,Record<string,string>> = {
  'DJ-CF-01':{A:'사각 테이블·경량 좌석과 우측 카운터 접근 공간으로 빠른 이용·픽업 전략을 비교합니다.',B:'독립형 쿠션 벤치·라운지 좌석·원형 테이블로 짧은 체류와 대화 단위를 비교합니다.'},
  'DJ-CF-02':{A:'기존 주 출입구(D1) 주변 브론즈 포털·소형 캐노피·국부 조명으로 입구 한 점을 강조합니다.',B:'1층 점토벽돌 마감·기존 간판 영역(SZ1) 하단 선형조명·벽등 3개 반복으로 거리의 수평 리듬을 만듭니다.'},
};
---
<ReviewLayout title={lessonTitle} lead={lessonGoal} page="lesson" sharedScreen {toc} {tocGroups}>
  <Lesson01Position />

  {periods.map((period,periodIndex)=><div class="day-period" id={period.id} data-period={periodIndex+1} data-teaching-minutes="50">
    <header class="period-heading"><p>Part {periodIndex+1}</p><h2>{period.title}</h2><p>이번 파트의 결과: {period.output}</p></header>
    {periodIndex===0 && <aside class="review-callout" id="course-start"><strong>COURSE OVERVIEW · 작업 흐름(Workflow)</strong><p>{workflowSummary}</p><p>오늘은 이미지 생성·수정의 기본을 익힌 뒤 의뢰서를 분석하는 실습으로 이어갑니다.</p><p><a href={`${base}/course-overview/`}>과정 안내 전체 보기</a> · 읽은 뒤 이 페이지로 돌아옵니다.</p></aside>}
    {period.sections.map((id,sectionIndex)=><ReviewSection {...sectionFor(id)} index={sections.findIndex((s)=>s.id===id)+1} minutes={periodIndex===0||periodIndex===3?period.timing[sectionIndex][1]:undefined}>
      {id==='goals' && <><p>AI의 제안을 사람이 확인하고 수정하며 판단하는 방법을 익힙니다.</p><ol>{dayGoals.map((goal)=><li>{goal}</li>)}</ol><p>입력한 자료와 자신의 선택·수정 과정을 함께 기록합니다.</p></>}
      {id==='ai-basics' && <><p>생성형 AI는 우리가 입력한 요청과 자료를 바탕으로 글·이미지 등의 초안과 제안을 만드는 도구입니다.</p><div class="review-cards"><article class="review-card"><h3>검색과 생성은 다릅니다</h3><p>검색은 이미 있는 원자료를 찾는 일이고, 생성은 입력을 바탕으로 새로운 설명이나 이미지를 만드는 일입니다. 두 기능을 함께 사용하더라도 만들어진 답변이 원자료 자체는 아닙니다.</p></article><article class="review-card"><h3>글과 이미지를 함께 다루기도 합니다</h3><p>여러 형식의 입력을 다루는 AI를 Multimodal AI라고 합니다. 문서·이미지를 함께 줄 수 있지만, 입력을 받는 것과 내용을 정확히 해석하는 것은 다릅니다.</p></article></div><p class="review-task">“기준 도면 파일을 찾기”와 “도면을 보고 공간 설명 초안 만들기”는 각각 어떤 작업인지 적습니다.</p></>}
      {id==='roles' && <><div class="review-cards">{roles.map((role)=><article class="review-card"><h3>{role.name}</h3><ul>{role.items.map((item)=><li>{item}</li>)}</ul></article>)}</div><aside class="review-callout">사실 확인, 현장조건, 구조·법규·시공 판단, 확인되지 않은 수치·조건은 AI의 답변만으로 결정하지 않습니다. 관련 자료와 전문가의 확인이 필요합니다.</aside><p class="review-task"><strong>판단:</strong> “대기공간의 가구 배치를 제안한다”와 “이 벽을 철거해도 된다”는 서로 다른 판단입니다. AI에게 맡길 작업과 전문가에게 확인할 일을 적습니다.</p></>}
      {id==='grounding' && <><div class="review-cards"><article class="review-card"><h3>그럴듯하지만 틀린 내용 · Hallucination</h3><p>근거가 없거나 사실과 다른 내용을 그럴듯하게 만들어낼 수 있는 현상입니다.</p><ul><li>자료에 없는 창문을 이미지에 추가합니다.</li><li>도면에 없는 면적이나 치수를 사실처럼 말합니다.</li><li>사진만 보고 구조 안전성을 확정합니다.</li><li>확인되지 않은 이용 조건을 이미 정해진 사실처럼 표현합니다.</li></ul></article><article class="review-card"><h3>자료와 연결해 확인하기 · Grounding</h3><p>제공된 문서·도면·이미지와 AI 답변을 대조해 근거를 확인합니다. 자료를 첨부했다고 오류가 없어지는 것은 아닙니다.</p></article></div><p><strong>근거 자료(Source)와 참고 이미지(Reference):</strong> 기준 도면과 제공 문서는 조건을 확인하는 근거입니다. 참고 이미지는 재료·색감·분위기를 보는 자료입니다. 참고 이미지의 창문 위치를 현황의 사실로 가져오지 않습니다.</p><p class="review-task">“사진에서 통로가 넓어 보이므로 법규에 맞습니다.” 이 설명을 확인하려면 어떤 자료가 더 필요한지 적습니다.</p><aside class="review-callout"><strong>이미지 ≠ 설계 사실.</strong> 보기 좋은 이미지가 치수·구조·법규 적합성을 증명하지는 않습니다.</aside></>}
      {id==='types' && <><p>방금 받은 분석표에서 한 문장씩 골라 아래 네 가지로 구분합니다. 원문에 있는 조건과 AI가 해석하거나 새롭게 제안한 내용을 나눕니다.</p><div class="review-table-wrap"><table data-answer-groups><thead><tr><th>구분</th><th>쉬운 설명</th><th>의뢰서 분석 예시</th></tr></thead><tbody>{answerGroups.map(([name,description,example])=><tr><th>{name}</th><td>{description}</td><td>{example}</td></tr>)}</tbody></table></div><p class="review-task">분석표의 각 문장이 어느 구분에 해당하는지 적습니다. 추론·가정·디자인 제안을 원문에서 확인한 조건처럼 쓰지 않습니다.</p></>}
      {id==='safety' && <><ul>{safety.slice(2,5).map((item)=><li>{learnerText(item)}</li>)}</ul><p>회사·발주처 자료는 조직의 보안 기준과 자료 소유자의 허용 범위를 확인합니다. 개인정보를 가리는 것만으로 외부 AI 업로드 권한이 생기지는 않습니다.</p><Lesson01CopyrightNotice/><div class="review-question"><strong>업로드 전 판단 퀴즈</strong><ol><li>고객 도면에서 이름을 지우면 외부 AI 업로드 권한이 확보되나요?</li><li>회사에서 사용하는 사진이면 모든 AI 서비스에 올려도 되나요?</li><li>인터넷에서 찾은 참고 이미지는 사용 목적과 권한을 확인하지 않아도 되나요?</li></ol></div><details><summary>답 확인</summary><p>세 질문 모두 허용 여부를 따로 확인해야 합니다. 개인정보, 조직의 보안 기준, 원본의 사용 권한을 각각 확인합니다.</p></details><p class="review-task">자신의 자료를 업로드하기 전에 확인할 질문 3개를 적습니다.</p></>}
      {id==='principles' && <><ol data-basic-principles>{basicPrinciples.map(line=><li>{line}</li>)}</ol><p>다음 단계부터는 이 원칙을 작업 요청과 이미지 결과에 적용합니다.</p></>}
      {id==='prompt-basics' && <><p>AI 작업 요청문(Prompt)은 AI에게 원하는 작업과 조건을 전달하는 입력입니다. 실무에서는 작업지시서로 이해하면 쉽습니다.</p><p>맥락은 왜·누가·어디에 쓰는지입니다. 입력에는 요청과 자료, 제한 조건이 들어갑니다. 출력은 우리가 받을 결과입니다.</p><p>AI가 전달받지 않은 조건까지 안다고 가정하지 않습니다.</p><div class="review-cards"><article class="review-card"><h3>정보를 확인하는 질문</h3><blockquote>작은 실내공간을 계획할 때 고려할 기능, 가구, 재료와 조명 요소를 항목별로 알려줘.</blockquote><p>일반 지식과 아이디어를 준비합니다. 특정 이미지를 분석하거나 제작하라는 지시는 아닙니다.</p></article><article class="review-card"><h3>작업을 맡기는 요청</h3><blockquote>첨부한 빈 상업공간 이미지를 분석하고 유지·추가·변경·삭제·금지할 요소와 이미지로 확인할 수 없는 조건을 구분해 작업 조건표를 작성해줘.</blockquote><p>자료와 작업 범위, 받을 결과의 형식을 지정합니다.</p></article></div><aside class="review-callout" id="flower-cafe-intro" data-flower-cafe-intro><p>이제 앞에서 배운 Prompt 원칙을 하나의 작은 공간 예제에 적용해봅니다.</p><h3>예시 실습 · 작은 플라워 카페 공간 바꾸기</h3><p>빈 공간 이미지에 작업 목적과 유지·변경 조건을 더해 요청합니다. <a href="#flower-cafe-demo">기준 빈 공간과 두 결과를 나란히 보기 →</a> 교육용 예시이며 실제 현장의 조건을 확정하는 자료는 아닙니다.</p></aside><details><summary>Prompt 작성 전 기본 개념</summary>{lesson02FoundationConcepts.map((concept)=><article class="theory-detail"><h3>{concept.title}</h3><strong>{concept.keyLine}</strong><p>{concept.summary}</p><p>부족: {concept.before}</p><p>개선: {concept.after}</p><ul>{concept.details.map((detail)=><li>{detail}</li>)}</ul></article>)}</details></>}
      {id==='rules' && <><p>7가지 규칙은 무엇을 빠뜨리지 않아야 하는지 확인하는 기준입니다.</p><div class="prompt-rules">{lesson02PromptRules.map((rule,index)=><article data-prompt-rule={index+1}><p class="review-eyebrow">RULE {index+1}</p><h3>{rule.title}</h3><strong>{rule.keyLine}</strong><p>{rule.meaning}</p><div class="review-cards"><div class="review-card"><h4>부족한 요청</h4><p>{rule.interiorBefore}</p></div><div class="review-card"><h4>개선된 요청</h4><p>{rule.improved}</p></div></div><p class="review-question">{rule.checkQuestion}</p><details><summary>예시 적용 · 더 알아보기</summary><h4>왜 필요한가</h4><ul>{rule.why.map((v)=><li>{v}</li>)}</ul><p>일반 예시 · 부족: {rule.generalBefore}</p><p>개선: {rule.generalAfter}</p><p>{rule.generalNote}</p><h4>부족한 이유</h4><ul>{rule.missingReasons.map((v)=><li>{v}</li>)}</ul><h4>AI가 이해해야 할 핵심</h4><ul>{rule.aiUnderstands.map((v)=><li>{v}</li>)}</ul><h4>적용 범위</h4><ul>{rule.application.map((v)=><li>{v}</li>)}</ul></details></article>)}</div></>}
      {id==='formula' && <><p>7단 공식은 앞에서 확인한 내용을 어떤 순서로 작성할지 정하는 틀입니다. 아래 순서에 맞춰 작업지시를 조립합니다.</p><ol class="review-prompt-cards">{lesson02Formula.map(([name,rule])=><li data-prompt-step><strong>{name}</strong><p>{rule}</p></li>)}</ol><p>유지·추가·변경·삭제·금지·확인 불가는 “조건·제한” 안에 정리합니다.</p></>}
      {id==='short-structured' && <><blockquote>이 빈 공간을 예쁜 플라워 카페로 만들어줘.</blockquote><p>플라워 카페 예시의 짧은 요청입니다. 문장이 짧아서가 아니라 작업 목적과 조건, 받을 결과와 검토 기준이 빠져 있어서 부족합니다.</p><details><summary>구조화 요청 예시와 문장 분석</summary><ReviewPrompt id="gw-complete" title="플라워 카페 예시 · 구조화 요청" prompt={lesson02CompletePrompt}/><p>실행문은 이미지 1장 생성에 집중합니다. 아래 분석용 문장은 역할을 읽기 쉽게 축약했으며 전체 실행문과 같은 문장이 아닙니다. 이미지 없이 읽고 문장의 역할만 살펴봅니다.</p><div data-prompt-annotation><PromptPlatformGuide id="gw-annotated-copy" /><AnnotatedPromptBlock id="gw-annotated" title="문장별 역할 분석" prompt={annotatedText} segments={[...lesson02AnnotatedSegments]}/></div></details><aside class="review-callout"><strong>생성 후 사람이 확인할 것</strong><p>원본과 결과를 나란히 놓고 유지된 요소·의도한 변경·요청하지 않은 변경·이미지로 확인할 수 없는 조건을 기록합니다. 이 비교는 이미지 생성기 출력에 포함시키지 않습니다. 분석표가 필요하면 텍스트 대화창에 두 이미지를 넣어 별도로 요청합니다.</p></aside><FlowerCafeDemo/></>}
      {id==='bad-prompt' && <><div class="review-cards"><article class="review-card"><h3>실내 공간</h3><blockquote>이 공간을 따뜻하고 예쁜 카페로 바꿔줘.</blockquote></article><article class="review-card"><h3>건물 외관</h3><blockquote>이 건물 외관을 현대적으로 바꿔줘.</blockquote></article></div><p class="review-task">목적·사용자·입력자료·유지·변경·금지·출력·검토 기준 중 빠진 내용을 찾습니다. 빈 정보를 상상해 채우기 전에 필요한 자료와 질문을 적습니다.</p><details><summary>조건이 서로 충돌하는 요청 살펴보기</summary><p><strong>학습·오류 비교 예시 · 실행 안 함.</strong> 이미지를 첨부하거나 생성하지 않고 충돌하는 지시만 읽습니다.</p><ReviewPrompt id="conflicting" title="서로 충돌하는 조건" prompt={lesson02PracticeThreeProblem}/><p>기존 가구를 유지하면서 대형 카운터와 좌석을 추가하면 통로 유지와 충돌할 수 있습니다. 우선순위를 정하고 실제 치수는 확인 필요로 남깁니다.</p><ReviewPrompt id="conflict-revision" title="조건을 구분한 수정 요청" prompt={lesson02PracticeThreeRevision}/></details></>}
      {id==='assemble' && <><p>지금은 내 작업지시서 문장을 조립·작성하는 단계입니다. 실제 이미지 첨부·실행은 §13에서 BASE 이미지를 고른 뒤 §14에서 진행합니다. 꺾쇠 빈칸은 내 조건으로 바꾸며, 삭제할 요소가 없으면 “없음”이라고 씁니다.</p><ReviewPrompt id="assemble-template" title="빈칸형 작업지시서" prompt={lesson02PracticeTemplate}/><details><summary>BASE 01 기준 완성 예시 · 지금은 읽기</summary><pre>{assembleExample}</pre></details><p>선행 분석이 필요하면 텍스트 대화창에 “이미지를 생성하지 말고 이 공간의 유지·변경 조건표를 작성해줘”라고 먼저 요청합니다. 위 양식에는 확정한 시각 작업만 옮깁니다.</p><p class="review-task">빠진 조건과 충돌을 읽고 작업지시서를 저장합니다. 생성 후 비교는 §15의 사람 검수로 분리합니다.</p></>}
      {id==='apply' && <><p>빈 공간 이미지 하나를 골라 같은 원칙을 적용합니다. 이미지에서 읽을 수 있는 조건과 바꾸려는 범위를 정해 첫 작업지시를 작성합니다.</p><EmptySpaceMaterials/><p class="review-task">목적 → 맥락 → 입력자료 → 작업 단계 → 조건·제한 → 출력 형식 → 검토 기준을 채웁니다. 다음 단계에 사용할 Prompt 1개와 입력 이미지를 준비합니다.</p></>}
      {id==='first-generation' && <><ol><li>앞 단계의 Prompt에서 빈칸·고정 조건·금지 조건을 확인합니다.</li><li>선택한 빈 공간 이미지를 Nano Banana의 이미지 생성·수정 기능에 첨부합니다.</li><li>Prompt를 입력하고 첫 이미지 1개를 생성합니다.</li><li>사용 도구·화면의 모델 표시·실행일·입력 파일명·Prompt·결과를 기록합니다.</li></ol><aside class="review-callout">첫 결과는 판단하고 수정할 첫 제안입니다. <a href="#additional-practice-images">추가 실습 이미지 BASE 01~05</a>에서 입력 이미지를 선택할 수 있습니다. 직접 생성한 결과가 있다면 원본과 비교합니다. 실행하지 못한 경우에는 실행 상태만 기록합니다.</aside></>}
      {id==='result-review' && <><ol>{resultChecks.map((check)=><li>{check}</li>)}</ol><p class="review-task"><a href="#flower-cafe-demo">플라워 카페 Before / After</a>처럼 원본과 결과를 나란히 보고 “관찰한 차이 / 요청과의 관계 / 다음 조치”를 짧게 적습니다. 예뻐도 창문·출입구·서비스영역이 바뀌면 먼저 수정합니다.</p><p>재생성은 같은 결과를 보장하지 않습니다. 수정 결과에서도 고정 요소와 비례부터 다시 확인합니다.</p></>}
      {id==='revision' && <><p>위 “AI로 작성 요청”은 관찰 메모를 주어 ChatGPT가 재수정 요청문 초안을 작성하게 하는 방법입니다. 아래 양식은 그 초안을 고치거나 직접 빈칸을 채워 실행하는 문장입니다. 둘 중 한 방식으로 최종 요청문 1개를 만듭니다.</p><p><strong>첨부 역할:</strong> 이미지 1 = 첫 생성 결과(편집 대상), 이미지 2 = 원본 빈 공간(비교 기준), 관찰 메모 = 바꿀 조건. [유지] 등 대괄호는 고정 제목, &lt;고정 요소&gt; 등 꺾쇠는 치환할 빈칸입니다.</p><ReviewPrompt id="revision-prompt" title="결과 검토를 수정 요청으로 바꾸기" prompt={revisionPrompt}/><details><summary>완성된 재수정 요청 예시</summary><pre>{revisionExample}</pre></details><aside class="review-callout"><strong>사람의 사후 검수</strong><p>원본 대비 문·창·카메라가 유지됐는지, 관찰한 문제만 바뀌었는지 비교합니다. 실제 치수·구조·법규는 이미지로 확정하지 않습니다.</p></aside><p><a href="#flower-cafe-demo">플라워 카페 예시의 수정 요청</a>처럼 유지할 부분과 가장 중요한 문제 하나를 구분합니다. 가능하면 두 번째 이미지를 생성한 뒤 같은 기준으로 비교합니다.</p><p class="review-task"><strong>필수:</strong> 첫 Prompt·첫 이미지 또는 실행 상태·결과 검토·수정 Prompt. <strong>선택 심화:</strong> 두 번째 이미지.</p></>}
      {id==='rfp-guide' && <><p><strong>의뢰서(RFP)</strong>는 고객이 원하는 목적·조건·범위를 정리한 문서입니다. 요구사항은 충족해야 할 내용이고, 제약조건은 바꿀 수 있는 범위를 제한하는 조건입니다.</p><p>이번에는 요청을 읽고 분석할 조건을 찾습니다. 제공 자료는 교육용 가상 예제이며 실제 입찰·계약·실측 자료는 아닙니다.</p></>}
      {id==='projects' && <><p>실습 A 또는 실습 B를 선택합니다. 선택한 의뢰서와 도면·현황 이미지를 다운로드하고 직접 읽습니다.</p><ProjectMaterials stage="rfp"/></>}
      {id==='read-rfp' && <><aside class="review-callout"><strong>의뢰서 01~05절 → 조건 7개 + 후속 판단 3개</strong><p>첨부된 의뢰서(RFP) 원문 01~05절에서 조건을 추출하는 7개 영역(목표·사용자·필수 요구 R1~R5·유지·변경·제외·미확정 조건)에, 05절의 미확정 조건과 R6의 대안 요구를 바탕으로 디자이너가 정리하는 3개 영역(발주처 추가 질문·전문가 확인·대안 비교 기준)을 더해 총 10개 영역으로 분석합니다.</p><p>01·03절 → 목표 / 02절 → 사용자 / 04절 R1~R5 → 필수·유지·변경·제외 / 05절 → 미확정 / 05절과 R6 → 질문·전문가 확인·대안 비교 기준.</p></aside><div class="review-cards">{packages.map((p)=><article class="review-card"><h3>{projectLabel(p.id)} · 자료 역할</h3><p>의뢰서는 요청과 범위, 도면은 교육용 치수와 고정 요소, 현황 이미지는 공간의 모습을 읽는 자료입니다.</p><p>{learnerText(p.diagramRole)}</p></article>)}</div><p class="review-task">목표·필수·유지·변경·제외·미확정에 밑줄을 긋고 근거 위치와 질문을 기록합니다.</p></>}
      {id==='analysis' && <><p>아래 분석표는 원문 조건을 추출하는 1~7번과 디자이너가 후속 확인·비교를 정리하는 8~10번을 합친 10개 영역입니다. 수치 조건은 관련 영역에 적고 필요한 항목에만 디자인 영향을 덧붙입니다.</p><p>선택한 의뢰서·기준 도면·현황 이미지를 함께 제공합니다. 작은 글씨를 읽지 못하면 “판독 불가”로 남깁니다. 지금은 조건을 분석하고, 작업 기준서와 전략은 다음 단계에서 만듭니다.</p>{packages.map((p)=><details id={`${projectLabel(p.id)==='실습 A'?'practice-a':'practice-b'}-analysis`}><summary>{projectLabel(p.id)} · 의뢰서 분석 Prompt</summary><Lesson01Prompt id={`${p.id}-analysis`} title={`${projectLabel(p.id)} · 의뢰서 분석`} prompt={promptText(p.id,'rfp-analysis-prompt.txt')} filename={`${p.id}_rfp-analysis-prompt.txt`}/></details>)}<div class="review-table-wrap"><table data-analysis-table><thead><tr><th>영역</th><th>핵심 내용</th><th>원문 근거</th><th>확인할 것</th></tr></thead><tbody>{analysisAreas.map((area)=><tr><th>{area}</th><td>1~3문장</td><td>자료명·페이지·요구 ID</td><td>답이 필요한 질문</td></tr>)}</tbody></table></div><p class="review-task">AI가 정리한 분석표를 저장합니다. 이어지는 영역에서 문장의 성격과 근거를 확인합니다.</p></>}
      {id==='evidence' && <><p>“의뢰서에서 확인됨”으로 표시한 문장 옆에 원문의 짧은 인용과 페이지·요구조건 ID를 적습니다. 근거가 없으면 원문 조건으로 취급하지 않습니다.</p><aside class="review-callout" data-confirmation-status><h3>확인 상태</h3><ul><li><strong>확인됨:</strong> 제공 자료에서 근거를 찾았습니다. 실제 현장 검증과는 구분합니다.</li><li><strong>추가 확인 필요:</strong> 도면·실측·담당자 답변 등으로 더 확인해야 합니다.</li><li><strong>아직 정하지 않음:</strong> 선택이나 답변이 남아 있습니다. 임시 가정은 실제 조건으로 확정하지 않습니다.</li></ul></aside><p class="review-task">추론에는 확인 질문, 임시 가정에는 해제할 조건, 디자인 제안에는 선택 이유를 남깁니다.</p></>}
      {id==='next-verification' && <><p>지금 표시한 문장 구분·원문 근거·확인 상태를 다음 단계에 가져갑니다. 빠진 요구, 잘못 읽은 조건, 미확정 항목을 원문과 대조한 뒤 작업 기준서를 만듭니다.</p><a class="review-download" href="#verify-conditions">다음 단계 · 원문 대조와 검증</a></>}
      {id==='verify-conditions' && <><p>AI 분석의 각 항목을 의뢰서 원문과 대조합니다. 확인한 근거와 아직 답이 필요한 부분을 기록합니다.</p><ol><li>원문에 없는 내용: 제안·가정·질문으로 분리합니다.</li><li>빠진 조건: 필수·유지·제외 조건을 근거와 함께 복원합니다.</li><li>분류 오류: 유지할 조건을 변경 범위에 넣었는지 확인합니다.</li><li>미확정을 확정한 내용: 답을 받기 전까지 미확정으로 되돌립니다.</li></ol><p class="review-task">추가 질문 3~5개를 “누구에게 / 무엇을 / 답에 따라 어떤 결정이 달라지는가”로 적습니다. 구조·설비·법규·시공은 별도 전문가 확인으로 남깁니다.</p><details><summary>검증 질문</summary><ul><li>원문 근거와 필수 조건이 모두 있는가?</li><li>수치·사용자·현장 조건을 임의로 확정하지 않았는가?</li><li>자료에서 확인한 내용과 추론·가정·제안을 구분했는가?</li><li>미확정을 질문으로 전환했는가?</li><li>선택과 수정에 자신의 판단 근거가 있는가?</li></ul></details></>}
      {id==='brief' && <><p><strong>디자인 작업 기준서(Design Brief)</strong>는 의뢰서의 조건을 확인한 뒤 실제 디자인 작업에 사용할 기준으로 다시 정리한 문서입니다.</p><p>의뢰서 분석 10개 영역은 원문 조건과 질문을 파악하는 단계입니다. 원문 대조 뒤 디자이너가 3. 핵심 설계 문제, 4. 설계 우선순위 1→2→3, 9. 디자인 대안 전략 2개를 결정·보완하여 실제 디자인에 쓸 작업 기준서 10개 항목으로 전환합니다. AI가 제안한 우선순위·전략은 사람이 선택하기 전까지 후보 초안입니다.</p><ol data-simple-brief>{briefAreas.map((area)=><li>{area}</li>)}</ol>{packages.map((p)=><details><summary>{projectLabel(p.id)} · 작업 기준서 Prompt</summary><Lesson01Prompt id={`${p.id}-brief`} title={`${projectLabel(p.id)} · 작업 기준서 만들기`} prompt={simpleBriefPrompt(p.id)} filename={`${p.id}_day01-design-brief-prompt.txt`}/></details>)}<p>지금 AI가 제안하는 우선순위와 전략은 <strong>후보 제안 초안</strong>입니다. §26에서 사람이 우선순위를 정하고 §27에서 전략을 선택·보완한 뒤 작업 기준서를 확정합니다. 각 판단에 이유를, 미확정·가정에는 확인 질문을 남깁니다.</p></>}
      {id==='priorities' && <><p>§25의 작업 기준서에서 무엇을 먼저 해결할지 정합니다. 먼저 유지 조건·제외 범위를 지키고, 그 안에서 이용 흐름·체류 방식 또는 출입 인지·거리 조화의 우선순위를 판단합니다.</p><p class="review-task">“1순위 [조건·설계 문제] → 2순위 [조건·설계 문제] → 3순위 [조건·설계 문제]”를 의뢰서 근거와 연결합니다. 답변이나 전문가 확인이 필요한 판단은 보류합니다.</p><aside class="review-callout" data-priority-to-strategy><strong>우선순위에서 두 대안으로</strong><p>예를 들어 같은 자리에서 픽업 통로와 체류 좌석을 모두 늘리려 하면 공간 사용이 충돌할 수 있습니다. 공통 고정 조건을 바꾸어 해결하지 않고, 작업 기준서 9번의 전략 초안을 다음 단계에서 두 가지 해결 방향으로 나누어 비교합니다.</p></aside></>}
      {id==='strategies' && <><aside class="review-callout" data-why-two-strategies><strong>왜 전략을 두 개로 나누나요?</strong><p>의뢰서(RFP) 04절 R6가 같은 고정 조건 안에서 비교할 수 있는 서로 다른 대안 2개를 요구하기 때문입니다. 한 이미지에 상충하는 행동을 한꺼번에 넣기보다, §26에서 정한 우선순위에 따라 해결 방법을 두 갈래로 나누면 장점과 한계를 비교할 수 있습니다.</p></aside><p><strong>도출 순서:</strong> §25 작업 기준서 9번의 후보 전략 → §26 우선순위 확인 → A/B의 유지·금지 조건 공통 고정 → 변경 가능한 핵심 행동과 적용 위치를 두 방향으로 구체화합니다.</p>{strategyDerivationExamples.map((example)=><article data-strategy-derivation={example.id}><h3>{example.title} · 공통 조건에서 두 방향 도출</h3><div class="review-table-wrap"><table><thead><tr><th>구분</th><th>전략을 만드는 판단과 행동</th></tr></thead><tbody><tr><th>A/B 공통 유지</th><td>{example.keep}</td></tr>{example.alternatives.map((alternative)=><tr><th>{alternative.name}</th><td><p>{alternative.action}</p><p><strong>근거·우선순위:</strong> {alternative.basis}</p></td></tr>)}</tbody></table></div></article>)}<p>R6는 두 대안을 요구하지만 위 전략명이나 구체적 배치를 정답으로 지정하지는 않습니다. 색상만 바꾸는 대신 공간 사용 또는 외관 표현의 방법을 달리하고, 두 안 모두 필수 조건을 충족하는지 비교합니다.</p></>}
      {id==='learning-prompt' && <><p><strong>새 양식을 두 번 작성하는 단계가 아닙니다.</strong> Part 2에서 배운 7단 구조로 방금 도출한 전략이 이미지 요청문의 어느 부분에 들어가는지만 확인합니다.</p><div class="review-table-wrap"><table data-strategy-to-seven-step><thead><tr><th>7단 구조</th><th>전략을 요청문으로 바꾸는 원리</th></tr></thead><tbody>{strategyToPromptPrinciples.map(([part,principle])=><tr><th>{part}</th><td>{principle}</td></tr>)}</tbody></table></div><p>완성된 A/B 실행문과 이미지는 §30에서 바로 볼 수 있습니다. 직접 다른 전략을 적용할 때만 아래 양식을 참고합니다.</p>{packages.map((p)=><details data-optional-prompt-template={`${p.id}-learning`}><summary>{projectLabel(p.id)} · 직접 빈칸을 채워 응용해 볼 때 여는 7단 양식 · 선택 참고</summary><Lesson01Prompt id={`${p.id}-learning`} title={`${projectLabel(p.id)} · 학습용 7단 요청문 양식`} prompt={promptText(p.id,'image-prompt-from-brief.txt')} filename={`${p.id}_image-prompt-from-brief.txt`}/></details>)}</>}
      {id==='execution-prompt' && <><p><strong>A/B의 핵심 차이는 [변경]에 들어갑니다.</strong> 문·창·카메라 등 [유지]의 핵심 고정 조건과 [금지] 범위는 함께 지키고, [변경]의 행동·적용 위치를 전략 A와 B로 나눕니다.</p><div class="review-table-wrap"><table data-five-part-comparison><thead><tr><th>5항목</th><th>A/B에서 공통으로 두거나 달리하는 것</th></tr></thead><tbody><tr><th>[목적]</th><td>같은 목표·입력자료를 바탕으로 어느 전략을 표현할지 구분합니다.</td></tr><tr><th>[유지]</th><td>원본·시점·구조·개구부 등 공통 고정 조건을 유지합니다.</td></tr><tr><th>[변경]</th><td>§27에서 정한 전략 A/B의 구체적 행동과 적용 위치가 달라집니다.</td></tr><tr><th>[금지]</th><td>구조·개구부 변경과 실습 범위를 넘는 작업은 두 안 모두 제외합니다.</td></tr><tr><th>[결과]</th><td>같은 시점·비교 조건으로 안마다 이미지 1장을 요청합니다.</td></tr></tbody></table></div><p>카페는 “사각 테이블·경량 좌석”과 “독립형 쿠션 벤치·원형 테이블·라운지 좌석”, 외관은 “출입구 주변 한 점 강조”와 “1층 마감·수평 조명 반복”이 [변경]의 차이입니다. 다음 단계의 완성문에서 이 부분을 찾아봅니다.</p>{packages.map((p)=><details data-optional-prompt-template={`${p.id}-execution`}><summary>{projectLabel(p.id)} · 직접 빈칸을 채워 응용해 볼 때 여는 5항목 양식 · 선택 참고</summary><Lesson01Prompt id={`${p.id}-execution`} title={`${projectLabel(p.id)} · A/B별로 채우는 실행문 양식`} prompt={promptText(p.id,'image-prompt-execution.txt')} filename={`${p.id}_image-prompt-execution.txt`}/></details>)}</>}
      {id==='ab-generation' && <><p>§27의 두 전략이 아래 완성 실행문의 [변경] 조건과 기존 예시 이미지에 어떻게 연결되는지 차례로 읽습니다. 직접 실습할 때는 같은 편집 원본·기준 도면으로 A의 실행문과 B의 실행문을 각각 입력해 이미지 1장씩 생성합니다.</p><div data-complete-ab-examples><p>완성 실행문은 기존 이미지의 전략을 정리한 교육용 문안이며 당시 실제 도구 호출 원문과 구분합니다. 같은 문안으로도 결과가 달라질 수 있습니다.</p>{packages.map((p)=><article><h3>{projectName(p.id)} · 전략 → 완성 실행문 → 결과 이미지</h3><p>{exampleStrategyLinks[p.id]}</p><p>{p.id==='DJ-CF-01'?'아래 5줄 완성 실행문은 사각·경량 좌석 중심 전략과 독립형 대화 좌석 중심 전략을 정리한 예시입니다.':'아래는 기존 문단형 TXT를 보존한 완성 실행문입니다. 앞 단계의 5항목과 문단 형식은 다르지만 입력·유지·변경·금지·결과 조건으로 읽습니다.'}</p><div class="review-cards">{['A','B'].map((letter,i)=><article class="review-card"><h4>전략 {letter} · {p.strategyNames[i]}</h4><ReviewPrompt id={completeExampleId(p.id,letter)} title={`${projectLabel(p.id)} · 전략 ${letter} 완성 실행예시`} guide={completeExampleGuide(p.id,letter)} prompt={promptText(p.id,`example-${letter}-execution-prompt.txt`)} filename={`${p.id}_example-${letter}-execution-prompt.txt`}/><figure>{assetsEnabled && <Lesson01Image id={`${p.id}-example-${letter}`} src={assetHref(p.id,`example-${letter}.png`)!} alt={`${projectName(p.id)} · 전략 ${letter}`}/>}<figcaption>{exampleCaptions[p.id][letter]}</figcaption></figure>{assetsEnabled&&<p><a class="review-download" href={assetHref(p.id,`example-${letter}-execution-prompt.txt`)} download={`${p.id}_example-${letter}-execution-prompt.txt`}>보존된 완성 실행예시 TXT 다운로드</a> · <a href={assetHref(p.id,`example-${letter}-generation-prompt.txt`)} download={`${p.id}_example-${letter}-generation-prompt.txt`}>당시 실제 생성 원문 TXT · 제작 기록</a> · <a href={assetHref(p.id,`example-${letter}.png`)} download={`${p.id}_example-${letter}.png`}>예시 이미지 PNG 다운로드</a></p>}</article>)}</div><p>{p.id==='DJ-CF-01'?'두 안 모두 서비스영역(S1) 후면·카운터 상판·접근 통로를 비우는 조건이 같습니다. 예시의 좌석 수·가구 적합성과 서비스영역 경계는 기준 평면도에서 추가 확인합니다.':'기존 생성 이미지는 시각 참고이며 현재 교육용 기준 도면의 수치·정밀 투영 일치를 보증하지 않습니다. 당시 생성 원문의 구형 수치는 제작 기록이며 현재 치수 근거가 아닙니다.'}</p></article>)}</div><p class="review-task">두 전략·실행문 2개·이미지 또는 실행 상태를 함께 남깁니다. 이어지는 §31에서 유지 조건과 전략 차이를 같은 기준으로 비교하고 선택·보류 이유를 기록합니다.</p></>}
      {id==='compare' && <><p>두 전략을 같은 기준으로 평가하고 선택·보류 이유를 적습니다.</p><ol><li>원본 구조·개구부·서비스영역·시점이 유지됐는가?</li><li>각 전략의 사용 방식 또는 입구·거리 관계가 읽히는가?</li><li>요청하지 않은 추가·삭제·비례 오류가 있는가?</li><li>어떤 전략을 어떤 근거로 선택하고 무엇을 다음에 수정할 것인가?</li><li>이미지로 확인하지 못한 조건은 무엇인가?</li></ol><p class="review-task">선택 또는 보류 이유 2~3문장과 다음 수정 1개를 적습니다. 외관 예시에서는 A의 입구 강조가 과도한지, B에서 기존 주 출입구(D1)가 잘 보이는지도 비교합니다.</p></>}
      {id==='outputs' && <><div class="review-cards"><article class="review-card"><h3>작업지시 기초 기록</h3><ul><li>구조화 Prompt 1개</li><li>첫 생성 이미지 또는 실행 상태와 검토</li><li>수정 Prompt</li><li>가능하면 수정 이미지</li></ul></article><article class="review-card"><h3>선택한 의뢰서의 분석 기록</h3><ul><li>선택한 실습과 10개 영역 분석</li><li>추가 질문·전문가 확인</li><li>작업 기준서</li><li>전략 2개와 실행 Prompt</li><li>가능하면 A/B 이미지와 선택 이유</li></ul></article></div><p>사용한 자료와 미확정 조건, 선택 이유를 한 묶음으로 정리합니다. 직접 생성한 결과와 예시를 비교한 기록은 구분합니다.</p></>}
    </ReviewSection>)}

  </div>)}
</ReviewLayout>
