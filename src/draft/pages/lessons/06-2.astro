<script>
  const bindL062Copy = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-l062-copy]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const text = btn.dataset.l062Copy || '';
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.textContent;
          btn.textContent = '복사됨 ✓';
          setTimeout(() => {
            btn.textContent = orig;
          }, 1400);
        } catch {
          // ignore
        }
      });
    });
  };
  bindL062Copy();
  document.addEventListener('astro:page-load', bindL062Copy);
</script>

