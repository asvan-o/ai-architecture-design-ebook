---
import { activeCourse } from '../../lib/courses';
import '../../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portalHref = base.replace(new RegExp(`/${activeCourse.routeSlug}$`), '') + '/';
---
<!doctype html>
<html lang="ko" data-course-id={activeCourse.courseId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{activeCourse.regionLabel} 과정 | AI Lecture 건축디자인</title>
  </head>
  <body>
    <main class="course-draft" data-course-status="design-pending">
      <p class="eyebrow">AI LECTURE · ARCHITECTURE DESIGN</p>
      <h1>{activeCourse.regionLabel} 과정</h1>
      <h2>현재 과정 설계 중입니다.</h2>
      <p>교육과정이 확정되면 이곳에 강의자료를 안내합니다.</p>
      <a href={portalHref}>← 과정 선택으로 돌아가기</a>
    </main>
  </body>
</html>
<style>
  .course-draft{max-width:54rem;margin:auto;padding:clamp(3rem,10vw,8rem) 1.5rem}.course-draft h1{font-family:var(--serif);font-size:clamp(3rem,7vw,5rem)}.course-draft h2{font-size:1.5rem}.course-draft a{display:inline-block;margin-top:2rem;color:var(--accent-dark)}
</style>
