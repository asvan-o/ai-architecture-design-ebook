---
import ReviewLayout from '../layouts/ReviewLayout.astro';
import {officialTopics} from '../content/course-roadmap';
import {alignedLessons, topicLessonLinks} from '../content/lesson-topic-alignment';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessonTopicsMap = new Map<string, string[]>();
officialTopics.forEach((topicTitle, idx) => {
  for (const link of topicLessonLinks[idx] ?? []) {
    const list = lessonTopicsMap.get(link.id) ?? [];
    const label = `대주제 ${idx + 1} · ${topicTitle}`;
    if (!list.includes(label)) list.push(label);
    lessonTopicsMap.set(link.id, list);
  }
});
const cards=[
  {title:'COURSE OVERVIEW',topicLabels:['전체 과정 · 7개 대주제 Roadmap'],schedule:'과정 전체 안내',description:'과정 전체 방향과 7개 대주제 Roadmap, 도구 역할을 안내합니다.',path:'course-overview'},
  ...alignedLessons.map(lesson=>({...lesson,topicLabels:lessonTopicsMap.get(lesson.id) ?? [],path:'lessons/'+lesson.id})),
];
---
<ReviewLayout title="대전 과정" lead="과정 안내와 제1~13차시 실습을 대주제 흐름에 따라 이어갑니다." page="home">
  <p>AI 활용의 원칙을 익히고, 이미지·도면·업무 자동화 실습을 차례로 따라가는 교재입니다.</p>
  <section class="home-topic-roadmap" id="home-topic-roadmap" aria-labelledby="home-topic-roadmap-heading">
    <h2 id="home-topic-roadmap-heading">7개 대주제 · 13차시 전체 목차</h2>
    <p>상위 대주제 흐름을 먼저 확인하고, 각 대주제에 연결된 차시로 바로 이동할 수 있습니다.</p>
    <ol class="home-topic-roadmap__list">
      {officialTopics.map((topicTitle, index) => (
        <li class="home-topic-roadmap__item">
          <span class="home-topic-roadmap__number">대주제 {String(index + 1).padStart(2, '0')}</span>
          <div class="home-topic-roadmap__body">
            <strong class="home-topic-roadmap__title">{topicTitle}</strong>
            <div class="home-topic-roadmap__links">
              {(topicLessonLinks[index] ?? []).map((lesson) => {
                const info = alignedLessons.find((item) => item.id === lesson.id);
                const shortTitle = info ? info.title.replace(/^제\d+차시\s*·\s*/, '') : '';
                return (
                  <a href={`${base}/lessons/${lesson.id}/`}>
                    <strong>{lesson.label}</strong>
                    {shortTitle && <span> · {shortTitle}</span>}
                  </a>
                );
              })}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>
  <div class="review-cards">
    {cards.map(card=>{
      const pdfFile = card.path==='course-overview'
        ? 'ai-architecture-design-daejeon-course-overview.pdf'
        : `ai-architecture-design-daejeon-lesson-${card.path.split('/')[1]}.pdf`;
      return (
        <article class="review-card" data-course-lesson-card={card.path}>
          {card.topicLabels.length > 0 && (
            <div class="review-card__topics">
              {card.topicLabels.map((label) => <span class="review-card__topic-badge">{label}</span>)}
            </div>
          )}
          <h2>{card.title}</h2>
          <p><strong>{card.schedule}</strong></p>
          <p>{card.description}</p>
          <p>
            <a href={base+'/'+card.path+'/'}>{card.path==='course-overview'?'COURSE OVERVIEW':'제'+Number(card.path.split('/')[1])+'차시'} 읽기 →</a>
            {' · '}
            <a href={`${base}/downloads/daejeon/pdf/${pdfFile}`} download>교보재 PDF ↓</a>
          </p>
        </article>
      );
    })}
  </div>
  <aside class="review-callout">각 차시에서 실습 이미지 확대 보기와 자료·Prompt·교보재 PDF 다운로드를 사용할 수 있습니다.</aside>
</ReviewLayout>
