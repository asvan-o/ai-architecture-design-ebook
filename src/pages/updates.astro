---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/reference-content.css';

const entry = (await getCollection('updates'))[0];
if (!entry) throw new Error('updates 컬렉션 콘텐츠가 없습니다.');
const { Content } = await render(entry);
---

<SiteLayout title="업데이트 및 정정 내역" section="UPDATES">
  <div class="page-shell updates-page">
    <header class="page-intro">
      <p class="page-kicker">CHANGELOG · CORRECTIONS</p>
      <h1 class="page-title">업데이트 및<br />정정 내역</h1>
      <p class="lead">내용 변경, 사실 검증일, 정정 사유를 학생이 확인할 수 있도록 기록하는 화면입니다.</p>
    </header>
    <Content />
  </div>
</SiteLayout>
