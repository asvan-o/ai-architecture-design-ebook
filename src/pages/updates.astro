---
import SiteLayout from '../layouts/SiteLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
---

<SiteLayout title="업데이트 및 정정 내역" section="UPDATES">
  <div class="page-shell updates-page">
    <header class="page-intro">
      <p class="page-kicker">CHANGELOG · CORRECTIONS</p>
      <h1 class="page-title">업데이트 및<br />정정 내역</h1>
      <p class="lead">내용 변경, 사실 검증일, 정정 사유를 학생이 확인할 수 있도록 기록하는 화면입니다.</p>
    </header>

    <section class="update-log" aria-labelledby="update-title">
      <div class="section-heading">
        <span>01</span>
        <h2 id="update-title">변경 기록</h2>
      </div>
      <ol>
        <li>
          <time datetime="2026-07-28">2026.07.28</time>
          <div>
            <span>UI SYSTEM</span>
            <h3>전자서적 기본 골격 생성</h3>
            <p>콘텐츠를 포함하지 않은 개발환경과 페이지 구조를 생성했습니다.</p>
          </div>
          <StatusBadge status="디자인 제안" />
        </li>
        {[1, 2].map(() => (
          <li class="placeholder-update">
            <time>—</time>
            <div>
              <span>CONTENT</span>
              <h3>업데이트 내역 검토 예정</h3>
              <p>승인된 변경 기록이 이 위치에 추가됩니다.</p>
            </div>
            <StatusBadge status="검증 필요" />
          </li>
        ))}
      </ol>
    </section>
  </div>
</SiteLayout>

<style>
  .page-intro { margin-bottom: 6rem; }
  .update-log ol { margin: 0; padding: 0; border-top: 1px solid var(--line-dark); list-style: none; }
  .update-log li {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .update-log time { color: var(--accent); font-size: 0.78rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .update-log div > span { color: var(--muted); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.12em; }
  .update-log h3 { margin: 0.35rem 0; font-family: var(--serif); font-size: 1.4rem; }
  .update-log p { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .placeholder-update { opacity: 0.72; }
  @media (max-width: 650px) {
    .update-log li { grid-template-columns: 1fr; gap: 0.7rem; }
    .update-log :global(.status-badge) { justify-self: start; }
  }
</style>
