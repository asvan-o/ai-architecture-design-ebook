---
import SiteLayout from '../layouts/SiteLayout.astro';
import PdfDownloadPanel from '../components/PdfDownloadPanel.astro';
import { getVisibleLessons } from '../lib/lessons';
import { getLessonTopics } from '../lib/lesson-topics';
import { withBase } from '../lib/site';

const lessons = await getVisibleLessons();
const lessonsById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
const topicGroups = getLessonTopics().map((topic) => ({
  topic,
  lessons: topic.lessonIds.flatMap((lessonId) => {
    const lesson = lessonsById.get(lessonId);
    return lesson ? [lesson] : [];
  }),
}));
const dateLabel = (date: string) => date === 'pending' ? '일정 확인 예정' : date;
const durationLabel = (durationMinutes: number | null) =>
  durationMinutes === null ? '수업시간 확인 예정' : `${durationMinutes}분`;
---

<SiteLayout title="전체 강의 목차" section="CURRICULUM">
  <div class="page-shell curriculum-page">
    <header class="page-intro">
      <p class="page-kicker">CURRICULUM · 7 TOPICS · 14 LESSONS</p>
      <h1 class="page-title">전체 강의<br />목차</h1>
      <p class="lead">
        총 48시간의 과정을 7개 상위 주제와 14개 하위 차시의 흐름으로 확인합니다.
        각 차시는 해당 주제 안에서 순서대로 이어집니다.
      </p>
    </header>

    <section class="course-summary" aria-label="과정 요약">
      <p><span>COURSE</span><strong>AI 건축디자인 바이블</strong></p>
      <p><span>SCHEDULE</span><strong>2026년 8월</strong></p>
      <p><span>STRUCTURE</span><strong>7 TOPICS · 14 LESSONS</strong></p>
      <p><span>TOTAL</span><strong>48 HOURS</strong></p>
    </section>

    <PdfDownloadPanel
      eyebrow="COURSE PDF"
      items={[{
        href: '/downloads/ai-architecture-design-course.pdf',
        label: '전체 교안 PDF 다운로드',
        meta: '14차시 학생용 교안 · A4',
      }]}
    />

    <div class="topic-groups">
      {topicGroups.map(({ topic, lessons: topicLessons }) => (
        <section class="topic-group" aria-labelledby={`topic-${topic.number}-title`}>
          <header class="topic-group__header">
            <p>주제 {topic.number}</p>
            <h2 id={`topic-${topic.number}-title`}>{topic.title}</h2>
            <span>{topic.lessonCount}개 차시</span>
          </header>
          <ol class="curriculum-list">
            {topicLessons.map((lesson) => (
              <li>
                <a href={withBase(`/lessons/${lesson.id}/`)}>
                  <span class="number">{String(lesson.data.day).padStart(2, '0')}</span>
                  <div>
                    <p>LESSON {String(lesson.data.day).padStart(2, '0')}</p>
                    <h3>{lesson.data.title}</h3>
                  </div>
                  <div class="schedule">
                    <span>{dateLabel(lesson.data.date)}</span>
                    <span>{durationLabel(lesson.data.durationMinutes)}</span>
                  </div>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
    {lessons.length === 0 && (
      <p class="empty-lessons">현재 공개된 차시가 없습니다. 검토가 완료된 차시부터 순차적으로 제공됩니다.</p>
    )}
  </div>
</SiteLayout>

<style>
  .page-intro {
    margin-bottom: 5rem;
  }

  .course-summary {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.7fr;
    margin-bottom: 4rem;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .course-summary p {
    display: grid;
    min-height: 7rem;
    align-content: space-between;
    margin: 0;
    padding: 1rem;
    border-right: 1px solid var(--line-dark);
  }

  .course-summary p:last-child {
    border-right: 0;
  }

  .course-summary span,
  .schedule span {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .course-summary strong {
    font-family: var(--serif);
    font-size: 1rem;
  }

  .topic-groups {
    display: grid;
    gap: 4rem;
  }

  .topic-group {
    border-top: 2px solid var(--ink);
  }

  .topic-group__header {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.5rem 0.7rem 1.8rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .topic-group__header p,
  .topic-group__header span {
    margin: 0;
    color: var(--accent-dark);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .topic-group__header h2 {
    max-width: 32ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.4vw, 2.35rem);
    font-weight: 650;
    line-height: 1.3;
    text-wrap: balance;
    word-break: keep-all;
  }

  .topic-group__header span {
    color: var(--muted);
    letter-spacing: 0;
  }

  .curriculum-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .curriculum-list li {
    border-bottom: 1px solid var(--line-dark);
  }

  .empty-lessons {
    margin: 0;
    padding: 3rem 1rem;
    border-bottom: 1px solid var(--line-dark);
    color: var(--muted);
  }

  .curriculum-list a {
    display: grid;
    grid-template-columns: 5rem minmax(16rem, 1fr) 11rem 2rem;
    gap: 1.2rem;
    align-items: center;
    min-height: 8.5rem;
    padding: 1rem 0.7rem;
    text-decoration: none;
  }

  .curriculum-list a:hover {
    padding-inline: 1.4rem;
    background: var(--surface);
  }

  .number {
    color: var(--accent);
    font-family: var(--serif);
    font-size: 2.8rem;
    line-height: 1;
  }

  .curriculum-list h3 {
    margin: 0.2rem 0 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .curriculum-list div > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .schedule {
    display: grid;
  }

  .arrow {
    font-size: 1.4rem;
  }

  @media (max-width: 950px) {
    .course-summary {
      grid-template-columns: 1fr 1fr;
    }

    .course-summary p:nth-child(2) {
      border-right: 0;
    }

    .course-summary p:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .curriculum-list a {
      grid-template-columns: 4rem 1fr auto;
    }

    .schedule {
      display: none;
    }

    .topic-group__header {
      grid-template-columns: 5rem 1fr;
    }

    .topic-group__header span {
      grid-column: 2;
    }
  }

  @media (max-width: 520px) {
    .course-summary {
      grid-template-columns: 1fr;
    }

    .course-summary p {
      min-height: 5.5rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .curriculum-list a {
      grid-template-columns: 3rem 1fr 1.2rem;
      gap: 0.7rem;
      min-height: 7rem;
    }

    .number {
      font-size: 2rem;
    }

    .topic-groups {
      gap: 3rem;
    }

    .topic-group__header {
      display: block;
      padding: 1.2rem 0.2rem 1.4rem;
    }

    .topic-group__header h2 {
      margin: 0.4rem 0 0.7rem;
      font-size: 1.45rem;
    }
  }
</style>
