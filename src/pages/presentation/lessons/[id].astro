---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PresentationDeck from '../../../components/presentation/PresentationDeck.astro';
import { getVisibleLessons } from '../../../lib/lessons';
import { getLessonTopicSummary } from '../../../lib/lesson-topics';
import '../../../styles/global.css';
import '../../../styles/lesson-content.css';
import '../../../styles/presentation.css';

type Lesson = CollectionEntry<'lessons'>;

interface Props {
  lesson: Lesson;
}

export async function getStaticPaths() {
  if (import.meta.env.MODE !== 'instructor') return [];
  const lessons = await getVisibleLessons();
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const lessonId = String(lesson.data.day).padStart(2, '0');
const topic = getLessonTopicSummary(lessonId);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>프레젠테이션 · {lesson.data.title}</title>
  </head>
  <body class="presentation-page">
    <a class="skip-link" href="#presentation-deck">프레젠테이션으로 이동</a>
    <main id="presentation-deck">
      <PresentationDeck
        contentId={`lesson-${lessonId}`}
        kicker={`LESSON ${lessonId}`}
        title={lesson.data.title}
        topic={topic ? `주제 ${topic.number} · ${topic.title}` : ''}
        role="projector"
      >
        <div class="lesson-content"><Content /></div>
      </PresentationDeck>
    </main>
  </body>
</html>
