---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/reference-content.css';

const entry = (await getCollection('troubleshooting'))[0];
if (!entry) throw new Error('troubleshooting 컬렉션 콘텐츠가 없습니다.');
const { Content } = await render(entry);
---

<SiteLayout title="오류 해결 가이드" section="TROUBLESHOOTING">
  <div class="page-shell troubleshooting-page">
    <header class="page-intro">
      <p class="page-kicker">TROUBLESHOOTING · QUICK REFERENCE</p>
      <h1 class="page-title">오류 해결<br />가이드</h1>
      <p class="lead">증상, 가능한 원인, 확인 순서, 해결 방법을 일관된 형식으로 제공하기 위한 기본 구조입니다.</p>
    </header>
    <Content />
  </div>
</SiteLayout>
