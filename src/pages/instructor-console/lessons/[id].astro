---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import InstructorDeckConsole from '../../../components/instructor/InstructorDeckConsole.astro';
import InstructorNoteSlot from '../../../components/instructor/InstructorNoteSlot.astro';
import { getInstructorNoteSlots } from '../../../lib/instructor-notes';
import { getVisibleLessons } from '../../../lib/lessons';
import { getLessonTopicSummary } from '../../../lib/lesson-topics';
import { withBase } from '../../../lib/site';
import '../../../styles/global.css';
import '../../../styles/lesson-content.css';
import '../../../styles/presentation.css';
import '../../../styles/instructor-console.css';

type Lesson = CollectionEntry<'lessons'>;

interface Props {
  lesson: Lesson;
  lessons: Lesson[];
}

export async function getStaticPaths() {
  if (import.meta.env.MODE !== 'instructor') return [];
  const lessons = await getVisibleLessons();
  return lessons.map((lesson) => ({
    params: { id: lesson.id },
    props: { lesson, lessons },
  }));
}

const { lesson, lessons } = Astro.props;
const { Content } = await render(lesson);
const sections = lesson.data.sections ?? [];
const lessonId = String(lesson.data.day).padStart(2, '0');
const topic = getLessonTopicSummary(lessonId);
const navigation = [
  { href: withBase('/instructor-console/lecture-start/'), label: '강의 시작' },
  ...lessons.map((item) => ({
    href: withBase(`/instructor-console/lessons/${item.id}/`),
    label: `${String(item.data.day).padStart(2, '0')} · ${item.data.title}`,
    current: item.id === lesson.id,
  })),
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>강사용 콘솔 · {lesson.data.title}</title>
  </head>
  <body class="presenter-console">
    <a class="skip-link" href="#console-main">강사용 콘솔로 이동</a>
    <div id="console-main">
      <InstructorDeckConsole
        contentId={`lesson-${lessonId}`}
        kicker={`LESSON ${lessonId}`}
        title={lesson.data.title}
        topic={topic ? `주제 ${topic.number} · ${topic.title}` : ''}
        presentationUrl={withBase(`/presentation/lessons/${lesson.id}/`)}
        durationMinutes={lesson.data.durationMinutes ?? undefined}
        {navigation}
      >
        <div slot="source" class="lesson-content"><Content /></div>
        <div slot="notes">
          <section data-note-panel="title" class="console-note-panel">
            <p class="console-note-empty">차시 제목 슬라이드입니다. 첫 섹션으로 이동하면 등록된 강사 메모를 확인할 수 있습니다.</p>
          </section>
          {sections.map((section) => {
            const noteSlots = getInstructorNoteSlots(lessonId, section.id);
            return (
              <section data-note-panel={section.id} class="console-note-panel" hidden>
                {noteSlots.length > 0
                  ? noteSlots.map((note) => (
                    <InstructorNoteSlot lessonId={lessonId} slot={note.slot} label={note.label} />
                  ))
                  : <p class="console-note-empty">현재 섹션에 등록된 강사 메모가 없습니다.</p>}
              </section>
            );
          })}
        </div>
      </InstructorDeckConsole>
    </div>
  </body>
</html>
