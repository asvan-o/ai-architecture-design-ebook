---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PdfDownloadPanel from '../../components/PdfDownloadPanel.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getVisibleLessons } from '../../lib/lessons';
import { getLessonTopicSummary } from '../../lib/lesson-topics';
import { pageSections, withBase } from '../../lib/site';
import '../../styles/lesson-content.css';

type Lesson = CollectionEntry<'lessons'>;
interface Props {
  lesson: Lesson;
  previous?: Lesson;
  next?: Lesson;
}

export async function getStaticPaths() {
  const lessons = await getVisibleLessons();
  return lessons.map((lesson, index) => ({
    params: { id: lesson.id },
    props: {
      lesson,
      previous: lessons[index - 1],
      next: lessons[index + 1],
    },
  }));
}

const { lesson, previous, next } = Astro.props;
const { Content } = await render(lesson);
const dayLabel = String(lesson.data.day).padStart(2, '0');
const topic = getLessonTopicSummary(dayLabel);
const dateLabel = lesson.data.date === 'pending' ? '일정 확인 예정' : lesson.data.date;
const durationLabel = lesson.data.durationMinutes === null
  ? '수업시간 확인 예정'
  : `${lesson.data.durationMinutes}분`;
const verifiedLabel = lesson.data.lastVerified ?? '검토 전';
const isDetailedLesson = lesson.data.day === 1;
const publicDateLabel = isDetailedLesson ? dateLabel.replaceAll('-', '.') : dateLabel;
const professionalReviewScope = lesson.data.professionalReviewScope ?? [];
const localSections = lesson.data.sections ?? pageSections.map((label, index) => ({
  id: `section-${String(index + 1).padStart(2, '0')}`,
  label,
}));
---

<SiteLayout title={lesson.data.title} section={`LESSON ${dayLabel}`}>
  <article class="lesson-page">
    <header class:list={['lesson-hero', { 'lesson-hero--public': isDetailedLesson }]}>
      {!isDetailedLesson && (
        <div class="lesson-hero__number" aria-hidden="true">{dayLabel}</div>
      )}
      <div class="lesson-hero__copy">
        {topic && (
          <div class="lesson-topic-context">
            <span>주제 {topic.number}</span>
            <strong>{topic.title}</strong>
          </div>
        )}
        <p class="page-kicker">
          LESSON {dayLabel}{!isDetailedLesson && ' · OUTLINE REVIEW REQUESTED'}
        </p>
        <h1>{lesson.data.title}</h1>
        {!isDetailedLesson && (
          <p>
            승인된 14차시 커리큘럼을 기준으로 작성한 교육 콘텐츠 골격입니다.
            상세 원고와 실제 자산은 아직 포함하지 않습니다.
          </p>
        )}
      </div>
      {isDetailedLesson ? (
        <dl class="lesson-meta lesson-meta--public">
          <div><dt>날짜:</dt><dd>{publicDateLabel}</dd></div>
          <div><dt>수업시간:</dt><dd>{durationLabel}</dd></div>
        </dl>
      ) : (
        <dl class="lesson-meta">
          <div><dt>DATE</dt><dd>{dateLabel}</dd></div>
          <div><dt>DURATION</dt><dd>{durationLabel}</dd></div>
          <div><dt>LAST VERIFIED</dt><dd>{verifiedLabel}</dd></div>
          <div class="lesson-meta__statuses">
            <dt>CONTENT STATUS</dt>
            <dd>
              <StatusBadge kind="contentType" value={lesson.data.contentType} />
              <StatusBadge kind="authorship" value={lesson.data.authorship} />
              <StatusBadge kind="verificationStatus" value={lesson.data.verificationStatus} />
              <StatusBadge kind="freshness" value={lesson.data.freshness} />
              <StatusBadge kind="riskLevel" value={lesson.data.riskLevel} />
              {(lesson.data.professionalReviewStatus === 'required' ||
                lesson.data.professionalReviewStatus === 'completed') && (
                <StatusBadge
                  kind="professionalReviewStatus"
                  value={lesson.data.professionalReviewStatus}
                />
              )}
            </dd>
          </div>
          {professionalReviewScope.length > 0 && (
            <div class="lesson-meta__review-scope">
              <dt>PRO REVIEW SCOPE</dt>
              <dd>
                <ul>
                  {professionalReviewScope.map((scope) => <li>{scope}</li>)}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      )}
    </header>

    <PdfDownloadPanel
      compact
      items={[{
        href: `/downloads/ai-architecture-design-lesson-${dayLabel}.pdf`,
        label: 'PDF 다운로드',
        meta: `제${lesson.data.day}차시 학생용 교안 · A4`,
      }]}
    />

    <nav class="lesson-local-nav" aria-label="이 차시의 섹션" tabindex="0">
      <div class="lesson-local-nav__heading">
        <span>ON THIS PAGE</span>
        <span class="lesson-local-nav__hint">옆으로 넘겨 전체 보기 →</span>
      </div>
      <ol>
        {localSections.map((section, index) => (
          <li>
            <a href={`#${section.id}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>{section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="lesson-content">
      <Content />
    </div>

    <nav class="lesson-pagination" aria-label="이전·다음 차시">
      {previous ? (
        <a class="previous" href={withBase(`/lessons/${previous.id}/`)}>
          <span>← PREVIOUS</span><strong>{previous.data.title}</strong>
        </a>
      ) : (
        <span class="pagination-empty">첫 번째 차시입니다.</span>
      )}
      {next ? (
        <a class="next" href={withBase(`/lessons/${next.id}/`)}>
          <span>NEXT →</span><strong>{next.data.title}</strong>
        </a>
      ) : (
        <span class="pagination-empty pagination-empty--next">마지막 차시입니다.</span>
      )}
    </nav>
  </article>
</SiteLayout>

<style>
  .lesson-hero {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(20rem, 1fr) minmax(19rem, 0.5fr);
    min-height: 31rem;
    border-bottom: 1px solid var(--line-dark);
  }
  .lesson-hero__number {
    display: grid;
    place-items: center;
    color: #f2efe8;
    background: var(--ink);
    font-family: var(--serif);
    font-size: clamp(6rem, 10vw, 10rem);
    letter-spacing: -0.08em;
  }
  .lesson-hero__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 5rem);
  }
  .lesson-topic-context {
    display: grid;
    gap: 0.35rem;
    max-width: 48rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-dark);
  }
  .lesson-topic-context span {
    color: var(--accent-dark);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }
  .lesson-topic-context strong {
    font-family: var(--serif);
    font-size: clamp(1rem, 1.45vw, 1.35rem);
    line-height: 1.4;
    text-wrap: balance;
    word-break: keep-all;
  }
  .lesson-hero__copy h1 {
    width: 100%;
    max-width: 56rem;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.75rem, 4.6vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1.08;
    line-break: strict;
    overflow-wrap: normal;
    text-wrap: balance;
    word-break: keep-all;
  }
  .lesson-hero__copy > p:last-child {
    max-width: 35rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
  .lesson-hero--public {
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.34fr);
    min-height: 24rem;
  }
  .lesson-hero--public .lesson-hero__copy h1 { max-width: 56rem; }
  .lesson-meta {
    display: grid;
    grid-template-rows: repeat(3, minmax(5rem, auto)) auto;
    margin: 0;
    border-left: 1px solid var(--line-dark);
  }
  .lesson-meta > div {
    display: grid;
    align-content: space-between;
    padding: 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .lesson-meta > div:last-child { border-bottom: 0; }
  .lesson-meta dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .lesson-meta dd { margin: 0; font-size: 0.84rem; font-weight: 700; }
  .lesson-meta__statuses dd { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  .lesson-meta__statuses :global(.status-badge) { font-size: 0.65rem; }
  .lesson-meta__review-scope { grid-column: 1 / -1; }
  .lesson-meta__review-scope dd { margin-top: 0.7rem; }
  .lesson-meta__review-scope ul { margin: 0; padding-left: 1.1rem; }
  .lesson-meta__review-scope li { color: var(--muted); font-size: 0.76rem; }
  .lesson-meta--public { grid-template-rows: repeat(2, minmax(6rem, 1fr)); }
  .lesson-meta--public dt { letter-spacing: 0; }
  .lesson-meta--public dd { font-size: 1rem; }
  .lesson-local-nav {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 2rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line-dark);
    background: var(--paper-deep);
  }
  .lesson-local-nav__heading > span:first-child {
    padding-top: 0.4rem;
    color: var(--accent-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .lesson-local-nav__hint { display: none; }
  .lesson-local-nav ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lesson-local-nav a {
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    color: #434a46;
    font-size: 0.76rem;
    text-decoration: none;
  }
  .lesson-local-nav a span { color: var(--accent-dark); }
  .lesson-local-nav a:hover { color: var(--ink); text-decoration: underline; }
  .lesson-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line-dark);
  }
  .lesson-pagination a,
  .pagination-empty {
    display: grid;
    min-height: 9rem;
    align-content: center;
    padding: 2rem clamp(1.5rem, 5vw, 5rem);
    text-decoration: none;
  }
  .lesson-pagination a:first-child { border-right: 1px solid var(--line-dark); }
  .lesson-pagination a:hover { color: #fff; background: var(--ink); }
  .lesson-pagination a span {
    color: var(--accent-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .lesson-pagination a:hover span { color: #ffb49f; }
  .lesson-pagination strong { margin-top: 0.5rem; font-family: var(--serif); font-size: 1.35rem; }
  .lesson-pagination .next,
  .pagination-empty--next { text-align: right; }
  .pagination-empty { color: var(--muted); font-size: 0.85rem; }
  @media (max-width: 1880px) {
    .lesson-hero { grid-template-columns: 7rem 1fr; }
    .lesson-hero.lesson-hero--public { grid-template-columns: 1fr; }
    .lesson-hero__number { font-size: 5rem; }
    .lesson-meta { grid-column: 1 / -1; grid-template-columns: repeat(3, 1fr) minmax(17rem, 1.5fr); border-top: 1px solid var(--line-dark); border-left: 0; }
    .lesson-meta.lesson-meta--public { grid-template-columns: repeat(2, 1fr); }
    .lesson-meta > div { border-right: 1px solid var(--line); border-bottom: 0; }
  }
  @media (max-width: 760px) {
    .lesson-hero { display: block; }
    .lesson-hero__number { display: block; padding: 1rem 1.5rem; font-size: 3.5rem; }
    .lesson-hero__copy { padding: 2.5rem 1.5rem; }
    .lesson-hero__copy h1 {
      max-width: none;
      font-size: clamp(2.35rem, 11.5vw, 3.25rem);
      letter-spacing: -0.045em;
      line-height: 1.14;
    }
    .lesson-meta { grid-template-columns: 1fr 1fr; }
    .lesson-meta__statuses { grid-column: 1 / -1; }
    .lesson-local-nav { display: block; overflow-x: auto; padding: 1rem 1.5rem; }
    .lesson-local-nav__heading {
      display: flex;
      width: calc(100vw - 3rem);
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.7rem;
    }
    .lesson-local-nav__heading > span:first-child { padding-top: 0; }
    .lesson-local-nav__hint {
      display: inline;
      color: var(--accent-dark);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0;
      white-space: nowrap;
    }
    .lesson-local-nav ol { display: flex; width: max-content; }
    .lesson-local-nav a { min-width: 10rem; }
    .lesson-pagination { grid-template-columns: 1fr; }
    .lesson-pagination a:first-child { border-right: 0; border-bottom: 1px solid var(--line-dark); }
    .pagination-empty {
      min-height: 4.5rem;
      padding-block: 1.25rem;
    }
    .pagination-empty:not(.pagination-empty--next) { border-bottom: 1px solid var(--line-dark); }
    .lesson-pagination .next,
    .pagination-empty--next { text-align: left; }
  }
</style>
