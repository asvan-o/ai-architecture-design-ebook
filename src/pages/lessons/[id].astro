---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import PromptCopy from '../../components/PromptCopy';
import CourseTools from '../../components/CourseTools';
import ImageZoom from '../../components/ImageZoom';
import ImageCompare from '../../components/ImageCompare';
import { pageSections, withBase } from '../../lib/site';

type Lesson = CollectionEntry<'lessons'>;
interface Props {
  lesson: Lesson;
  previous?: Lesson;
  next?: Lesson;
}

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons')).sort((a, b) => a.data.day - b.data.day);
  return lessons.map((lesson, index) => ({
    params: { id: lesson.id },
    props: {
      lesson,
      previous: lessons[index - 1],
      next: lessons[index + 1],
    },
  }));
}

const { lesson, previous, next } = Astro.props;
const dayLabel = String(lesson.data.day).padStart(2, '0');
const sectionId = (index: number) => `section-${String(index + 1).padStart(2, '0')}`;
---

<SiteLayout title={lesson.data.title} section={`LESSON ${dayLabel}`}>
  <article class="lesson-page">
    <header class="lesson-hero">
      <div class="lesson-hero__number" aria-hidden="true">{dayLabel}</div>
      <div class="lesson-hero__copy">
        <p class="page-kicker">LESSON {dayLabel} · CONTENT REVIEW PENDING</p>
        <h1>{lesson.data.title}</h1>
        <p>아래 영역은 강의 페이지의 레이아웃과 기능을 확인하기 위한 짧은 placeholder입니다.</p>
      </div>
      <dl class="lesson-meta">
        <div><dt>DATE</dt><dd>{lesson.data.date}</dd></div>
        <div><dt>DURATION</dt><dd>{lesson.data.duration}</dd></div>
        <div><dt>LAST VERIFIED</dt><dd>{lesson.data.lastVerified}</dd></div>
        <div><dt>STATUS</dt><dd><StatusBadge status={lesson.data.reviewStatus} /></dd></div>
      </dl>
    </header>

    <nav class="lesson-local-nav" aria-label="이 차시의 섹션">
      <span>ON THIS PAGE</span>
      <ol>
        {pageSections.map((section, index) => (
          <li><a href={`#${sectionId(index)}`}><span>{String(index + 1).padStart(2, '0')}</span>{section}</a></li>
        ))}
      </ol>
    </nav>

    <div class="lesson-content">
      <section class="lesson-section lesson-section--intro" id={sectionId(0)} aria-labelledby="learning-title">
        <div class="section-heading"><span>01</span><h2 id="learning-title">학습 목표</h2></div>
        <div class="objective-grid">
          {[1, 2, 3].map((item) => (
            <div><span>{String(item).padStart(2, '0')}</span><p>검토된 학습 목표가 이 위치에 표시됩니다.</p></div>
          ))}
        </div>
      </section>

      <section class="lesson-section" id={sectionId(1)} aria-labelledby="terms-title">
        <div class="section-heading"><span>02</span><h2 id="terms-title">필수 용어</h2></div>
        <div class="term-chips">
          <span>용어 검토 예정</span><span>용어 검토 예정</span><span>용어 검토 예정</span>
        </div>
      </section>

      <section class="lesson-section output-section" id={sectionId(2)} aria-labelledby="output-title">
        <div>
          <div class="section-heading"><span>03</span><h2 id="output-title">오늘 완성할 결과물</h2></div>
          <p class="placeholder">완성 결과물의 기준과 예시 설명이 이 위치에 표시됩니다.</p>
        </div>
        <ImageZoom client:visible />
      </section>

      <section class="lesson-section theory-section" id={sectionId(3)} aria-labelledby="theory-title">
        <div class="section-heading"><span>04</span><h2 id="theory-title">핵심 이론</h2></div>
        <div class="theory-layout">
          <div class="pull-quote">
            <span>CORE IDEA</span>
            <p>검토된 핵심 문장이 이 위치에 강조 표시됩니다.</p>
          </div>
          <div>
            <span class="placeholder-label">CONTENT PLACEHOLDER</span>
            <p class="placeholder">승인된 이론 설명과 출처가 이 위치에 표시됩니다. 출처 없는 전문정보는 작성하지 않습니다.</p>
            <p class="placeholder">문단, 목록, 표, 이미지 등 MDX 콘텐츠를 수용할 수 있는 본문 폭과 간격을 확인합니다.</p>
          </div>
        </div>
      </section>

      <section class="lesson-section demo-section" id={sectionId(4)} aria-labelledby="demo-title">
        <div class="section-heading"><span>05</span><h2 id="demo-title">강사 시연</h2></div>
        <div class="demo-placeholder">
          <span>VIDEO / DEMO PLACEHOLDER</span>
          <strong>검토된 시연 영상 또는 이미지 예정</strong>
          <p>재생 자료, 단계 표시, 보충 설명을 배치할 수 있는 영역입니다.</p>
        </div>
      </section>

      <section class="lesson-section practice-section" id={sectionId(5)} aria-labelledby="practice-title">
        <div class="section-heading"><span>06</span><h2 id="practice-title">단계별 실습</h2></div>
        <ol class="practice-list">
          {[1, 2, 3, 4].map((item) => (
            <li>
              <span>STEP {String(item).padStart(2, '0')}</span>
              <div><h3>실습 단계 검토 예정</h3><p>승인된 작업 순서와 확인 기준이 표시됩니다.</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="lesson-section" id={sectionId(6)} aria-labelledby="prompt-title">
        <div class="section-heading"><span>07</span><h2 id="prompt-title">프롬프트 예시</h2></div>
        <p class="placeholder section-copy">복사 기능 확인을 위한 placeholder입니다. 실제 프롬프트는 검토 후 제공됩니다.</p>
        <PromptCopy client:idle />
      </section>

      <section class="lesson-section cases-section" id={sectionId(7)} aria-labelledby="cases-title">
        <div class="section-heading"><span>08</span><h2 id="cases-title">성공 사례와 실패 사례</h2></div>
        <ImageCompare client:visible />
        <div class="case-notes">
          <article><span>SUCCESS</span><h3>성공 기준 검토 예정</h3><p>승인된 판단 기준과 관찰 항목이 표시됩니다.</p></article>
          <article><span>FAILURE</span><h3>실패 기준 검토 예정</h3><p>승인된 오류 징후와 개선 방향이 표시됩니다.</p></article>
        </div>
      </section>

      <section class="lesson-section fact-section" id={sectionId(8)} aria-labelledby="fact-title">
        <div class="section-heading"><span>09</span><h2 id="fact-title">사실 검증</h2></div>
        <div class="fact-panel">
          <div>
            <StatusBadge status={lesson.data.reviewStatus} />
            <h3>콘텐츠 검토 대기</h3>
            <p>실제 사실 주장과 출처가 제공되기 전까지 이 영역은 placeholder로 유지됩니다.</p>
          </div>
          <dl>
            <div><dt>출처</dt><dd>{lesson.data.sources.length > 0 ? `${lesson.data.sources.length}개` : '등록 전'}</dd></div>
            <div><dt>고위험 콘텐츠</dt><dd>{lesson.data.highRiskContent ? '포함' : '현재 없음'}</dd></div>
            <div><dt>전문가 검토</dt><dd>{lesson.data.requiresProfessionalReview ? '필요' : '현재 미지정'}</dd></div>
          </dl>
        </div>
      </section>

      <section class="lesson-section warning-section" id={sectionId(9)} aria-labelledby="warning-title">
        <div class="section-heading"><span>10</span><h2 id="warning-title">주의사항</h2></div>
        <div class="warning-box">
          <span aria-hidden="true">!</span>
          <div><h3>주의 문구 검토 예정</h3><p>안전, 저작권, 도구 한계 등 승인된 주의사항이 이 위치에 표시됩니다.</p></div>
          <StatusBadge status="전문가 검토 필요" />
        </div>
      </section>

      <div id={sectionId(10)}>
        <CourseTools client:load lessonId={lesson.id} />
      </div>

      <section class="lesson-section quiz-section" id={sectionId(11)} aria-labelledby="quiz-title">
        <div class="section-heading"><span>12</span><h2 id="quiz-title">확인 문제</h2></div>
        <fieldset disabled>
          <legend>검토된 확인 문제가 이 위치에 표시됩니다.</legend>
          <label><input type="radio" name="placeholder-quiz" /> 선택지 검토 예정</label>
          <label><input type="radio" name="placeholder-quiz" /> 선택지 검토 예정</label>
          <label><input type="radio" name="placeholder-quiz" /> 선택지 검토 예정</label>
        </fieldset>
      </section>

      <section class="lesson-section download-section" id={sectionId(12)} aria-labelledby="download-title">
        <div class="section-heading"><span>13</span><h2 id="download-title">실습 파일</h2></div>
        <div class="download-placeholder">
          <span>FILE · PENDING</span>
          <div><strong>실습 파일 검토 예정</strong><p>승인된 파일명, 형식, 용량이 표시됩니다.</p></div>
          <button type="button" disabled>준비 중</button>
        </div>
      </section>
    </div>

    <nav class="lesson-pagination" aria-label="이전·다음 차시">
      {previous ? (
        <a class="previous" href={withBase(`/lessons/${previous.id}/`)}>
          <span>← PREVIOUS</span><strong>{previous.data.title}</strong>
        </a>
      ) : (
        <span class="pagination-empty">첫 번째 차시입니다.</span>
      )}
      {next ? (
        <a class="next" href={withBase(`/lessons/${next.id}/`)}>
          <span>NEXT →</span><strong>{next.data.title}</strong>
        </a>
      ) : (
        <span class="pagination-empty pagination-empty--next">마지막 차시입니다.</span>
      )}
    </nav>
  </article>
</SiteLayout>

<style>
  .lesson-hero {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(20rem, 1fr) minmax(17rem, 0.45fr);
    min-height: 31rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .lesson-hero__number {
    display: grid;
    place-items: center;
    color: #f2efe8;
    background: var(--ink);
    font-family: var(--serif);
    font-size: clamp(6rem, 10vw, 10rem);
    letter-spacing: -0.08em;
  }

  .lesson-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .lesson-hero__copy h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 5vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1.08;
  }

  .lesson-hero__copy > p:last-child {
    max-width: 35rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }

  .lesson-meta {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    margin: 0;
    border-left: 1px solid var(--line-dark);
  }

  .lesson-meta div {
    display: grid;
    align-content: space-between;
    padding: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .lesson-meta div:last-child { border-bottom: 0; }
  .lesson-meta dt { color: var(--muted); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; }
  .lesson-meta dd { margin: 0; font-size: 0.82rem; font-weight: 700; }

  .lesson-local-nav {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 2rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line-dark);
    background: var(--paper-deep);
  }

  .lesson-local-nav > span {
    padding-top: 0.4rem;
    color: var(--accent);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .lesson-local-nav ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson-local-nav a {
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    color: #4f5752;
    font-size: 0.72rem;
    text-decoration: none;
  }

  .lesson-local-nav a span { color: var(--accent); }
  .lesson-local-nav a:hover { color: var(--ink); text-decoration: underline; }

  .lesson-content {
    width: min(100%, 73rem);
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 6vw, 6rem);
  }

  .lesson-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-bottom: 1px solid var(--line-dark);
  }

  .objective-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }

  .objective-grid div {
    min-height: 12rem;
    padding: 1.3rem;
    border-right: 1px solid var(--line-dark);
  }

  .objective-grid div:last-child { border-right: 0; }
  .objective-grid span { color: var(--accent); font-size: 0.72rem; font-weight: 800; }
  .objective-grid p { margin-top: 3rem; color: var(--muted); font-size: 0.9rem; }

  .term-chips { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .term-chips span { padding: 0.5rem 0.8rem; border: 1px solid var(--line-dark); background: var(--surface); font-size: 0.82rem; }

  .output-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .theory-layout {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 4rem;
  }

  .pull-quote { padding: 1.6rem; color: #fff; background: var(--ink); }
  .pull-quote span { color: #aeb6b1; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.13em; }
  .pull-quote p { margin: 5rem 0 0; font-family: var(--serif); font-size: 1.65rem; line-height: 1.5; }
  .theory-layout > div:last-child > p { margin-top: 0; }

  .demo-placeholder {
    display: grid;
    min-height: 25rem;
    place-content: center;
    padding: 2rem;
    color: #eff2ef;
    background:
      linear-gradient(135deg, transparent 0 45%, rgba(255,255,255,.08) 45% 55%, transparent 55%),
      var(--blue);
    text-align: center;
  }
  .demo-placeholder span { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.15em; }
  .demo-placeholder strong { margin-top: 0.7rem; font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.6rem); }
  .demo-placeholder p { max-width: 30rem; color: #ced9da; font-size: 0.85rem; }

  .practice-list { margin: 0; padding: 0; border-top: 1px solid var(--line-dark); list-style: none; }
  .practice-list li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 2rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .practice-list li > span { color: var(--accent); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; }
  .practice-list h3 { margin: 0; font-family: var(--serif); font-size: 1.25rem; }
  .practice-list p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.88rem; }

  .section-copy { margin: -1rem 0 1.5rem; }

  .case-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line-dark);
    border-top: 0;
  }
  .case-notes article { padding: 1.5rem; border-right: 1px solid var(--line-dark); }
  .case-notes article:last-child { border-right: 0; }
  .case-notes span { color: var(--accent); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.13em; }
  .case-notes h3 { margin: 1rem 0 0.4rem; font-family: var(--serif); }
  .case-notes p { margin: 0; color: var(--muted); font-size: 0.85rem; }

  .fact-panel {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    border: 1px solid var(--line-dark);
    background: var(--surface);
  }
  .fact-panel > div, .fact-panel dl { padding: 2rem; }
  .fact-panel h3 { margin: 1.4rem 0 0.4rem; font-family: var(--serif); font-size: 1.6rem; }
  .fact-panel p { margin: 0; color: var(--muted); }
  .fact-panel dl { margin: 0; border-left: 1px solid var(--line-dark); background: var(--paper-deep); }
  .fact-panel dl div { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid var(--line); font-size: 0.8rem; }
  .fact-panel dt { color: var(--muted); }
  .fact-panel dd { margin: 0; font-weight: 750; }

  .warning-box {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.6rem;
    border: 1px solid var(--accent);
    background: #f4e9e1;
  }
  .warning-box > span { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: 50%; color: #fff; background: var(--accent); font-weight: 800; }
  .warning-box h3 { margin: 0; font-family: var(--serif); }
  .warning-box p { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.85rem; }

  .lesson-content > div[id] { padding: clamp(4rem, 8vw, 7rem) 0; border-bottom: 1px solid var(--line-dark); scroll-margin-top: 4rem; }

  .quiz-section fieldset { display: grid; gap: 0.7rem; padding: 1.5rem; border: 1px solid var(--line-dark); }
  .quiz-section legend { padding: 0 0.7rem; font-family: var(--serif); font-size: 1.1rem; }
  .quiz-section label { padding: 0.7rem; border: 1px solid var(--line); color: var(--muted); }

  .download-placeholder {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.4rem;
    border: 1px solid var(--line-dark);
    background: var(--surface);
  }
  .download-placeholder > span { color: var(--accent); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em; }
  .download-placeholder strong { font-family: var(--serif); }
  .download-placeholder p { margin: 0; color: var(--muted); font-size: 0.8rem; }
  .download-placeholder button { padding: 0.5rem 0.8rem; border: 1px solid var(--line-dark); color: var(--muted); background: var(--paper-deep); }

  .lesson-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 5rem;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .lesson-pagination a, .pagination-empty {
    display: grid;
    min-height: 9rem;
    align-content: space-between;
    padding: 1.5rem clamp(1.5rem, 5vw, 5rem);
    text-decoration: none;
  }
  .lesson-pagination a:first-child, .pagination-empty:first-child { border-right: 1px solid var(--line-dark); }
  .lesson-pagination a:hover { color: #fff; background: var(--ink); }
  .lesson-pagination a > span { color: var(--accent); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.12em; }
  .lesson-pagination a strong { font-family: var(--serif); font-size: 1.15rem; }
  .lesson-pagination .next { text-align: right; }
  .pagination-empty { color: var(--muted); font-size: 0.8rem; }
  .pagination-empty--next { text-align: right; }

  @media (max-width: 980px) {
    .lesson-hero { grid-template-columns: 8rem 1fr; }
    .lesson-meta { grid-column: 1 / -1; grid-template-columns: repeat(4, 1fr); grid-template-rows: auto; border-top: 1px solid var(--line-dark); border-left: 0; }
    .lesson-meta div { min-height: 6rem; border-right: 1px solid var(--line); border-bottom: 0; }
    .lesson-local-nav { grid-template-columns: 1fr; gap: 0.8rem; }
    .lesson-local-nav ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 700px) {
    .lesson-hero { grid-template-columns: 1fr; }
    .lesson-hero__number { min-height: 10rem; place-items: end start; padding: 1.2rem; font-size: 6rem; }
    .lesson-hero__copy { padding: 2.5rem 1.25rem; }
    .lesson-meta { grid-template-columns: 1fr 1fr; }
    .lesson-meta div { border-bottom: 1px solid var(--line); }
    .lesson-local-nav { padding-inline: 1.25rem; }
    .lesson-local-nav ol { grid-template-columns: 1fr 1fr; }
    .lesson-content { padding-inline: 1.25rem; }
    .objective-grid, .output-section, .theory-layout, .fact-panel { grid-template-columns: 1fr; }
    .objective-grid div { min-height: 8rem; border-right: 0; border-bottom: 1px solid var(--line); }
    .objective-grid p { margin-top: 1.5rem; }
    .output-section { gap: 2rem; }
    .pull-quote p { margin-top: 3rem; }
    .case-notes { grid-template-columns: 1fr; }
    .case-notes article { border-right: 0; border-bottom: 1px solid var(--line); }
    .fact-panel dl { border-top: 1px solid var(--line-dark); border-left: 0; }
