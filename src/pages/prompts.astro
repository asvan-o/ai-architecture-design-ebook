---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/reference-content.css';

const entry = (await getCollection('prompts'))[0];
if (!entry) throw new Error('prompts 컬렉션 콘텐츠가 없습니다.');
const { Content } = await render(entry);
---

<SiteLayout title="프롬프트 라이브러리" section="PROMPT LIBRARY">
  <div class="page-shell prompts-page">
    <header class="page-intro">
      <p class="page-kicker">PROMPTS · REVIEWED LIBRARY</p>
      <h1 class="page-title">프롬프트<br />라이브러리</h1>
      <p class="lead">실제 수업 Source에서 확인한 재질·가구·환경·카메라 변경 프롬프트를 목적별로 찾고 복사합니다.</p>
    </header>
    <Content />
  </div>
</SiteLayout>
