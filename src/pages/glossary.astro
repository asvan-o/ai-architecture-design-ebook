---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/reference-content.css';

const entry = (await getCollection('glossary'))[0];
if (!entry) throw new Error('glossary 컬렉션 콘텐츠가 없습니다.');
const { Content } = await render(entry);
---

<SiteLayout title="용어 사전" section="GLOSSARY">
  <div class="page-shell reference-page">
    <header class="page-intro">
      <p class="page-kicker">GLOSSARY · VERIFIED TERMS</p>
      <h1 class="page-title">용어<br />사전</h1>
      <p class="lead">제1~4차시에서 사용하는 핵심 용어를 국문명, 영문명, 강의 내 의미와 혼동하기 쉬운 개념으로 함께 확인합니다.</p>
    </header>
    <Content />
  </div>
</SiteLayout>
